Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Tetris: {
					DisplayName: Tetris
					Tooltip:
						'''
						Hold this item to unfold a pixel Tetris board.
						Right click in multiplayer to invite the nearest player who is also holding Tetris.
						A/D or Left/Right moves the falling piece. S or Down soft drops. Space hard drops.
						W, Up, or X rotates clockwise. Z rotates counterclockwise. C stores the current piece.
						Clear full rows to score and survive. If the stack reaches the top, game over. Press R after game over to restart.
						'''
				}

				Game2048: {
					DisplayName: "2048"
					Tooltip:
						'''
						Hold this item to unfold a 4x4 pixel 2048 board.
						Use W/A/S/D or the arrow keys to slide all tiles. Equal tiles merge once per slide.
						Every successful slide creates a new 2 or 4 tile. Press R after game over to restart.
						'''
				}

				Snake: {
					DisplayName: Snake
					Tooltip:
						'''
						Hold this item to unfold a pixel Snake board.
						Tap W/A/S/D once to turn the snake. Eat apples to grow longer and faster.
						Hitting a wall or your own body ends the game. Press R after game over to restart.
						'''
				}

				Minesweeper: {
					DisplayName: Minesweeper
					Tooltip:
						'''
						Hold this item to unfold a pixel Minesweeper board.
						Left-click a covered tile to reveal it. Right-click a covered tile to place or remove a flag.
						Numbers show how many mines touch that tile. Revealing a mine ends the game.
						Correctly flag every mine, with no wrong flags, or reveal every safe tile to win. Left-click after the game ends to restart.
						'''
				}

				STG: {
					Tooltip:
						'''
						Hold this item to unfold a vertical retro shooter panel.
						A/D moves left and right. W/S moves forward and back. The plane fires automatically.
						Destroy randomly incoming enemy aircraft to score. Enemy planes, enemy bullets, and collisions cost one life.
						Enemies sometimes drop P upgrades that add extra shots and spread. Lose all three lives and it is game over. Press R to restart.
						'''
					DisplayName: STG
				}

				SacredThunder: {
					DisplayName: Sacred Thunder
					Tooltip: "[GFB]"
					LegendaryText:
						'''
						Throws a holy thunder disk that strikes up to five times before returning
						Stealth strike: the disk stops in the air for 15 seconds, escalating its borrowed lightning and holy beams before detonating
						[c/FFE85A:"But I think it is pretty sacred."]
						[c/6FDFFF:"Sacred? More like thunder."]
						'''
				}

				LegendaryCodex: {
					DisplayName: Legendary Codex
					Tooltip: Left click to open the legendary weapon codex.
				}

				CTRLBoss: {
					DisplayName: Boss Progress & Summoner
					Tooltip: Left click to open or close the boss progress debug panel. Right click to open or close the boss summon panel.
				}

				SoundproofEarmuffs: {
					DisplayName: Soundproof Earmuffs
					Tooltip:
						'''
						Right-click in the inventory to toggle muffling.
						When enabled, sound effects are reduced by 90%. Music is unaffected.
						Current state: [STATE]
						'''
					EnabledState: On
					DisabledState: Off
				}
			}

			Consumables: {
				LegendarySupplyBox: {
					DisplayName: Legendary Supply Box
					Tooltip: Right click to claim the currently available legendary weapons.
				}

				RetroGameConsoleSupplyBox: {
					DisplayName: Retro Game Console Supply Box
					Tooltip: Right click to claim the currently available retro game consoles.
				}

				QuickStartBox: {
					DisplayName: Quick Start Supply Box
					Tooltip:
						'''
						Right click to open. Grants strong early-game equipment, potions, and bulk resources.
						[WARNING: This item severely breaks game balance. Think twice before opening!]
						'''
				}

				Prime2041Summoner: {
					DisplayName: Strange Mechanical Skull
					Tooltip:
						'''
						Summons a Skeletron Prime from version 2.0.4.1
						Only works when summoned in Master Mode
						Only usable at night
						'''
				}

				Destroyer2041Summoner: {
					DisplayName: Strange Mechanical Worm
					Tooltip:
						'''
						Summons a Destroyer from version 2.0.4.1
						Only works when summoned in Master Mode
						Only usable at night
						'''
				}

				Twins2041Summoner: {
					DisplayName: Strange Mechanical Lens
					Tooltip:
						'''
						Summons the Twins from version 2.0.4.1
						Only works when summoned in Master Mode
						Only usable at night
						'''
				}
			}

			LegendaryEmblem: {
				DisplayName: Legendary Emblem
				Tooltip: Permanently unlocks every legendary weapon ultimate for this character
				AlreadyConsumed: This character has already received the Legendary Emblem's permanent boost.
			}

			LegendaryUltimateTester: {
				DisplayName: Legendary Ultimate Tester
				Tooltip: Test accessory: legendary weapon ultimates fully recharge in 1 second
			}

			TestWeapon: {
				DisplayName: Test Weapon
				Tooltip: ""
			}
		}

		Projectiles: {
			A_Dev: {
				TetrisPanel.DisplayName: Tetris Board
				Game2048Panel.DisplayName: 2048 Board
				SnakePanel.DisplayName: Snake Board

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendBrinyBaron: {
					DisplayName: Briny Baron - Return of Legends
					Tooltip: "[GFB]"
					BB_Left_1:
						'''
						[c/66CCFF:Left Click: Swing in a steady one-way rhythm.]
						[c/7F8FA6:Combo cycle (Stage 1): Fires a Seafoam Blade and three Sea Spirits with a 5-degree spread on each attack.]
						[c/99CCFF:The Seafoam Blade features glowing aquamarine star particles; the Sea Spirits have weak homing and deal no damage for the first 10 frames.]
						[c/4FAEFF:Tide rules: Blade hit +1 (2s cooldown), Boss fight auto +1 per 5s, no boss -1 per 5s, taking damage -1, no attack for 5s clears tide.]
						[c/4FAEFF:Bonus: +3% Briny Baron damage per stack; full tide +10% extra; full tide shurikens gain homing.]
						'''
					BB_Left_2:
						'''
						[c/66CCFF:Left Click: Swing in a steady one-way rhythm.]
						[c/7F8FA6:Stage 2, 3-swing cycle: Seafoams ×3 → faster Sea Spirits ×6 → Light Wave.]
						[c/99CCFF:Seafoams at 1.7× speed, 1.5× size, more pierce, with trail; Light Wave has a charge sound.]
						[c/4FAEFF:Direct blade hits summon a tornado. Sea Spirits deal no damage for the first 10 frames.]
						'''
					BB_Left_3:
						'''
						[c/66CCFF:Left Click: Swing in a steady one-way rhythm.]
						[c/7F8FA6:Stage 3, 4-swing cycle: parallel Seafoams ×5 + normal wave → Sea Spirits ×10 + normal wave → Shurikens ×5 + normal wave → giant enhanced Light Wave.]
						[c/99CCFF:Parallel Seafoams: extremely fast, no homing, heavy pierce; giant enhanced Light Wave fires tracking bubbles (normal waves do not).]
						[c/4FAEFF:Direct blade hits summon a tornado. Sea Spirits deal no damage for the first 10 frames.]
						'''
					BB_Left_4:
						'''
						[c/66CCFF:Left Click: Swing in a steady one-way rhythm.]
						[c/7F8FA6:Stage 4, 4-swing cycle: parallel Seafoams ×5 + normal wave → Sea Spirits ×10 + normal wave → Shurikens ×5 + normal wave → giant ultimate Light Wave.]
						[c/99CCFF:Giant ultimate Light Wave triggers tornado on hit (5-frame cooldown) and fires tracking bubbles; direct blade hits also trigger one and scatter fast sine-wave Sea Spirits.]
						[c/4FAEFF:Scattered Sea Spirits: sine-wave path for 20 frames then strong homing; no damage for first 10 frames. Normal waves do not fire tracking bubbles.]
						'''
					BB_Right_DefaultShuriken:
						'''
						[c/66CCFF:Right Click: Throw Tide Shurikens (Default).]
						[c/7F8FA6:Shurikens deal damage on hit. Throwing speed scales with range. Gain homing when tide is full.]
						'''
					BB_Right_LostGarment:
						'''
						[c/66CCFF:Right Click (Lost Garment): Dash through enemies.]
						[c/7F8FA6:Dashes forward and passes straight through all enemies along the path, dealing damage without being deflected.]
						'''
					BB_Right_CeruleanShield:
						'''
						[c/66CCFF:Right Click (Cerulean Shield): Dash and rebound off enemies.]
						[c/7F8FA6:Dashes forward and slams into the first enemy, bouncing back and triggering a cerulean explosion.]
						[c/7F8FA6:If an enemy is hit, the dash cooldown is immediately reduced to 1 second instead of 3.]
						'''
					BB_Right_VortexPortal:
						'''
						[c/66CCFF:Right Click (Vortex Portal): Teleport to cursor, then swing twice.]
						[c/7F8FA6:Instantly teleports to the target location and performs two consecutive slashes. Cooldown: 6 seconds.]
						'''
					BB_Right_Spin_Locked: "[c/7F8FA6:Hold Left Click, then hold Right Click: Locked (Unlock Whirl Cleave at Stage 2)]"
					BB_Right_Spin_Unlocked:
						'''
						[c/7F8FA6:Hold Left Click, then hold Right Click: Whirl the blade around you.]
						[c/DDA0FF:The wheel gains speed while held; only at full speed does it scatter tidal blades around you.]
						[c/FFB347:Low-speed whirling builds pressure, while the completed wheel controls nearby space.]
						'''
					BB_Tide: "[c/4FAEFF:Current tide value: ]"
					BB_Tide_Desc_NoAccessory: "[c/4FAEFF:(No dash/teleport accessory equipped, Tide only increases weapon damage)]"
					BB_Tide_Desc_HasAccessory: "[c/4FAEFF:(Accessory equipped, can perform dash/teleport attacks)]"
					Dash1_Unlock: "[c/66FFAA:Unlocked: Basic Dash]"
					Dash1_Lock: "[c/7F8FA6:Locked: Defeat the Eye of Cthulhu to unlock it.]"
					Dash2_Unlock: "[c/66FFAA:Unlocked: Spiral Cleave]"
					Dash2_Lock: "[c/DDA0FF:Locked: Defeat the Wall of Flesh to unlock it.]"
					Dash3_Unlock: "[c/66FFAA:Unlocked: Quick Slash]"
					Dash3_Lock: "[c/99CCFF:Locked: Defeat the Wall of Flesh to unlock it.]"
					BB_Passive: "[c/9AEF9E:When the player performs a dash, executes a dash reinforcement based on the currently equipped dash shield. Passive State: {0} (Right-click in inventory to toggle).]"
					PassiveStateOn: "[c/7BFFB7:On]"
					PassiveStateOff: "[c/F0D070:Off]"
					PassiveDevice_None: "[c/7F8FA6:No shield dash device is being read.]"
					PassiveDevice_OrnateShield: "[c/99CCFF:Ornate Shield is fitted; while shield rushing, it releases one tidal blade to each velocity-side every 7 frames.]"
					PassiveDevice_DeepDiver: "[c/99CCFF:Deep Diver is fitted; while surging, it releases one tidal blade to each velocity-side every 7 frames.]"
					PassiveDevice_AsgardsValor: "[c/99CCFF:Asgard's Valor is fitted; while shield rushing, it releases one tidal blade to each velocity-side every 7 frames.]"
					PassiveDevice_ElysianAegis: "[c/99CCFF:Elysian Aegis is fitted; while shield rushing, it releases one tidal blade to each velocity-side every 7 frames.]"
					PassiveDevice_AsgardianAegis: "[c/99CCFF:Asgardian Aegis is fitted; while shield rushing, it releases one tidal blade to each velocity-side every 7 frames.]"
					Dash4_Unlock: "[c/66FFAA:Unlocked: EX Skill「Oceanic Execution」]"
					Dash4_Lock: "[c/FFB347:EX Skill「Oceanic Execution」locked (Equip Legendary Emblem to unlock)]"
					BB_Final: "[c/9FD8A2:When tide is full and EX is ready, press the Legendary Skill key to lock onto a target, then left-click to sentence and execute.]"
					LegendaryHint: "[c/6C8EFF:Hold Shift to read the record]"
					LegendaryText:
						'''
						[c/66CCFF:The blade only begins its true hunt once the tide gauge is completely full.]
						[c/7F8FA6:It searches around the cursor for the worthiest target, then drags the whole battlefield into the sentence.]
						[c/99CCFF:Once the lock is set, fleeing or repositioning only changes the angle of the execution.]
						[c/DDA0FF:The confirming left click makes the wielder appear around the victim again and again, piercing through, cleaving, and reappearing.]
						[c/FFB347:The final mark does not fade at once; it clings to the prey and keeps delivering giant verdict slashes.]
						[c/66CCFF:When the tide finally recedes, the target and every bystander on the line are usually already broken apart.]
						'''
				}
			}

			BBTest: {
				DisplayName: BB Test
				Tooltip: ""
			}

			OffshoreWindTurbine: {
				DisplayName: Offshore Wind Turbine
				Tooltip:
					'''
					Increases Briny Baron's maximum tide by 4
					A higher tide cap means more stacked 3% damage bonuses, rewarding sustained combat
					[c/7F8FA6:Multiple copies stack]
					'''
			}

			ImpactRestarter: {
				DisplayName: Impact Restarter
				Tooltip:
					'''
					Right-click dash cooldown instantly resets on enemy hit, allowing immediate re-use
					Cerulean Shield dash cooldown is compressed from 3 seconds down to 1 second on hit
					[c/7F8FA6:Best used in dense crowds where the right-click dash becomes the core attack rhythm]
					'''
			}

			HighTideOverloadBarrier: {
				DisplayName: High-Tide Overload Barrier
				Tooltip:
					'''
					While at full tide, gain 20 defense and 20% damage reduction
					Water mist particles pulse around you as a visual indicator that the barrier is active
					[c/7F8FA6:The barrier drops the moment tide is consumed — keeping tide full is the key]
					'''
			}

			SurgeChainReactor: {
				DisplayName: Surge Chain Reactor
				Tooltip:
					'''
					Briny Baron left-click damage reduced by 50%
					Quick Slash damage increased to 2000% (×20)
					Quick Slash continuously unleashes a fiercer barrage of sea spirits during its swing
					[c/7F8FA6:Sacrifice sustained damage for extreme Quick Slash burst]
					'''
			}

			VortexPortal: {
				DisplayName: Vortex Portal
				Tooltip:
					'''
					[c/99CCFF:Replaces right-click skill with Vortex Portal Assault]
					Teleport to the cursor's position, then perform two consecutive slash attacks
					[c/FFB347:Cooldown: 6 seconds — significantly longer than standard dash. Highest skill priority]
					'''
			}

			LostGarment: {
				DisplayName: Lost Garment
				Tooltip:
					'''
					[c/99CCFF:Replaces right-click skill with Blade Storm Dash (Pass-Through)]
					Dash in the cursor's direction, passing straight through all enemies and dealing continuous damage
					[c/FFB347:Skill priority 10 — lowest; any other right-click skill accessory overrides this]
					'''
			}

			CeruleanShield: {
				DisplayName: Cerulean Shield
				Tooltip:
					'''
					[c/99CCFF:Replaces right-click skill with Cerulean Rebound Dash]
					Dash into the first enemy hit, bounce back, and trigger a cerulean explosion
					On hit, dash cooldown is immediately reduced to 1 second (Impact Restarter clears it entirely)
					[c/FFB347:Skill priority 20 — overrides Lost Garment, overridden by Vortex Portal]
					'''
			}

			BBPassiveChanneler: {
				DisplayName: Tide Radar
				Tooltip:
					'''
					[c/9AEF9E:As long as Briny Baron is anywhere in your inventory, the Quick Slash passive stays active — no need to hold it]
					Passive behavior is identical to holding the weapon; no values are changed or enhanced
					[c/7F8FA6:Grants no other combat bonuses — purely keeps the passive running while you swap weapons]
					'''
			}

			BottledRaft: {
				DisplayName: Bottled Raft
				Tooltip:
					'''
					+5% melee damage
					Increases Briny Baron's max tide to 6
					+7% Briny Baron damage when at full tide
					'''
			}

			BottledBoat: {
				DisplayName: Bottled Boat
				Tooltip:
					'''
					+8% melee damage
					Increases Briny Baron's max tide to 8
					+10% Briny Baron damage when at full tide
					Full tide significantly boosts shuriken homing and slash count
					'''
			}

			BottledBlackPearl: {
				DisplayName: Bottled Black Pearl
				Tooltip:
					'''
					+12% melee damage
					Increases Briny Baron's max tide to 10
					+14% Briny Baron damage when at full tide
					Full tide grants +10 defense and 10% damage reduction
					Light Wave projectiles gain near-infinite pierce
					'''
			}

			BottledAircraftCarrier: {
				DisplayName: Bottled Aircraft Carrier
				Tooltip:
					'''
					+15% melee damage
					Increases Briny Baron's max tide to 13
					+18% Briny Baron damage when at full tide
					'''
			}

			DrinkingFountain: {
				DisplayName: Drinking Fountain
				Tooltip:
					'''
					Blade hits spawn a healing water orb at the impact point
					When at full health, the orb instead homes in on enemies and deals damage
					[c/7F8FA6:The water orb counts as melee damage and benefits from tide bonuses]
					'''
			}

			AdrenalineInjector: {
				DisplayName: Adrenaline Injector
				Tooltip:
					'''
					Blade hits stack adrenaline, boosting damage and attack speed (up to 18 stacks)
					Taking any damage instantly clears all stacks, and that hit deals additional damage scaling with lost stacks
					[c/7F8FA6:Higher stacks mean higher risk — best for aggressive, uninterrupted offense]
					'''
			}
		}


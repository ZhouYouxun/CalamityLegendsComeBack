Mods: {
	CalamityLegendsComeBack: {
		Items: {
			TestItem: {
				DisplayName: PF Test Item
				Tooltip: While equipped, Pristine Fury single right clicks cycle imprints for testing
			}

			// General (Lily) accessories
			PFLily: {
				DisplayName: Lily
				Tooltip: Imprint queue +1 (total 4)\nRanged damage +8%\nRaises purification cap to level 3\nLv3 purification increases sustained damage; slightly weakens enemy attack rhythm; Boss takes more PF damage and extra purification burns on left-click hits
			}

			PFSlightlyBloomLily: {
				DisplayName: Slightly Bloomed Lily
				Tooltip: Imprint queue +2 (total 5)\nRanged damage +12%\nRaises purification cap to level 4\nLv4 purification causes purification combustion on regular enemy death; Boss periodically triggers mini combustion
			}

			PFBloomLily: {
				DisplayName: Bloomed Lily
				Tooltip: Imprint queue +3 (total 6)\nRanged damage +16%\nRaises purification cap to level 5\nLv5 purification enhances combustion; spreads lv2 purification on enemy death; Boss periodically releases white flames
			}

			PFKillIntentLily: {
				DisplayName: Lily of Killing Intent
				Tooltip: Imprint queue +4 (total 7)\nRanged damage +22%\nRaises purification cap to level 6\nLv6 purification causes large combustion and spreads lv3 purification on death; Boss enters kill-intent purification state with powerful periodic bursts
			}

			// Skill accessories
			PFChangEFireCan: {
				DisplayName: Chang'E Grievance Fire Can
				Tooltip: While holding Pristine Fury, the fuel backpack gains independent HP and can block enemy projectiles\nIf a blocked projectile exceeds the backpack's remaining HP, the backpack explodes in a 500x500 purification blast that does not harm the player or allies
			}

			PFMooncake: {
				DisplayName: Mooncake
				Tooltip: When a right-click nova fireball hits or explodes, it leaves a brief Moonhalo Brand in the area\nEnemies inside the brand accumulate purification faster\nEnemies already at the purification cap trigger an extra mini purification combustion
			}

			PFNineTails: {
				DisplayName: Pristine Nine Tails
				Tooltip: While holding Pristine Fury, the three fox fire tails become nine pristine fox tails\nTails are larger, have greater range, and automatically home toward nearby enemies\nHits deal high purification damage and slightly advance purification progress
			}

			PFLingmuFOMO: {
				DisplayName: Reimu FOMO
				Tooltip: When firing the left-click attack with the current imprint, non-selected imprints in the queue each fire a low-power echo projectile every 60 frames\nEffectively an additional set of side-cannon salvos
			}

			PFHellFairyTorch: {
				DisplayName: Hell Fairy's Torch
				Tooltip: When a regular enemy reaches the max purification level, it instantly takes 60% of its max HP as true damage, then periodically emits friendly purification sparks\nWhen a Boss triggers purification combustion, all purification levels reset and the Boss instantly takes 10% of its max HP as true damage, then fires a spiral burst of purification projectiles
			}

			Weapons: {
				NewLegendPristineFury: {
					DisplayName: Pristine Fury - Return of Legends
					PristineFuryIntro: "[c/FF9340:Current imprint: {0}.]"
					RightClick: "[c/FFB066:Right Click: charge and release a pristine nova shot.]"
					Hook: "[c/9AEAFF:Hold Left + Right to launch the extraction hook; valid bosses grant imprints.]"
					Left_Idle: "[c/FFE05C:Left Click: fire slow gravity sparks in a compact spreader rhythm.]"
					Left_DesertScourge: "[c/FFE05C:Left Click: fire glass blocks that shatter into cutting fragments.]"
					Left_EyeOfCthulhu: "[c/FFE05C:Left Click: fire restrained deathstare beams that lean toward enemies.]"
					Left_Skeletron: "[c/FFE05C:Left Click: launch bonefire skull sparks that curve and burst.]"
					Left_EvilT2: "[c/FFE05C:Left Click: launch magic-drawn yellow worms that repeatedly rush nearby targets.]"
					Left_SlimeGod: "[c/FFE05C:Left Click: fire overloaded slime globes built for ricochet and late homing.]"
					Left_HardMode: "[c/FFE05C:Left Click: launch heavy fireballs that leave fragments and ground fire.]"
					Left_Prime: "[c/FFE05C:Left Click: spray gear-toothed golden fire with mechanical spark teeth.]"
					Left_BrimstoneElemental: "[c/FFE05C:Left Click: fire brimstone rays that seed homing barrages.]"
					Left_FakeCalamity: "[c/FFE05C:Left Click: charge a yellow nova orb that detonates for burst damage.]"
					Left_Plantera: "[c/FFE05C:Left Click: prime visual beams before a splitting green lightning strike.]"
					Left_Golem: "[c/FFE05C:Left Click: channel a solar welding ray with a lethal endpoint.]"
					Left_Goliath: "[c/FFE05C:Left Click: charge briefly, then release a forward swarm of reaper drones.]"
					Left_Empress: "[c/FFE05C:Left Click: sustain a rainbow fire-lance that brightens as it ramps.]"
					Left_Moonlord: "[c/FFE05C:Left Click: warm up lunar bolts before an instant massive laser.]"
					Left_Providence: "[c/FFE05C:Left Click: profaned mortars create ground fire and celestial rain.]"
					Left_Ravager: "[c/FFE05C:Left Click: channel a bloodstone laser that sustains the user.]"
					Left_Polterghast: "[c/FFE05C:Left Click: fire aggressive phantom soulflames through targets.]"
					Left_Dog: "[c/FFE05C:Left Click: tear open void streams, delayed rifts, and black disks.]"
					Left_ExoTwins: "[c/FFE05C:Left Click: snap an Artemis warning laser, then launch Apollo rockets.]"
					Left_ExoThanatos: "[c/FFE05C:Left Click: converge Thanatos telegraphs into an extinction beam.]"
					Left_ExoAres: "[c/FFE05C:Left Click: fire rapid Ares lasers directly from the muzzle.]"
					Left_Dragon: "[c/FFE05C:Left Click: ramp dragon-breath volleys into short frenzy cycles.]"
					Passive:
						'''
						[c/FF7733:Passive: three fire tails fight behind the player.]
						[c/FF7733:They inherit weapon damage and strike rapidly with a short per-target cooldown.]
						[c/FF7733:Tail hits restore a small amount of wing flight time.]
						[c/BB55FF:Passive: a holy crystal hovers above the player's head while holding Pristine Fury.]
						[c/BB55FF:Left Click: crystal fires rapid homing shards toward the nearest enemy.]
						[c/BB55FF:Right Click (charging): crystal unleashes two slowly rotating scissor lasers.]
						'''
					Tooltip: "[GFB]"
					LegendaryHint: "[c/BABABA:Hold Shift to access the record]"
					LegendaryText:
						'''
						[c/FF9340:The first Pristine Fury was still a weapon that breathed holy flame, holding back nearby enemies with sustained burning.]
						[c/FFB066:That fire was pure enough, but it could not carry the pressure left by defeated bosses beyond Providence.]
						[c/9AEAFF:After the rebuild, the hook is no longer only a hit tool. It extracts, records, and preserves the marks of different enemies.]
						[c/FFB066:Each mark returns to the barrel, letting the flame carry malice, divinity, plague, hunger, or a more distant echo.]
						[c/FF7733:When the final fire burns again, Pristine Fury exhales more than flame. It exhales the legends it once anchored.]
						'''
				}
			}
		}


Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewVesuvius: {
					DisplayName: 地动山摇-维苏维阿斯
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/FF8A3D:左键：蓄积熔压，松开后射出爆发的火山弧光球。]
						[c/FF8A3D:弧光球命中受火山灾祸侵蚀的敌人时，会继续喷出岩浆。]
						'''
					ChargeStage1: "[c/FF8A3D:熔压让弧光球膨胀，爆发更加猛烈。]"
					ChargeStage2: "[c/FF8A3D:熔压让弧光球追踪敌人，撕开敌群。]"
					ChargeStage3: "[c/FF8A3D:熔压让弧光球命中后接连喷发。]"
					ChargeStage4: "[c/FF8A3D:熔压凝成热核，命中后引发完整喷发。]"
					RightClick:
						'''
						[c/FFB15C:右键：蓄力喷出超级火焰，使敌人染上火山灾祸。]
						[c/FFB15C:随后左键可立刻释放强化弧光球，右键则召下熔岩陨石。]
						'''
					Passive:
						'''
						[c/CC9A6A:被动【移动火山】：身边的火山灰使敌人染上火山灾祸。]
						[c/D878FF:被动【灰烬之魂】：击败敌人或消耗魔力会积聚魂火。]
						[c/D878FF:魂火积满后，下一次左键会让魂火环绕弧光球一同飞出。]
						'''
					EXHint:
						'''
						[c/FFD86B:大招【火山喷发】：按下【{0}】举起法杖，引发火山喷发。]
						[c/FFD86B:火山灰、熔岩与黑曜石碎片倾泻而下。]
						'''
					EXDisabledHint: "[c/9A9A9A:大招【火山喷发】进入困难模式后自动解锁。]"
					Final: "[c/FFB15C:地壳崩裂、灰烬遮天、火山碎屑流横扫整个战场。]"
				}
			}
		}


Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				LeonidProgenitor: {
					DisplayName: 狮子座流星雨
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/74D8FF:左键：在身边生成两颗小流星，短暂停留后飞向鼠标。]
						[c/99CCFF:小流星会撞击反射陨星，增伤、加速并改变轨道。]
						[c/9AD8FF:点亮狮子座主星，永久改变你的流星雨。]
						'''
					StealthLeftClick: "[c/B7A4FF:潜伏左键：在鼠标斜上方召来一阵流星雨。]"
					RightClick: "[c/8DEBFF:右键：长按蓄力一颗大流星；潜伏右键放出狮首与反射陨星。]"
					UltimateSkill: "[c/FFE85A:终结技（按 {0}）：展开引力场，召来从天空落下的流星暴。需要满终结能量和潜伏值。]"
					Passives: "[c/BFAFFF:动能循环：左键流星反射后会加速、增伤；第七次反射后会回到身边环绕。]"
					ConstellationStatus: "[c/FFE85A:狮子座星辉：可用 {0} | 已消耗 {1} | 已获得 {2} | 全图需 {3}]"
					ConstellationHint: "[c/B8A8FF:手持时点击鼠标中键，或在背包中对本武器点击鼠标中键，打开狮子座矩阵。]"
					LegendaryHint: "[c/BABABA:按住 Shift 阅读传奇记录]"
					LegendaryText: "[c/66E6FF:狮子座流星雨不再从背包寻找金属。每一位被击败的大型 Boss，都会成为狮子天空中的一颗星辉。]"

					Constellation: {
						Title: 狮子座流星雨矩阵
						Subtitle: Regulus is the heart. Awaken any principal star.
						Status: 可用 {0}    已消耗 {1}    已获得 {2}    全图需 {3}
						HoverHint: 悬停主星查看星辉印记
						Reset: 重置星图（免费）
						Heart: 狮心主星 — 恒常点亮
						Unlocked: Awakened
						Cost: 消耗：{0} 星辉

						Nodes: {
							Regulus: {
								Name: 轩辕十四 狮心

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Melee: {
					CosmicDischarge: {
						DisplayName: God-Rift Cosmic Discharge
						Tooltip: ""
					}
				}

				NewLegendCosmicDischarge: {
					DisplayName: God-Rift Cosmic Discharge - Legend Reborn
					Tooltip: "[GFB]"
					WhipName: Whip Mode
					SwordName: Sword Mode
					ChainKnifeName: Chain Blade Mode
					UltimateActiveText: God-rift opened!
					CosmicDischargeLeft:
						'''
						[c/8DEBFF:Left click: performs a three-hit combo in the current form. All hits inflict GodSlayerInferno and a rift mark.]
						[c/8DEBFF:Whip form: each hit has its own smear, lightning, or line-beam signature. Lashes throw rift bombs; the thrust detonates where it hits.]
						[c/8DEBFF:Sword form: the blade stays straight and fixed-length. Swings release heavy-homing DoG blades; the finisher creates distortion, rift cracks, and triple explosions.]
						[c/8DEBFF:Chain Blade form: multiple chains converge on the cursor. The first two hits emphasize current and stars; the finisher uses starsmoke, laser walls, and a severe explosion.]
						'''
					CosmicDischargeRight:
						'''
						[c/6FDFFF:Right click: opens a three-layer Stream Gouge rift portal and cycles forms (Whip -> Sword -> Chain Blade).]
						[c/6FDFFF:During a third-hit windup: triggers QuickDraw. After a 20-frame charge, the target point erupts with the full DoG particle library and grants 10 ultimate energy.]
						'''
					CosmicDischargeUltimate:
						'''
						[c/FFE85A:Ultimate: at 120 energy, press] [[c/FFE85A:{0}]] [c/FFE85A: to begin a 60-frame rift charge.]
						[c/FFE85A:Burst: full-screen FriendlyLaserWallBeam walls plus a DoGTeleportRift-class explosion, followed by a DoGFire-style lingering field.]
						'''
					CosmicDischargePassive: "[c/B8F4FF:Rift Seal:] [c/DCD6C8:while held, any single hit that would exceed 20% of your max HP is capped at that value. When triggered, gain 5 seconds of Rift Revival (+20% damage). Cooldown: 60 seconds.]"
					LegendaryHint: "[c/BABABA:Hold Shift to read the legendary record]"
					LegendaryText:
						'''
						[c/8DEBFF:The rift does not open because you swung the blade. It opens because it was already open — waiting for something to fall through.]
						[c/6FDFFF:Every form is a different language the Devourer uses to finish a sentence it started before the universe remembered itself.]
						[c/B8F4FF:The seal does not protect you. It reminds the void that you are still here to be consumed later.]
						'''
				}
			}
		}

		Buffs: {
			CosmicDischargeRiftRevivalBuff: {
				DisplayName: Rift Revival
				Description: The Devourer rift shatters your limits. Damage, defense, and movement speed increased by 20%.
			}

			CosmicDischargeUltimateGuardBuff: {
				DisplayName: Rift Field Guard
				Description: Damage taken is reduced and defense is increased.
			}

			CosmicDischargeDoGMarkDebuff: {
				DisplayName: Rift Mark
				Description: Marked by Devourer rift energy. Certain attacks can detonate the mark.
			}

			CosmicDischargeDevourerAscensionBuff: {
				DisplayName: Devourer Ascension
				Description: Damage, mobility, defense, damage reduction, and melee attack speed are increased.
			}

			CosmicDischargeDevourerSliverBuff: {
				DisplayName: Rift Sliver
				Description: Damage and defense are slightly increased.
			}
		}

		Projectiles: {
			Melee: {
				CosmicDischargeSwordWave.DisplayName: Cosmic Discharge Rift Wave
				CosmicDischargeDoGRiftBomb.DisplayName: Cosmic Discharge Rift Bomb
				CosmicDischargeDoGEnergyBolt.DisplayName: Cosmic Discharge DoG Blade
				CosmicDischargeDoGConvergenceExplosion.DisplayName: Cosmic Discharge Segment Rift
				CosmicDischargeSwitchPortal.DisplayName: Cosmic Discharge Switch Portal
				CosmicDischargeUltimateField.DisplayName: Cosmic Discharge Rift Field
				CosmicDischargeChainKnife.DisplayName: Cosmic Discharge Chain Blade
				CosmicDischargeComboHoldout.DisplayName: Cosmic Discharge Combo Holdout
				CosmicDischargeRiftSplit.DisplayName: Cosmic Discharge Rift Split
				CosmicDischargeHookHead.DisplayName: Cosmic Discharge Hook Head
				CosmicDischargeHookLimb.DisplayName: Cosmic Discharge Hook Limb
				CosmicDischargeKillModeReady.DisplayName: Cosmic Discharge Kill Mode Ready
				CosmicDischargeKillModeSlash.DisplayName: Cosmic Discharge Kill Mode Slash
			}
		}

		Cooldowns: {
			CosmicDischarge_Ultimate: Rift Energy
			CosmicDischarge_RiftSeal: Rift Seal
			CosmicDischarge_QuickDraw: Rift Draw
		}
	}
}

				LeonidReflectiveMeteor.DisplayName: 反射陨星
				LeonidCometLarge.DisplayName: 狮源陨星-大
				LeonidLionHead.DisplayName: 狮头虚影
				LeonidGravityField.DisplayName: 狮子座回响重力场
				LeonidUltimateUI.DisplayName: 终结能量条
				LeonidRightClickHoldout.DisplayName: 流星右键手持弹幕
				LPBookPanel.DisplayName: 狮源金属矩阵面板
				// LeonidStealthRainSpawner.DisplayName: Leonid Stealth Rain Spawner
			}
		}

		Buffs: {
			LeonidGravityDebuff: {
				DisplayName: 群星重力
				Description: 重力场限制了你，无法横向移动，并受到极强向下牵引！
			}
		}

		TheSpecialText: {
			LPBookNoRecords: 暂无已注册的狮源金属注入记录。
			LPBookMissingEffect: 暂无效果记录
		}

		Cooldowns.LeonidEX: 引力尽头
	}

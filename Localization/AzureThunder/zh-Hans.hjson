Mods: {
	CalamityLegendsComeBack: {
		Common.NoMana: 魔力不足

		Items: {
			Weapons: {
				AzureThunder: {
					DisplayName: 青霆剑
					Tooltip: "[GFB]"
					AzureThunderLeft:
						'''
						[c/6FDFFF:左键：] [c/DCD6C8:缓慢挥动大剑，释放青霆光弹和多个飞行重剑。]
						[c/8DEBFF:命中敌人后] [c/DCD6C8:释放额外闪电攻击。]
						'''
					AzureThunderRight:
						'''
						[c/6FDFFF:右键：] [c/DCD6C8:在附近的地面或者空中创建多把浮空剑。]
						[c/8DEBFF:浮空剑] [c/DCD6C8:会周期性地对附近敌人释放天降闪电。]
						'''
					AzureThunderUltimate:
						'''
						[c/FFE85A:终结技：] [c/DCD6C8:终结技能量达到120后按 [{0}] 获得25秒天理真和。]
						[c/FFE85A:天理真和] [c/DCD6C8:会强化青霆剑的左键、右键与最终攻击。]
						'''
					AzureThunderPassiveHeavenEarth0: "[c/B8F4FF:天地造化：] [c/DCD6C8:开局解锁。荒灾会使其得到提升。]"
					AzureThunderPassiveHeavenEarth1: "[c/B8F4FF:天地造化：] [c/DCD6C8:场上每存在一把青霆剑，+1魔力再生。]"
					AzureThunderPassiveHeavenEarth2: "[c/B8F4FF:天地造化：] [c/DCD6C8:场上每存在一把青霆剑，+1魔力再生；+2护甲穿透。]"
					AzureThunderPassiveHeavenEarth3: "[c/B8F4FF:天地造化：] [c/DCD6C8:场上每存在一把青霆剑，+1魔力再生；+2护甲穿透；+1生命再生。]"
					AzureThunderPassiveHeavenEarth4: "[c/B8F4FF:天地造化：] [c/DCD6C8:场上每存在一把青霆剑，+1魔力再生；+2护甲穿透；+1生命再生；+2%魔法伤害。]"
					AzureThunderPassiveHeavensWard0: "[c/B8F4FF:承天之佑：] [c/8A8A8A:邪恶T2后解锁。]"
					AzureThunderPassiveHeavensWard1: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时可周期性闪避一次攻击并恢复40点生命。]"
					AzureThunderPassiveHeavensWard2: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时可周期性闪避一次攻击并恢复80点生命。]"
					AzureThunderPassiveHeavensWard3: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时可周期性闪避一次攻击并恢复125点生命。]"
					AzureThunderPassiveHeavensWard4: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时可周期性闪避一次攻击并恢复150点生命。]"
					AzureThunderPassiveHeavensWard5: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时可周期性闪避一次攻击并恢复200点生命。]"
					AzureThunderPassiveFourSymbols0: "[c/B8F4FF:和合四象：] [c/8A8A8A:肉山后解锁。]"
					AzureThunderPassiveFourSymbols1: "[c/B8F4FF:和合四象：] [c/DCD6C8:若场上青霆剑少于3把，每10秒自动生成1把。]"
					AzureThunderPassiveFourSymbols2: "[c/B8F4FF:和合四象：] [c/DCD6C8:若场上青霆剑少于3把，每10秒自动生成1把；触发时额外回复生命。]"
					AzureThunderPassiveFourSymbols3: "[c/B8F4FF:和合四象：] [c/DCD6C8:触发时额外回复生命；若场上青霆剑少于6把，每10秒自动生成1把。]"
					AzureThunderThunderCharge: "[c/FFE85A:一息万变：] [c/DCD6C8:攻击带有电系减益、元素协鸣或超界崩解的敌怪时获得，最多10层。]"
					AzureThunderDot: "[c/FFE85A:天理真和持续伤害：] [c/DCD6C8:随流程从静电逸散逐步升级，并在高阶阶段追加更强减益。]"
					AzureThunderFinal: "[c/FFE85A:“愿殷雷阵阵，驱邪秽，引甘霖，济苍生”]"
				}
			}
		}

		Buffs: {

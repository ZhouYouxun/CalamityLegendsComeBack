Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Malachite: {
					DisplayName: Peacock Plume
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/7DFF9A:Left: Throw a peacock kunai.]
						[c/7DFF9A:Stored stealth kunai fire first, one by one.]
						[c/7DFF9A:Ignores gravity with Clear Breeze Kunai; later tiers add shots.]
						'''
					RightClick:
						'''
						[c/80FFC8:Right: Store right feathers behind you.]
						[c/80FFC8:Right click pours all stored feathers out.]
						[c/80FFC8:Normal right feathers do not explode or gain stealth power.]
						'''
					StealthStrike:
						'''
						[c/B5FF74:Stealth left: Store 23 malachite darts.]
						[c/B5FF74:Stealth right: Fire every stored right feather.]
						[c/B5FF74:Stealth right feathers explode and gain power.]
						'''
					Finale:
						'''
						[c/D6FF9A:Finale: At full stealth and off cooldown, press] [[c/D6FF9A:{0}]] [c/D6FF9A:.]
						[c/D6FF9A:Spotlights mark you and nearby enemies.]
						[c/D6FF9A:23 petals turn into blades and split by distance.]
						'''
					Passive:
						'''
						[c/9AFFC8:Passive while held:]
						[c/9AFFC8:Into Shadow: stealth attacks consume only half of your stealth and instantly restore 15 stealth points; while above 50% stealth, also gain 15% movement speed.]
						'''
					LegendaryHint: "[c/BABABA:Hold Shift to read the record]"
					LegendaryText:
						'''
						[c/7DFF9A:When the plume opens, it is not the blade that moves, but the time left to its target.]
						[c/80FFC8:The frenzied kunai obey the fan only until they are awakened.]
						[c/B5FF74:The peacock spread waits in shadow, each blade watching for the first wrong step.]
						[c/D6FF9A:Once the spotlight falls, one cut is enough; the blasts finish the curtain call.]
						'''
				}
			}

			Accessories: {
				BreezeKunai: {
					DisplayName: Breeze Kunai
					Tooltip:
						'''
						+10 rogue stealth maximum
						Peacock Plume projectile speed +8%
						Peacock Plume kunai gain +10 armor penetration
						'''
				}

				ClearBreezeKunai: {
					DisplayName: Clear Breeze Kunai
					Tooltip:
						'''
						+15 rogue stealth maximum
						Peacock Plume projectile speed +12%
						Peacock Plume kunai gain +15 armor penetration
						Peacock Plume left-click normal kunai are no longer affected by gravity
						'''
				}

				GaleKunai: {
					DisplayName: Gale Kunai
					Tooltip:
						'''
						+20 rogue stealth maximum
						Peacock Plume projectile speed +16%
						Peacock Plume kunai gain +25 armor penetration
						After a stealth strike, refund an additional 25% of consumed stealth
						'''
				}

				WillowBlade: {
					DisplayName: Willow Blade
					Tooltip:
						'''
						+40 rogue stealth maximum
						Peacock Plume projectile speed +22%
						Peacock Plume kunai gain +50 armor penetration
						While both left fan and right feathers are full, "Peacock Display": +20% move speed, +2 jump speed, +230% flight time
						'''
				}

				PeacockScroll: {
					DisplayName: Peacock Scroll
					Tooltip:
						'''
						Right feather generation speed doubled
						While Peacock Plume is in your inventory, generates right feathers at the same rate as when held
						Right feather speed +15% and damage +20%
						'''
				}

				PrecisionEmblem: {
					DisplayName: Precision Emblem (Retired)
					Tooltip: This accessory has been removed and no longer has any effect.
				}

				MalachiteFeather: {
					DisplayName: Malachite Feather (Retired)
					Tooltip: This accessory has been removed and no longer has any effect.
				}

				GaleAce: {
					DisplayName: Gale Ace
					Tooltip:
						'''
						Enables grazing: nearby enemy projectiles trigger a graze
						On successful graze: restore 20% stealth
						Gain 1 stack of brief attack boost (each stack: +8% rogue damage, max 5 stacks)
						'''
				}

				PeacockBox: {
					DisplayName: Peacock Box
					Tooltip:
						'''
						Peacock Plume stores right feathers while in your inventory
						Stores 1 feather every 60 frames and auto-fires at 23
						'''
				}

				PeacockDart: {
					DisplayName: Peacock Dart
					Tooltip:
						'''
						Peacock Plume left and right projectiles are affected by gravity
						Those projectiles deal 30% extra damage
						'''
				}
			}
		}

		Projectiles: {
			Malachite: {
				MalachiteKunai.DisplayName: Peacock Kunai
				MalachiteHitCutVisual.DisplayName: Peacock Hit Lines
				MalachiteGreenExplosion.DisplayName: Peacock Blast
				MalachiteRightFeather.DisplayName: Malachite Right Feather
				MalachiteRightFeatherExplosion.DisplayName: Malachite Feather Blast
				MalachiteRightNovaShard.DisplayName: Malachite Nova
				MalachiteGrazeSlashVisual.DisplayName: Nimble Graze Slash
				MalachiteFinaleController.DisplayName: Peacock Finale
				MalachiteFinaleSlash.DisplayName: Peacock Slash
				MalachiteFinaleHitSlash.DisplayName: Peacock Execution Slash
				MalachiteFinaleDart.DisplayName: Peacock Finale Dart
				MalachiteFinaleImpactExplosion.DisplayName: Peacock Lamp Burst
				MalachiteFinalePetal.DisplayName: Peacock Petal
			}
		}

		Cooldowns.Malachite_EX: Peacock Finale Cooldown
	}
}

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Tetris: {
					DisplayName: 俄罗斯方块
					Tooltip:
						'''
						手持该物品即可展开像素俄罗斯方块面板。
						A/D 或左右方向键控制方块左右移动。S 或下方向键快速下落。空格键硬降到底。
						W、上方向键或 X 顺时针旋转。Z 逆时针旋转。C 暂存当前方块。
						游戏结束后按 R 重新开始。
						'''
				}

				Snake: {
					DisplayName: 贪吃蛇
					Tooltip:
						'''
						手持该物品即可展开像素贪吃蛇面板。
						单次点击 W/A/S/D 控制蛇转向。
						游戏结束后按 R 重新开始。
						'''
				}

				Minesweeper: {
					DisplayName: 扫雷
					Tooltip:
						'''
						手持该物品即可展开像素扫雷面板。
						左键踩雷，右键标记雷，可以反复取消标记
						数字表示周围的地雷数量，不小心踩到雷，会导致游戏直接结束
						标记所有地雷即可获胜，游戏结束后左键点击重新开始。
						[c/6FDFFF:“不是怎么老被炸呀”]
						'''
				}

				Strikers1945: {
					Tooltip:
						'''
						手持该物品即可展开纵屏1945面板。
						A/D 控制左右，W/S 控制前后，飞机会自动开火。
						击落随机来袭的敌机获得分数。命中敌机、敌弹或被敌机撞到都会损失生命。
						敌机偶尔掉落 P 强化，提升子弹数量与散射。三条命耗尽后游戏结束，按 R 重新开始。
						'''
					// DisplayName: "1945"
				}

				SacredThunder: {
					DisplayName: 神圣雷霆
					Tooltip: "[GFB]"
					LegendaryText:
						'''
						丢出雷电神圣飞盘，反复攻击5次后飞回玩家
						潜伏攻击：飞盘停在空中滞留15秒，不断释放越来越多的闪电与圣光，结束后巨型爆炸并消失
						[c/FFE85A:“可是我觉得很神圣啊”]
						[c/6FDFFF:”神圣你雷霆“]
						'''
				}

				CTRLBoss: {
					DisplayName: Boss进度修改器
					Tooltip: 左键打开或关闭 Boss 进度调试面板。
				}
			}

			Consumables: {
				LegendarySupplyBox: {
					DisplayName: 传奇补给箱
					Tooltip:
						'''
						右键打开，领取目前已经准备好的传奇武器。
						“你根本想象不到在另一个世界的人们想要获得这个箱子两个月的使用权需要经历多少种苦难”
						'''
				}

				RetroGameConsoleSupplyBox: {
					DisplayName: 复古游戏机补给包
					Tooltip: 右键打开，领取目前已经准备好的复古游戏机。
				}
			}
		}

		Projectiles: {
			A_Dev: {
				TetrisPanel.DisplayName: 俄罗斯方块面板
				SnakePanel.DisplayName: 贪吃蛇面板
				MinesweeperPanel.DisplayName: 扫雷面板
				Strikers1945Panel.DisplayName: 1945 战机面板
				CTRLBossPanel.DisplayName: Boss进度面板
			}

			SacredThunder.SacredThunderPROJ.DisplayName: 神圣雷霆
		}

		TheSpecialText: {
			TetrisLevel: 等级 {0}
			TetrisGameOver: 游戏结束
			TetrisRestart: 按 R 重新开始
			SnakeSpeed: 速度 {0}
			SnakeGameOver: 游戏结束
			SnakeRestart: 按 R 重新开始
			MinesweeperMines: 剩余 {0} 雷
			MinesweeperGameOver: 游戏结束
			MinesweeperWin: You Win
			MinesweeperRestart: 左键点击重新开始
			Strikers1945GameOver: 游戏结束
			Strikers1945Restart: 按 R 重新开始
			CTRLBossDefeated: 已击杀
			CTRLBossUndefeated: 未击杀
			CTRLBossStatusSet: "{0} 已被调整为{1}。"
			CTRLBossBulkPreHardmode: 一键开关困难模式前的所有 Boss
			CTRLBossBulkHardmode: 一键开关困难模式的所有 Boss
			CTRLBossBulkPostMoonLord: 一键开关月球领主后的所有 Boss
			CTRLBossBulkAll: 一键开关所有 Boss
			CTRLBossBulkInvert: 一键反向调整所有 Boss
			CTRLBossBulkChanged: "{0}：已调整 {1} 个 Boss 进度。"
		}

		Keybinds: {
			LegendarySkill.DisplayName: 传奇技能
			LegendaryWeaponFormSwitch.DisplayName: 传奇武器形态切换
		}
	}
}

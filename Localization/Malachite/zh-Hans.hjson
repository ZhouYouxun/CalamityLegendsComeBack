Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Malachite: {
					DisplayName: 孔雀翎
					Tooltip: "[GFB]"
					LeftClick: "[c/7DFF9A:左键：]掷出高速苦无，命中后中毒并短暂钉在敌人身上。若背后已有特殊苦无，会优先逐把投出；肉后普通苦无不再受重力影响，歌莉娅后一次生成 2 把，月后一次生成 3 把，都会蓄势 10 帧后高速飞出。"
					RightClick: "[c/80FFC8:右键：]在身后生成 3 把急疯苦无构成刀扇；若已存在完整急疯刀扇，会先将旧刀扇一次性激发出去再重新挂上 3 把。冷却 3 秒。"
					StealthStrike: "[c/B5FF74:潜伏攻击：]潜伏左键和潜伏右键完全相同：若背后已有 1-23 根孔雀苦无，会先按左键弹幕一齐射出，再重新挂满 23 根孔雀苦无。孔雀苦无不能穿透，会以每帧最多 3 度的转角快速追踪目标；王牌苦无命中时引发迷你爆破。"
					Finale: "[c/D6FF9A:终结技：]满潜伏且冷却结束时按 [{0}]，柔化的绿色圆台聚光落下，花瓣飘坠；2 秒后挥出孔雀翎斩击，并在周边敌怪身上引发带黑洞核心的多段绿色爆炸。"
					Passive:
						'''
						[c/9AFFC8:被动（手持）：]
						灵动步伐：允许擦弹，每次擦弹获得 1 点潜伏值。
						幻影之刃：使用潜伏攻击后恢复 15 点潜伏值。
						遁入暗影：潜伏值高于 50% 时，获得 15% 伤害减免与移速加成。
						'''
					LegendaryHint: "[c/BABABA:按住 Shift 读取记录]"
					LegendaryText: "[c/B5FF74:看似停在影子里，实际上每一根都在等待猎物暴露逃跑的方向。]"
				}
			}

			Accessories: {
				PeacockScroll: {
					DisplayName: 孔雀卷轴
					Tooltip:
						'''
						+10%盗贼伤害
						孔雀翎右键冷却时间内，+15%盗贼攻击速度
						若世纪之花已被击败，触发孔雀翎左键加速后会重新生成3把急疯苦无
						'''
				}

				PrecisionEmblem: {
					DisplayName: 精准徽章
					Tooltip:
						'''
						+5%盗贼伤害，+10%盗贼暴击率
						被激发的孔雀翎苦无获得10点护甲穿透
						孔雀苦无和王牌苦无额外造成5%乘算伤害
						'''
				}

				MalachiteFeather: {
					DisplayName: 孔雀石羽毛
					Tooltip:
						'''
						手持孔雀翎时，+15%盗贼伤害，+5%盗贼暴击率，+10%孔雀翎弹幕速度
						没有外挂苦无时，每30帧生成一把急疯苦无
						'''
				}

				GaleAce: {
					DisplayName: 疾风王牌
					Tooltip:
						'''
						手持孔雀翎时，+15%盗贼伤害，+5%盗贼暴击率
						中毒减益伤害翻倍
						孔雀翎终结技的花瓣会被吹向面朝一侧并造成伤害
						通过终结技激发的外挂苦无会替换为王牌苦无
						'''
				}
			}
		}

		Projectiles: {

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendAntiMaterielRifle: {
					DisplayName: Little Legend - Anti-materiel Rifle
					Tooltip: "[GFB]"
					LeftClick: Fires .408 heavy anti-materiel rounds
					RightClick: Right click to widen your view and enter immersive sniping mode
					CurrentStage: Current record: {0}
					InventoryToggle: Right click in your inventory to toggle the view change
					ZoomState: Aiming zoom: {0}
					ZoomEnabled: Enabled
					ZoomDisabled: Disabled
					LegendaryHint: Hold Shift to view all unlocked upgrades and legendary text
					LatestUnlockPrefix: Latest Upgrade: {0}
					Stage0: .408 proprietary round: extreme velocity with partial armor penetration
					Stage1: Eye of Cthulhu executed: hits inflict Marked for Death and strip more defense
					Stage2: Eater of Worlds or Brain of Cthulhu executed: impacts form a metal jet through the target
					Stage3: Wall of Flesh executed: use Calamity's dash key or double-tap left/right for two chained slides that empower the next aimed shot
					Stage4: Any mechanical boss executed: the rebuilt action shortens automatic fire interval to 24 frames
					Stage5: Plantera executed: calibrate repeatedly on one target; the third hit deals greatly increased damage
					Stage6: Moon Lord executed: critical chance above 100% becomes additional critical damage
					Stage7: Providence executed: critical hits rupture the target's core for more critical damage
					Stage8: Devourer of Gods executed: slides enter the dimensional seam and empower aimed rounds further
					Stage9: Exo Mechs or Supreme Witch executed: onyx marker and detonator rounds load alternately
					LegendaryText:
						'''
						You and your cover make me laugh.
						There is no waiting—only the bullet through your chest.
						Atrocity without remainder.
						'''
				}
			}
		}

		Projectiles: {

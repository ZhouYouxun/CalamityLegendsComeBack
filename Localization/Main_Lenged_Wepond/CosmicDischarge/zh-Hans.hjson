Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Melee: {
					CosmicDischarge: {
						DisplayName: 寒宙弹刃
						Tooltip: ""
					}

					DiseasedPike: {
						// DisplayName: Diseased Pike
						// Tooltip: ""
					}
				}

				NewLegendCosmicDischarge: {
					DisplayName: 星宇裁决-“神噬”裂宇弹刃
					Tooltip: "[GFB]"
					WhipName: 鞭形态
					SwordName: 剑形态
					ChainKnifeName: 链刃形态
					UltimateActiveText: 神明裂隙展开!
					CosmicDischargeLeft:
						'''
						[c/8DEBFF:左键：当前形态连续斩击，命中留下神灼业火与裂隙印记。]
						[c/8DEBFF:鞭形态挥出远距离鞭击，剑形态以剑刃近身连斩。]
						[c/8DEBFF:链刃形态甩出锁链，终结一击让链刃一同扑向敌人。]
						'''
					CosmicDischargeRight:
						'''
						[c/6FDFFF:右键：打开裂隙，在鞭、剑与链刃形态间切换。]
						[c/6FDFFF:终结一击蓄势时按右键，发动速拔并轰击目标处。]
						'''
					CosmicDischargeUltimate:
						'''
						[c/FFE85A:大招【维度压缩】：按下【{0}】蓄力展开神明裂隙。]
						[c/FFE85A:裂隙爆发后留下一片守护玩家的领域。]
						'''
					CosmicDischargePassive:
						'''
						[c/B8F4FF:被动【裂隙封存】：手持时，裂隙会挡下过重的一击。]
						[c/B8F4FF:封存触发后，裂隙复苏会短暂唤醒你的力量。]
						'''
					CosmicDischargeUltimateLocked: "[c/9A9A9A:大招【维度压缩】进入困难模式后自动解锁。]"
					GrowthBase: "[c/8DEBFF:当前成长：三形态基础连击；神吞后剑终结技追加裂隙弹。]"
					GrowthDoG: "[c/8DEBFF:当前成长：剑终结技追加双裂隙弹；尧龙后链刃终结段追加追踪刃。]"
					GrowthYharon: "[c/8DEBFF:当前成长：链刃终结段追加双追踪刃；终局双 Boss 后速拔追加剑波。]"
					GrowthFinal: "[c/8DEBFF:当前成长：速拔追加剑波，三形态成长已完成。]"
				}
			}
		}

		Buffs: {
			CosmicDischargeWhipBuff: {
				DisplayName: 鞭形态
				Description: 攻击速度与击退力提高。
			}

			CosmicDischargeSwordBuff: {
				DisplayName: 剑形态

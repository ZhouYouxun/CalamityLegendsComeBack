Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				PlayerSaddleItem: {
					DisplayName: Седло для игрока
					Tooltip:
						'''
						Щелкните левой кнопкой по ближайшему игроку, чтобы оседлать его.
						Во время езды вы не можете двигаться, но по-прежнему можете нормально атаковать и взаимодействовать.
						Вы автоматически слезаете, если ваша «езда» погибает.
						Снова щелкните левой кнопкой, чтобы слезть, или правой, чтобы сбросить собственного наездника.
						'''
				}
			}
		}

		TheSpecialText: {
			PlayerSaddleNoTarget: Поблизости нет игрока, которого можно оседлать.
			PlayerSaddleOccupied: У этого игрока уже есть наездник.
			PlayerSaddleMounted: "{0} теперь едет верхом на {1}!"
		}
	}
}

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Summon: {
					GlacialEmbrace: {
						DisplayName: Glacial Embrace — Legend Reborn
						Tooltip: "[GFB]"
						ModeName0: Cleave Mode
						ModeName1: Pierce Mode
						ModeName2: Strike Mode
						GE_Intro:
							'''
							[c/7BC8E5:Current combat form: {0}]
							[c/A0D8EF:Summon-class legendary weapon — 48 base damage, 10 mana cost]
							[c/A0D8EF:First use automatically summons a Glacial Core (0 slots) to anchor the spike system.]
							[c/A0D8EF:All hits inflict Frostburn II (5 seconds).]
							'''
						GE_LeftClick: "[c/A0D8EF:◆ Left Click: summon Glacial Core first if absent; then Ice Spikes until full; release/charge special attack when full.]"
						GE_SpikeMode0:
							'''
							[c/90FFB0:◈ Cleave Mode — Spike Behavior]
							[c/90FFB0:  · Spikes occupy 0.5 slots. Each spike splits into opposite inner and outer crystal parts.]
							[c/90FFB0:  · Inner crystal: 90px orbit, speed 4°/frame, 0.85x damage, 90-frame NPC immunity.]
							[c/90FFB0:  · Outer crystal: 140px orbit, speed 2.8°/frame, 1.35x damage, 128-frame NPC immunity.]
							[c/90FFB0:Each crystal hits the same target once per rotation cycle. Inner and outer spikes have separate immunity.]
							'''
						GE_SpikeMode1:
							'''
							[c/80EFFF:◈ Pierce Mode — Spike Behavior]
							[c/80EFFF:  · Spikes occupy 1.0 slot, 90px orbit. Automatically flies out after 3s to homing-hit and embed (max 6 per enemy).]
							[c/80EFFF:  · Whip hit detonates 1 random embedded spike; special attack hit detonates all embedded spikes.]
							[c/80EFFF:  · Detonated spikes thrust in their embed direction to pierce and deal secondary damage to a short line of enemies.]
							'''
						GE_SpikeMode2:
							'''
							[c/FF8B60:◈ Strike Mode — Spike Behavior]
							[c/FF8B60:  · Spikes occupy 1.0 slot, tips inward. After 6s, all spikes align towards the cursor.]
							[c/FF8B60:  · Left click while aligned: triggers a collision smash, spikes converge to deal 2.2x AoE damage, then hibernate for 4s.]
							'''
						GE_SpecialIntro: "[c/A0D8EF:◆ Special Attack (Left click / hold when minion slots are full)]"
						GE_SpecialMode0:
							'''
							[c/90FFB0:Cleave Special → Glacial Cleaver Blade (IceBladeProj)]
							[c/90FFB0:  · Condenses at cursor when held. Upon release, spins around the player for 2 rotations after a short delay.]
							[c/90FFB0:  · 8-frame NPC hit cooldown for fast multi-hits.]
							'''
						GE_SpecialMode1:
							'''
							[c/80EFFF:Pierce Special → Glacial Piercing Wedge (IceWedgeProj)]
							[c/80EFFF:  · Fires a mild-homing crystal wedge towards cursor that shatters on hit, detonating ALL embedded spikes on that target.]
							'''
						GE_SpecialMode2:
							'''
							[c/FF8B60:Strike Special → Glacial Strike Pillar (IcePillarProj)]
							[c/FF8B60:  · Drops a heavy gravity-affected ice pillar that explodes in a wide area.]
							[c/FF8B60:  · Deals strong knockback that forces boss knockback, and detonates all spikes.]
							'''
						GE_PassiveRhythm: "[c/B0E0FF:◇ Frost Rhythm: switch forms or release a charge (35-45 frames) to trigger QTE. Press {0} at 70-90% sweet spot: combo +1 (max 20). Failure resets combo.]"
						GE_PassiveCombo: "[c/B0E0FF:  · Combo: {0}. Every 2 combo: +1 life regen/s (current: +{1}); every 4 combo: +8 defense (current: +{2}); every 5 combo: restores 60 wing time.]"
						GE_PassiveDivinity: "[c/B0E0FF:  · Glacial Divinity: 10+ combo increases spike speed by 1.1x (faster rotation/fly-out). Lasts until fail or 5s.]"
						GE_PassiveAurora: "[c/C8A0FF:◇ Aurora Melody: special hits within 45 frames grant 5s of Aurora grace (+10 defense, 15% pre-defense damage reduction).]"
						GE_Ultimate:
							'''
							[c/A0F0FF:★ Ultimate — Glacial Diamond Drill]
							[c/A0F0FF:  · Special hits grant +4 energy. Press {0} at 240 energy to release (current: {1}/240).]
							[c/A0F0FF:  · Assembly (1.5s): Spikes x3 (max 30, i.e., 10 slot cap) gather in 3 layers (9-12-9) with a rotating star flash.]
							[c/A0F0FF:  · Launch (3s): Click left-click to launch towards cursor. Deals high-frequency hits; player is slowed and invulnerable.]
							[c/A0F0FF:  · Shatter: explodes after 3s for 6x damage, clearing all spikes and buffs.]
							[c/A0F0FF:  · Over-slot bonus: each slot above 10 increases drill damage by 3% (shatter by 18%).]
							'''
						LegendaryHint: "[c/BABABA:Hold Shift to read the legendary record]"
						LegendaryText:
							'''
							[c/B0D8FF:At first it was merely an ice crystal shard forgotten in the permafrost, spinning alone in an abyss untouched for a thousand years.]
							[c/B0D8FF:It knew nothing of warmth, nor any sound beyond silence.]
							[c/80C8FF:Then someone tried to tame it, weaving the cold into orbiting guardians, only to discover that frost has its own rhythm and will.]
							[c/80C8FF:Every rotation was an unfinished melody; every fracture, an unvoiced sigh.]
							[c/A0B0FF:And so the cleave split the stagnant air, the pierce threaded through frozen time, and the strike shattered what was never meant to break.]
							[c/A0B0FF:Three stances are not a choice — they are the breathing of the ice itself.]
							[c/C0A0FF:Learn to listen to its beat, to step in rhythm with each frozen cadence — that is the only key to commanding absolute cold.]
							[c/E0C0FF:When the final beat falls perfectly, the Diamond Drill awakens from its ancient seal, forging every spike into one starlit aurora lance.]
							[c/E0C0FF:Ending this battlefield of ice and fire with the will of absolute zero.]
							'''
					}
				}
			}
		}
		Projectiles: {
			IceBlockMinion.DisplayName: Glacial Core
			IceSpikeMinion.DisplayName: Glacial Ice Spike
			GlacialEmbraceChargeHoldout.DisplayName: Glacial Charge Holdout
			IceBladeProj.DisplayName: Glacial Cleaver Blade
			IceWedgeProj.DisplayName: Glacial Piercing Wedge
			IcePillarProj.DisplayName: Glacial Strike Pillar
			GlacialDrillProj.DisplayName: Glacial Diamond Drill Finisher
		}
		Buffs: {
			GlacialEmbraceBuff: {
				DisplayName: Glacial Embrace
				Description: An ancient glacier coils around you, granting the guardian's embrace of absolute cold.
			}
		}
		Cooldowns.GlacialEmbrace_Ultimate: Glacial Energy
	}
}

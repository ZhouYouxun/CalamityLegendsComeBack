Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				AegisBlade: {
					DisplayName: Unyielding Bulwark - Aegis Blade
					Tooltip: "[GFB]"
					FunctionalTooltip:
						'''
						[c/FFD966:Left Click: Spin the Aegis Blade to strike nearby enemies.]
						[c/FFD966:Holy fire erupts as it swings; souls and falling beams join the attack as the weapon grows.]
						[c/FFD966:Release left click to throw the spinning blade, still linked to you by holy light.]
						[c/8DB8FF:Right Click: Raise the shield to guard; a perfect parry empowers the next shield bash.]
						[c/8DB8FF:Release right click to dash toward the cursor and strike with the shield.]
						[c/8DB8FF:Hold both buttons to charge and raise an Aegis barricade at the cursor.]
						[c/7FE886:Passive [Aegis]: Slower movement strengthens your defense.]
						[c/7FE886:Passive [Bulwark]: Without lingering harm, you better withstand close-range blows.]
						[c/FFD700:Ultimate [Golden Hand]: Press [{0}] to summon the Golden Hand and shelter yourself from attacks.]
						'''
					GrowthStage0: "[c/FFD966:Current growth: two fireballs. Tracking souls unlock in Hardmode; falling beams unlock after Moon Lord.]"
					GrowthStage4: "[c/FFD966:Current growth: tracking souls. Shield charge unlocks after a Mechanical Boss; fireballs upgrade after Plantera.]"
					GrowthStage6: "[c/FFD966:Current growth: four fireballs and stronger soul bursts. Falling beams unlock after Moon Lord.]"
					GrowthStage8: "[c/FFD966:Current growth: two falling beams per swing. Four unlock after Providence.]"
					GrowthStage9: "[c/FFD966:Current growth: four falling beams per swing; the full attack is unlocked.]"
				}


Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendBlossomFlux: {
					DisplayName: 叶流 - 传奇归来
					Tooltip: "[GFB]"
					/* BF_Left:
						'''
						[c/66CCFF:Left Click: Fires with the current doctrine.]
						[c/99CCFF:Breakthrough, Recovery, Reconnaissance, and Bombardment only convert wooden arrows.]
						[c/99CCFF:Converted wooden arrows become doctrine-shaped leaf arrows.]
						[c/DDA0FF:Plague converts any ammo into an invisible plague flame.]
						[c/7BE495:Breakthrough is maple leaf, Recovery is parasite, and Reconnaissance is wood thorn.]
						[c/7BE495:Bombardment is branch, while Plague becomes formless toxic flame.]
						''' */
					// BF_Preset: "[c/7BE495:Current displayed doctrine: {0}; details below.]"
					PresetName0: 突击
					PresetName1: 复苏
					PresetName2: 侦察
					PresetName3: 歼灭
					PresetName4: 侵染
					PresetLeft0:
						'''
						[c/8BE89A:左键 - 突击：直线单弹道，无散射、无随机偏移、无复杂附加机制。]
						[c/8BE89A:只转化木箭；其他箭矢按原弹药发射，但仍属于叶流左键弹幕。]
						[c/8BE89A:侦察优先标记存在时，命中该目标造成 x1.40 伤害。]
						'''
					PresetLeft1:
						'''
						[c/8BE89A:左键 - 复苏：全转化，发射快速 DNA 双链叶弹。]
						[c/8BE89A:每轮发射两发；两发沿“武器到鼠标中轴线”的垂线两侧偏移，偏移会持续靠近中心、越过中心、再从另一侧返回。]
						[c/8BE89A:命中敌人有 20% 几率产生复苏闪光；闪光消失时治疗玩家并提供 5 秒复苏之叶，持续时间可叠加。]
						[c/8BE89A:侦察优先标记存在时，复苏闪光冷却改为 1.25 秒，并取消 5 秒最多 2 个的限制。多人模式本身也取消该限制。]
						'''
					PresetLeft2:
						'''
						[c/8BE89A:左键 - 侦察：全转化，适合对单且输出稳定。]
						[c/8BE89A:连射五发，每两发间隔 5 帧；每轮五连射之间间隔 20 帧。]
						[c/8BE89A:侦察箭可造成 3 次伤害；穿透敌人后短暂关闭碰撞，随机游荡，然后重新追踪。]
						[c/8BE89A:若场上存在侦察优先标记目标，侦察箭会优先追踪该目标，造成 x1.25 伤害，并在命中后折返继续攻击，折返后伤害大幅降低。]
						'''
					PresetLeft3:
						'''
						[c/8BE89A:左键 - 歼灭：全转化，从空中落下歼灭箭雨。]
						[c/8BE89A:歼灭箭穿透次数 -1，命中后触发 BFLeafBombExplosion，并额外生成无伤害视觉弹幕 FuckYou。]
						[c/8BE89A:若目标被侦察优先标记，爆炸有概率变成更高伤害、更大范围的强化爆炸，并无视普通爆炸次数限制。]
						'''
					PresetLeft4:
						'''
						[c/8BE89A:左键 - 侵染：全转化，发射使用 BlossomFluxBOMB 贴图的收割者弹幕。]
						[c/8BE89A:发射点位于手持弹幕中心附近；速度约为旧版一半，扩散角度约为旧版一半。]
						[c/8BE89A:收割者会强力追踪侦察优先标记目标。命中会施加污染和一组负面效果；重复命中会刷新或延长。]
						[c/8BE89A:污染由 GlobalNPC 管理，切换战术、换武器或丢掉武器后仍存在，直到持续时间结束。污染逐层降低敌人防御倍率，最多 -75%。]
						'''
					/* BF_Right:
						'''
						[c/F7D87C:Right Click: Tap to open the tactical panel and switch doctrine.]
						[c/F7D87C:Hold for over 0.15 seconds to enter the charge stance.]
						[c/F7D87C:Release at full charge to fire the current special arrow.]
						[c/F7D87C:Right-click special arrows hit harder than normal left arrows.]
						''' */
					PresetRight0:
						'''
						[c/F4D57A:右键 - 突击蓄力：逐根装填突击箭，松手后从中轴线排队依次射出。]
						[c/F4D57A:每两根射出间隔 4 帧；箭矢完全平行，不再按水平偏移同时齐射，也不再追踪。]
						[c/F4D57A:突击蓄力箭初速较慢，飞行中每帧速度 x1.01；具备多次穿透与穿透特效。]
						'''
					PresetRight1:
						'''
						[c/F4D57A:右键 - 复苏蓄力：向上举弓蓄力，释放一批纯粹复苏闪光。]
						[c/F4D57A:纯粹复苏闪光更大、更分散；只治疗玩家，不提供复苏之叶。]
						'''
					PresetRight2:
						'''
						[c/F4D57A:右键 - 侦察蓄力：发射高速标记箭。]
						[c/F4D57A:标记箭额外更新次数提升，不受重力下坠影响，穿透次数 -1，会记录路径上全部命中的敌人。]
						[c/F4D57A:弹幕死亡时，只标记命中过的最大生命值最高目标；标记会强化所有形态的左键。]
						'''
					PresetRight3:
						'''
						[c/F4D57A:右键 - 歼灭蓄力：鼠标位置生成赤红准星，准星跟随鼠标但带加速和减速。]
						[c/F4D57A:蓄力 60 帧可释放；释放后箭矢先向天空发射，随后从屏幕上方高速制导至准星位置并产生大爆炸。]
						[c/F4D57A:落下前准星继续跟随鼠标；箭矢重新进入屏幕后锁定最终点位。前一发爆炸前无法开始下一次歼灭蓄力。]
						'''
					PresetRight4:
						'''
						[c/F4D57A:右键 - 侵染蓄力：积攒大型孢子弹，命中后产生感染主题爆发并持续喷出孢子云。]
						[c/F4D57A:蓄力命中会永久降低该 NPC 的能力。该削弱绑定在敌人身上，不要求玩家继续手持叶流。]
						'''
					BF_Passive:
						'''
						[c/9AEF9E:被动复活：手持叶流时，可抵消一次致命伤害。]
						[c/9AEF9E:触发后立即回满生命并生成复苏立场；之后 15 秒内再次受到致命伤害会直接死亡。]
						[c/9AEF9E:若撑过倒计时，生命至少恢复到一半。当前状态：{0}。]
						'''
					PassiveStateReady: "[c/7BFFB7:已就绪]"
					PassiveStateActive: "[c/FF9B8B:终末防线中]"
					PassiveStateCooldown: "[c/F0D070:冷却 {0} 秒]"
					PassiveStateLocked: "[c/9A9A9A:困难模式后解锁]"
					// PresetUnlock1: "[c/7BFFB7:Recovery: unlocked and selectable in the tactical panel.]"
					// PresetLock1: "[c/9A9A9A:Recovery: unlocked after Queen Bee.]"
					// PresetUnlock2: "[c/7BFFB7:Reconnaissance: unlocked and selectable in the tactical panel.]"
					// PresetLock2: "[c/9A9A9A:Reconnaissance: unlocked in Hardmode.]"
					// PresetUnlock3: "[c/7BFFB7:Bombardment: unlocked and selectable in the tactical panel.]"
					// PresetLock3: "[c/9A9A9A:Bombardment: unlocked after Skeletron Prime.]"
					// PresetUnlock4: "[c/7BFFB7:Plague: unlocked and selectable in the tactical panel.]"
					// PresetLock4: "[c/9A9A9A:Plague: unlocked after the Plaguebringer Goliath.]"
					// BF_Final: "[c/9FD8A2:The bowstring hums, and the forest answers.]"
					/* BF_EX:
						'''
						[c/8EF5A8:Legendary Skill: Stores up to 60 Bloom Energy.]
						[c/8EF5A8:While held, restores 1 energy every 2 seconds.]
						[c/8EF5A8:Releasing a charged right-click arrow restores 3 energy.]
						[c/8EF5A8:At full energy with the EX accessory, press the Legendary Skill key.]
						[c/8EF5A8:Then enter the ready stance and left-click.]
						[c/8EF5A8:Finally releases the verdant arrow curtain barrage.]
						''' */
					LegendaryHint: "[c/BABABA:按住 Shift 阅读完整传奇记录]"
					LegendaryText:
						'''
						[c/66E6FF:最初，它只是一场追求更快连射的尝试。]
						[c/66E6FF:后来制作者意识到，速度不是答案。]
						[c/66E6FF:同一根弓弦必须学会五种呼吸方式。]
						[c/66E6FF:于是战术拆分为五条枝流。]
						[c/66E6FF:即便是普通木箭，也会在离弦后改变形态。]
						[c/66E6FF:它仍会继续生长，但节奏已经成形。]
						[c/66E6FF:等待、松弦，然后让战术回应。]
						'''
				}
			}
		}


Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				AegisBlade: {
					DisplayName: 固若金汤-庇护之刃
					Tooltip: "[GFB]"
					FunctionalTooltip:
						'''
						[c/FFD966:左键：旋转庇护之刃，斩击周围敌人。]
						[c/FFD966:挥舞时射出圣火；随着武器成长，圣光灵魂与光柱加入攻势。]
						[c/FFD966:松开左键掷出斩击盘，圣光连线仍与玩家相连。]
						[c/8DB8FF:右键：举盾格挡，完美格挡会强化随后的盾牌猛击。]
						[c/8DB8FF:松开右键向光标方向冲刺，以盾牌撞击敌人。]
						[c/8DB8FF:同时按住左右键蓄力，在光标处升起庇护掩体。]
						[c/7FE886:被动【埃癸斯】：移动越慢，防御越稳。]
						[c/7FE886:被动【壁垒】：未受持续伤害侵扰时，更能抵御近身冲击。]
						[c/FFD700:大招【金手】：按下【{0}】召唤金手，庇护玩家免受攻击。]
						'''
					GrowthStage0: "[c/FFD966:当前成长：双火球；困难模式解锁圣光灵魂，月后解锁天降光柱。]"
					GrowthStage4: "[c/FFD966:当前成长：圣光灵魂散射；机械 Boss 后可蓄盾，花后升级火球。]"
					GrowthStage6: "[c/FFD966:当前成长：四火球与强化圣光散射；月后解锁天降光柱。]"
					GrowthStage8: "[c/FFD966:当前成长：每轮两道天降光柱；神后升级为四道。]"
					GrowthStage9: "[c/FFD966:当前成长：每轮四道天降光柱，完整攻势已解锁。]"
				}

				Summon: {
					GlacialEmbrace: {
						DisplayName: 极寒节奏-冰霜之拥
						Tooltip: "[GFB]"
					}
				}
			}
		}


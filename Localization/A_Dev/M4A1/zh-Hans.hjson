Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				InheritedCaseM4A1: {
					DisplayName: 传承武器箱·M4A1
					Tooltip: "[GFB]"
					M4A1_Intro: 一只在战火中传承下来的武器箱——开局是迷你鲨，中期是巨兽玛瑙爆破鲨，后期是弑君之刃
					M4A1_LeftClick: 长按左键暖机，射出三种弹幕（特殊子弹·荧光绿能量弹·火箭弹）；战术同步率越高，射速、弹速与精度越好
					M4A1_RightClick: 右键从武器箱中展开便携式重炮，消耗约 35 点战术同步率；炮弹伤害为左键的 600%，同步率越高齐射越完整
					M4A1_Mark: 连续命中同一敌人为其烙上伸冤者印记（最多三层）：先追加伤害，再破甲，最后周期性引发战术爆破
					M4A1_Passive: 被动·战术指挥模块：战术同步率以矩阵条显示在你的头顶
					M4A1_Ultimate: 大招·伸冤者印记：完全同步后按 {0} 令武器箱完全展开，锁定光标附近至多五个目标，倾泻一轮追踪炮弹齐射
				}
			}
		}

		Projectiles: {

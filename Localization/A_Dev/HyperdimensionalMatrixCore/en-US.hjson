			Weapons: {
				HyperdimensionalMatrixCore: {
					DisplayName: Hyperdimensional Matrix Core
					Tooltip:
						'''
						[c/7EB8FF:Summons a Matrix Core; its damage increases with your minion slots]
						[c/FF9040:Always locks onto the nearest enemy]
						[c/FFEC40:Data Matrix · Geometric Projection · Geometric Satellite · Fluid Aggregation · Spatial Warp · Hyperdimensional Inscription]
						[c/5880C0:Fortifies your body · reduces incoming damage · regenerates life · boosts movement speed · reduces aggro · extends flight time]
						[c/FF3030:Overclocks all modules when health is critical; its passive data field continuously damages all nearby enemies]
						[c/AA88FF:Non-homing projectiles deal double damage]
						[c/787888:"It is a pleasure working with you, two-dimensional organism."]
						'''
				}
			}
		}

		Buffs: {
			HyperdimensionalMatrixCoreBuff: {
				DisplayName: Matrix Protection Field
				Description: Fortifies body · reduces damage · regenerates life · boosts speed · reduces aggro; the core recompiles the battlefield
			}
		}

		Projectiles: {
			HyperdimensionalMatrixCore: {
				HyperdimensionalMatrixCoreProjectile.DisplayName: Hyperdimensional Matrix Core

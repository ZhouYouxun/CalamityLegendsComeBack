			Twins2041Retinazer.DisplayName: Twins2041 Retinazer
			Twins2041Spazmatism.DisplayName: Twins2041 Spazmatism
		}

		Projectiles: {
			ResponsibilityCommunicationSequence.DisplayName: Wulfrum Communication Sequence

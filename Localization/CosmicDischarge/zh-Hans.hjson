Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Melee: {
					CosmicDischarge: {
						DisplayName: 寒宙弹刃
						Tooltip: ""
					}
				}

				NewLegendCosmicDischarge: {
					DisplayName: 寒宙弹刃-传奇归来
					Tooltip: "[GFB]"
					WhipName: 鞭形态
					SwordName: 剑形态
					ChainKnifeName: 链刀形态
					UltimateActiveText: 神明裂隙展开!
					CosmicDischargeLeft:
						'''
						[c/8DEBFF:左键：根据当前形态释放三连击，命中施加神明吞噬者风格的裂隙印记。]
						[c/8DEBFF:鞭形态：顺/逆时针甩动会甩出逐渐减速的裂隙炸弹；直线突刺命中会在原地爆炸。]
						[c/8DEBFF:剑形态：刀刃保持伸直并固定长度。每次挥动都会释放多枚强追踪 DoG 光刃，适合反复压制单体目标。]
						[c/8DEBFF:链刀形态：多条段体锁链汇聚到鼠标位置，引发严重爆炸和短暂滞留伤害。]
						'''
					CosmicDischargeRight:
						'''
						[c/6FDFFF:右键：通过裂隙传送门循环切换左键形态（鞭 -> 剑 -> 链刀）。]
						[c/6FDFFF:第三段前摇期间右键：触发裂隙出鞘，直接刺出并快速抽回弹刃。只有裂隙出鞘会提供10点终结技能量。]
						'''
					CosmicDischargeUltimate:
						'''
						[c/FFE85A:终结技：能量达到120后按] [[c/FFE85A:{0}]] [c/FFE85A:，撕开神明裂隙并在玩家身上生成10秒力场。]
						[c/FFE85A:力场：8格内敌怪被高额减速并持续遭受 GodSlayerInferno；周期性生成 DoG 激光墙。]
						'''
					CosmicDischargePassive: '''[c/B8F4FF:裂隙封存：] [c/DCD6C8:手持时，单次伤害超过最大生命值20%的部分将被削减至上限。触发时获得5秒"裂隙复苏"（伤害+20%），冷却60秒。]'''
				}
			}
		}

		Buffs: {
			CosmicDischargeIceboundBuff: {
				DisplayName: 裂隙免死
				Description: 致死伤害被压制，生命再生大幅提高。
			}

			CosmicDischargeFrostwindRevivalBuff: {
				DisplayName: 裂隙复苏
				Description: 神明裂隙打破极限，伤害提升20%。
			}

			CosmicDischargeUltimateGuardBuff: {
				DisplayName: 神明裂隙场
				Description: 受到伤害降低，防御提高。
			}

			CosmicDischargeDoGMarkDebuff: {
				DisplayName: 裂隙印记
				Description: 被神明吞噬者裂隙标记，特定攻击会引爆印记。
			}

			CosmicDischargeFrozenEmperorBuff: {
				DisplayName: 吞噬升格
				Description: 伤害、机动、防御、伤害减免与近战攻速提高。
			}

			CosmicDischargeFrozenEmperorSliverBuff: {
				DisplayName: 裂隙残辉
				Description: 伤害与防御小幅提高。
			}
		}

		Projectiles: {
			Melee: {
				CosmicDischargeSwordWave.DisplayName: 裂隙剑气
				CosmicDischargeDoGRiftBomb.DisplayName: 裂隙炸弹
				CosmicDischargeDoGEnergyBolt.DisplayName: 神明光刃
				CosmicDischargeDoGConvergenceExplosion.DisplayName: 段体裂隙爆破
				CosmicDischargeModeShift.DisplayName: 形态裂隙
				CosmicDischargeUltimateField.DisplayName: 神明裂隙场
				// CosmicDischargeChainKnife.DisplayName: Cosmic Discharge Chain Knife
				// CosmicDischargeComboHoldout.DisplayName: Cosmic Discharge Combo Holdout
				// CosmicDischargeEndothermicSplit.DisplayName: Cosmic Discharge Endothermic Split
				// CosmicDischargeHookHead.DisplayName: Cosmic Discharge Hook Head
				// CosmicDischargeHookLimb.DisplayName: Cosmic Discharge Hook Limb
				// CosmicDischargeKillModeReady.DisplayName: Cosmic Discharge Kill Mode Ready
				// CosmicDischargeKillModeSlash.DisplayName: Cosmic Discharge Kill Mode Slash
				// CosmicDischargeScytheProjectile.DisplayName: Cosmic Discharge Scythe Projectile
			}
		}

		Cooldowns: {
			CosmicDischarge_Ultimate: 裂隙能量
			CosmicDischarge_Icebound: 裂隙封存
			CosmicDischarge_QuickDraw: 裂隙出鞘
		}
	}
}

Mods: {
	CalamityLegendsComeBack: {
		Common.NoMana: 魔力不足

		Items: {
			Weapons: {
				AzureThunder: {
					DisplayName: 青霆剑
					Tooltip: "[GFB]"
					AzureThunderLeft:
						'''
						[c/6FDFFF:左键：] [c/DCD6C8:挥动青霆剑，释放雷法与青霆剑攻击敌人。]
						[c/8DEBFF:最后一击] [c/DCD6C8:如果击败了所有机械boss，则每存在3把释放青霆剑便恢复5点魔力。]
						'''
					AzureThunderRight:
						'''
						[c/6FDFFF:右键：] [c/DCD6C8:消耗所有一息万变并生成等量的青霆剑。如果青霆剑总数少于3，则额外生成一把]
						[c/8DEBFF:释放青霆剑：] [c/DCD6C8:会响应青霆剑的右键，依次生成雷电攻击敌人，最后一次雷击造成更高伤害。]
						[c/6FDFFF:右键：][c/DCD6C8:如果击败了所有机械boss，则每消耗1层一息万变便恢复5点魔力。]
						'''
					AzureThunderUltimate:
						'''
						[c/FFE85A:终结技：] [c/DCD6C8:终结技能量达到240后按 [{0}] ]进入持续25秒的天理真和状态。
						[c/FFE85A:天理真和：] [c/DCD6C8:强化青霆剑的左键与右键。]
						'''
					AzureThunderPassiveHeavenEarth0: "[c/B8F4FF:天地造化：] [c/DCD6C8:开局解锁。击败荒漠灾虫、邪恶BOSS、猪龙鱼公爵、犽戎以强化本效果。]"
					AzureThunderPassiveHeavenEarth1: "[c/B8F4FF:天地造化：] [c/DCD6C8:场上每存在一把青霆剑，+1魔力再生。]"
					AzureThunderPassiveHeavenEarth2: "[c/B8F4FF:天地造化：] [c/DCD6C8:场上每存在一把青霆剑，+1魔力再生；+2护甲穿透。]"
					AzureThunderPassiveHeavenEarth3: "[c/B8F4FF:天地造化：] [c/DCD6C8:场上每存在一把青霆剑，+1魔力再生；+2护甲穿透；+1生命再生。]"
					AzureThunderPassiveHeavenEarth4: "[c/B8F4FF:天地造化：] [c/DCD6C8:场上每存在一把青霆剑，+1魔力再生；+2护甲穿透；+1生命再生；+2%魔法伤害。]"
					AzureThunderPassiveHeavensWard0: "[c/B8F4FF:承天之佑：] [c/8A8A8A:击败血肉宿主或腐巢意志后解锁。]"
					AzureThunderPassiveHeavensWard1: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时允许闪避一次攻击并恢复40点生命，冷却99秒。]"
					AzureThunderPassiveHeavensWard2: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时允许闪避一次攻击并恢复80点生命，冷却99秒。]"
					AzureThunderPassiveHeavensWard3: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时允许闪避一次攻击并恢复125点生命，冷却99秒。]"
					AzureThunderPassiveHeavensWard4: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时允许闪避一次攻击并恢复150点生命，冷却99秒。]"
					AzureThunderPassiveHeavensWard5: "[c/B8F4FF:承天之佑：] [c/DCD6C8:手持时允许闪避一次攻击并恢复200点生命，冷却99秒。]"
					AzureThunderPassiveFourSymbols0: "[c/B8F4FF:和合四象：] [c/8A8A8A:击败血肉墙后解锁。]"
					AzureThunderPassiveFourSymbols1: "[c/B8F4FF:和合四象：] [c/DCD6C8:若场上青霆剑少于3把，则每10秒自动生成1把。]"
					AzureThunderPassiveFourSymbols2: "[c/B8F4FF:和合四象：] [c/DCD6C8:若场上青霆剑少于3把，则每10秒自动生成1把；触发时额外回复生命。]"
					AzureThunderPassiveFourSymbols3: "[c/B8F4FF:和合四象：] [c/DCD6C8:若场上青霆剑少于6把，则每10秒自动生成1把；触发时额外回复生命。]"
					AzureThunderThunderCharge: "[c/FFE85A:一息万变:] [c/DCD6C8:左键最后一次攻击命中时根据目标的电系减益数、元素谐鸣与超位崩解相应获得层数，最多3层.]"
					AzureThunderDot: "[c/FFE85A:天理真和：] [c/DCD6C8:左键与右键的最后一次攻击会随着进度推进施加不同的电系减益]"
					AzureThunderFinal: "[c/32FF82:“愿殷雷阵阵，驱邪秽，引甘霖，济苍生”]"
				}


Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Summon: {
					GlacialEmbrace: {
						ModeName0: Cleave Mode
						ModeName1: Pierce Mode
						ModeName2: Strike Mode
						GE_Intro:
							'''
							[c/7BC8E5:Current form: {0} (auto-rotates every 5 seconds)]
							[c/A0D8EF:Summon legendary weapon — 48 base damage, 10 mana]
							[c/A0D8EF:First use summons a Glacial Core (0 slots) as anchor]
							[c/A0D8EF:All hits inflict Frostburn II (5 seconds)]
							'''
						GE_LeftClick:
							'''
							[c/A0D8EF:◆ Left Click: summon Glacial Core first if absent]
							[c/A0D8EF:  Then click to summon orbiting Ice Spikes]
							[c/A0D8EF:  Hold when full to charge, release for special attack]
							'''
						GE_SpikeMode0:
							'''
							[c/90FFB0:◈ Cleave — each spike splits into paired inner/outer crystals]
							[c/90FFB0:  Inner: 90px orbit, 4°/frame, 0.85x damage]
							[c/90FFB0:  Outer: 140px orbit, 2.8°/frame, 1.35x damage]
							[c/90FFB0:  Different angular speeds; independent NPC immunity]
							'''
						GE_SpikeMode1:
							'''
							[c/80EFFF:◈ Pierce — spikes orbit ~3s then fly out to embed]
							[c/80EFFF:  Max 6 spikes per enemy; reduces orbit count while out]
							[c/80EFFF:  Whip hit detonates 1 random embedded spike]
							[c/80EFFF:  Detonated spikes pierce a short line of enemies]
							'''
						GE_SpikeMode2:
							'''
							[c/FF8B60:◈ Strike — spikes face inward; auto-align after 6s cooldown]
							[c/FF8B60:  Left click when aligned: spikes collide and shockwave]
							[c/FF8B60:  2.2x collision damage; all spikes hibernate for 4s]
							'''
						GE_SpecialIntro: "[c/A0D8EF:◆ Special Attack (hold Left Click when minion slots are full)]"
						GE_SpecialMode0:
							'''
							[c/90FFB0:Cleave Special: condense ice blade at cursor position]
							[c/90FFB0:  Release to spin 2 rotations around player after delay]
							[c/90FFB0:  Multi-hit with 8-frame NPC immunity per hit]
							'''
						GE_SpecialMode1:
							'''
							[c/80EFFF:Pierce Special: fire a homing ice wedge toward cursor]
							[c/80EFFF:  Shatters on hit; detonates ALL embedded spikes on target]
							'''
						GE_SpecialMode2:
							'''
							[c/FF8B60:Strike Special: launch a heavy gravity-affected ice pillar]
							[c/FF8B60:  Wide explosion on hit; force-knockbacks bosses]
							[c/FF8B60:  Detonates all spikes into shockwaves; spikes hibernate]
							'''
						GE_PassiveRhythm:
							'''
							[c/B0E0FF:◇ Frost Rhythm: hold Right Click to start rhythm QTE bar]
							[c/B0E0FF:  Release in the green sweet-spot zone: combo +1 (max 20)]
							[c/B0E0FF:  Outside sweet spot or timeout: combo resets to 0]
							'''
						GE_PassiveCombo: "[c/B0E0FF:  Combo: {0} (+{1} life regen/s, +{2} defense)]"
						GE_PassiveDivinity: "[c/B0E0FF:  At 10 combo: spike speed +10% for 5s (Glacial Divinity)]"
						GE_PassiveAurora:
							'''
							[c/C8A0FF:◇ Aurora Melody: special hits within 0.75s of each other]
							[c/C8A0FF:  Grant 5s Aurora Grace (+10 defense, 15% pre-DR reduction)]
							'''
						GE_Ultimate:
							'''
							[c/A0F0FF:★ Ultimate — Glacial Diamond Drill (press {0} to release)]
							[c/A0F0FF:  Special hits give +4 energy. Current: {1}/240]
							[c/A0F0FF:  On release: spikes triple into 3-layer drill (max 30)]
							[c/A0F0FF:  Left click to launch; high-freq hits; player is invulnerable]
							[c/A0F0FF:  Shatters after 3s for 6x area damage; clears all spikes]
							'''
						LegendaryHint: "[c/BABABA:Hold Shift to read the legendary record]"
						LegendaryText:
							'''
							[c/B0D8FF:At first it was merely an ice crystal shard forgotten in the permafrost,]
							[c/B0D8FF:spinning alone in an abyss untouched for a thousand years.]
							[c/B0D8FF:It knew nothing of warmth, nor any sound beyond silence.]
							[c/80C8FF:Then someone tried to tame it, weaving the cold into orbiting guardians,]
							[c/80C8FF:only to discover that frost has its own rhythm and will.]
							[c/80C8FF:Every rotation was an unfinished melody;]
							[c/80C8FF:every fracture, an unvoiced sigh.]
							[c/A0B0FF:And so the cleave split the stagnant air,]
							[c/A0B0FF:the pierce threaded through frozen time,]
							[c/A0B0FF:and the strike shattered what was never meant to break.]
							[c/A0B0FF:Three stances are not a choice — they are the breathing of the ice itself.]
							[c/C0A0FF:Learn to listen to its beat, step in rhythm with each frozen cadence —]
							[c/C0A0FF:that is the only key to commanding absolute cold.]
							[c/E0C0FF:When the final beat falls perfectly, the Diamond Drill awakens,]
							[c/E0C0FF:forging every spike into one starlit aurora lance.]
							[c/E0C0FF:Ending this battlefield of ice and fire with the will of absolute zero.]
							'''
					}
				}
			}
		}

		Projectiles: {
			IceBlockMinion.DisplayName: Glacial Core
			IceSpikeMinion.DisplayName: Glacial Ice Spike
			GlacialEmbraceChargeHoldout.DisplayName: Glacial Charge Holdout
			IceBladeProj.DisplayName: Glacial Cleaver Blade
			IceWedgeProj.DisplayName: Glacial Piercing Wedge
			IcePillarProj.DisplayName: Glacial Strike Pillar
			GlacialDrillProj.DisplayName: Glacial Diamond Drill
		}

		Buffs: {
			GlacialEmbraceBuff: {
				DisplayName: Glacial Embrace
				Description: An ancient glacier coils around you, granting the guardian's embrace of absolute cold.
			}
		}

		Cooldowns.GlacialEmbrace_Ultimate: Glacial Energy
	}
}

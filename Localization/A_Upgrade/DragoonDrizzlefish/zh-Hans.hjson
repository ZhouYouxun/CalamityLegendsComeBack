Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewDragoonDrizzlefish: {
					DisplayName: 宴火龙骑鱼
					Tooltip:
						'''
						发射硫火鱼焰；每隔数发喷出一颗会分裂的大火球
						<right>从背包前往后寻找第一个可食用物并喂给小家伙
						不同食物会改变同一套火球的飞行、分裂、命中与灼烧逻辑
						连续喂食会提高饱腹度；过饱时弹道会变得不稳定
						[c/9DA8B8:按住 Shift 查看完整菜单]
						'''
					MealDetails:
						'''
						[c/FFE09A:喂食规则] 右键会消耗背包中从前往后的第一个可喂物；把想喂的食物放在更靠前的格子即可控制菜式。收藏的物品不会被消耗。
						[c/9DA8B8:所有菜式都不会把武器换成其他弹幕；它们只改造当前的小火球、大火球与分裂火苗。]
						[c/8FD8FF:凝胶] 最基础的燃料；略微提高火球伤害，持续时间较短。
						[c/FFE09A:主食/面包/普通食物] 稳定套餐；射速略快、散布更小，大火球循环更平滑。
						[c/FF7A42:肉类] 重炮套餐；火球变大、伤害与击退提高，但射击节奏变慢。
						[c/FF9A54:美味肉排] 肉类强化版；大幅提高单发压迫感，适合打硬目标。
						[c/55D2FF:鱼类/海鲜] 追猎套餐；火球轻微追踪目标，命中时会溅出小火苗。
						[c/6FE8FF:深渊炖鱼] 海鲜强化版；追踪范围和持续发射数更高。
						[c/74F074:水果/植物] 留火套餐；命中后强化硫火灼烧，并洒出绿色余烬。
						[c/FF96EB:甜品] 糖分套餐；射速与大火球频率提高，火球会额外蹦出小火球。
						[c/FF78F0:亵渎甜甜圈] 甜品强化版；糖分爆发更激烈，额外小火球更多。
						[c/FF4614:辛辣/硫火/熔岩料理] 高温套餐；灼烧时间更长，大火球分裂更多。
						[c/FF5A22:熔岩鸡汤] 辛辣强化版；伤害、灼烧与分裂火力都更强。
						[c/BE78FF:饮品/酒类] 微醺套餐；射速较快但散布更大，弹道会摇晃，偶尔乱溅火苗。
						[c/AFFF46:怪味/蘑菇] 幻觉套餐；火球轨迹波动，命中时可能生成异常角度的火苗。
						[c/B6FF50:怪异蘑菇] 怪味强化版；波动更明显，随机溅射更频繁。
						[c/FFFF78:三明治] 胃痛套餐；每一发随机套用一种菜式，且立刻进入过饱。
						[c/CFA6FF:优质糊糊] 消化后随机变成一种普通套餐。
						[c/FF6A6A:过饱] 连续喂食会触发过饱：火球威力略降，但分裂更多、散布和摇晃明显变大。
						'''
				}
			}
		}

		Projectiles: {
			DragoonDrizzlefish: {
				FoodDrizzlefishFireball.DisplayName: 宴火鱼焰
				FoodDrizzlefishFire.DisplayName: 宴火大鱼焰
				FoodDrizzlefishFireSplit.DisplayName: 宴火分裂焰
			}
		}
	}
}

				BrinyBaron_DashWaterPillar.DisplayName: Baron Dash Water Pillar
				BrinyBaron_SkillDashTornado_BladeDash.DisplayName: Blade Dash
				BrinyBaron_SkillSpinRush_SpinBlade.DisplayName: Spiral Cleave
				BrinyBaron_SkillSlashDash_SlashDash.DisplayName: Shield-Surge Cleave
				Z_BrinyBaron_SkillSuperCharge_SuperDash.DisplayName: Final Tide Execution
				BBSD_Star.DisplayName: Final Tide Star
				BBSD_Final_INV.DisplayName: Final Tide Brand
				SurgeChainWaterBurst.DisplayName: Surge Chain Water Burst
				BrinyBaron_HomingBubble.DisplayName: Briny Baron_ Homing Bubble
				BrinyBaron_Tornado.DisplayName: Briny Baron_ Tornado
				BrinyBaron_WaterStream.DisplayName: Briny Baron_ Water Stream
			}
		}

		Cooldowns: {
			BrinyBaron_Tide: Briny Baron Tide
			BrinyBaron_SuperDash: Briny Baron Finisher
		}
	}

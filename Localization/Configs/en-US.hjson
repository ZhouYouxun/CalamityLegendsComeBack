Mods: {
	CalamityLegendsComeBack: {
		Configs: {
			CalamityLegendsComeBackConfig: {
				DisplayName: Calamity Legends Come Back Settings

				AllowMassMaterialRecipes: {
					Label: Allow Bulk Material Crafting
					Tooltip: If enabled, many materials can be copied or crafted in a simpler way.
				}

				AllowBossRelicWeaponRecipes: {
					Label: Allow Boss Relic Weapon Recipes
					Tooltip: If enabled, some boss relics can be crafted into their related weapon drops.
				}

				AllowOtherRecipes: {
					Label: Allow Extra QOL Recipes
					Tooltip: If enabled, adds extra recipes that smooth out progression.
				}

				AllowWheelSlowdown: {
					Label: Allow Wheel Slowdown
					Tooltip: ""
				}

				GiveQuickStartBoxOnSpawn: {
					Label: Give Quick Start Box On Spawn
					Tooltip: ""
				}
			}

			CLCBClientConfig: {
				DisplayName: Calamity Legends Come Back Client Settings

				ShowMatrixBossBar: {
					Label: Show Matrix Boss Health Bar
					Tooltip: If enabled, displays a custom matrix-style boss health bar at the top-center of the screen.
				}

				ShowInternalEnglishNames: {
					Label: Show Internal English Names
					Tooltip: If enabled, appends every item's internal English name to its tooltip name while the game language is not English.
				}
			}
		}
	}
}

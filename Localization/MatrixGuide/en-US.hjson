Mods: {
	CalamityLegendsComeBack: {
		Items: {
			IUMWMatrixTablet: {
				DisplayName: Matrix Guide Tablet
				Tooltip: Opens the Calamity Legends Come Back matrix guide.
			}
		}

		Projectiles.IUMWMatrixPanel.DisplayName: Matrix Guide Panel

		UI: {
			GuideTitle: CALAMITY LEGENDS MATRIX
			GuideSubtitle: Return of Legends information terminal
			GuideBody: Calamity Legends Come Back focuses on rebuilding and expanding legendary Calamity weapon experiences. Current systems include reworked legendary weapons, EX skills, accessory support, visual effects, debug tools, retro game panels, and local experiments that can be studied directly from the source files.
			BossListTitle: Current learning targets
			BossList: SHPC material and heat systems, Briny Baron tide techniques, Pristine Fury effects, Yharim's Crystal attacks, Vesuvius, Blossom Flux, Malachite, MK14 EBR, and single-effect examples in Particle Lab.
			CloseHint: Use the tablet again or click outside this panel to close.
			ModeEnabled: Matrix guide mode enabled.
			ModeDisabled: Matrix guide mode disabled.
			StatusOn: Matrix guide mode: enabled
			StatusOff: Matrix guide mode: disabled
		}
	}
}

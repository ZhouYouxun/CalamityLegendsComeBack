Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Summon: {
					GlacialEmbrace: {
						ModeName0: 斩击模式
						ModeName1: 突刺模式
						ModeName2: 打击模式
						GE_Intro:
							'''
							[c/7BC8E5:当前战斗形态：{0}]
							[c/A0D8EF:召唤系传奇武器 — 基础伤害 48，法力消耗 10]
							[c/A0D8EF:首次使用自动召唤极寒冰核（不占仆从栏）以锚定冰刺系统。]
							[c/A0D8EF:所有攻击命中均施加霜冻灼烧（持续 5 秒）。]
							'''
						GE_LeftClick: "[c/A0D8EF:◆ 左键：若场上无极寒冰核，优先召唤；若未满，召唤樊寒冰刺；若已满，释放或蓄力特殊攻击。]"
						GE_SpikeMode0:
							'''
							[c/90FFB0:◈ 斩击模式 — 冰刺行为]
							[c/90FFB0:  · 冰刺占0.5栏位。每个冰刺分裂为独立的大冰刺与小冰刺对立环绕。]
							[c/90FFB0:  · 小冰刺轨道90px，角速度4°/帧，0.85x伤害，无敌帧90帧。]
							[c/90FFB0:  · 大冰刺轨道140px，角速度2.8°/帧，1.35x伤害，无敌帧128帧。]
							[c/90FFB0:每个周期每个冰刺对同一敌人仅造成一次伤害，大小冰刺无敌帧独立。]
							'''
						GE_SpikeMode1:
							'''
							[c/80EFFF:◈ 突刺模式 — 冰刺行为]
							[c/80EFFF:  · 冰刺占1.0栏位，以90px轨道环绕。3秒后自动飞出锁定敌人并嵌入（每个敌人最多6个）。]
							[c/80EFFF:  · 使用鞭子命中时，随机引爆1个嵌入冰刺；使用特殊攻击命中时，引爆所有嵌入冰刺。]
							[c/80EFFF:  · 引爆的冰刺朝着钉入方向飞出贯穿，造成二次伤害并穿透小范围敌怪。]
							'''
						GE_SpikeMode2:
							'''
							[c/FF8B60:◈ 打击模式 — 冰刺行为]
							[c/FF8B60:  · 冰刺占1.0栏位，尖端朝内环绕。6秒冷却后，冰刺会在鼠标方向自动列阵。]
							[c/FF8B60:  · 列阵完成时按下左键：触发碰撞轰击，双翼冰刺在中线碰撞并造成2.2x范围伤害，随后休眠4秒。]
							'''
						GE_SpecialIntro: "[c/A0D8EF:◆ 特殊攻击（在仆从满时左键释放/按住蓄力）]"
						GE_SpecialMode0:
							'''
							[c/90FFB0:斩击特殊 → 极寒裂空斩刃（IceBladeProj）]
							[c/90FFB0:  · 长按蓄力在鼠标位置凝聚，松开后在短暂延迟后于玩家中心迅速旋转2周。]
							[c/90FFB0:  · 8帧无敌帧，具有多段连击判定。]
							'''
						GE_SpecialMode1:
							'''
							[c/80EFFF:突刺特殊 → 冰棘穿甲楔（IceWedgeProj）]
							[c/80EFFF:  · 朝光标方向射出具有微弱追踪的冰楔，命中敌人时破碎，并强行引爆其身上所有嵌入的冰刺。]
							'''
						GE_SpecialMode2:
							'''
							[c/FF8B60:打击特殊 → 冰岩重崩柱（IcePillarProj）]
							[c/FF8B60:  · 砸落受重力影响的巨型冰柱，落地造成大范围爆炸。]
							[c/FF8B60:  · 造成强击退且能强制击退Boss，同时引爆所有冰刺。]
							'''
						GE_PassiveRhythm: "[c/B0E0FF:◇ 被动 — 霜冻能乐：切换形态或蓄力攻击（蓄力35-45帧）踩点成功（甜区70-90%按【{0}】），连击+1（上限20）；失败则连击重置。]"
						GE_PassiveCombo: "[c/B0E0FF:  · 当前连击：{0}。每2次连击+1生命回复/秒（当前：+{1}）；每4次连击+8防御（当前：+{2}）；每5次连击恢复60点飞行时间。]"
						GE_PassiveDivinity: "[c/B0E0FF:  · 冰川神性：踩点完成10次后，冰刺攻击间隔缩短10%（旋转/飞出速度加快1.1x），持续至失败或5秒后结束。]"
						GE_PassiveAurora: "[c/C8A0FF:◇ 被动 — 极光旋律：特殊攻击命中时间隔不超过0.75秒时，获得5秒极光加护（+10防御，且防前减伤15%）。]"
						GE_Ultimate:
							'''
							[c/A0F0FF:★ 终结技 — 至臻极冰之樊寒神钻]
							[c/A0F0FF:  · 特殊攻击命中+4能量，蓄满240能后按【{0}】释放（当前：{1}/240）。]
							[c/A0F0FF:  · 装配阶段（1.5秒）：冰刺x3（最多30个，即10个召唤栏上限），分三层（9-12-9）集结并发出十字闪光。]
							[c/A0F0FF:  · 十字闪光后按左键推出（持续3秒）：对碰触的敌人造成高频多段伤害，期间玩家减速并获得完全无敌判定。]
							[c/A0F0FF:  · 3秒后爆碎：造成6倍的范围巨额爆炸伤害，并清空冰刺和增益。]
							[c/A0F0FF:  · 超额栏位加成：从第11栏开始，每超出1栏，钻头伤害提升3%（爆碎伤害提升18%）。]
							'''
						LegendaryHint: "[c/BABABA:按住 Shift 阅读完整传奇记录]"
						LegendaryText:
							'''
							[c/B0D8FF:起初只是一枚被遗忘在永冻层深处的冰晶碎片，在无人触及的千年寒渊中独自旋转。]
							[c/B0D8FF:它不知道什么是温暖，也不知道什么是寂静以外的声音。]
							[c/80C8FF:后来有人试图驾驭它，将极寒编织成环绕身侧的守护，却发现冰霜有自己的节奏与意志。]
							[c/80C8FF:每一次旋转都是一段未谱完的旋律，每一次碎裂都是一声未发出的叹息。]
							[c/A0B0FF:于是斩击劈开凝滞的空气，突刺穿透冻结的时光，打击震碎一切本不该碎裂的事物。]
							[c/A0B0FF:三种姿态并非选择，而是寒冰自身的呼吸方式。]
							[c/C0A0FF:学会倾听它的节拍，在每一次转换中踏准冰霜的韵脚——那便是驾驭极寒的唯一秘钥。]
							[c/E0C0FF:当最后一次节拍完美落下，神钻便会从万年冰封中苏醒，将所有的冰刺凝为一柄贯穿星空的极光之矛。]
							[c/E0C0FF:以绝对零度的意志，终结这冰与火交织的战场。]
							'''
					}
				}
			}
		}

		Projectiles: {
			IceBlockMinion.DisplayName: 极寒冰核
			IceSpikeMinion.DisplayName: 樊寒冰刺

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendSHPC: {
					DisplayName: SHPC - Return of Legends
					SHPC_LeftIntro: "[c/66CCFF:Left click fires energy orbs. By default, white orbs deal area damage.]"
					SHPC_LoadingUIHint: "[c/66CCFF:Open inventory and press] [[c/66CCFF:{0}]] [c/66CCFF:to open the loading UI. Load specific materials to change attack effects.]"
					SHPC_CurrentAmmoEffect: "[c/66CCFF:Current loaded effect: {0}]"
					SHPC_DefaultAmmoEffect: No special material loaded; fires default white orbs that deal area damage.
					SHPC_Passive: "[c/B8FF9E:Passive: increases maximum mana and mana potion restoration, and shortens Mana Sickness duration.]"
					SHPC_RightIntro1:
						'''
						[c/FFB347:Right click fires a laser barrage. Barrage fire builds heat; at full heat the weapon overheats and shuts down. Heat dissipates after you stop attacking.]
						[c/FFB347:As progression advances, full heat can enter higher levels. Each heat level multiplicatively increases right-click damage by 5% and adds special effects.]
						[c/FFB347:Current heat cap: I. Effect: no bonus.]
						[c/FFB347:Left click during barrage consumes one heat level to immediately fire three energy orbs.]
						'''
					SHPC_RightIntro2:
						'''
						[c/FFB347:Right click fires a laser barrage. Barrage fire builds heat; at full heat the weapon overheats and shuts down. Heat dissipates after you stop attacking.]
						[c/FFB347:As progression advances, full heat can enter higher levels. Each heat level multiplicatively increases right-click damage by 5% and adds special effects.]
						[c/FFB347:Current heat cap: II. Effect: adds a secondary beam; beams pierce 3 enemies.]
						[c/FFB347:Left click during barrage consumes one heat level to immediately fire three energy orbs.]
						'''
					SHPC_RightIntro3:
						'''
						[c/FFB347:Right click fires a laser barrage. Barrage fire builds heat; at full heat the weapon overheats and shuts down. Heat dissipates after you stop attacking.]
						[c/FFB347:As progression advances, full heat can enter higher levels. Each heat level multiplicatively increases right-click damage by 5% and adds special effects.]
						[c/FFB347:Current heat cap: III. Effect: first hits from main and secondary beams may trigger heat blasts.]
						[c/FFB347:Left click during barrage consumes one heat level to immediately fire three energy orbs.]
						'''
					SHPC_RightIntro4:
						'''
						[c/FFB347:Right click fires a laser barrage. Barrage fire builds heat; at full heat the weapon overheats and shuts down. Heat dissipates after you stop attacking.]
						[c/FFB347:As progression advances, full heat can enter higher levels. Each heat level multiplicatively increases right-click damage by 5% and adds special effects.]
						[c/FFB347:Current heat cap: IV. Effect: adds a second secondary beam, increases damage, and lets heat blasts trigger through pierce.]
						[c/FFB347:Left click during barrage consumes one heat level to immediately fire three energy orbs.]
						'''
					SHPC_RightIntro5:
						'''
						[c/FFB347:Right click fires a laser barrage. Barrage fire builds heat; at full heat the weapon overheats and shuts down. Heat dissipates after you stop attacking.]
						[c/FFB347:As progression advances, full heat can enter higher levels. Each heat level multiplicatively increases right-click damage by 5% and adds special effects.]
						[c/FFB347:Current heat cap: V. Effect: infinite pierce and bonus damage based on target maximum life.]
						[c/FFB347:Left click during barrage consumes one heat level to immediately fire three energy orbs.]
						'''
					SHPC_Final: "[c/99B3FF:The system is still evolving......]"
					SHPC_EXHint:
						'''
						[c/66CCFF:EX Skill (Super Laser): When enemies are nearby, each left-click shot grants 1 ultimate energy, up to 60.]
						[c/66CCFF:Once fully charged, press] [[c/66CCFF:{0}]] [c/66CCFF:to activate the ultimate mode.]
						[c/66CCFF:After a brief charge, unleash a colossal laser that pierces through everything.]
						'''
					SHPC_EXDisabledHint: "[c/9A9A9A:Golden Emblem is not equipped. The ultimate is disabled.]"
					SHPC_AmmoWheelHint: "[c/F7D87C:Close inventory and press] [[c/F7D87C:{0}]] [c/F7D87C:to open the selection wheel and switch loaded ammo.]"
					Tooltip: "[GFB]"
					TooltipGFB: Have you finally arrived here?
					LegendaryHint: "[c/BABABA:Hold Shift to access the record]"
					LegendaryText:
						'''
						[c/66E6FF:The initial design relied too heavily on a single energy source, and was ultimately deemed unstable.]
						[c/66E6FF:The revised system no longer depends on souls; any material with sufficient energy density is now viable.]
						[c/66E6FF:Different inputs produce drastically varied responses, with some combinations exhibiting anomalous amplification.]
						[c/66E6FF:The control system was redesigned accordingly, forcing premature release before full containment.]
						[c/66E6FF:In theory, this device is no longer limited by ammunition type, yet its true limits remain unknown.]
						[c/66E6FF:In barrage mode, all prior reliance on soul-based energy has been eliminated, replaced by a more primitive thermal drive.]
						[c/66E6FF:To stabilize output, the cooling system was redefined, giving rise to new thermal instability effects.]
						[c/66E6FF:With continued operation, the system will inevitably enter an overheat state, trading safety for greater output efficiency.]
						[c/66E6FF:Without timely intervention, this optimization will ultimately consume the operator.]
						'''
				}

				SHPCBook: {
					DisplayName: SHPC Material Manual
					Tooltip: Left click opens the SHPC material index. Right click opens the right-click heat system index.
				}
			}

			FastChip: {
				DisplayName: Fast Chip
				Tooltip:
					'''
					Left-click energy orbs grant double ultimate charge
					Right-click laser barrage grants 1 ultimate charge per second
					Life regeneration is halved; during right-click barrage, each heat level reduces life regeneration by another 2 HP/s
					'''
			}

			DiffuChip: {
				DisplayName: Diffusion Chip
				Tooltip:
					'''
					+7% magic damage and magic critical strike chance
					SHPC empowered left-click attacks have a tighter spread, improving non-homing ammo accuracy
					'''
			}

			CommandAscend: {
				DisplayName: Mortar Transceiver
				Tooltip: While holding SHPC, right click switches to a mortar holdout that automatically charges and fires weakly guided bombardment shells
			}

			MilitaryCaller: {
				DisplayName: Military Caller
				Tooltip:
					'''
					While holding SHPC, right click switches to Military Caller mode
					This mode does not use the right-click heat system
					Fires a tech beacon that air-drops one friendly Calamity tech turret
					Each call has a base cost of 40 mana
					Up to 8 turrets can exist at once
					Deploying a ninth turret makes the oldest turret explode in place
					Each turret lasts up to 5 minutes
					Deployment fails within 18 tiles of another turret
					Biome turret mapping:
					Jungle = Plague; Snow = Ice; Underworld or Brimstone Crags = Fire
					Ocean, Sulphurous Sea, Abyss, or Sunken Sea = Water
					Astral, Hallow, or Sky = Laser
					Desert or Evil biome = Onyx; other biomes = Lab
					'''
			}

			MatrixChargingBarrier: {
				DisplayName: Matrix Charging Barrier
				Tooltip: While holding SHPC, charges a shield equal to 25% of maximum life rounded down to a multiple of 5. Damage resets a 10-second recharge delay, then the shield fully charges over 5 seconds. While active, it reduces pre-defense damage by 10%
			}

			CtrlChip: {
				DisplayName: Control Chip
				Tooltip:
					'''
					Gives SHPC right click automatic lock-on
					Provides 8% increased critical strike chance
					Right-click laser projectiles will weakly home in on the targeting reticle if it is within 180 degrees in front (turns up to 1 degree per frame)
					'''
			}

			FlyChip: {
				DisplayName: Ascension Chip
				Tooltip:
					'''
					Flight time increased by 300%
					Acceleration increased by 70%, movement speed and jump speed increased by 25%
					'''
			}

			HeatModule: {
				DisplayName: Heat Sensor
				Tooltip:
					'''
					SHPC right-click barrage generates 25% more heat and natural heat dissipation is reduced by 33%
					Heat-level right-click damage scaling is raised to 7.5% per level
					Forced shutdown vents a wider searing smoke field that repeatedly damages nearby enemies
					At full Heat V, continued fire constantly vents damaging smoke around the player
					Forced shutdown cooling runs faster, halving the downtime
					'''
			}

			AIOC: {
				DisplayName: AIOC
				Tooltip:
					'''
					Simultaneously activates all effects of Diffusion Chip, Fast Chip, Control Chip, and Ascension Chip
					Inherits Fast Chip's charge benefits, but not its life regeneration penalties
					Hiding visuals conceals the targeting reticle while preserving all effects
					'''
			}

			ProjectilePossessionModule: {
				DisplayName: Vacuum Cleaner
				Tooltip:
					'''
					While holding SHPC, right click switches to projectile possession mode
					Hold right click to capture clones of nearby hostile projectiles in a vacuum cone, up to 15 stored
					The original hostile projectile keeps existing, but its velocity and damage are permanently reduced by 20%
					The clone is pulled to the player, becomes friendly, and permanently deals 20x damage
					Release right click to launch the stored friendly clones forward
					Projectiles spawned by those clones remain friendly; if they have no damage type, they count as magic damage
					Projectiles with more than 3600 damage or more than 3600 time left cannot be absorbed
					Some persistent beams and blacklisted projectiles are ignored
					'''
			}

			WastelandEnergyCore: {
				DisplayName: Wasteland Energy Core
				Tooltip:
					'''
					+7% SHPC damage
					SHPC left-click mana cost -8%; right-click mana cost -12%
					SHPC left click gains 1 extra soul canister and loads 10% more ammo rounded up to a multiple of 5
					While holding SHPC, cease fire to rapidly restore mana
					Grants Mana Flower automatic mana potion use
					Halves SHPC right-click forced overheat shutdown time
					'''
			}

			EverfrostEnergyCore: {
				DisplayName: Everfrost Energy Core
				Tooltip:
					'''
					+15% SHPC damage
					SHPC left-click mana cost -10%; right-click mana cost -20%; left click has a 20% chance not to consume ammo
					SHPC left click gains 2 extra soul canisters and loads 25% more ammo rounded up to a multiple of 5
					While holding SHPC, cease fire to rapidly restore mana
					Grants Mana Flower automatic mana potion use
					Shortens right-click startup
					Halves SHPC right-click forced overheat shutdown time
					'''
			}

			EvolutionEnergyCore: {
				DisplayName: Evolution Energy Core
				Tooltip:
					'''
					+15% SHPC damage, +5% critical strike chance, allows right-click critical hits
					SHPC left-click mana cost -15%; right-click mana cost -30%; left click has a 20% chance not to consume ammo
					SHPC left click gains 3 extra soul canisters and loads 50% more ammo rounded up to a multiple of 5
					While holding SHPC, cease fire to rapidly restore mana
					Grants Mana Flower automatic mana potion use
					Shortens right-click startup
					Halves SHPC right-click forced overheat shutdown time
					'''
			}

			ExoEnergyCore: {
				DisplayName: Exo Energy Core
				Tooltip:
					'''
					+20% SHPC damage, +10% critical strike chance, allows right-click critical hits
					While holding SHPC, gain infinite mana; left click has a 50% chance not to consume ammo
					SHPC left click gains 3 extra soul canisters and loads 100% more ammo rounded up to a multiple of 5
					Shortens right-click startup
					Halves SHPC right-click forced overheat shutdown time
					'''
			}
		}

		TheSpecialText: {
			SHPCAmmoWheelHover: "{0} - {1} shots"
			SHPCBookNoRecords: No registered SHPC material records.
			SHPCBookMissingEffect: No effect record
		}

		AMMO: {
			SHPCAmmoPrompt: This item can be used to charge SHPC. Effect:
			SHPCAmmoPanel: Left-click displayed multiplier: {0}x; load capacity: {1} shots
			SHPCAmmo1: Energy Core makes the orb bounce while scattering dense electric sparks along its path.
			SHPCAmmo2: Stormlion Mandible releases five chaining lightning arcs that jump rapidly between enemy groups.
			SHPCAmmo3: Sulphuric Scale bursts when the orb hits the ground, leaving a corrosive sulphur mist area.
			SHPCAmmo4: Purified Gel splits directly into multiple pursuing energy orbs.
			SHPCAmmo5: Essence of Havoc is affected by extreme gravity, dealing stronger damage while falling.
			SHPCAmmo6: Essence of Eleum spreads a cryogenic liquid nitrogen zone at the blast site, continuously suppressing enemies in the area.
			SHPCAmmo7: Essence of Sunlight opens a core above the blast point, rapidly firing seven homing sunlight lasers.
			SHPCAmmo8: Starblight Soot scatters multiple star souls, producing a medium explosion and inflicting Astral Infection upon hitting.
			SHPCAmmo9: Soul of Light summons high-damage light souls to orbit the orb and continuously damage surrounding targets.
			SHPCAmmo10: Soul of Night pours out chasing dark souls, letting them automatically search for nearby enemies.
			SHPCAmmo11: Soul of Flight rises into the air, then dives down from above to bombard the target.
			SHPCAmmo12: Soul of Fright leaves hovering terror souls that continuously search for prey near the blast point.
			SHPCAmmo13: Soul of Might releases three delayed-explosion energy orbs.
			SHPCAmmo14: Soul of Sight causes the orb to unleash a more violent explosion the longer it flies.
			SHPCAmmo15: Living Shard tracks enemies and converts the power dealt into healing.
			SHPCAmmo16: !!!
			SHPCAmmo17: Depth Cells fires a Viperfish that falls from above and bursts.
			SHPCAmmo18: Plague Cell Canister fires a marking ray and calls plague missiles.
			SHPCAmmo19: Ashes of Calamity pours out a large number of red souls that track enemies at high speed.
			SHPCAmmo20: !!!
			SHPCAmmo21: Solar Fragment summons multiple piercing solar lances from the sky at the blast point.
			SHPCAmmo22: Vortex Fragment releases homing missiles during flight to escort it.
			SHPCAmmo23: Nebula Fragment releases three chasing nebular stars; the blue star has a stronger effect.
			SHPCAmmo24: Stardust Fragment splits into a large number of cells, letting them continuously reproduce recursively.
			SHPCAmmo25: Meld Blob releases high-speed dark light, causing a violent explosion.
			SHPCAmmo26: Unholy Essence releases a violent directional shockwave.
			SHPCAmmo27: !!!
			SHPCAmmo28: Divine Geode refracts multiple homing geometric lasers upon exploding.
			SHPCAmmo29: Bloodstone Core absorbs player life to empower itself, releasing healing and damaging orbs after exploding.
			SHPCAmmo30: Ruinous Soul releases homing souls and orbiting/returning souls.
			SHPCAmmo31: Ectoplasm releases a large number of homing souls along its path and upon hitting enemies.
			SHPCAmmo32: Dark Plasma generates a miniature dark core that actively tracks enemies, pulls them in, and ignores defense and damage reduction below 95%.
			SHPCAmmo33: Twisting Nether releases multiple void blades that pierce through many enemies.
			SHPCAmmo34: Endothermic Energy creates a liquid nitrogen zone and releases a large number of ice spikes.
			SHPCAmmo35: Nightmare Fuel splits into nightmare arcs that continuously strike enemies.
			SHPCAmmo36: Ascendant Spirit Essence continuously fires a large number of star needles that pierce many enemies.
			SHPCAmmo37: Yharon Soul Fragment releases violent flames.
			SHPCAmmo38: Exo Prism fires judgment lasers and unfolds fractal geometry attacks.
			SHPCAmmo39: Ashes of Annihilation locks onto an enemy and releases a large amount of annihilation strikes.
			SHPCAmmo40: Armored Shell fires a large amount of gradually slowing electromagnetic orbs, subsequently forming a sustained storm.
			SHPCAmmo41: Pearl Shard fires three large pearls that split into accelerating homing small pearls upon breaking.
			SHPCAmmo42: Darksun Fragment creates an eclipsed black sun that can be continuously empowered, eventually releasing a powerful explosion.
			SHPCAmmo43: Cynosure fires a heavy armor-piercing round that releases electromagnetic lightning, two auric-orb ellipses, and an outer charged-cell ring on hit.
			SHPCAmmo44: Core of Calamity splits into four strongly homing energy bolts.
		}


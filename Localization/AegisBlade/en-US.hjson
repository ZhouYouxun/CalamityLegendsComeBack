Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				AegisBlade: {
					DisplayName: Aegis Blade
					Tooltip: "[GFB]"
					FunctionalTooltip:
						'''
						[c/FFD966:Left Click] [c/DCD6C8:Hold to swing the greatsword; while it spins, golden tracking souls continuously scatter around you]
						[c/8DB8FF:Right Click] [c/DCD6C8:Raise the 40-frame Aegis shield — the first 15 frames are the Perfect Parry window, then it can be charged]
						[c/8DB8FF:Shield Bash] [c/DCD6C8:Release right-click to dash toward the cursor and ram enemies with the shield; longer charge means more distance and damage]
						[c/8DB8FF:Full Charge] [c/DCD6C8:Unlocked after any Mechanical Boss; left-click to hurl down the Aegis Blade and raise 16-tile rapid barricades on both sides]
						[c/DCD6C8:Barricades last 60 seconds, or 10 seconds during boss fights]
						[c/8DB8FF:Perfect Parry] [c/DCD6C8:Absorbs all damage, grants 35 iframes and 8 energy; your next shield bash is empowered]
						[c/8DB8FF:Shield Raised] [c/DCD6C8:+20 defense and knockback immunity]
						[c/7FE886:Aegis] [c/DCD6C8:Gain 6–15 bonus defense based on movement speed; maximized while standing still]
						[c/7FE886:Bulwark] [c/DCD6C8:Without damage-over-time debuffs, contact damage reduced by 20%, doubled while stationary]
						[c/FFD700:Legendary Skill (Golden Hand)] [c/DCD6C8:When energy is full, press the Legendary Skill key to summon a golden hand granting 10s of full invincibility]
						'''
					LegendaryHint: "[c/BABABA:Hold Shift to read the legendary record]"
					LegendaryText:
						'''
						[c/FFD966:On an ancient battlefield, there was a knight clad in golden armor, wielding this blade.]
						[c/FFD966:His shield never shattered — not because it was unbreakable,]
						[c/FFD966:but because he could absorb every strike at the precise moment of impact, turning it into light.]
						[c/FFD966:They say his silhouette was like the dawn itself — untouchable, impossible to overcome.]
						[c/FFD966:And this sword was the extension of his will: the edge of a guardian.]
						'''
				}

				Summon: {
					GlacialEmbrace: {
						DisplayName: Glacial Embrace
						Tooltip: ""
					}
				}
			}

			NewLegendGaelsGreatsword: {
				DisplayName: New Legend Gaels Greatsword
				Tooltip: ""
			}
		}

		Projectiles: {
			AegisSwingHoldout.DisplayName: Aegis Blade Swing
			AegisShieldHoldout.DisplayName: Aegis Shield

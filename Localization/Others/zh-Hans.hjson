Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				MiaoGun: {
					DisplayName: 非常棒的枪
					Tooltip:
						'''
						射出随机的弹幕
						“不是吧，又整这一套？”
						“距离上次我们做出类似的东西才过了不到几个月啊。”
						“什么？你说这是我们的特色？”
						“好吧，满足你。”
						'''
				}

				DesertEagle: {
					DisplayName: 沙漠之鹰
					Tooltip:
						'''
						左键轮流散射动能灌注弹，以及强力吸血弹
						按住右键将高速旋转手里的沙漠之鹰，切碎撞到它的敌人
						充能满时点击左键将释放一枚强力的闪光爆弹
						“传奇神射手同款”
						'''
				}

				SHPBow: {
					DisplayName: SHPB
					Tooltip: "[GFB]"
					ModeName0: 穿透
					ModeName1: 反弹
					ModeName2: 散射
					ModeName3: 追踪
					SHPB_CurrentSequence: "[c/78E6FF:当前 SHP 弓弦序列：{0}]"
					SHPB_Left: "[c/9FD8FF:左键发射由弓弦序列构成的一份箭式，从左到右依次加工，允许重复。]"
					SHPB_StackHint:
						'''
						[c/C7F3FF:在核心面板中左键点击核心会把它追加到序列末端；]"
						[c/C7F3FF:序列满时向前滚动。右键点击核心会把序列重置为该核心。]"
						'''
					SHPB_Mode0: "[c/60E2FF:穿透：提高飞行速度、穿透次数、护甲穿透与局部无敌帧。]"
					SHPB_Mode1: "[c/FFD464:反弹：增加物块反弹次数与命中后的再索敌范围。]"
					SHPB_Mode2: "[c/FF7AAA:散射：增加分裂次数，增加分裂后的弹幕伤害。]"
					SHPB_Mode3: "[c/A476FF:追踪：提高索敌范围与转向强度。]"
					SHPB_Right: "[c/F7D87C:右键短按打开核心面板；右键按住超过 0.15 秒会为整条序列蓄力，蓄满后松手释放。]"
					SHPB_EX:
						'''
						[c/BAA0FF:序列结构决定输出形态，箭矢不再独立存在。]
						[c/BAA0FF:所有行为均由弓弦序列驱动并逐段叠加。]
						'''
					SHPB_Final:
						'''
						[c/9FD8FF:理论上可构建无限组合，但稳定性完全依赖操作者。]
						[c/9FD8FF:错误的序列不会失效，只会以另一种形式生效。]
						'''
				}

				Tetris: {
					DisplayName: 俄罗斯方块
					Tooltip:
						'''
						手持该物品即可展开像素俄罗斯方块面板。
						A/D 或左右方向键控制方块左右移动。S 或下方向键快速下落。空格键硬降到底。
						W、上方向键或 X 顺时针旋转。Z 逆时针旋转。C 暂存当前方块。
						填满整行即可消行得分并继续生存。方块堆到顶部则游戏结束，游戏结束后按 R 重新开始。
						'''
				}

				Snake: {
					DisplayName: 贪吃蛇
					Tooltip:
						'''
						手持该物品即可展开像素贪吃蛇面板。
						单次点击 W/A/S/D 控制蛇转向。吃苹果会变长，并逐渐加快速度。
						撞到墙壁或自己的身体会游戏结束，游戏结束后按 R 重新开始。
						'''
				}

				Minesweeper: {
					DisplayName: 扫雷
					Tooltip:
						'''
						手持该物品即可展开像素扫雷面板。
						左键点击未打开的格子来揭开它。右键点击未打开的格子可以标记或取消标记。
						阿拉伯数字表示该格周围接触的炸弹数量。揭开炸弹会游戏结束。
						正确标记所有炸弹且没有错误标记，或揭开所有安全格子即可获胜。游戏结束后左键点击重新开始。
						'''
				}

				Strikers1945: {
					Tooltip:
						'''
						手持该物品即可展开纵屏1945面板。
						A/D 控制左右，W/S 控制前后，飞机会自动开火。
						击落随机来袭的敌机获得分数。命中敌机、敌弹或被敌机撞到都会损失生命。
						敌机偶尔掉落 P 强化，提升子弹数量与散射。三条命耗尽后游戏结束，按 R 重新开始。
						'''
					// DisplayName: "1945"
				}

				TheNewEnforcer: {
					DisplayName: 暴政
					Tooltip:
						'''
						[c/9C6DFF:快速挥动大剑，命中敌人时释放星界斩杀]
						[c/59E8FF:每次挥舞都会释放多枚完全改进的灵魂火]
						[c/8A8A8A:灵魂火能够追踪敌人，并释放额外的火焰]

						[c/6E0000:我从深渊归来]
						[c/8B0000:带着你们亲手留下的伤痕]
						[c/B10000:背叛、遗弃、沉默]
						[c/C80000:我会让这一切，百倍奉还]
						[c/FF3C3C:永噬之颚、湮灭之弦、终灭裂隙]
						[c/FF6A00:还有你——诺法雷]
						[c/FF0000:你们曾将我抛入黑暗]
						[c/FF0000:如今，我会让整个世界，听见你们的惨叫]
						'''
				}
			}

			Consumables: {
				LegendarySupplyBox: {
					DisplayName: 传奇补给箱
					Tooltip:
						'''
						右键打开，领取目前已经准备好的传奇武器。
						“你根本想象不到在另一个世界的人们想要获得这个箱子两个月的使用权需要经历多少种苦难”
						'''
				}

				RetroGameConsoleSupplyBox: {
					DisplayName: 复古游戏机补给包
					Tooltip: 右键打开，领取目前已经准备好的复古游戏机。
				}
			}
		}

		Projectiles: {
			A_Dev: {
				TetrisPanel.DisplayName: 俄罗斯方块面板
				SnakePanel.DisplayName: 贪吃蛇面板

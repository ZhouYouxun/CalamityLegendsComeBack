Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Malachite: {
					DisplayName: 孔雀翎
					Tooltip: "[GFB]"
					LeftClick0:
						'''
						[c/7DFF9A:左键：掷出一枚孔雀苦无。]
						[c/7DFF9A:命中会留下短促平行绿线。]
						'''
					LeftClick1:
						'''
						[c/7DFF9A:左键：苦无不再受自然重力。]
						[c/7DFF9A:背后潜伏苦无仍优先射出。]
						'''
					LeftClick2:
						'''
						[c/7DFF9A:左键：每次掷出两枚苦无。]
						[c/7DFF9A:潜伏扇发射时也每次两枚。]
						'''
					LeftClick3:
						'''
						[c/7DFF9A:左键：每9次触发双重散射。]
						[c/7DFF9A:散射会连续撒出5×2枚苦无。]
						'''
					LeftClick4:
						'''
						[c/7DFF9A:左键：每次掷出三枚苦无。]
						[c/7DFF9A:第9次散射升级为7×2枚。]
						'''
					RightClick0:
						'''
						[c/6D6D6D:右键：击败史莱姆王后解锁。]
						[c/6D6D6D:解锁前不会显示真实招式。]
						'''
					RightClick1:
						'''
						[c/80FFC8:右键：积攒并倾泻右羽。]
						[c/80FFC8:潜伏右羽命中会引发爆裂。]
						'''
					RightClick2:
						'''
						[c/80FFC8:右键：释放后获得3秒轻身。]
						[c/80FFC8:移动与跳跃提高15%。]
						'''
					RightClick3:
						'''
						[c/80FFC8:右键：触发后强化左键1秒。]
						[c/80FFC8:期间左键攻速直接翻倍。]
						'''
					RightClick4:
						'''
						[c/80FFC8:右键：触发后强化左键1秒。]
						[c/80FFC8:潜伏右键完全不消耗潜伏值。]
						'''
					StealthStrike0:
						'''
						[c/B5FF74:潜伏攻击：召出15枚暗器。]
						[c/B5FF74:左键与右键共享这组潜伏扇。]
						'''
					StealthStrike1:
						'''
						[c/B5FF74:潜伏攻击：暗器数量提高到17。]
						[c/B5FF74:最中心王牌苦无开始出现。]
						'''
					StealthStrike2:
						'''
						[c/B5FF74:潜伏攻击：暗器数量提高到19。]
						[c/B5FF74:王牌苦无仍位于扇面中心。]
						'''
					StealthStrike3:
						'''
						[c/B5FF74:潜伏攻击：暗器数量提高到21。]
						[c/B5FF74:右键爆裂与左键急速联动。]
						'''
					StealthStrike4:
						'''
						[c/B5FF74:潜伏攻击：暗器数量提高到23。]
						[c/B5FF74:孔雀扇完整展开。]
						'''
					Finale:
						'''
						[c/D6FF9A:大招（翎羽灯光秀）：满潜伏且冷却结束时按] [[c/D6FF9A:{0}]] [c/D6FF9A:。]
						[c/D6FF9A:30秒充能，潜伏攻击推进5秒。]
						[c/D6FF9A:花瓣化为轻快追踪苦无。]
						'''
					Passive:
						'''
						[c/9AFFC8:被动（手持）：]
						[c/9AFFC8:遁入暗影：潜伏攻击只消耗一半潜伏值。]
						[c/9AFFC8:随后立刻恢复15点潜伏值。]
						[c/9AFFC8:潜伏值过半时，移速提高15%。]
						'''
					LegendaryHint: "[c/BABABA:按住 Shift 读取记录]"
					LegendaryText:
						'''
						[c/B5FF74:它不是羽饰，而是一套等待风向的暗器。]
						[c/7DFF9A:第一枚苦无沉默，后面的才像开屏。]
						[c/80FFC8:右羽越安静，脱手时越像一条绿线。]
						[c/D6FF9A:花瓣坠下时，敌人已被灯光钉住。]
						[c/BABABA:真正的孔雀翎，从不把锋芒留太久。]
						'''
				}
			}


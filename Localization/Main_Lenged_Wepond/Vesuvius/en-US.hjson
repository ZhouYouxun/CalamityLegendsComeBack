Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewVesuvius: {
					DisplayName: Earthshaker - Vesuvius
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/FF8A3D:Left Click: Hold to build volcanic pressure, then release an explosive Volcanic Arc Orb.]
						[c/FF8A3D:Hitting an enemy afflicted with Volcanic Calamity ejects damaging magma along the orb's original path.]
						'''
					ChargeStage1: "[c/FF8A3D:Unlocked charge: Stage I pressure increases the orb's size, damage, and eruption.]"
					ChargeStage2: "[c/FF9F45:Unlocked charge: Stage II pressure gains homing and tears through crowds.]"
					ChargeStage3: "[c/FFE27E:Unlocked charge: Stage III pressure causes far more violent chained eruptions.]"
					ChargeStage4: "[c/FFF4BE:Unlocked charge: Stage IV releases Vesuvius' complete thermal core.]"
					RightClick:
						'''
						[c/FFB15C:Right Click: Drag the staff behind you with both hands and briefly charge a Super Flame that deals 250% damage.]
						[c/FFB15C:Super Flame inflicts Volcanic Calamity for 17 seconds. For 90 frames, the next left click is instant, larger, and stronger, while the next right click calls down a lava meteor.]
						'''
					Passive:
						'''
						[c/CC9A6A:Mobile Volcano: If your maximum mana is below 100, gain 100 maximum mana. Become immune to fire blocks, lava, and burning. Nearby ash inflicts Volcanic Calamity.]
						[c/AA8CFF:Landing after falling at least 7 tiles creates a stellar shockwave. At 21 tiles, its damage and radius are doubled.]
						[c/D878FF:Ashen Soul: Vesuvius kills or every 400 mana spent creates one soul.]
						[c/D878FF:At 6 souls, the next left click releases six 40%-damage soul flames orbiting the main orb.]
						[c/FF7040:Volcanic Calamity: damage taken ×1.05; damage taken from Vesuvius is multiplied by an additional ×1.2.]
						'''
					EXHint:
						'''
						[c/FFD86B:While held, Vesuvius charges ultimate energy up to 60.]
						[c/FFD86B:At full energy, press] [[c/FFD86B:{0}]] [c/FFD86B: to raise the staff overhead and charge Volcanic Eruption.]
						[c/FFD86B:After the ready sound, left click to unleash five seconds of ash, magma, meteors, fireballs, and obsidian shards.]
						'''
					EXDisabledHint: "[c/9A9A9A:Golden Emblem is not equipped. The ultimate is disabled.]"
					Final: "[c/FFB15C:The crust splits, ash shuts out the sky, and the pyroclastic flow sweeps the battlefield.]"
					LegendaryHint: "[c/BABABA:Hold Shift to access the record]"
					LegendaryText:
						'''
						[c/FFB15C:The first Vesuvius understood volcanoes as meteors: fall from above, smash the target, then explode.]
						[c/FF8A3D:That design was direct enough, but it only showed the surface fall of a volcano, not the disaster moving through the earth below.]
						[c/FFB15C:After the rebuild, scattered ejecta are compressed into a single thermal core; a precise hit drives the eruption into the target.]
						[c/D84BFF:Right click drags the staff behind you to compress the volcano, then tears through mid-range combat with a Super Flame.]
						[c/FF4422:When the final eruption comes, what falls is no longer lava. It is an entire layer of earth finishing the volcano's declaration.]
						'''
				}
			}
		}

		Buffs: {
			VesuviusVolcanicCalamity: {
				DisplayName: Volcanic Calamity
				Description: Damage taken is increased by 5%, with a further 20% increase to damage from Vesuvius
			}

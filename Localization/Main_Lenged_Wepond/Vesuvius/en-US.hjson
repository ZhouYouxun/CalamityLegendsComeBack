Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewVesuvius: {
					DisplayName: Earthshaker - Vesuvius
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/FF8A3D:Left Click: Build volcanic pressure, then release an erupting arc orb.]
						[c/FF8A3D:When it strikes an enemy afflicted with Volcanic Calamity, more magma erupts.]
						'''
					ChargeStage1: "[c/FF8A3D:Pressure swells the orb and strengthens its eruption.]"
					ChargeStage2: "[c/FF8A3D:Pressure sends the orb hunting through enemies.]"
					ChargeStage3: "[c/FF8A3D:Pressure makes the orb erupt repeatedly on impact.]"
					ChargeStage4: "[c/FF8A3D:Pressure condenses into a thermal core that erupts on impact.]"
					RightClick:
						'''
						[c/FFB15C:Right Click: Charge a super flame that afflicts enemies with Volcanic Calamity.]
						[c/FFB15C:Afterward, left click instantly releases a stronger arc orb; right click calls down a lava meteor.]
						'''
					Passive:
						'''
						[c/CC9A6A:Passive [Mobile Volcano]: Ash around you afflicts enemies with Volcanic Calamity.]
						[c/D878FF:Passive [Ashen Soul]: Defeating enemies or spending mana gathers soul flames.]
						[c/D878FF:Once gathered, they circle the next left-click orb and fly with it.]
						'''
					EXHint:
						'''
						[c/FFD86B:Ultimate [Volcanic Eruption]: Press [{0}] to raise the staff and erupt.]
						[c/FFD86B:Ash, lava, and obsidian shards rain down.]
						'''
					EXDisabledHint: "[c/9A9A9A:The ultimate unlocks automatically in Hardmode.]"
					Final: "[c/FFB15C:The crust splits, ash shuts out the sky, and the pyroclastic flow sweeps the battlefield.]"
				}
			}
		}


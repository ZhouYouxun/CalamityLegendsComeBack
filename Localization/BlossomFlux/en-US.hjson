Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendBlossomFlux: {
					DisplayName: BlossomFlux - Return of Legends
					Tooltip: "[GFB]"
					BF_Intro:
						'''
						[c/7BE495:Current doctrine: {0}]
						[c/F7D87C:Hold right click to enter the current doctrine's charge stance, then release to fire its special arrow.]
						'''
					PresetName0: Breakthrough
					PresetName1: Recovery
					PresetName2: Reconnaissance
					PresetName3: Bombardment
					PresetName4: Plague
					PresetLeft0:
						'''
						[c/8BE89A:Left Click - Breakthrough: fires stable straight leaf arrows.]
						[c/8BE89A:Wooden arrows become breakthrough leaf arrows; other arrows fire as their original ammo.]
						[c/8BE89A:Breakthrough leaf arrows focus on direct hits and continuous piercing.]
						'''
					PresetLeft1:
						'''
						[c/8BE89A:Left Click - Recovery: converts arrows into fast twin-strand leaf shots.]
						[c/8BE89A:Each volley fires two shots that advance along both sides of the aim line.]
						[c/8BE89A:Hits can create a recovery flash; when it fades, it heals the player and grants Recovery Leaf.]
						'''
					PresetLeft2:
						'''
						[c/8BE89A:Left Click - Reconnaissance: converts arrows into single-target tracking scout arrows.]
						[c/8BE89A:Each volley fires five shots; scout arrows can damage multiple times.]
						[c/8BE89A:After a short free flight, they predict moving targets, accelerate, and re-home.]
						'''
					PresetLeft3:
						'''
						[c/8BE89A:Left Click - Bombardment: converts arrows into falling bombardment volleys.]
						[c/8BE89A:Bombardment arrows create branch bursts on impact, suppressing the target area with blast damage.]
						'''
					PresetLeft4:
						'''
						[c/8BE89A:Left Click - Plague: converts arrows into plague reapers.]
						[c/8BE89A:Reapers inflict pollution and debuffs on hit; repeated hits refresh or extend them.]
						[c/8BE89A:Pollution gradually weakens enemy defense.]
						'''
					PresetRight0:
						'''
						[c/F4D57A:Right Click - Breakthrough Charge: loads breakthrough arrows one by one, then releases them in sequence from the aim line.]
						[c/F4D57A:Loaded arrows deal greatly increased damage, fire in parallel, accelerate during flight, and ignore defense and damage reduction.]
						'''
					PresetRight1:
						'''
						[c/F4D57A:Right Click - Recovery Charge: raises the bow and releases a group of pure recovery flashes.]
						[c/F4D57A:Pure recovery flashes are larger and more spread out; they heal the player but do not grant Recovery Leaf.]
						'''
					PresetRight2:
						'''
						[c/F4D57A:Right Click - Reconnaissance Charge: fires a high-speed marking arrow.]
						[c/F4D57A:The arrow ignores gravity, records enemies it hits, and marks the highest-value target when it expires.]
						[c/F4D57A:The mark improves BlossomFlux left-click fire against that target.]
						'''
					PresetRight3:
						'''
						[c/F4D57A:Right Click - Bombardment Charge: creates a crimson reticle at the cursor.]
						[c/F4D57A:After charging, the arrow launches upward, then dives from above to the reticle and detonates.]
						[c/F4D57A:The reticle keeps following the cursor until the falling arrow locks its final point.]
						'''
					PresetRight4:
						'''
						[c/F4D57A:Right Click - Plague Charge: stores a large spore projectile.]
						[c/F4D57A:On hit, it creates a plague-themed burst and continuously releases spore clouds.]
						[c/F4D57A:A charged hit permanently weakens that enemy.]
						'''
					PresetPassive0:
						'''
						[c/B7FFB0:Doctrine Passive - Breakthrough: grants a high-speed dash with no invincibility frames; existing dash cooldowns are halved.]
						[c/B7FFB0:After dashing, BlossomFlux damage is increased by 20% for 0.75 seconds.]
						'''
					PresetPassive1:
						'''
						[c/B7FFB0:Doctrine Passive - Recovery: immune to defense damage and greatly expands heart pickup range.]
						[c/B7FFB0:Debuff life drain is halved; when a hit exceeds 30% max life, half of the excess damage is removed.]
						'''
					PresetPassive2:
						'''
						[c/B7FFB0:Doctrine Passive - Reconnaissance: immune to movement slowdowns, +25% movement speed, +100% acceleration, and +50% flight time.]
						[c/B7FFB0:Grapple launch, retreat, and pull speed +30%; platform or slope grapples release automatically when reached.]
						'''
					PresetPassive3:
						'''
						[c/B7FFB0:Doctrine Passive - Bombardment: gains fire rate from enemies on screen.]
						[c/B7FFB0:At 5/10/20 enemies on screen, BlossomFlux use time and left-fire delay are reduced by 1/2/3 frames.]
						'''
					PresetPassive4:
						'''
						[c/B7FFB0:Doctrine Passive - Plague: BlossomFlux attacks extend any debuff already on the target.]
						[c/B7FFB0:Debuffs on all enemies tick down at half speed.]
						'''
					BF_Passive:
						'''
						[c/9AEF9E:Final Stand: while holding BlossomFlux, one lethal hit is blocked; charges for 180 seconds and does not charge while a boss is alive.]
						[c/9AEF9E:On trigger, stay at 1 life and open a 5-second recovery field. During it, you are nearly invincible and immune to debuffs and environmental damage.]
						[c/9AEF9E:When it ends, revive up to full life; each blocked hit during the field reduces revival life by 20%, down to 1. Current state: {0}.]
						'''
					PassiveStateReady: "[c/7BFFB7:Ready]"
					PassiveStateActive: "[c/FF9B8B:Final Stand Active]"
					PassiveStateCooldown: "[c/F0D070:Charging {0}/{1}s]"
					PassiveStateLocked: "[c/9A9A9A:Unlocked in Hardmode]"
					BF_EXHint:
						'''
						[c/8EF5A8:Ultimate: Stores up to 60 Bloom Energy.]
						[c/8EF5A8:While held, restores 1 energy every 2 seconds; releasing a charged right-click arrow restores 3 energy.]
						[c/8EF5A8:At full energy, press [{0}] to release the verdant arrow curtain barrage.]
						'''
					BF_EXDisabledHint: "[c/9A9A9A:Golden Emblem is not equipped. The ultimate is disabled.]"
					BF_FormWheelHint: "[c/F7D87C:Hold [{0}] to open the doctrine wheel; release over a sector to switch doctrine.]"
					BF_Final: "[c/9FD8A2:The bowstring hums, and the forest answers.]"
					LegendaryHint: "[c/BABABA:Hold Shift to read the legendary record]"
					LegendaryText:
						'''
						[c/66E6FF:It began as an attempt to make burst fire faster.]
						[c/66E6FF:Later, its maker realized speed was not the answer.]
						[c/66E6FF:The same bowstring had to learn five ways to breathe.]
						[c/66E6FF:So doctrine split into five branches.]
						[c/66E6FF:Even a plain wooden arrow changes form after release.]
						[c/66E6FF:It will keep growing, but the rhythm is already formed.]
						[c/66E6FF:Wait, loose, and let the doctrine answer.]
						'''
				}
			}

			ATunedQuiver: {
				DisplayName: Tuned Quiver
				Tooltip:
					'''
					+15% ranged damage
					+4 defense
					Grants arrow speed bonuses. Each BlossomFlux doctrine receives a different bonus.
					Recipe: Magic Quiver + 10 Jungle Spores + 5 Vines @ Anvil
					'''
			}

			BResonatingQuiver: {
				DisplayName: Resonating Quiver
				Tooltip:
					'''
					+15% ranged damage
					+5% ranged critical strike chance
					+15 ranged projectile armor penetration
					+6 defense
					Grants arrow speed bonuses. Each BlossomFlux doctrine receives a different bonus.
					Recipe: Tuned Quiver + Ranger Emblem + 5 Life Alloys + 5 Galactica Singularities @ Ancient Manipulator
					'''
			}

			CDominationQuiver: {
				DisplayName: Domination Quiver
				Tooltip:
					'''
					+15% ranged damage
					+5% ranged critical strike chance
					+15 ranged projectile armor penetration
					+16 defense
					+15% maximum life
					Grants arrow speed bonuses. Each BlossomFlux doctrine receives a different bonus.
					All attacks pass through walls and ignore defense.
					Recipe: Resonating Quiver + 10 Reaper Teeth + 10 Ruinous Souls @ Ancient Manipulator
					'''
			}

			PastLingering: {
				DisplayName: Lingering Remnant
				Tooltip:
					'''
					Changes Breakthrough into a Phantasm-like mode: arrows are no longer converted and release strongly homing shards after hitting enemies.
					Continuous fire gradually increases attack speed. Reaching the maximum tier plays an extra sound.
					Recipe: Phantasm + 12 Luminite Bars + 5 Vortex Fragments @ Ancient Manipulator
					'''
			}

			SeedOfSilva: {
				DisplayName: Seed of Silva
				Tooltip:
					'''
					Generates five seeds that slowly orbit the player and emit a faint green glow.
					While holding BlossomFlux, the seeds bloom into different flowers based on the current doctrine.
					Breakthrough: Sunflower
					Sunflowers create a small field. Breakthrough arrows passing through it gain 30% damage and 15% critical strike chance.
					Recovery: Daisy
					Daisies have 15 maximum life, regenerate 1.2 life per second, and inherit the player's defense and damage reduction.
					If a daisy takes 20 or more damage, it heals the player for its stored regenerated life, rounded down.
					Reconnaissance: Delphinium
					Delphiniums attack nearby enemies once every 1.5 seconds with a curving arc that deals light damage and stuns for 1 second.
					Stunned enemies are heavily slowed and take double damage from reconnaissance arrows.
					Enemies immune to knockback only receive the damage bonus, reduced to 1.15x.
					Each successful delphinium stun restores 0.5 seconds of flight time.
					Bombardment: Torchflower
					Torchflowers spray flames when enemies approach.
					Arrows passing through a torchflower also trigger an explosion with an independent cooldown.
					Plague: Mandrake
					Mandrakes slow nearby enemies and reduce their contact damage by 15%.
					Mandrakes constantly create spores, like a Spore Sac, applying debuffs for 3 seconds each. Their cap follows the current weapon.
					Mandrakes also occasionally fire homing withering-flower projectiles that paralyze and slow enemies.
					Recipe: Bloom Stone + 50 Planty Mush + 10 Auric Bars @ Mythril Anvil
					'''
			}

			SilvaHarp: {
				DisplayName: Silva Harp
				Tooltip:
					'''
					+5 life per second. This regeneration cannot be reduced by any factor.
					+60 frames of invincibility after taking damage.
					Coexists with BlossomFlux Final Stand, but no longer changes its duration or cooldown rules.
					Recipe: 12 Effulgent Feathers + 30 Planty Mush + 12 Gold Bars + 3 Divine Geodes @ Cosmic Anvil
					'''
			}
		}


Mods: {
	CalamityLegendsComeBack: {
		Common.NoMana: Not enough mana

		Items: {
			Weapons: {
				AzureThunder: {
					DisplayName: SunderBlade
					Tooltip: "[GFB]"
					AzureThunderLeft:
						'''
						[c/6FDFFF:Left click: slowly swing the greatsword, releasing SunderBlade light orbs and multiple flying heavy swords.]
						[c/6FDFFF:On hit: release extra lightning attacks.]
						'''
					AzureThunderRight:
						'''
						[c/8DEBFF:Right click: create multiple floating swords on nearby ground or in the air.]
						[c/8DEBFF:Floating swords: periodically call down lightning on nearby enemies.]
						'''
					AzureThunderUltimate:
						'''
						[c/FFE85A:Ultimate: at 120 ultimate energy, press] [[c/FFE85A:{0}]] [c/FFE85A: to gain Empyrean of Truth for 25 seconds.]
						[c/FFE85A:Empyrean of Truth: empowers SunderBlade's left click, right click, and final strikes.]
						'''
					AzureThunderPassiveHeavenEarth0: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:unlocked by default. Desert Scourge will improve it.]"
					AzureThunderPassiveHeavenEarth1: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:+1 mana regeneration for each active SunderBlade sword.]"
					AzureThunderPassiveHeavenEarth2: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:+1 mana regeneration for each active SunderBlade sword; +2 armor penetration.]"
					AzureThunderPassiveHeavenEarth3: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:+1 mana regeneration for each active SunderBlade sword; +2 armor penetration; +1 life regeneration.]"
					AzureThunderPassiveHeavenEarth4: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:+1 mana regeneration for each active SunderBlade sword; +2 armor penetration; +1 life regeneration; +2% magic damage.]"
					AzureThunderPassiveHeavensWard0: "[c/B8F4FF:Ordained by Heaven:] [c/8A8A8A:unlocks after Hive Mind or Perforators.]"
					AzureThunderPassiveHeavensWard1: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 40 life.]"
					AzureThunderPassiveHeavensWard2: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 80 life.]"
					AzureThunderPassiveHeavensWard3: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 125 life.]"
					AzureThunderPassiveHeavensWard4: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 150 life.]"
					AzureThunderPassiveHeavensWard5: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 200 life.]"
					AzureThunderPassiveFourSymbols0: "[c/B8F4FF:Four Symbols of Harmony:] [c/8A8A8A:unlocks after Wall of Flesh.]"
					AzureThunderPassiveFourSymbols1: "[c/B8F4FF:Four Symbols of Harmony:] [c/DCD6C8:if fewer than 3 SunderBlade swords exist, automatically create one every 10 seconds.]"
					AzureThunderPassiveFourSymbols2: "[c/B8F4FF:Four Symbols of Harmony:] [c/DCD6C8:if fewer than 3 SunderBlade swords exist, automatically create one every 10 seconds; triggering this also restores life.]"
					AzureThunderPassiveFourSymbols3: "[c/B8F4FF:Four Symbols of Harmony:] [c/DCD6C8:triggering this restores life; if fewer than 6 SunderBlade swords exist, automatically create one every 10 seconds.]"
					AzureThunderThunderCharge: "[c/FFE85A:Breath of Transformation:] [c/DCD6C8:gained by final left-click lightning based on the target's electric debuffs and Elemental Mix, up to 3 stacks; disabled during Empyrean of Truth.]"
					AzureThunderDot: "[c/FFE85A:Empyrean of Truth damage over time:] [c/DCD6C8:upgrades from Static Discharge through progression and adds stronger debuffs at higher tiers.]"
					AzureThunderFinal: '''[c/FFE85A:"Let solemn thunder cleanse evil, call sweet rain, and spare the living."]'''
				}
			}

			GuZhou: {
				DisplayName: Long Barge
				Tooltip:
					'''
					+10% generic magic damage
					While holding SunderBlade, gain an additional +5% magic damage
					When SunderBlade consumes Breath of Transformation, each consumed stack grants +5% magic damage for 20 seconds; repeated triggers reset the duration
					Consuming Breath of Transformation during Empyrean of Truth slows the locked non-worm enemy by 15%
					'''
			}

			YiGanYiYing: {
				DisplayName: Sense and Response
				Tooltip:
					'''
					+50 maximum mana
					-15% mana cost
					+9% magic damage and magic critical strike chance
					When SunderBlade's right click consumes Breath of Transformation, each active SunderBlade sword grants +2% magic damage for 5 seconds
					During Empyrean of Truth, each sword instead grants +3% magic damage for 15 seconds
					This damage bonus is recalculated and its duration reset the next time Breath of Transformation is consumed
					'''
			}

			QianDingWanDing: {
				DisplayName: Absolute Composure
				Tooltip:
					'''
					+120 maximum mana
					-20% mana cost
					Increases SunderBlade sword effect radius from 50 tiles to 75 tiles
					Up to 3 SunderBlade swords orbit the player on an elliptical path and act as mobile turrets
					SunderBlade right-click lightning grants 7 ultimate energy on hit instead of 6
					Four Symbols of Harmony creates swords every 6 seconds instead of every 10 seconds
					'''
			}

			FengYunZhiBian: {
				DisplayName: Storm of Transform
				Tooltip:
					'''
					SunderBlade damage +18%
					SunderBlade attacks inflict Azure Thunder for 2 seconds
					Empyrean of Truth duration increases from 25 seconds to 30 seconds
					During Empyrean of Truth, magic damage is multiplied by 1.09 and gain 36 magic armor penetration
					'''
			}

			Overclock: {
				DisplayName: Overclock
				Tooltip:
					'''
					Zhuang Fangyi's attack cooldown is reduced from 17 seconds to 7 seconds
					Hits against enemies suffering electric debuffs deal x2 final damage
					SunderBlade right-click non-final strikes deal 20% less damage; the final strike remains at 600%
					'''
			}

			WorldSplitter: {
				DisplayName: World Splitter
				Tooltip:
					'''
					+8% critical strike chance
					While holding SunderBlade, gain an additional +5% magic critical strike chance
					After Zhuang Fangyi attacks, summons Mifu to rush at an enemy, dealing 540% of SunderBlade's displayed damage to that enemy and enemies behind it and inflicting Crumbling
					When Mifu is released, creates a 10-second shield with durability equal to 20% of the player's maximum life
					If Zhuang Fangyi used her main attack, the player gains +9% damage for 10 seconds
					'''
			}

			QingDianFa: {
				DisplayName: Azure Lightning Arts
				Tooltip:
					'''
					+15% movement and jump speed
					Double-tap a direction to become lightning and dash through enemies without taking damage.
					While holding SunderBlade, dashing strikes a nearby enemy with lightning. This effect has a 12-second cooldown.
					'''
			}

			JiDianFa: {
				DisplayName: Jolting Arts
				Tooltip:
					'''
					+15% flight time; +24% movement and jump speed
					Double-tap a direction to become lightning and dash through enemies without taking damage.
					While holding SunderBlade, dashing releases up to 3 lightning strikes based on nearby SunderBlade swords. This effect has a 9-second cooldown.
					'''
			}

			QingTingJue: {
				DisplayName: Azure Thunder Formula
				Tooltip:
					'''
					+25% flight time; +27% movement and jump speed
					Double-tap a direction to become lightning and dash through enemies without taking damage.
					While holding SunderBlade, dashing calls lightning along its path based on nearby SunderBlade swords.
					The next SunderBlade attack becomes a heavy strike. This effect has a 9-second cooldown.
					'''
			}

			WanJunFengLei: {
				DisplayName: Myriad Thunderstorms
				Tooltip:
					'''
					+50% flight time; +36% movement and jump speed
					Double-tap a direction to become lightning and dash through enemies without taking damage.
					While holding SunderBlade, dashing calls lightning along its path based on nearby SunderBlade swords.
					The next SunderBlade attack becomes a heavy strike. This effect has a 9-second cooldown.
					'''
			}
		}

		Buffs: {
			AzureThunderHarmonyBuff: {
				DisplayName: Empyrean of Truth
				Description: Final damage, defense, damage reduction, and life regeneration are increased; SunderBlade attacks are empowered.
			}

			AzureThunderGuZhouDamageBuff: {

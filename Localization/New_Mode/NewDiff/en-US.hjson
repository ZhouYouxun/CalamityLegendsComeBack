Mods: {
	CalamityLegendsComeBack: {
		DifficultyUI: {
			Name: Legends Mode
			ShortDescription: Enables Legends Mode.
			ExpandedDescription: Legends Mode rebuilds selected Calamity bosses with bespoke AI layers: staged phase changes, weapon-themed attack cycles, motion pressure, death performances, and bottom-left debug text.
		}

		UI: {
			ModeEnabled: Legends Mode enabled.
			ModeDisabled: Legends Mode disabled.
			StatusOn: Current state: ON
			StatusOff: Current state: OFF
		}

		Items: {
			BossSummonerItem: {
				DisplayName: Boss Summoner
				Tooltip: Right-click to open the boss list. Click any boss icon to spawn it.
			}
		}

		Configs: {
			LegendsClientConfig: {
				DisplayName: Legends Mode Client Settings

				ShowBossAIDebugText: {
					Label: Show boss AI debug text
					Tooltip: Shows the current tracked boss, phase, weapon, timer, and life in the bottom-left corner while Legends Mode is active.
				}
			}
		}

		LegendsDebug: {
			Header: LEGENDS MODE DEBUG
			NoBoss: waiting for tracked boss
			Boss: Boss
			Phase: Phase
			Weapon: Weapon
			Timer: Timer
			Life: Life
			PhaseFallback: Phase {0}
		}


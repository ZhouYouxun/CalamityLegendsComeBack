Mods: {
	CalamityLegendsComeBack: {
		Common.NoMana: Not enough mana

		Items: {
			Weapons: {
				AzureThunder: {
					DisplayName: AzureThunder
					Tooltip: "[GFB]"
					AzureThunderLeft:
						'''
						[c/6FDFFF:Left click:] [c/DCD6C8:slowly swing the greatsword, releasing AzureThunder light orbs and multiple flying heavy swords.]
						[c/8DEBFF:On hit,] [c/DCD6C8:release extra lightning attacks.]
						'''
					AzureThunderRight:
						'''
						[c/6FDFFF:Right click:] [c/DCD6C8:create multiple floating swords on nearby ground or in the air.]
						[c/8DEBFF:Floating swords] [c/DCD6C8:periodically call down lightning on nearby enemies.]
						'''
					AzureThunderUltimate:
						'''
						[c/FFE85A:Ultimate:] [c/DCD6C8:at 120 ultimate energy, press [{0}] to gain Heavenly Harmony for 25 seconds.]
						[c/FFE85A:Heavenly Harmony] [c/DCD6C8:empowers AzureThunder's left click, right click, and final strikes.]
						'''
					AzureThunderPassiveHeavenEarth0: "[c/B8F4FF:Heaven and Earth:] [c/DCD6C8:unlocked by default. Desert Scourge will improve it.]"
					AzureThunderPassiveHeavenEarth1: "[c/B8F4FF:Heaven and Earth:] [c/DCD6C8:+1 mana regeneration for each active AzureThunder sword.]"
					AzureThunderPassiveHeavenEarth2: "[c/B8F4FF:Heaven and Earth:] [c/DCD6C8:+1 mana regeneration for each active AzureThunder sword; after Hive Mind or Perforators, +2 armor penetration.]"
					AzureThunderPassiveHeavenEarth3: "[c/B8F4FF:Heaven and Earth:] [c/DCD6C8:+1 mana regeneration for each active AzureThunder sword; +2 armor penetration; after Duke Fishron, +1 life regeneration.]"
					AzureThunderPassiveHeavenEarth4: "[c/B8F4FF:Heaven and Earth:] [c/DCD6C8:+1 mana regeneration for each active AzureThunder sword; +2 armor penetration; +1 life regeneration; after Yharon, +2% magic damage.]"
					AzureThunderPassiveHeavensWard0: "[c/B8F4FF:Heaven's Ward:] [c/8A8A8A:unlocks after Hive Mind or Perforators.]"
					AzureThunderPassiveHeavensWard1: "[c/B8F4FF:Heaven's Ward:] [c/DCD6C8:unlocked after Hive Mind or Perforators. While held, periodically dodge one hit and restore life.]"
					AzureThunderPassiveHeavensWard2: "[c/B8F4FF:Heaven's Ward:] [c/DCD6C8:unlocked after Hive Mind or Perforators; after Wall of Flesh, healing increases to 80.]"
					AzureThunderPassiveHeavensWard3: "[c/B8F4FF:Heaven's Ward:] [c/DCD6C8:unlocked after Hive Mind or Perforators; after Plantera, healing increases to 125.]"
					AzureThunderPassiveHeavensWard4: "[c/B8F4FF:Heaven's Ward:] [c/DCD6C8:unlocked after Hive Mind or Perforators; after Moon Lord, healing increases to 150.]"
					AzureThunderPassiveHeavensWard5: "[c/B8F4FF:Heaven's Ward:] [c/DCD6C8:unlocked after Hive Mind or Perforators; after Yharon, healing increases to 200.]"
					AzureThunderPassiveFourSymbols0: "[c/B8F4FF:Fourfold Accord:] [c/8A8A8A:unlocks after Wall of Flesh.]"
					AzureThunderPassiveFourSymbols1: "[c/B8F4FF:Fourfold Accord:] [c/DCD6C8:unlocked after Wall of Flesh. If fewer than 3 AzureThunder swords exist, automatically create one every 10 seconds.]"
					AzureThunderPassiveFourSymbols2: "[c/B8F4FF:Fourfold Accord:] [c/DCD6C8:unlocked after Wall of Flesh. If fewer than 3 AzureThunder swords exist, automatically create one every 10 seconds; after Duke Fishron, triggering this also restores life.]"
					AzureThunderPassiveFourSymbols3: "[c/B8F4FF:Fourfold Accord:] [c/DCD6C8:unlocked after Wall of Flesh. After Duke Fishron, triggering this also restores life; after Moon Lord, swords auto-generate whenever fewer than 6 are present.]"
					AzureThunderThunderCharge: "[c/FFE85A:Thunder Charge:] [c/DCD6C8:gained by striking enemies with electric debuffs, Elemental Mix, or Miracle Blight, up to 10 stacks.]"
					AzureThunderDot: "[c/FFE85A:Heavenly Harmony damage over time:] [c/DCD6C8:upgrades from Static Discharge through progression and adds stronger debuffs at higher tiers.]"
					AzureThunderFinal: '''[c/FFE85A:"Let solemn thunder cleanse evil, call sweet rain, and spare the living."]'''
				}
			}
		}

		Buffs: {
			AzureThunderHarmonyBuff: {
				DisplayName: Heavenly Harmony
				Description: Final damage, defense, damage reduction, and life regeneration are increased; AzureThunder attacks are empowered.
			}
		}

		Projectiles: {
			AzureThunder: {
				AzureThunderSwingHoldout.DisplayName: AzureThunder
				AzureThunderLightOrb.DisplayName: AzureThunder Light Orb
				AzureThunderStormLightning.DisplayName: AzureThunder Lightning
				AzureThunderFlatLightning.DisplayName: AzureThunder Flat Bolt
				AzureThunderFlyingSword.DisplayName: AzureThunder Flying Sword
				AzureThunderGroundSword.DisplayName: AzureThunder Ground Sword
				AzureThunderGrandSword.DisplayName: AzureThunder Grand Sword
				AzureThunderStrikeSequencer.DisplayName: AzureThunder Strike Sequencer
			}
		}

		Cooldowns: {
			AzureThunder_ThunderCharge: Thunder Charge
			AzureThunder_Ultimate: AzureThunder Ultimate
		}
	}
}

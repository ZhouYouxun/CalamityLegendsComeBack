Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				CallofDuty: {
					DisplayName: 责任的电话
					Tooltip: "[GFB]"
					Compact:
						'''
						[c/8FDFFF:左键发射当前通讯语言 {0}，按住右键打开轮盘选择语言]
						[c/8FDFFF:当前语言效果：{2}]
						[c/FFD84C:整串通讯命中会让敌人“已接通”，接通 6 次后给它扣上一顶钨钢帽子]
						[c/FFD84C:钨钢帽子使召唤伤害提高 8%，并会响应通讯开火、标记目标、释放干扰环]
						[c/6FA8FF:放在主背包中即可获得钨钢屏障等效护盾；佩戴钨钢屏障时每层护盾生命由 20 提高到 40]
						[c/C2FF43:传奇技能（{1}）：都过来]
						[c/C2FF43:先空投一台钨钢增幅器，落地后固定，0.5 秒后叫来另外 16 台钨钢机器人]
						[c/C2FF43:大招与冷却均持续 60 秒；击败任意真实 Boss 会立即完成冷却]
						'''

					LanguageEffects: {
						Alarm: 三发高速直线警报，总伤害提高 15%，不追踪
						Query: 三发中速查询，会自行追踪修正弹道
						Static: 四发低速静默，可穿透 3 个敌人，总伤害降低 10%
						Confirm: 五发密集近程确认，接通值翻倍，总伤害降低 10%
					}

					DetailsHint: "[c/97ADB8:按住 Shift 查看通讯、帽子和分队详情]"
					Details:
						'''
						[c/FF654C:!?] 三发高速警报；[c/55B9FF:??] 三发查询追踪；[c/A3ADB4:...] 四发穿透静默；[c/66E867::)] 五发近程确认
						帽子使召唤伤害提高 8%，还能开融合炮、标记目标、释放干扰环，并把下一次融合炮升级为八连发

						[c/C2FF43:都过来：]1 台钨钢增幅器、6 台钨钢探测车、4 台钨钢回旋仪、4 台钨钢无人机、2 台钨钢气垫船
						所有友军拥有钨钢绿色发光包边、独立生命，完整继承你的防御力，并能真正挡下可安全删除的敌方弹幕
						钨钢增幅器空投后自由落体，落地即永远固定；990 像素场内玩家获得 20 防御，电话机器人获得 50% 生命、防御与攻击
						钨钢探测车冲锋、正面减伤，并使用废料霰射和融合炮
						钨钢回旋仪会认真原地越转越快，然后滚出去撞人
						钨钢无人机的激光伤害不高但几乎必中；钨钢气垫船先把导弹打上天，再让它们自己回来
						左键点击敌人或地面可下令进攻/前往；右键轮盘中央为“回来”；再次按传奇技能键会说“算了”
						'''
					LegendaryText: “都过来。”
				}
			}
		}

		Cooldowns.CallofDuty_Ultimate: 都过来
		UI.CallofDuty.Return: 回来

		NPCs: {
			ResponsibilityArmyAmplifier.DisplayName: 责任分队·钨钢增幅器

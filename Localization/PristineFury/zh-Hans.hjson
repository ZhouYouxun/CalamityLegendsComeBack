Mods: {
	CalamityLegendsComeBack: {
		Items: {
			TestItem: {
				DisplayName: PF 测试配饰
				Tooltip: 佩戴时，纯元单击右键改为按顺序切换印记
			}

			// General (Lily) accessories
			PFLily: {
				DisplayName: 百合
				Tooltip: 印记队列 +1（共4）\n远程伤害 +8%\n纯化等级上限提高至 3 级\n3 级纯化会进一步提高持续伤害；小怪受到轻微攻击节奏削弱；Boss 受到更多纯元伤害并在被左键命中时额外受到纯化灼伤
			}

			PFSlightlyBloomLily: {
				DisplayName: 稍微绽放的百合
				Tooltip: 印记队列 +2（共5）\n远程伤害 +12%\n纯化等级上限提高至 4 级\n4 级纯化会使小怪死亡时产生纯化爆燃；Boss 会周期性触发小型纯化爆燃
			}

			PFBloomLily: {
				DisplayName: 绽放的百合
				Tooltip: 印记队列 +3（共6）\n远程伤害 +16%\n纯化等级上限提高至 5 级\n5 级纯化会强化爆燃；小怪死亡时向周围施加 2 级纯化；Boss 周期性释放白焰
			}

			PFKillIntentLily: {
				DisplayName: 杀意的百合
				Tooltip: 印记队列 +4（共7）\n远程伤害 +22%\n纯化等级上限提高至 6 级\n6 级纯化会使小怪死亡时产生大型爆燃并施加 3 级纯化；Boss 进入杀意纯化状态，周期性触发强力爆燃并释放扩散纯化火花
			}

			// Skill accessories
			PFChangEFireCan: {
				DisplayName: 嫦娥怨火罐
				Tooltip: 手持纯元时，燃料背包获得独立血量，可以阻挡敌方弹幕\n若挡下的弹幕伤害超过剩余血量，背包爆炸产生 500×500 像素的纯化爆炸，不伤害玩家与友方
			}

			PFMooncake: {
				DisplayName: 月饼
				Tooltip: 右键纯化火球命中或爆炸时，范围内留下短暂的月华烙印\n处于烙印中的敌人会更快积累纯化等级\n已达到纯化上限的敌人会额外触发一次小型纯化爆燃
			}

			PFNineTails: {
				DisplayName: 无秽九尾
				Tooltip: 手持纯元时，原本的三条火狐狸尾巴变为九条无秽狐尾\n狐尾体型大幅提高，会自动追踪附近敌人\n狐尾命中时造成高额纯化伤害，并少量推进纯化进度
			}

			PFLingmuFOMO: {
				DisplayName: 灵梦FOMO
				Tooltip: 左键使用当前印记攻击时，队列中未被选中的印记会每 60 帧释放一次低威力残响弹幕\n相当于额外的副炮
			}

			PFHellFairyTorch: {
				DisplayName: 地狱妖精的火把
				Tooltip: 小怪达到当前最高纯化等级后，直接造成最大生命值 60% 的真实伤害，然后周期性释放友方纯化火花\nBoss 触发纯化爆燃时，清空所有纯化等级并立刻造成最大生命值 10% 的真实伤害，然后一次性释放螺旋扩散的纯化弹幕
			}

			Weapons: {
				NewLegendPristineFury: {
					DisplayName: 新传奇 - 纯元怒焰
					PristineFuryIntro: "[c/FF9340:当前印记：{0}。]"
					RightClick: "[c/FFB066:右键：蓄力并释放纯元新星弹。]"
					Hook: "[c/9AEAFF:按住左键与右键发射提取钩；有效 Boss 会授予对应印记。]"
					Left_Idle: "[c/FFE05C:左键：以紧凑散布节奏发射低速重力火星。]"
					Left_DesertScourge: "[c/FFE05C:左键：发射玻璃块，命中后碎裂为切割碎片。]"
					Left_EyeOfCthulhu: "[c/FFE05C:左键：发射克制的凝视激光，轻微倒向敌人。]"
					Left_Skeletron: "[c/FFE05C:左键：发射骨火颅弹，弯行后爆开。]"
					Left_EvilT2: "[c/FFE05C:左键：发射魔法绘制的亮黄色小虫，反复冲向附近目标。]"
					Left_SlimeGod: "[c/FFE05C:左键：发射过载史莱姆球，偏重弹跳与后段追踪。]"
					Left_HardMode: "[c/FFE05C:左键：发射重型火球，留下碎片与地火。]"
					Left_Prime: "[c/FFE05C:左键：喷射齿轮状金焰，伴随机械火花。]"
					Left_BrimstoneElemental: "[c/FFE05C:左键：发射硫火射线，并引出追踪弹幕。]"
					Left_FakeCalamity: "[c/FFE05C:左键：蓄出黄色新星球，命中后造成爆发。]"
					Left_Plantera: "[c/FFE05C:左键：以视觉激光预热，再释放分裂绿雷。]"
					Left_Golem: "[c/FFE05C:左键：引导日光焊枪射线，末端伤害极高。]"
					Left_Goliath: "[c/FFE05C:左键：短暂蓄力后，释放收割者无人机群。]"
					Left_Empress: "[c/FFE05C:左键：维持彩虹火流，随时间逐渐增强。]"
					Left_Moonlord: "[c/FFE05C:左键：月曜弹预热后，释放瞬时巨型激光。]"
					Left_Providence: "[c/FFE05C:左键：亵渎迫击弹生成地火，并召来天体雨。]"
					Left_Ravager: "[c/FFE05C:左键：引导血石激光，为玩家提供续航。]"
					Left_Polterghast: "[c/FFE05C:左键：高速幽魂火穿透敌人，并留下幽魂尾迹。]"
					Left_Dog: "[c/FFE05C:左键：撕开虚空流、延迟裂隙与黑色吸积盘。]"
					Left_ExoTwins: "[c/FFE05C:左键：阿尔忒弥斯激光后接阿波罗火箭。]"
					Left_ExoThanatos: "[c/FFE05C:左键：塔纳托斯预警线收束为灭绝光束。]"
					Left_ExoAres: "[c/FFE05C:左键：从枪口高速连射阿瑞斯激光。]"
					Left_Dragon: "[c/FFE05C:左键：龙息齐射逐渐加速，进入短暂狂热循环。]"
					Passive:
						'''
						[c/FF7733:被动【烈焰之尾】三条火尾在玩家身后作战。]
						[c/FF7733:火尾继承武器伤害，并以短命中冷却高速攻击。]
						[c/FF7733:火尾命中敌人时会回复少量翅膀飞行时间。]
						[c/BB55FF:被动【亵渎水晶】手持纯元时，一枚神圣水晶悬浮于头顶。]
						[c/BB55FF:左键射击时：每 16 帧水晶同时射出 5 枚彩虹碎片，80° 扇形展开后全部收束追踪同一目标。]
						[c/BB55FF:右键蓄力时：水晶持续释放两道缓缓交叉旋转的剪刀激光。]
						'''
					Tooltip: "[GFB]"
					LegendaryHint: "[c/BABABA:按住 Shift 键以读取记录]"
					LegendaryText:
						'''
						[c/FF9340:最初的纯元仍是一把喷吐神圣火焰的武器，用持续燃烧压住靠近的敌人。]
						[c/FFB066:这种火焰足够纯粹，却很难承载亵渎天神之外那些被击败 Boss 留下的压力。]
						[c/9AEAFF:重构后，钩爪不再只是命中工具，而是用来提取、记录并保存不同敌人的印记。]
						[c/FFB066:每一种印记都会被重新送回枪管，让火焰带上恶意、神性、瘟疫、饥饿或更遥远的回响。]
						[c/FF7733:当劫火最终重燃，纯元喷出的不只是火，而是那些曾被锚定过的传奇本身。]
						'''
				}
			}
		}


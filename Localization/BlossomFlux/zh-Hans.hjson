Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendBlossomFlux: {
					DisplayName: 叶流 - 传奇归来
					Tooltip: "[GFB]"
					BF_Intro:
						'''
						[c/7BE495:当前战术：{0}]
						[c/F7D87C:右键长按：进入当前战术的蓄力姿态，松开后释放特殊箭。]
						'''
					PresetName0: 突击
					PresetName1: 复苏
					PresetName2: 侦察
					PresetName3: 歼灭
					PresetName4: 侵染
					PresetLeft0:
						'''
						[c/8BE89A:当前模式：【突击】]
						[c/8BE89A:左键：快速射出大量叶枝箭，将木箭转化为叶枝箭]
						[c/8BE89A:叶枝箭可以笔直飞行，并穿透多个敌人]
						'''
					PresetLeft1:
						'''
						[c/70E0D0:当前模式：【复苏】]
						[c/70E0D0:左键：将箭矢转化为双链交错推进的叶弹]
						[c/70E0D0:命中时概率产生闪光，消失时治疗并提供绿叶防护]
						'''
					PresetLeft2:
						'''
						[c/66CCFF:当前模式：【侦察】]
						[c/66CCFF:左键：转化为单体锁定的五连发追踪侦察箭]
						[c/66CCFF:侦察箭短暂飞行后会重新追踪目标并逐渐加速]
						'''
					PresetLeft3:
						'''
						[c/FFA07A:当前模式：【歼灭】]
						[c/FFA07A:左键：抛射落下的箭雨，仅将木箭转化为歼灭箭]
						[c/FFA07A:其他箭矢正常发射，歼灭箭命中引发大范围爆炸]
						'''
					PresetLeft4:
						'''
						[c/DDA0FF:当前模式：【侵染】]
						[c/DDA0FF:左键：将箭矢转化为造成防御衰减的侵染收割者]
						[c/DDA0FF:重复命中会刷新污染时间，持续削弱敌人防御]
						'''
					PresetRight0:
						'''
						[c/8BE89A:右键：摁住右键进行蓄力，逐渐装填强化叶枝箭]
						[c/8BE89A:装填可以大幅提升其伤害，松手后依次快速射出]
						'''
					PresetRight1:
						'''
						[c/70E0D0:右键：按住向上举弓蓄力，释放大范围复苏闪光]
						[c/70E0D0:复苏闪光仅治疗玩家，不提供复苏之叶效果]
						'''
					PresetRight2:
						'''
						[c/66CCFF:右键：按住发射不受重力下坠影响的高速标记箭]
						[c/66CCFF:标记最高生命值目标，使其承受更高的左键伤害]
						'''
					PresetRight3:
						'''
						[c/FFA07A:右键：按住生成引导准星，松手向天空发射导弹]
						[c/FFA07A:导弹从天而降制导至准星位置，引发剧烈爆炸]
						'''
					PresetRight4:
						'''
						[c/DDA0FF:右键：按住积蓄并射出大型孢子弹，产生持续孢子云]
						[c/DDA0FF:命中后永久降低敌人的各项属性与防御能力]
						'''
					PresetPassive0:
						'''
						[c/B7FFB0:战术被动 - 突击：获得无无敌帧的高速冲刺；已有冲刺的冷却减半。]
						[c/B7FFB0:冲刺后 0.75 秒内，叶流伤害提高 20%。]
						'''
					PresetPassive1:
						'''
						[c/B7FFB0:战术被动 - 复苏：免疫防御损伤，大幅扩大红心拾取范围。]
						[c/B7FFB0:减益造成的生命流失减半；单次伤害超过最大生命值 30% 时，超出部分减半。]
						'''
					PresetPassive2:
						'''
						[c/B7FFB0:战术被动 - 侦察：免疫移速降低，移动速度 +25%，加速度 +100%，飞行时间 +50%。]
						[c/B7FFB0:钩爪发射、回收和牵引速度 +30%；钩中平台或斜坡后，抵达钩点会自动松钩。]
						'''
					PresetPassive3:
						'''
						[c/B7FFB0:战术被动 - 歼灭：根据屏幕内敌人数量提升射速。]
						[c/B7FFB0:屏幕内有 5/10/20 个敌人时，叶流使用时间和左键循环延迟 -1/-2/-3。]
						'''
					PresetPassive4:
						'''
						[c/B7FFB0:战术被动 - 侵染：叶流攻击会延长目标身上已有的任何减益。]
						[c/B7FFB0:任意敌人身上的减益以一半速度流逝。]
						'''
					BF_Passive:
						'''
						[c/9AEF9E:被动 - 终末防线：手持该武器时可抵消一次致命伤害]
						[c/9AEF9E:触发后获得短暂无敌与强力治疗，Boss战时不充能。当前状态：{0}]
						'''
					PassiveStateReady: "[c/7BFFB7:已就绪]"
					PassiveStateActive: "[c/FF9B8B:终末防线中]"
					PassiveStateCooldown: "[c/F0D070:充能 {0}/{1} 秒]"
					PassiveStateLocked: "[c/9A9A9A:困难模式后解锁]"
					BF_EXHint:
						'''
						[c/8EF5A8:大招 - 森绿能量爆发：手持或右键蓄力可积蓄能量]
						[c/8EF5A8:能量充满后，按下] [[c/8EF5A8:{0}]] [c/8EF5A8:释放倾泻而出的森绿箭幕]
						'''
					BF_EXDisabledHint: "[c/9A9A9A:当前未佩戴黄金饰章，大招将被禁用。]"
					BF_FormWheelHint: "[c/F7D87C:按住] [[c/F7D87C:{0}]] [c/F7D87C:打开战术轮盘，松手即可切换至当前扇区战术。]"蓄力命中会永久降低该 NPC 的能力。该削弱绑定在敌人身上，不要求玩家继续手持叶流。]
						'''
					PresetPassive0:
						'''
						[c/B7FFB0:战术被动 - 突击：获得无无敌帧的高速冲刺；已有冲刺的冷却减半。]
						[c/B7FFB0:冲刺后 0.75 秒内，叶流伤害提高 20%。]
						'''
					PresetPassive1:
						'''
						[c/B7FFB0:战术被动 - 复苏：免疫防御损伤，大幅扩大红心拾取范围。]
						[c/B7FFB0:减益造成的生命流失减半；单次伤害超过最大生命值 30% 时，超出部分减半。]
						'''
					PresetPassive2:
						'''
						[c/B7FFB0:战术被动 - 侦察：免疫移速降低，移动速度 +25%，加速度 +100%，飞行时间 +50%。]
						[c/B7FFB0:钩爪发射、回收和牵引速度 +30%；钩中平台或斜坡后，抵达钩点会自动松钩。]
						'''
					PresetPassive3:
						'''
						[c/B7FFB0:战术被动 - 歼灭：根据屏幕内敌人数量提升射速。]
						[c/B7FFB0:屏幕内有 5/10/20 个敌人时，叶流使用时间和左键循环延迟 -1/-2/-3。]
						'''
					PresetPassive4:
						'''
						[c/B7FFB0:战术被动 - 侵染：叶流攻击会延长目标身上已有的任何减益。]
						[c/B7FFB0:任意敌人身上的减益以一半速度流逝。]
						'''
					BF_Passive:
						'''
						[c/9AEF9E:终末防线：手持叶流时，可抵消一次致命伤害；180 秒充能，Boss 存活时不会计时。]
						[c/9AEF9E:触发时保持 1 生命并展开 5 秒复苏立场，期间几乎无敌，免疫负面效果和环境伤害。]
						[c/9AEF9E:结束后恢复至最大生命；期间每拦下一次伤害，复苏生命 -20%，最低为 1。当前状态：{0}。]
						'''
					PassiveStateReady: "[c/7BFFB7:已就绪]"
					PassiveStateActive: "[c/FF9B8B:终末防线中]"
					PassiveStateCooldown: "[c/F0D070:充能 {0}/{1} 秒]"
					PassiveStateLocked: "[c/9A9A9A:困难模式后解锁]"
					BF_EXHint:
						'''
						[c/8EF5A8:大招：最多储存60点森绿能量。]
						[c/8EF5A8:手持叶流时，每2秒恢复1点能量；释放蓄力右键箭会恢复3点能量。]
						[c/8EF5A8:能量充满后，按下 [{0}] 释放森绿箭幕。]
						'''
					BF_EXDisabledHint: "[c/9A9A9A:当前未佩戴黄金饰章，大招将被禁用。]"
					BF_FormWheelHint: "[c/F7D87C:按住 [{0}] 打开战术轮盘；松开时会切换到当前扇区的战术。]"
					// BF_Final: "[c/9FD8A2:The bowstring hums, and the forest answers.]"
					LegendaryHint: "[c/BABABA:按住 Shift 阅读完整传奇记录]"
					LegendaryText:
						'''
						[c/66E6FF:最初，它只是一场追求更快连射的尝试。]
						[c/66E6FF:后来制作者意识到，速度不是答案。]
						[c/66E6FF:同一根弓弦必须学会五种呼吸方式。]
						[c/66E6FF:于是战术拆分为五条枝流。]
						[c/66E6FF:即便是普通木箭，也会在离弦后改变形态。]
						[c/66E6FF:它仍会继续生长，但节奏已经成形。]
						[c/66E6FF:等待、松弦，然后让战术回应。]
						'''
				}
			}

			ATunedQuiver: {
				DisplayName: 同调箭袋
				Tooltip:
					'''
					+15% 远程伤害
					+4 防御力
					提升箭矢速度。叶流的每种战术会获得不同的加成。
					'''
			}

			BResonatingQuiver: {
				DisplayName: 共鸣箭袋
				Tooltip:
					'''
					+15% 远程伤害
					+5% 远程暴击率
					+15 远程弹幕护甲穿透
					+6 防御力
					提升箭矢速度。叶流的每种战术会获得不同的加成。
					'''
			}

			CDominationQuiver: {
				DisplayName: 主宰箭袋
				Tooltip:
					'''
					+15% 远程伤害
					+5% 远程暴击率
					+15 远程弹幕护甲穿透
					+16 防御力
					+15% 最大生命值
					提升箭矢速度。叶流的每种战术会获得不同的加成。
					所有攻击都能穿墙且无视防御。
					'''
			}

			PastLingering: {
				DisplayName: 旧日残影
				Tooltip:
					'''
					将“突击”战术改变为类似于幻影弓的模式
					箭矢不再被转化，并在命中敌人时释放出强追踪幻影。
					持续射击会逐渐提升攻击速度。
					'''
			}

			SeedOfSilva: {
				DisplayName: 席尔瓦之种
				Tooltip:
					'''
					生成五枚缓慢围绕玩家旋转并发出微弱绿光的种子。
					手持叶流时，种子会根据当前战术绽放成不同的花朵。
					突击：向日葵
					向日葵会创造一个小区域。穿过该区域的突击箭获得 30% 伤害加成和 15% 暴击率加成。
					复苏：雏菊
					雏菊拥有 15 点最大生命值，每秒恢复 1.2 生命值，并继承玩家的防御和伤害减免。
					如果雏菊承受 20 点或更多伤害，它会为玩家治疗其存储的生命恢复量（向下取整）。
					侦察：飞燕草
					飞燕草每 1.5 秒用弧光攻击附近的敌人一次，造成轻微伤害并眩晕 1秒。
					被眩晕的敌人会大幅减速，且受到来自侦察箭的双倍伤害。
					免疫击退的敌人只获得伤害加成，且降至 1.15 倍。
					每次飞燕草成功造成眩晕，都会恢复 0.5 秒的飞行时间。
					歼灭：火炬花
					当敌人接近时，火炬花会喷射火焰。
					穿过火炬花的箭矢也会触发一次有独立冷却时间的爆炸。
					侵染：曼陀罗
					曼陀罗会减速附近的敌人，并使其接触伤害降低 15%。
					曼陀罗会像孢子囊一样持续产生孢子，每个孢子施加 3 秒的减益。其上限跟随当前武器。
					曼陀罗还会偶尔发射追踪的毁灭性花朵弹幕，使敌人瘫痪并减速。
					'''
			}

			SilvaHarp: {
				DisplayName: 席尔瓦竖琴
				Tooltip:
					'''
					每秒生命恢复 +5。此生命恢复不受任何因素削弱。
					受击后的无敌时间增加 60 帧。
					与叶流的终末防线共存，但不再改变复活持续时间或冷却规则。
					'''
			}
		}


Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				DesertEagle: {
					DisplayName: 沙漠之鹰
					Tooltip:
						'''
						左键轮流散射动能灌注弹，以及强力吸血弹
						按住右键将高速旋转手里的沙漠之鹰，切碎撞到它的敌人
						充能满时点击左键将释放一枚强力的闪光爆弹
						'''
				}
			}

			VortexEye: {
				DisplayName: 漩涡之眼
				Tooltip:
					'''
					[c/99CCFF:将海爵右键替换为"漩涡折返冲刺"]
					近战伤害 +10%，近战攻速 +10%，移动速度 +15%
					手持海爵剑时在鼠标位置生成漩涡之眼
					右键沿水平或竖直方向做穿透折返冲刺，
					并在折返点生成垂直方向的巨型水龙卷
					'''
			}

			AbyssalBastion: {
				DisplayName: 渊洋壁垒
				Tooltip:
					'''
					防御 +6，伤害减免 +6%，免疫击退
					冲刺速度与距离增加并减少冲刺冷却
					背包内带海爵剑时，允许使用快刀斩冲刺
					右键冲刺命中后赋予 100 生命值与 25% 减伤的泡沫护盾
					护盾存在时为玩家抵挡伤害并额外提供 25 点防御
					'''
			}

			BaronHelix: {
				DisplayName: 爵士螺旋
				Tooltip:
					'''
					近战伤害 +10%，近战攻速 +10%
					双键龙卷风伤害频率翻倍且更快达到最高速度
					达到最高速后在周围生成水泡：
					生命值不满时水泡飞向玩家恢复 2 点生命；
					满血时快速向敌人发射近战水泡（60/月后 140/神吞后 300 伤害）
					'''
			}

			OceanHormone: {
				DisplayName: 海洋激素
				Tooltip:
					'''
					减少 10% 暴击率，并使玩家获得野性噬咬减益
					增加 20% 近战攻速，且肾上腺素充能速度提升（与鸦片酊不叠加）
					在肾上腺素模式激活期间，海爵剑使用时间 -6
					'''
			}

			TideWiseHat: {
				DisplayName: 潮汐智者
				Tooltip:
					'''
					魔力上限 +50，近战伤害 +15%
					潮汐流逝速度减半，每拥有 1 层潮汐增加 1% 暴击率
					暴击时有 1% 概率获得 1 层潮汐
					使用“激流送葬”（终结技）时消耗所有魔力：
					每消耗 1 点魔力使单段倍率提高 0.1%，最后一击提高 1%
					'''
			}
		}

		Projectiles: {
			DesertEagleHoldout.DisplayName: 沙漠之鹰持握体

			A_Dev: {
				DesertEagleHeavyRound.DisplayName: 沙漠之鹰重弹
				DesertEagleLifeRound.DisplayName: 沙漠之鹰生命弹
			}
		}
	}
}

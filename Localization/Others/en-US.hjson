		NPCs: {
			Prime2041.DisplayName: Skeletron Prime (2024 Master AI)
			Prime2041SecondHead.DisplayName: Skeletron Prime (2024 Master AI) - Second Head
			Prime2041Saw.DisplayName: Prime Saw (2024)
			Prime2041Laser.DisplayName: Prime Laser (2024)
			Prime2041Vice.DisplayName: Prime Vice (2024)
			Prime2041Cannon.DisplayName: Prime Cannon (2024)
			Destroyer2041Head.DisplayName: The Destroyer (2024 Master AI)
			Destroyer2041Body.DisplayName: The Destroyer (2024 Master AI)
			Destroyer2041Tail.DisplayName: The Destroyer (2024 Master AI)

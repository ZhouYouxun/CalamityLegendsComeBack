Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				HyperdimensionalMatrixCore: {
					DisplayName: 高维矩阵核心
					Tooltip:
						'''
						[c/7EB8FF:召唤一个矩阵核心——每吞噬一个召唤栏，使其所有攻击伤害提高25%]
						[c/FF9040:永远锁定一个距离最近的目标]
						[c/5880C0:强化躯体 · 降低伤害 · 恢复生命 · 提升移速 · 降低仇恨 · 延长飞行]
						[c/FF3030:生命危急时超频加速所有攻击模块]
						[c/AA88FF:矩阵核心将完全占用你的召唤栏]
						[c/787888:"很高兴与你合作，二维生物"]
						[c/9DA8B8:按住Shift键查看具体攻击方式]
						'''
					AttackDetails:
						'''
						[c/7EB8FF:数据矩阵：展开数据面板，向目标发射追踪数据矛。]
						[c/FF9040:几何爆裂：构筑几何体后，从其顶点爆射锋利碎片。]
						[c/FFEC40:五属性环绕球：五颗元素能量球环绕并灼烧目标。]
						[c/5880C0:聚合爆炸：汇聚能量后，在目标处引发剧烈爆炸。]
						[c/AA88FF:空间扭曲：对大型敌人施加持续扭曲伤害。]
						[c/9DA8B8:七芒符文：刻下七芒符文，射出碎片与追踪数据矛。]
						[c/FF3030:常驻数据场：在核心周围持续侵蚀靠近的敌人。]
						[c/FFFFFF:编译风暴：同时启动所有主要攻击，最终引爆数据奇点。]
						'''
				}
			}
		}

		Buffs: {
			HyperdimensionalMatrixCoreBuff: {
				DisplayName: 矩阵防护场
				Description: 强化躯体 · 降低伤害 · 恢复生命 · 提升速度 · 降低仇恨

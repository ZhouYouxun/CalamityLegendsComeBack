Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewVesuvius: {
					DisplayName: Vesuvius
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/FF8A3D:Left Click: Hold to charge Supervolcanic Eruption, then release to fire.]
						[c/FF8A3D:Short taps are forced into Stage 0 and only release three weak meteors.]
						'''
					ChargeStage1: "[c/FF8A3D:Unlocked charge: Stage I - basaltic jet.]"
					ChargeStage2: "[c/FF9F45:Unlocked charge: Stage II - strombolian bombs.]"
					ChargeStage3: "[c/FFC45B:Unlocked charge: Stage III - vulcanian magma pillars.]"
					ChargeStage4: "[c/FF754F:Unlocked charge: Stage IV - vesuvian homing cinders.]"
					ChargeStage5: "[c/D84BFF:Unlocked charge: Stage V - Toba-class obsidian shards.]"
					RightClick:
						'''
						[c/FFB15C:Right Click: Throw the staff like a javelin.]
						[c/FFB15C:When it strikes terrain it becomes an active fault core; progression adds turret fire, pyroclastic flow, and a subduction zone.]
						'''
					Passive:
						'''
						[c/CC9A6A:Passive: Volcanic ash falls around you while held.]
						[c/CC9A6A:Landing after a fall causes a quake. Greater fall speed means greater range and damage.]
						'''
					EXHint:
						'''
						[c/FFD86B:While held, Vesuvius charges ultimate energy up to 60.]
						[c/FFD86B:At full energy, press] [[c/FFD86B:{0}]] [c/FFD86B: to raise the staff overhead and charge Volcanic Eruption.]
						[c/FFD86B:After the ready sound, left click to unleash five seconds of ash, magma, meteors, fireballs, and obsidian shards.]
						'''
					EXDisabledHint: "[c/9A9A9A:Golden Emblem is not equipped. The ultimate is disabled.]"
					Final: "[c/FFB15C:The crust splits, ash shuts out the sky, and the pyroclastic flow sweeps the battlefield.]"
					LegendaryHint: "[c/BABABA:Hold Shift to access the record]"
					LegendaryText:
						'''
						[c/FFB15C:The first Vesuvius understood volcanoes as meteors: fall from above, smash the target, then explode.]
						[c/FF8A3D:That design was direct enough, but it only showed the surface fall of a volcano, not the disaster moving through the earth below.]
						[c/FFB15C:After the rebuild, jets, volcanic bombs, magma pillars, firestorms, and caldera collapse are all compressed into one staff.]
						[c/D84BFF:Right click is no longer just another projectile. It pulls earthquakes, faults, and crust pressure into the fight.]
						[c/FF4422:When the final eruption comes, what falls is no longer lava. It is an entire layer of earth finishing the volcano's declaration.]
						'''
				}
			}
		}


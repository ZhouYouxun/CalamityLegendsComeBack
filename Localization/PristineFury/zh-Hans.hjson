Mods: {
	CalamityLegendsComeBack: {
		Items: {
			TestItem: {
				DisplayName: PF 测试配饰
				Tooltip: 佩戴时，纯元单击右键改为按顺序切换印记
			}

			// General (Lily) accessories
			PFLily: {
				DisplayName: 百合
				Tooltip: 印记队列 +1（共4）\n远程伤害 +8%\n纯化等级上限提高至 3 级\n3 级纯化会进一步提高持续伤害；小怪受到轻微攻击节奏削弱；Boss 受到更多纯元伤害并在被左键命中时额外受到纯化灼伤
			}

			PFSlightlyBloomLily: {
				DisplayName: 稍微绽放的百合
				Tooltip: 印记队列 +2（共5）\n远程伤害 +12%\n纯化等级上限提高至 4 级\n4 级纯化会使小怪死亡时产生纯化爆燃；Boss 会周期性触发小型纯化爆燃
			}

			PFBloomLily: {
				DisplayName: 绽放的百合
				Tooltip: 印记队列 +3（共6）\n远程伤害 +16%\n纯化等级上限提高至 5 级\n5 级纯化会强化爆燃；小怪死亡时向周围施加 2 级纯化；Boss 周期性释放白焰
			}

			PFKillIntentLily: {
				DisplayName: 杀意的百合
				Tooltip: 印记队列 +4（共7）\n远程伤害 +22%\n纯化等级上限提高至 6 级\n6 级纯化会使小怪死亡时产生大型爆燃并施加 3 级纯化；Boss 进入杀意纯化状态，周期性触发强力爆燃并释放扩散纯化火花
			}

			// Skill accessories
			PFChangEFireCan: {
				DisplayName: 嫦娥怨火罐
				Tooltip: 手持纯元时，燃料背包获得独立血量，可以阻挡敌方弹幕\n若挡下的弹幕伤害超过剩余血量，背包爆炸产生 500×500 像素的纯化爆炸，不伤害玩家与友方
			}

			PFMooncake: {
				DisplayName: 月饼
				Tooltip: 右键纯化火球命中或爆炸时，范围内留下短暂的月华烙印\n处于烙印中的敌人会更快积累纯化等级\n已达到纯化上限的敌人会额外触发一次小型纯化爆燃
			}

			PFNineTails: {
				DisplayName: 无秽九尾
				Tooltip: 手持纯元时，原本的三条火狐狸尾巴变为九条无秽狐尾\n狐尾体型大幅提高，会自动追踪附近敌人\n狐尾命中时造成高额纯化伤害，并少量推进纯化进度
			}

			PFLingmuFOMO: {
				DisplayName: 灵梦FOMO
				Tooltip: 左键使用当前印记攻击时，队列中未被选中的印记会每 60 帧释放一次低威力残响弹幕\n相当于额外的副炮
			}

			PFHellFairyTorch: {
				DisplayName: 地狱妖精的火把
				Tooltip: 小怪达到当前最高纯化等级后，直接造成最大生命值 60% 的真实伤害，然后周期性释放友方纯化火花\nBoss 触发纯化爆燃时，清空所有纯化等级并立刻造成最大生命值 10% 的真实伤害，然后一次性释放螺旋扩散的纯化弹幕
			}

			Weapons: {
				NewLegendPristineFury: {
					DisplayName: 纯元：传奇归来
					PristineFuryIntro: "[c/FF9340:当前印记：{0}。]"
					RightClick: "[c/FFB066:右键：蓄力发射新星弹。佩戴 PF 测试配饰时，单击右键改为按顺序切换印记。]"
					Hook: "[c/9AEAFF:同时按住左键与右键 3 秒会发射提取钩。有效 Boss 会授予对应印记；其他敌人会承受高额钩爪伤害。]"
					Left_Idle: "[c/FFE05C:左键：以 400RPM 发射火花散布器风格的低速重力火星。]"
					Left_DesertScourge: "[c/FFE05C:左键：直接射出原版玻璃块，命中后炸裂成多枚切割玻璃碎片。]"
					Left_EyeOfCthulhu: "[c/FFE05C:左键：死亡凝视式眼球激光瞬间五连散射，优先锁定前方五个不同敌人，目标不足时集中火力。]"
					Left_Skeletron: "[c/FFE05C:左键：发射骨火骷髅弹，飞行中轻微追踪并在命中时炸出骨火脉冲。]"
					Left_EvilT2: "[c/FFE05C:左键：发射魔法绘制的亮黄色小虫，反复冲向附近目标。]"
					Left_SlimeGod: "[c/FFE05C:左键：过载黄色史莱姆球偏重弹射；没弹射过的球在减速耗尽后才缓慢曲线追踪。]"
					Left_HardMode: "[c/FFE05C:左键：缓慢发射重型火球，落地炸出终焉火碎片与持续地火。]"
					Left_Prime: "[c/FFE05C:左键：机械齿轮式金焰喷流，火花按齿距跳步咬合。]"
					Left_BrimstoneElemental: "[c/FFE05C:左键：发射硫火射线同款主激光，并沿路径生成强化追踪硫火弹。]"
					Left_FakeCalamity: "[c/FFE05C:左键：单段蓄力发射漫散弧星风格的黄色光球，命中后造成高额爆炸。]"
					Left_Plantera: "[c/5EF26C:左键：八次视觉伪激光后释放一次递归分裂的绿色重型闪电。]"
					Left_Golem: "[c/FFE05C:左键：引导石巨人日光配色的工业焊枪光束，末端造成极高伤害。]"
					Left_Goliath: "[c/FFE05C:左键：短暂蓄力后向前方持续散射收割者无人机群。]"
					Left_Empress: "[c/FFE05C:左键：持续锁定单个敌人喷射彩虹长枪火流，火流会随时间变亮并逐渐强化。]"
					Left_Moonlord: "[c/FFE05C:左键：月曜射线逐步暖机，短暂停火后释放瞬时巨型激光。]"
					Left_Providence: "[c/FFE05C:左键：亵渎迫击弹爆炸后生成地火，并按昼夜召唤圣光球或熔岩球雨。]"
					Left_Ravager: "[c/FFE05C:左键：引导单体血石激光，命中时通过直接治疗与治疗球提供续航。]"
					Left_Polterghast: "[c/FFE05C:左键：高速恶鬼魂火会强力追踪并贯穿敌人，飞行时留下层叠幽魂尾迹。]"
					Left_Dog: "[c/FFE05C:左键：光切虚空流撕开延迟裂隙与黑色吸积盘。]"
					Left_ExoTwins: "[c/4AFFB4:左键：阿尔忒弥斯预警激光快速贯穿，随后三连发阿波罗导弹。]"
					Left_ExoThanatos: "[c/FFE05C:左键：三道塔纳托斯预警线缓慢收束，最终释放灭绝激光并撕出侧向激光。]"
					Left_ExoAres: "[c/FF4C40:左键：阿瑞斯式普通激光从枪口高速全自动连射。]"
					Left_Dragon: "[c/FFE05C:左键：龙息齐射会从慢速预热逐渐加快，进入短暂疯狂扫射，休息后循环。]"
					Passive:
						'''
						[c/FF9340:被动（火尾）：]
						玩家背后伸出三条火狐尾，持续造成高频伤害。
						伤害继承武器直接面板，命中冷却为 10 帧。
						'''
					Tooltip: "[GFB]"
					LegendaryHint: "[c/BABABA:按住 Shift 键以读取记录]"
					LegendaryText:
						'''
						[c/FF9340:纯元不再只作为一把武器燃烧。]
						[c/FFB066:它记录钩爪锚定过的压力、恶意、神性、瘟疫与不可能的饥饿。]
						[c/9AEAFF:枪管会把这些轨迹作为印记保存，再将它们重新吐回世界。]
						[c/FF7733:在终焉的劫火中，那些曾被锚定的传奇终将以神圣的姿态重生。]
						'''
				}
			}
		}


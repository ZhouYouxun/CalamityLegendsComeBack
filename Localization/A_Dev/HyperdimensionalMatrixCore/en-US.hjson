Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				HyperdimensionalMatrixCore: {
					DisplayName: Hyperdimensional Matrix
					Tooltip:
						'''
						Summons the Matrix Core — a singular development engine made manifest
						Occupies every available minion slot; each additional slot grants +50% damage
						The core autonomously cycles through five attack modules
						Module I  · Data Grid: computes an optimal strike path, fires all lit cells simultaneously
						Module II · Geometry Burst: constructs a rotating polyhedron, then detonates it into edge shards
						Module III· Shader Experiments: deploys five experimental orbs, each running a different shader
						Module IV · Metaball Fusion: spawns energy spheres that converge and collapse into a supermass
						Module V  · Space Warp: warps local spacetime around large enemies
						Every 900 frames the core enters Compile Storm — all modules fire simultaneously
						Its defensive matrix grants 15 defense and 15% damage reduction
						"You did not summon a minion. You instantiated a runtime."
						'''
				}
			}
		}

		Buffs: {
			HyperdimensionalMatrixCoreBuff: {
				DisplayName: Matrix Protection Field
				Description: 15 defense and 15% damage reduction; the core is continuously recompiling the battlefield
			}
		}

		Projectiles: {
			HyperdimensionalMatrixCore: {
				HyperdimensionalMatrixCoreProjectile.DisplayName: Hyperdimensional Matrix Core
				MatrixDataGridPanel.DisplayName: Data Matrix Panel
				MatrixGridCell.DisplayName: Grid Cell Projectile
				MatrixGeoBurst.DisplayName: Geometry Burst
				MatrixGeoShard.DisplayName: Geometry Edge Shard
				MatrixShaderOrb.DisplayName: Shader Experiment Orb
				MatrixFusionController.DisplayName: Fusion Convergence
				MatrixFusionExplosion.DisplayName: Fusion Collapse
				MatrixSpaceWarpField.DisplayName: Space Warp Field
				MatrixCompileStorm.DisplayName: Compile Storm
				MatrixSingularity.DisplayName: Data Singularity
			}
		}
	}
}

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				LeonidProgenitor: {
					DisplayName: Meteorfall
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/74D8FF:Left Click: Spawns two small comets near you that launch toward the cursor after a brief delay.]
						[c/99CCFF:Comets bounce on reflective meteors, gain damage, and redirect through the battlefield.]
						[c/9AD8FF:Light the Leo constellation to permanently reshape the meteor rain.]
						'''
					StealthLeftClick: "[c/B7A4FF:Stealth Left: Summons a diagonal rain of comets above the cursor.]"
					RightClick: "[c/8DEBFF:Right Click: Hold to charge a large meteor; Stealth Right sends a roaring Lion Head and reflective meteors.]"
					UltimateSkill: "[c/FFE85A:Ultimate (Press {0}): Opens a gravity field that gathers a falling meteor storm. Requires full Ultimate Energy and Stealth.]"
					Passives: "[c/BFAFFF:Kinetic Cycle: Reflected left-click comets accelerate, grow stronger, and return to orbit after their seventh reflection.]"
					ConstellationStatus: "[c/FFE85A:Leo Starlight: {0} available | {1} spent | {2} earned | {3} to complete]"
					ConstellationHint: "[c/B8A8FF:Middle-click while held, or middle-click this weapon in your inventory, to open the Leo Matrix.]"
					LegendaryHint: "[c/BABABA:Hold Shift to read the legendary record]"
					LegendaryText: "[c/66E6FF:Meteorfall no longer searches your inventory for metal. Each major foe overcome becomes a starlight in the Lion's sky.]"

					Constellation: {
						Title: LEO // LEONID MATRIX
						Subtitle: Regulus is the heart. Any principal star may be awakened from it.
						Status: Available {0}    Spent {1}    Earned {2}    Full map {3}
						HoverHint: Hover a principal star to read its celestial imprint.
						Reset: Reset constellation (Free)
						Heart: Heart star — always lit
						Unlocked: Awakened
						Cost: Cost: {0} starlight

						Nodes: {
							Regulus: {
								Name: Regulus — Lion Heart
								Description: The fixed heart of Leo. It anchors every unlocked star.
							}

							Algieba: {
								Name: Algieba — Twin Mane
								Description: Small comets launch 20% faster.
							}

							Adhafera: {
								Name: Adhafera — Crown Thread
								Description: Normal left-click releases a third small comet.
							}

							Rasalas: {
								Name: Rasalas — Sickle Turn
								Description: Every reflection grants 12% speed and 6% damage, instead of 5% and 4%.
							}

							Zosma: {
								Name: Zosma — Falling Flank
								Description: Stealth meteor rain gains two additional comets.
							}

							Chertan: {
								Name: Chertan — Hunting Line
								Description: A fully reflected comet restores 4 Ultimate Energy instead of 3.
							}

							Denebola: {
								Name: Denebola — Tail of Dawn
								Description: The Ultimate gravity field lasts 2 seconds longer.
							}

							Alterf: {
								Name: Alterf — Roaring Crown
								Description: Stealth Lion Head damage increases by 25% and releases 18 reflective meteors.
							}

							Subra: {
								Name: Subra — Forepaw Comet
								Description: A charged large meteor deals 20% more damage.
							}
						}
					}
				}
			}
		}

		Projectiles: {
			LeonidProgenitor: {
				LeonidCometSmall.DisplayName: Small Meteor
				LeonidReflectiveMeteor.DisplayName: Reflective Meteor
				LeonidCometLarge.DisplayName: Large Meteor
				LeonidLionHead.DisplayName: Roaring Lion Head
				LeonidGravityField.DisplayName: Leonid Echo Gravity Field
				LeonidUltimateUI.DisplayName: Ultimate Energy Bar
				LeonidRightClickHoldout.DisplayName: Leonid Right Click Holdout
				LeonidStealthRainSpawner.DisplayName: Leonid Stealth Rain Spawner
			}
		}

		Buffs: {
			LeonidGravityDebuff: {
				DisplayName: Gravity of Stars
				Description: The gravity field restricts horizontal movement and pulls you down.
			}
		}

		Cooldowns.LeonidEX: Leonid Ultimate Energy
	}
}

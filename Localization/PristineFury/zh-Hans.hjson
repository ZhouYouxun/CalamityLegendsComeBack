Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendPristineFury: {
					DisplayName: 纯元：传奇归来
					PristineFuryIntro: "[c/FF9340:当前印记：{0}。]"
					RightClick: "[c/FFB066:临时调试：右键按顺序切换印记。原右键散射只是在代码中注释掉，没有删除。]"
					Hook: "[c/9AEAFF:同时按住左键与右键 3 秒会发射提取钩。有效 Boss 会授予对应印记；其他敌人会承受高额钩爪伤害。]"
					Left_Idle: "[c/FF9340:左键：短距纯元火舌，枪口只使用高级粒子绽放。]"
					Left_EvilT2: "[c/D246EB:左键：邪恶双螺旋火流，紫黑烟缎与星脉交织并附加脑腐。]"
					Left_SlimeGod: "[c/BC4EFF:左键：五枚过载电容弹追踪弹跳，每次反弹都爆出紫色弧光。]"
					Left_HardMode: "[c/FF8E42:左键：血肉墙压力锥，三道橙红冲击吐息逐层膨胀穿透。]"
					Left_Prime: "[c/FFCE5C:左键：机械齿轮式金焰喷流，火花按齿距跳步咬合。]"
					Left_BrimstoneElemental: "[c/F63740:左键：蓄能后释放硫火烙印光矛，红黑烬痕沿轴线撕开。]"
					Left_FakeCalamity: "[c/FF4236:Left Click: FakeCalamity six-shot scatter burst.]"
					Left_Plantera: "[c/5EF26C:左键：按住蓄能，松开发射四枚野火花孢，花纹缠绕并追踪。]"
					Left_Aurora: "[c/7ED2FF:左键：星辉极光雾带，以五段折返轨迹旋转燃烧。]"
					Left_Goliath: "[c/8BF249:左键：瘟疫群息会脱落蜂群子弹，感染目标并在死亡时释放虫群。]"
					Left_Moonlord: "[c/7E9CFF:左键：月亮领主综合色焰，轮换日耀、星云、星旋与星尘粒子语法。]"
					Left_Providence: "[c/FFDC76:左键：亵渎净焰迫击弹落地后展开持续灼烧圣域。]"
					Left_Polterghast: "[c/D288FF:左键：哈雷幽魂星火先漂移再苏醒追踪，死亡时绽开鬼火玫瑰。]"
					Left_Dog: "[c/6049D6:左键：光切虚空流撕开延迟裂隙与黑色吸积盘。]"
					Left_ExoTwins: "[c/4AFFB4:左键：阿尔忒弥斯预警激光快速贯穿，随后三连发阿波罗导弹。]"
					Left_ExoThanatos: "[c/66A2FF:左键：三道塔纳托斯预警线缓慢收束，最终释放灭绝激光并撕出侧向激光。]"
					Left_ExoAres: "[c/FF4C40:左键：阿瑞斯式普通激光从枪口高速全自动连射。]"
					Left_Dragon: "[c/FF6C32:左键：丛林龙式十八连扇形龙息，命中后分裂为压力余烬。]"
					Tooltip: "[GFB]"
					LegendaryHint: "[c/BABABA:按住 Shift 键以读取记录]"
					LegendaryText:
						'''
						[c/FF9340:纯元不再只作为一把武器燃烧。]
						[c/FFB066:它记录钩爪锚定过的压力、恶意、神性、瘟疫与不可能的饥饿。]
						[c/9AEAFF:枪管会把这些轨迹作为印记保存，再将它们重新吐回世界。]
						'''
				}
			}
		}


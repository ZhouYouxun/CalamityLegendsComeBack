Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendSHPC: {
					DisplayName: SHPC - Return of Legends
					SHPC_LeftIntro:
						'''
						[c/66CCFF:Left Click: Fires an energy sphere.]
						[c/FFD966:Materials in your inventory can be loaded; loaded materials multiply the left-click base damage and may provide different capacities.]
						[c/99CCFF:Automatically reloads once the current charge is depleted.]
						[c/AAAAAA:Can still fire without any loaded material, but only as a default white orb; its multiplier and blast radius improve with progression.]
						[c/99CCFF:Right-click the item in your inventory to purge the current load, with a chance to recover the material.]
						[c/DDA0FF:Current loaded effect:]
						'''
					SHPC_RightIntro1:
						'''
						[c/66CCFF:Right Click: Hold to fire a precise laser barrage.]
						[c/FFB347:Current form: Heat I. Sustained fire builds heat; once filled, output can continue briefly before forced shutdown.]
						[c/DDA0FF:Left click while firing to manually vent heat, fire 3 energy orbs, and remove one heat level.]
						'''
					SHPC_RightIntro2:
						'''
						[c/66CCFF:Right Click: Hold to fire a precise laser barrage.]
						[c/FFB347:Current form: Heat II. A secondary beam is added beside the main beam with slight deviation and spiral lateral offset.]
						[c/99CCFF:At Heat II, beams can pierce 3 enemies and lose a little damage after each pierce.]
						[c/DDA0FF:Left click while firing to manually vent heat, fire 3 energy orbs, and remove one heat level.]
						'''
					SHPC_RightIntro3:
						'''
						[c/66CCFF:Right Click: Hold to fire a precise laser barrage.]
						[c/FFB347:Current form: Heat III. Secondary beams can create a small thermal blast on first hit, while the main beam can create a medium thermal blast on first hit.]
						[c/DDA0FF:Left click while firing to manually vent heat, fire 3 energy orbs, and remove one heat level.]
						'''
					SHPC_RightIntro4:
						'''
						[c/66CCFF:Right Click: Hold to fire a precise laser barrage.]
						[c/FFB347:Current form: Heat IV. A second secondary beam is added; thermal blast chance rises and can still trigger after piercing.]
						[c/FF7043:Heat IV suppresses life regeneration and continuously burns the user.]
						[c/DDA0FF:Left click while firing to manually vent heat, fire 3 energy orbs, and remove one heat level.]
						'''
					SHPC_RightIntro5:
						'''
						[c/66CCFF:Right Click: Hold to fire a precise laser barrage.]
						[c/FFB347:Current form: Heat V. Beams gain infinite piercing and bonus damage based on the target's maximum life.]
						[c/FF7043:Heat V rapidly drains the user's life.]
						[c/DDA0FF:Left click while firing to manually vent heat, fire 3 energy orbs, and remove one heat level.]
						'''
					SHPC_Final: "[c/99B3FF:The system remains in evolution. Its flaws are not yet resolved, yet its potential endures. Perhaps one day, it will reach true completion.]"
					SHPC_EXHint:
						'''
						[c/66CCFF:When enemies are nearby, each left-click shot grants 1 ultimate energy, up to 60.]
						[c/FFD966:Once fully charged, press [{0}] to activate the ultimate mode.]
						[c/FF7043:After a brief charge, unleash a colossal laser that pierces through everything.]
						'''
					SHPC_EXDisabledHint: "[c/9A9A9A:Golden Emblem is not equipped. The ultimate is disabled.]"
					SHPC_AmmoWheelHint: "[c/F7D87C:Hold [{0}] to open the material wheel; release over a sector to load that material.]"
					Tooltip: "[GFB]"
					TooltipGFB: Have you finally arrived here?
					LegendaryHint: "[c/BABABA:Hold Shift to access the record]"
					LegendaryText:
						'''
						[c/66E6FF:The initial design relied too heavily on a single energy source, and was ultimately deemed unstable.]
						[c/66E6FF:The revised system no longer depends on souls; any material with sufficient energy density is now viable.]
						[c/66E6FF:Different inputs produce drastically varied responses, with some combinations exhibiting anomalous amplification.]
						[c/66E6FF:The control system was redesigned accordingly, forcing premature release before full containment.]
						[c/66E6FF:In theory, this device is no longer limited by ammunition type, yet its true limits remain unknown.]
						[c/66E6FF:In barrage mode, all prior reliance on soul-based energy has been eliminated, replaced by a more primitive thermal drive.]
						[c/66E6FF:To stabilize output, the cooling system was redefined, giving rise to new thermal instability effects.]
						[c/66E6FF:With continued operation, the system will inevitably enter an overheat state, trading safety for greater output efficiency.]
						[c/66E6FF:Without timely intervention, this optimization will ultimately consume the operator.]
						'''
				}

				SHPCBook: {
					DisplayName: SHPC Material Manual
					Tooltip: Left click opens the SHPC material index. Right click opens the right-click heat system index.
				}
			}
		}

		TheSpecialText: {
			SHPCAmmoWheelHover: "{0} - {1} shots"
			SHPCBookNoRecords: No registered SHPC material records.
			SHPCBookMissingEffect: No effect record
		}

		AMMO: {
			SHPCAmmoPrompt: This item can be used to charge SHPC. Effect:
			SHPCAmmoPanel: Left-click displayed multiplier: {0}x; load capacity: {1} shots
			SHPCAmmo1: Energy Core makes the orb bounce while scattering dense electric sparks along its path.
			SHPCAmmo2: Stormlion Mandible releases five chaining lightning arcs that jump through enemy groups.
			SHPCAmmo3: Sulphuric Scale bursts into corrosive sulphur mist when the orb hits the ground.
			SHPCAmmo4: Purified Gel splits into two pursuing energy orbs when its charge is spent.
			SHPCAmmo5: Essence of Havoc is pulled by extreme gravity and deals stronger damage while falling.
			SHPCAmmo6: Essence of Eleum creates a cryogenic zone that suppresses enemies near the detonation.
			SHPCAmmo7: Essence of Sunlight opens a burst relay at the blast point and rapidly fires seven faintly homing sunlight lasers.
			SHPCAmmo8: Starblight Soot directly scatters star souls that create medium explosions and inflict Astral Infection.
			SHPCAmmo9: Soul of Light summons high-damage light souls to orbit the orb and bombard nearby targets.
			SHPCAmmo10: Soul of Night releases shadow souls that automatically hunt nearby enemies.
			SHPCAmmo11: Soul of Flight rises skyward before diving back down in an aerial bombardment.
			SHPCAmmo12: Soul of Fright leaves lingering terror souls that hover and hunt around the blast point.
			SHPCAmmo13: Soul of Might releases three delayed explosive energy orbs.
			SHPCAmmo14: Soul of Sight makes the final explosion grow stronger the longer the orb flies.
			SHPCAmmo15: Living Shard tracks enemies and attempts to convert its power into healing.
			SHPCAmmo16: This material slot is not connected to an available item and provides no charge effect.
			SHPCAmmo17: Depth Cells forms an abyssal orb that falls from above and detonates.
			SHPCAmmo18: Plague Cell Canister marks a target and triggers a plague-like nuclear burst.
			SHPCAmmo19: Ashes of Calamity pours out crimson souls and turns the blast zone into a burning hazard.
			SHPCAmmo20: Beetle Husk is reserved for a future SHPC effect and is not implemented yet.
			SHPCAmmo21: Solar Fragment fires a volley of piercing solar lances from the blast point.
			SHPCAmmo22: Vortex Fragment releases escort missiles during flight to intercept nearby enemies.
			SHPCAmmo23: Nebula Fragment summons a hunting star that charges before exploding.
			SHPCAmmo24: Stardust Fragment splits into cell projectiles that keep spreading the attack.
			SHPCAmmo25: Meld Blob creates a dark blast that pulls visible enemies into its center.
			SHPCAmmo26: Unholy Essence releases a violent directional shockwave after striking tiles.
			SHPCAmmo27: This material slot is not connected to an available item and provides no charge effect.
			SHPCAmmo28: Divine Geode refracts several sacred geometric lasers when it detonates.
			SHPCAmmo29: Bloodstone Core spends player health to empower itself, then restores life after the explosion.
			SHPCAmmo30: Ruinous Soul awakens deep spirits that steadily close in on enemies.
			SHPCAmmo31: Necroplasm creates chained soul bursts that jump between enemies.
			SHPCAmmo32: Dark Plasma generates a miniature dark core that pulls enemies inward before rupturing.
			SHPCAmmo33: Twisting Nether unfolds void blades that carve repeated crossing paths through a target.
			SHPCAmmo34: Endothermic Energy ricochets through the air and splits into piercing ice spikes.
			SHPCAmmo35: Nightmare Fuel divides into nightmare arcs that keep cutting through struck enemies.
			SHPCAmmo36: Ascendant Spirit Essence summons many small star needles for area suppression.
			SHPCAmmo37: Yharon Soul Fragment brands enemies with explosive dragonfire.
			SHPCAmmo38: Exo Prism fires judgment lasers and follows with fractal geometry attacks.
			SHPCAmmo39: Ashes of Annihilation locks onto visible enemies and unleashes a wide annihilation strike.
			SHPCAmmo40: Armored Shell fires a large swarm of electromagnetic orbs to form a sustained storm.
			SHPCAmmo41: Pearl Shard releases three large pearls that split into accelerating homing pearls.
			SHPCAmmo42: Darksun Fragment creates an eclipsed black sun, uses its eight-frame material guide, and stacks into sustained pressure.
			SHPCAmmo43: Cynosure fires a heavy armor-piercing round that ruptures into electromagnetic lightning, two auric-orb ellipses, and an outer charged-cell ring.
			SHPCAmmo44: Core of Calamity fires a wide gray energy stream that ruptures into four curving, homing fragments.
		}


Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Melee: {
					CosmicDischarge: {
						DisplayName: 寒宙弹刃
						Tooltip: ""
					}
				}

				NewLegendCosmicDischarge: {
					DisplayName: 寒宙弹刃-传奇归来
					Tooltip: "[GFB]"
					WhipName: 鞭形态
					SwordName: 剑形态
					ChainKnifeName: 弧斩形态
					UltimateActiveText: 冰河时代!
					CosmicDischargeLeft:
						'''
						[c/8DEBFF:左键：根据当前形态释放三连击。命中时施加”冰霜印记”(持续5秒)。]
						[c/8DEBFF:鞭形态：从上下甩出并突刺。击中时施加印记。在冰皇形态下，将同时自上方与下方挥舞双重鞭刃，进行双重打击。]
						[c/8DEBFF:剑形态：两次挥舞与一次砸击。攻击带有印记的敌人会引爆印记，造成1.4倍最终伤害并向外散射8枚寒冰飞弹(冰皇形态下为12枚)。]
						[c/8DEBFF:弧斩形态：挥动铁链进行大范围弧形斩击。命中时引爆冰霜印记；弧顶释放寒冰飞弹。在冰皇形态下，攻击范围与飞弹数量提升。]
						'''
					CosmicDischargeRight:
						'''
						[c/6FDFFF:右键：循环切换左键的形态（鞭子 -> 剑 -> 弧斩）。]
						[c/6FDFFF:第三段前摇期间右键：触发寒芒出鞘，直接刺出并快速抽回弹刃。只有寒芒出鞘会提供10点终结技能量。]
						'''
					CosmicDischargeUltimate:
						'''
						[c/FFE85A:终结技：能量达到120后按] [[c/FFE85A:{0}]] [c/FFE85A:，给予25格内敌怪10秒冰河时代，并在玩家身上生成10秒力场。]
						[c/FFE85A:力场：8格内敌怪被高额减速；玩家受到伤害-35%，防御+20。力场存在期间无法获得终结技能量。]
						'''
					CosmicDischargePassive: '''[c/B8F4FF:寒宇冰封：] [c/DCD6C8:手持时，单次伤害超过最大生命值20%的部分将被削减至上限。触发时获得5秒"寒风再起"（伤害+20%），冷却60秒。]'''
				}
			}
		}

		Buffs: {
			CosmicDischargeIceboundBuff: {
				DisplayName: 冰固免死
				Description: 致死伤害被压制，生命再生大幅提高。
			}

			CosmicDischargeFrostwindRevivalBuff: {
				DisplayName: 寒风再起
				Description: 寒冷打破极限，伤害提升20%。
			}

			CosmicDischargeUltimateGuardBuff: {
				DisplayName: 寒宙力场
				Description: 受到伤害降低，防御提高。
			}

			CosmicDischargeFrostMarkDebuff: {
				DisplayName: 冰霜印记
				Description: 被寒宙标记，特定攻击会引爆印记。
			}

			CosmicDischargeFrozenEmperorBuff: {
				DisplayName: 冰皇形态
				Description: 伤害、机动、防御、伤害减免与近战攻速提高。
			}

			CosmicDischargeFrozenEmperorSliverBuff: {
				DisplayName: 冰皇残辉
				Description: 伤害与防御小幅提高。
			}
		}

		Projectiles: {
			Melee: {
				CosmicDischargeSwordWave.DisplayName: 寒宙剑气
				CosmicDischargeIceBomb.DisplayName: 寒宙冰炸弹
				CosmicDischargeUltimateField.DisplayName: 寒宙力场
				// CosmicDischargeChainKnife.DisplayName: Cosmic Discharge Chain Knife

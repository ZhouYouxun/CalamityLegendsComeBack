Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendBrinyBaron: {
					DisplayName: 海爵剑-传奇归来
					Tooltip: "[GFB]"
					BB_Left:
						'''
						[c/66CCFF:左键：以稳定的单向节奏连续挥斩。]
						[c/7F8FA6:连段按 A-B-A-B-C 循环：潮锋波、三枚旋水刃、潮锋波、三枚旋水刃、龙卷召唤器。]
						[c/99CCFF:龙卷召唤器命中后会释放风暴泡，并在周围随机散布数个 50×50 的水爆炸。]
						[c/4FAEFF:每层潮汐提高 3% 武器伤害；潮汐每 5 秒自动回复 1 层，剑刃命中敌人也会回复 1 层。]
						[c/99CCFF:剑身近距离命中时，只会在伤口处卷起灾厄海爵同源的风暴泡。]
						[c/DDA0FF:潮锋波会减速并释放蓝色追踪光球；潮汐满层时手里剑才会进入追踪模式。]
						[c/FFB347:持续按住左键时，挥砍大小与节奏保持一致并循环推进。]
						'''
					BB_Tide: "[c/4FAEFF:当前潮汐值：]"
					BB_Right:
						'''
						[c/66CCFF:右键：消耗 1 层潮汐向前突进；没有潮汐时无法发动。]
						[c/4FAEFF:冲刺命中敌人或撞到方块时回复 1 层潮汐，并从下方向上喷出多条水柱。]
						[c/7F8FA6:按住左键时再按住右键，会将剑势转为环身旋舞。]
						[c/DDA0FF:转盘会随持续时间加速；只有达到满速后，才会向周围撒出潮刃。]
						[c/FFB347:低速旋舞用于蓄势，完成转速后才真正压制近身区域。]
						'''
					Dash1_Unlock: "[c/66FFAA:已解锁：基础突进]"
					Dash1_Lock: "[c/7F8FA6:暂未解锁，需击败克苏鲁之眼]"
					Dash2_Unlock: "[c/66FFAA:已解锁：回旋切割]"
					Dash2_Lock: "[c/DDA0FF:暂未解锁，需击败血肉之墙]"
					Dash3_Unlock: "[c/66FFAA:已解锁：快刀斩]"
					Dash3_Lock: "[c/99CCFF:暂未解锁，需击败血肉之墙]"
					BB_Passive: "[c/9AEF9E:快刀斩被动：{0}。{1}背包右键可切换。]"
					PassiveStateOn: "[c/7BFFB7:开启]"
					PassiveStateOff: "[c/F0D070:关闭]"
					PassiveDevice_None: "[c/7F8FA6:当前未读取到盾冲设备。]"
					PassiveDevice_OrnateShield: "[c/99CCFF:当前佩戴华丽护盾；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_DeepDiver: "[c/99CCFF:当前佩戴深渊潜游者；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_AsgardsValor: "[c/99CCFF:当前佩戴阿斯加德英勇；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_ElysianAegis: "[c/99CCFF:当前佩戴极乐之庇护；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_AsgardianAegis: "[c/99CCFF:当前佩戴阿斯加德之庇护；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					Dash4_Unlock: "[c/66FFAA:已解锁：潮狱处刑]"
					Dash4_Lock: "[c/FFB347:暂未解锁，需击败猪鲨公爵]"
					BB_Final: "[c/9FD8A2:潮汐满溢时，按传奇技能键锁定猎物，再以左键宣判，直至目标被潮锋反复处刑。]"
					LegendaryHint: "[c/6C8EFF:按住Shift键以读取记录]"
					LegendaryText:
						'''
						[c/66CCFF:潮汐被灌满的那一刻，整把剑才真正开始狩猎。]
						[c/7F8FA6:它先沿着鼠标搜寻最值得处刑的目标，再把整片战场一并拖入判决。]
						[c/99CCFF:锁定一旦完成，逃跑与换位都只是把死亡的角度改得更难看。]
						[c/DDA0FF:左键落下的瞬间，持剑者会从目标周围反复现身，将其穿透、回斩、再度现身。]
						[c/FFB347:最后留下的印记不会立刻散去，它会贴着猎物继续书写余下的处刑。]
						[c/66CCFF:当海潮终于退下时，敌人与路径上的旁观者往往已经一起碎裂。]
						'''
				}
			}

			BBTest: {

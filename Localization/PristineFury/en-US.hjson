Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendPristineFury: {
					DisplayName: Pristine Fury - Return of Legends
					PristineFuryIntro: "[c/FF9340:Current imprint: {0}.]"
					RightClick: "[c/FFB066:Temporary debug: Right Click cycles imprints in order. The original scatter barrage is commented out in code, not removed.]"
					Hook: "[c/9AEAFF:Hold Left + Right for 3 seconds to launch the extraction hook. Valid bosses grant their imprint; other enemies take heavy hook damage.]"
					Left_Idle: "[c/FF9340:Left Click: compact ember jet with particle-only muzzle bloom.]"
					Left_EvilT2: "[c/D246EB:Left Click: corrupt twin-helix flame that braids violet smoke, star pulses, and Brain Rot.]"
					Left_SlimeGod: "[c/BC4EFF:Left Click: five overloaded bolts arc toward targets and ricochet as violet capacitor bursts.]"
					Left_HardMode: "[c/FF8E42:Left Click: three Wall-pressure cones inflate into orange shock breath and searing waves.]"
					Left_Prime: "[c/FFCE5C:Left Click: gear-toothed gold firestream with stepping cinders and mechanical spark teeth.]"
					Left_BrimstoneElemental: "[c/F63740:Left Click: charge, then lance out a brimstone smear beam with red brand geometry.]"
					Left_Plantera: "[c/5EF26C:Left Click: hold and release four wild-bloom spores that weave, heal, and home through petal runes.]"
					Left_Aurora: "[c/7ED2FF:Left Click: aurora ribbon fog turns in five-point astral bends and stains enemies with starlight.]"
					Left_Goliath: "[c/8BF249:Left Click: blight cloud breath sheds plague swarmlets and infects targets for death-release bursts.]"
					Left_Moonlord: "[c/7E9CFF:Left Click: chromatic lunar fire cycles solar, nebula, vortex, and stardust particle grammars.]"
					Left_Providence: "[c/FFDC76:Left Click: profaned cleansing mortar blooms into a stationary consecrated fire field.]"
					Left_Polterghast: "[c/D288FF:Left Click: Halley-soul stars drift, awaken, and chase in violet spectral rose patterns.]"
					Left_Dog: "[c/6049D6:Left Click: Photoviscerator void stream tears delayed rifts and black accretion disks.]"
					Left_Dragon: "[c/FF6C32:Left Click: Yharon-style 18-pellet fan that splits into pressure cinders on impact.]"
					Tooltip: "[GFB]"
					LegendaryHint: "[c/BABABA:Hold Shift to access the record]"
					LegendaryText:
						'''
						[c/FF9340:Pristine Fury no longer burns as one weapon.]
						[c/FFB066:It records the pressure, malice, divinity, plague, and impossible hunger of anything its hook can anchor.]
						[c/9AEAFF:The barrel remembers those patterns as imprints, then exhales them back into the world.]
						'''
				}
			}
		}


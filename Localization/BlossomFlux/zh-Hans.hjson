Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendBlossomFlux: {
					DisplayName: 叶流 - 传奇归来
					Tooltip: "[GFB]"
					BF_Intro:
						'''
						[c/7BE495:当前战术：{0}]
						[c/F7D87C:右键长按：进入当前战术的蓄力姿态，松开后释放特殊箭。]
						'''
					PresetName0: 突击
					PresetName1: 复苏
					PresetName2: 侦察
					PresetName3: 歼灭
					PresetName4: 侵染
					PresetLeft0:
						'''
						[c/8BE89A:左键 - 突击：将木箭转化为快速叶枝箭。]
						[c/8BE89A:直线穿透射击，适合持续压制。]
						'''
					PresetLeft1:
						'''
						[c/70E0D0:左键 - 复苏：发射双链交错的叶弹。]
						[c/70E0D0:命中可治疗玩家，并准备绿叶防护。]
						'''
					PresetLeft2:
						'''
						[c/66CCFF:左键 - 侦察：发射追踪侦察箭齐射。]
						[c/66CCFF:侦察箭会重读目标，并在飞行中加速。]
						'''
					PresetLeft3:
						'''
						[c/FFA07A:左键 - 歼灭：将木箭转化为坠落箭雨。]
						[c/FFA07A:转化箭命中爆炸，其他箭矢正常发射。]
						'''
					PresetLeft4:
						'''
						[c/DDA0FF:左键 - 侵染：发射削弱防御的收割者。]
						[c/DDA0FF:重复命中会刷新污染，持续压低目标防御。]
						'''
					PresetRight0:
						'''
						[c/FFB347:右键 - 突击：按住装填强化叶枝箭。]
						[c/FFB347:松手后，将储存箭矢高速射出。]
						'''
					PresetRight1:
						'''
						[c/FFB347:右键 - 复苏：按住凝聚大范围复苏闪光。]
						[c/FFB347:松手治疗玩家，但不会提供绿叶防护。]
						'''
					PresetRight2:
						'''
						[c/FFB347:右键 - 侦察：按住发射无重力标记箭。]
						[c/FFB347:最高生命目标被标记后，会承受更高左键伤害。]
						'''
					PresetRight3:
						'''
						[c/FFB347:右键 - 歼灭：按住布置准星并发射引导箭。]
						[c/FFB347:打击会从空中坠落，在标记处爆炸。]
						'''
					PresetRight4:
						'''
						[c/FFB347:右键 - 侵染：按住发射大型孢子云。]
						[c/FFB347:孢子云会永久削弱被命中的敌人。]
						'''
					PresetPassive0:
						'''
						[c/B7FFB0:战术被动 - 突击：获得无无敌帧的高速冲刺；已有冲刺的冷却减半。]
						[c/B7FFB0:冲刺后 0.75 秒内，叶流伤害提高 20%。]
						'''
					PresetPassive1:
						'''
						[c/B7FFB0:战术被动 - 复苏：免疫防御损伤，大幅扩大红心拾取范围。]
						[c/B7FFB0:减益造成的生命流失减半；单次伤害超过最大生命值 30% 时，超出部分减半。]
						'''
					PresetPassive2:
						'''
						[c/B7FFB0:战术被动 - 侦察：免疫移速降低，移动速度 +25%，加速度 +100%，飞行时间 +50%。]
						[c/B7FFB0:钩爪发射、回收和牵引速度 +30%；钩中平台或斜坡后，抵达钩点会自动松钩。]
						'''
					PresetPassive3:
						'''
						[c/B7FFB0:战术被动 - 歼灭：根据屏幕内敌人数量提升射速。]
						[c/B7FFB0:屏幕内有 5/10/20 个敌人时，叶流使用时间和左键循环延迟 -1/-2/-3。]
						'''
					PresetPassive4:
						'''
						[c/B7FFB0:战术被动 - 侵染：叶流攻击会延长目标身上已有的任何减益。]
						[c/B7FFB0:任意敌人身上的减益以一半速度流逝。]
						'''
					BF_Passive:
						'''
						[c/9AEF9E:被动 - 终末防线：手持时抵消一次致命伤害。]
						[c/9AEF9E:触发后获得短暂无敌与治疗。当前：{0}]
						'''
					PassiveStateReady: "[c/7BFFB7:已就绪]"
					PassiveStateActive: "[c/FF9B8B:终末防线中]"
					PassiveStateCooldown: "[c/F0D070:充能 {0}/{1} 秒]"
					PassiveStateLocked: "[c/9A9A9A:困难模式后解锁]"
					BF_EXHint:
						'''
						[c/8EF5A8:大招：手持开火与右键攻击会积蓄森绿能量。]
						[c/8EF5A8:充满后按下] [[c/8EF5A8:{0}]] [c/8EF5A8:释放森绿箭幕。]
						'''
					BF_EXDisabledHint: "[c/9A9A9A:当前未佩戴黄金饰章，大招将被禁用。]"
					BF_FormWheelHint: "[c/F7D87C:按住] [[c/F7D87C:{0}]] [c/F7D87C:打开战术轮盘，松手切换。]"
					// BF_Final: "[c/9FD8A2:The bowstring hums, and the forest answers.]"
					LegendaryHint: "[c/BABABA:按住 Shift 阅读完整传奇记录]"
					LegendaryText:
						'''
						[c/66E6FF:最初，它只是一场追求更快连射的尝试。]
						[c/66E6FF:后来制作者意识到，速度不是答案。]
						[c/66E6FF:同一根弓弦必须学会五种呼吸方式。]
						[c/66E6FF:于是战术拆分为五条枝流。]
						[c/66E6FF:即便是普通木箭，也会在离弦后改变形态。]
						[c/66E6FF:它仍会继续生长，但节奏已经成形。]
						[c/66E6FF:等待、松弦，然后让战术回应。]
						'''
				}
			}

			BFSpareQuiver: {
				DisplayName: 备用箭袋
				Tooltip:
					'''
					远程伤害 +8%，防御力 +4
					所有叶流右键蓄力时间 ×0.90
					突击右键最大装填 +1，复苏治疗闪光 +1，侦察右键标记时间小幅提高。
					'''
			}

			BFTunedQuiver: {
				DisplayName: 同调箭袋
				Tooltip:
					'''
					远程伤害 +11%，远程暴击率 +6%
					所有叶流右键蓄力时间 ×0.80
					突击右键最大装填 +2，复苏治疗闪光 +2，侦察右键标记时间提高，歼灭右键爆炸范围提高。
					'''
			}

			BFResonatingQuiver: {
				DisplayName: 共鸣箭袋
				Tooltip:
					'''
					远程伤害 +14%，远程护甲穿透 +12
					所有叶流右键蓄力时间 ×0.65
					突击右键最大装填 +4，复苏治疗闪光 +3，侦察右键标记时间大幅提高，歼灭右键弹幕伤害提高，侵染解锁第一批高级 Debuff。
					'''
			}

			BFDominationQuiver: {
				DisplayName: 主宰箭袋
				Tooltip:
					'''
					远程伤害 +18%，远程暴击率 +8%
					所有叶流右键蓄力时间 ×0.50
					突击右键最大装填 +6，复苏治疗闪光 +4，侦察右键标记时间达到最高，歼灭右键弹幕伤害与范围提高，侵染解锁全部高级 Debuff。
					'''
			}

			PastLingering: {
				DisplayName: 旧日残影
				Tooltip:
					'''
					将“突击”战术改变为类似于幻影弓的模式
					箭矢不再被转化，并在命中敌人时释放出强追踪幻影。
					持续射击会逐渐提升攻击速度。
					'''
			}

			SwordsplosionQuiver: {
				DisplayName: 爆破剑箭袋
				Tooltip:
					'''
					将歼灭战术从天而降的弹幕替换为爆破剑彩剑雨。
					每把彩剑只能造成一次伤害。
					'''
			}

			BlightSpewerQuiver: {
				DisplayName: 枯萎散播者箭袋
				Tooltip:
					'''
					将侵染战术左键替换为枯萎散播者的瘟疫火焰。
					保留叶流自身的基础侵染效果。
					'''
			}

			SeedOfSilva: {
				DisplayName: 席尔瓦之种
				Tooltip:
					'''
					生成五枚缓慢围绕玩家旋转并发出微弱绿光的种子。
					手持叶流时，种子会根据当前战术绽放成不同的花朵。
					突击：向日葵
					向日葵会创造一个小区域。穿过该区域的突击箭获得 30% 伤害加成和 15% 暴击率加成。
					复苏：雏菊
					雏菊拥有 15 点最大生命值，每秒恢复 1.2 生命值，并继承玩家的防御和伤害减免。
					如果雏菊承受 20 点或更多伤害，它会为玩家治疗其存储的生命恢复量（向下取整）。
					侦察：飞燕草
					飞燕草每 1.5 秒用弧光攻击附近的敌人一次，造成轻微伤害并眩晕 1秒。
					被眩晕的敌人会大幅减速，且受到来自侦察箭的双倍伤害。
					免疫击退的敌人只获得伤害加成，且降至 1.15 倍。
					每次飞燕草成功造成眩晕，都会恢复 0.5 秒的飞行时间。
					歼灭：火炬花
					当敌人接近时，火炬花会喷射火焰。
					穿过火炬花的箭矢也会触发一次有独立冷却时间的爆炸。
					侵染：曼陀罗
					曼陀罗会减速附近的敌人，并使其接触伤害降低 15%。
					曼陀罗会像孢子囊一样持续产生孢子，每个孢子施加 3 秒的减益。其上限跟随当前武器。
					曼陀罗还会偶尔发射追踪的毁灭性花朵弹幕，使敌人瘫痪并减速。
					'''
			}

			SilvaHarp: {
				DisplayName: 席尔瓦竖琴
				Tooltip:
					'''
					每秒生命恢复 +5。此生命恢复不受任何因素削弱。
					受击后的无敌时间增加 60 帧。
					与叶流的终末防线共存，但不再改变复活持续时间或冷却规则。
					'''
			}

			BFArrowRest: {
				DisplayName: 战术箭台
				Tooltip:
					'''
					佩戴后，叶流的突击与歼灭战术会将木箭转化为自身弹幕，其余箭矢正常发射。
					不佩戴时，突击与歼灭无论使用任何箭矢，均直接发射自身弹幕。
					复苏、侦察与侵染战术不受影响，始终射出定制弹幕。
					'''
			}
		}


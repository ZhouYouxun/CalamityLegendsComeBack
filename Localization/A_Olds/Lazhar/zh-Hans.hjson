Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Lazhar: {
					DisplayName: 拉扎尔射线
					Tooltip:
						'''
						左键释放快速的三连发金色拉扎尔射线，射线会自动追踪敌人，造成极高的单体伤害
						右键发射一枚锁定信标，击中敌怪后使其进入“雷达锁定”状态
						攻击被锁定的敌怪时，射线伤害提升50%并会绝对追踪目标，同时从天空召唤轨道卫星射线进行轰炸
						“精致的手握武器，发射致命的聚焦光流”
						'''
				}
			}
		}

		Buffs: {
			LazharTargetDebuff: {
				DisplayName: 雷达锁定
				Description: 你被轨道激光和追踪射线锁定了！
			}
		}
	}
}

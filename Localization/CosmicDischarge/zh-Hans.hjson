				// CosmicDischargeScytheProjectile.DisplayName: Cosmic Discharge Scythe Projectile
			}
		}

		Cooldowns: {
			CosmicDischarge_Ultimate: 寒芒能量
			CosmicDischarge_Icebound: 寒宇冰封
			CosmicDischarge_QuickDraw: 寒芒出鞘
		}
	}
}

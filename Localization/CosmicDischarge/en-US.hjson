Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Melee: {
					CosmicDischarge: {
						DisplayName: Cosmic Discharge
						Tooltip: ""
					}
				}

				NewLegendCosmicDischarge: {
					DisplayName: Cosmic Discharge - Legend Reborn
					Tooltip: "[GFB]"
					WhipName: Whip Mode
					SwordName: Sword Mode
					ChainKnifeName: Chain Blade Mode
					UltimateActiveText: Glacial Age!
					CosmicDischargeLeft:
						'''
						[c/8DEBFF:Left click: performs a three-hit combo in the current form. Hits apply a Frost Mark (5s).]
						[c/8DEBFF:Whip form: slashes from above, below, then thrusts forward. Whip hits apply Frost Mark. Under Frozen Emperor, swings dual whips simultaneously from both directions.]
						[c/8DEBFF:Sword form: sweeps twice and slams. Striking a target with Frost Mark detonates it, dealing 1.4x damage and launching 8 radial ice bolts (12 under Frozen Emperor).]
						[c/8DEBFF:Chain Blade form: sweeps the chain in a wide arc. Detonates Frost Marks on contact; releases ice bolts at the arc's peak. Under Frozen Emperor, reach and bolt count are increased.]
						'''
					CosmicDischargeRight:
						'''
						[c/6FDFFF:Right click: cycles left-click attack forms (Whip -> Sword -> Chain Blade).]
						[c/6FDFFF:During the third hit windup: triggers Frostflash Draw instead, instantly thrusting the blade-chain and rapidly retracting it. Only this attack grants 10 ultimate energy.]
						'''
					CosmicDischargeUltimate:
						'''
						[c/FFE85A:Ultimate: at 120 energy, press] [[c/FFE85A:{0}]] [c/FFE85A: to inflict Glacial State on enemies within 25 tiles and create a 10 second frost field.]
						[c/FFE85A:Frost field: enemies within 8 tiles are heavily slowed; you take 35% less damage and gain 20 defense. Ultimate energy cannot be gained while it exists.]
						'''
					CosmicDischargePassive: "[c/B8F4FF:Voidfrost Seal:] [c/DCD6C8:while held, any single hit that would exceed 20% of your max HP is capped at that value. When triggered, gain 5 seconds of Frostwind Revival (+20% damage). Cooldown: 60 seconds.]"
				}
			}
		}

		Buffs: {
			CosmicDischargeIceboundBuff: {
				DisplayName: Icebound Undying
				Description: Fatal damage is being suppressed and life regeneration is greatly increased.
			}

			CosmicDischargeFrostwindRevivalBuff: {
				DisplayName: Frostwind Revival
				Description: The cold shatters your limits. Damage increased by 20%.
			}

			CosmicDischargeUltimateGuardBuff: {
				DisplayName: Frost Field Guard
				Description: Damage taken is reduced and defense is increased.
			}

			CosmicDischargeFrostMarkDebuff: {
				DisplayName: Frost Mark
				Description: Marked by Cosmic Discharge. Certain attacks can detonate the mark.
			}

			CosmicDischargeFrozenEmperorBuff: {
				DisplayName: Frozen Emperor
				Description: Damage, mobility, defense, damage reduction, and melee attack speed are increased.
			}

			CosmicDischargeFrozenEmperorSliverBuff: {
				DisplayName: Frozen Emperor Sliver
				Description: Damage and defense are slightly increased.
			}
		}

		Projectiles: {
			Melee: {
				CosmicDischargeSwordWave.DisplayName: Cosmic Discharge Frost Wave
				CosmicDischargeIceBomb.DisplayName: Cosmic Discharge Ice Bomb
				CosmicDischargeUltimateField.DisplayName: Cosmic Discharge Frost Field
				CosmicDischargeChainKnife.DisplayName: Cosmic Discharge Chain Knife
				CosmicDischargeComboHoldout.DisplayName: Cosmic Discharge Combo Holdout
				CosmicDischargeEndothermicSplit.DisplayName: Cosmic Discharge Endothermic Split
				CosmicDischargeHookHead.DisplayName: Cosmic Discharge Hook Head
				CosmicDischargeHookLimb.DisplayName: Cosmic Discharge Hook Limb
				CosmicDischargeIceShard.DisplayName: Cosmic Discharge Ice Shard
				CosmicDischargeKillModeReady.DisplayName: Cosmic Discharge Kill Mode Ready
				CosmicDischargeKillModeSlash.DisplayName: Cosmic Discharge Kill Mode Slash
				CosmicDischargeScytheProjectile.DisplayName: Cosmic Discharge Scythe Projectile
			}
		}

		Cooldowns: {
			CosmicDischarge_Ultimate: Frostflash Energy
			CosmicDischarge_Icebound: Voidfrost Seal
			CosmicDischarge_QuickDraw: Frostflash Draw
		}
	}
}

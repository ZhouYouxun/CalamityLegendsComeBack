Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				HyperdimensionalMatrixCore: {
					DisplayName: 高维矩阵
					Tooltip:
						'''
						召唤矩阵核心——一台被实体化的开发引擎
						占用当前全部召唤栏位；每额外占用一个栏位，伤害提高50%
						核心自主循环调用五个攻击模块
						模块 I  · 数据矩阵：运算最优攻击路径，所有亮格同时向目标开火
						模块 II · 几何投影：构建旋转多面体，随后将其引爆为边线碎片弹
						模块 III· Shader实验：释放五个实验体，每个展示不同的着色器效果
						模块 IV · 流体聚合：召唤向中心汇聚的能量球，融合后坍缩爆炸
						模块 V  · 空间扭曲：对大型敌人扭曲周围时空（含全屏后处理效果）
						每900帧核心进入编译风暴——所有模块同时启动，随后释放数据奇点
						防护矩阵提供15防御与15%伤害减免
						"你召唤的不是仆从——你实例化了一个运行时"
						'''
				}
			}
		}

		Buffs: {
			HyperdimensionalMatrixCoreBuff: {
				DisplayName: 矩阵防护场
				Description: 提供15防御与15%伤害减免；核心正在持续重编译战场
			}
		}

		Projectiles: {
			HyperdimensionalMatrixCore: {
				HyperdimensionalMatrixCoreProjectile.DisplayName: 高维矩阵核心
				MatrixDataGridPanel.DisplayName: 数据矩阵面板
				MatrixGridCell.DisplayName: 矩阵格弹幕
				MatrixGeoBurst.DisplayName: 几何爆发体
				MatrixGeoShard.DisplayName: 几何边线碎片
				MatrixShaderOrb.DisplayName: Shader实验体
				MatrixFusionController.DisplayName: 能量聚合核心
				MatrixFusionExplosion.DisplayName: 聚合坍缩
				MatrixSpaceWarpField.DisplayName: 空间扭曲场
				MatrixCompileStorm.DisplayName: 编译风暴
				MatrixSingularity.DisplayName: 数据奇点
			}
		}
	}
}

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Malachite: {
					DisplayName: 孔雀翎
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/7DFF9A:左键：掷出孔雀苦无。]
						[c/7DFF9A:背后若有潜伏苦无，会优先逐发射出。]
						[c/7DFF9A:佩戴清风苦无后不受重力；歌莉娅/月后数量提升。]
						'''
					RightClick:
						'''
						[c/80FFC8:右键：身后积攒右键羽毛。]
						[c/80FFC8:右键会按短间隔全部倾泻。]
						[c/80FFC8:普通右羽不会爆炸，也无潜伏增伤。]
						'''
					StealthStrike:
						'''
						[c/B5FF74:潜伏左键：召出23根孔雀石飞镖。]
						[c/B5FF74:潜伏右键：射出所有右键羽毛。]
						[c/B5FF74:潜伏右羽命中会爆炸并获得强化。]
						'''
					Finale:
						'''
						[c/D6FF9A:大招：满潜伏且冷却结束时按] [[c/D6FF9A:{0}]] [c/D6FF9A:。]
						[c/D6FF9A:聚光锁定自身和近敌，花瓣缓落。]
						[c/D6FF9A:23片花瓣化刃，按距离分配刺向敌人。]
						'''
					Passive:
						'''
						[c/9AFFC8:被动（手持）：]
						[c/9AFFC8:遁入暗影：潜伏攻击只消耗一半潜伏值，并立刻恢复 15 点潜伏值；潜伏值高于 50% 时额外获得 15% 移速加成。]
						'''
					LegendaryHint: "[c/BABABA:按住 Shift 读取记录]"
					LegendaryText: "[c/B5FF74:看似停在影子里，实际上每一根都在等待猎物暴露逃跑的方向。]"
				}
			}

			Accessories: {
				BreezeKunai: {
					DisplayName: 微风苦无
					Tooltip:
						'''
						+10 盗贼潜伏上限
						孔雀翎所有弹幕速度 +8%
						孔雀翎所有苦无 +10 护甲穿透
						'''
				}

				ClearBreezeKunai: {
					DisplayName: 清风苦无
					Tooltip:
						'''
						+15 盗贼潜伏上限
						孔雀翎所有弹幕速度 +12%
						孔雀翎所有苦无 +15 护甲穿透
						孔雀翎左键普通苦无不再受重力影响
						'''
				}

				GaleKunai: {
					DisplayName: 疾风苦无
					Tooltip:
						'''
						+20 盗贼潜伏上限
						孔雀翎所有弹幕速度 +16%
						孔雀翎所有苦无 +25 护甲穿透
						潜伏攻击后额外返还 25% 已消耗潜伏值
						'''
				}

				WillowBlade: {
					DisplayName: 柳叶刀
					Tooltip:
						'''
						+40 盗贼潜伏上限
						孔雀翎所有弹幕速度 +22%
						孔雀翎所有苦无 +50 护甲穿透
						左键孔雀扇与右键羽毛均积满时，"孔雀开屏"：+20% 移速，+2 跳跃速度，+230% 飞行时间
						'''
				}

				PeacockScroll: {
					DisplayName: 孔雀卷轴
					Tooltip:
						'''
						右键羽毛积攒速度翻倍
						背包中有孔雀翎时，未手持也能以同等速度积攒右键羽毛
						右键羽毛速度 +15%，伤害 +20%
						'''
				}

				PrecisionEmblem: {
					DisplayName: 精准徽章（已退役）
					Tooltip: 该饰品已被移除，不再具有任何效果。
				}

				MalachiteFeather: {
					DisplayName: 孔雀石羽毛（已退役）
					Tooltip: 该饰品已被移除，不再具有任何效果。
				}

				GaleAce: {
					DisplayName: 疾风王牌
					Tooltip:
						'''
						允许擦弹：附近的敌人弹幕会触发擦弹效果
						擦弹成功：立即恢复 20% 潜伏值
						并获得 1 层短暂攻击强化（每层 +8% 盗贼伤害，最多叠加 5 层）
						'''
				}

				PeacockBox: {
					DisplayName: 孔雀盒
					Tooltip:
						'''
						孔雀翎在背包中也会积攒右键羽毛
						每60帧积攒1根，满23根后自动发射
						'''
				}

				PeacockDart: {
					DisplayName: 孔雀飞镖
					Tooltip:
						'''
						孔雀翎左键和右键弹幕受重力影响
						这些弹幕造成30%额外伤害
						'''
				}
			}
		}


Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				PlayerSaddleItem: {
					DisplayName: Selle de joueur
					Tooltip:
						'''
						Faites un clic gauche sur un joueur proche pour le chevaucher.
						Pendant que vous le chevauchez, vous ne pouvez pas bouger, mais vous pouvez toujours attaquer et interagir normalement.
						Vous descendez automatiquement si votre monture meurt.
						Faites à nouveau un clic gauche pour descendre, ou un clic droit pour éjecter votre propre cavalier.
						'''
				}
			}
		}

		TheSpecialText: {
			PlayerSaddleNoTarget: Aucun joueur proche à chevaucher n'a été trouvé.
			PlayerSaddleOccupied: Ce joueur a déjà un cavalier.
			PlayerSaddleMounted: "{0} chevauche maintenant {1} !"
		}
	}
}

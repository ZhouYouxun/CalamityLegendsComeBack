Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendBrinyBaron: {
					DisplayName: 海爵剑-传奇归来
					Tooltip: "[GFB]"
					BB_Left_1:
						'''
						[c/66CCFF:左键：连续挥斩。]
						[c/7F8FA6:攻击方式（第1阶段）：每次攻击射出一发海沫与三枚散射角度为5度的海灵。]
						[c/99CCFF:海沫具备类似耀海之剑的星蓝飞行特效；海灵具备较弱的追踪能力，且在前10帧内不造成伤害。]
						[c/4FAEFF:每层潮汐提高 3% 武器伤害；潮汐每 5 秒自动回复 1 层，剑刃命中敌人也会回复 1 层。]
						'''
					BB_Left_2:
						'''
						[c/66CCFF:左键：连续挥斩。]
						[c/7F8FA6:第2阶段 3连段：散射海沫×3 → 快速海灵×6 → 光波。]
						[c/99CCFF:海沫提速1.7倍、体积增1.5倍、穿透增强并有拖尾；光波释放时有充能音效。]
						[c/4FAEFF:真近战命中触发龙卷风；海灵前10帧无伤。]
						'''
					BB_Left_3:
						'''
						[c/66CCFF:左键：连续挥斩。]
						[c/7F8FA6:第3阶段 4连段：并排海沫×5+默认光波 → 散射海灵×10+默认光波 → 手里剑×5+默认光波 → 巨大增强光波。]
						[c/99CCFF:并排海沫速度极快、不追踪但强穿透；巨大增强光波会释放追踪弹幕，前面的默认光波不释放。]
						[c/4FAEFF:真近战命中触发龙卷风；海灵前10帧无伤。]
						'''
					BB_Left_4:
						'''
						[c/66CCFF:左键：连续挥斩。]
						[c/7F8FA6:第4阶段 4连段：并排海沫×5+默认光波 → 散射海灵×10+默认光波 → 手里剑×5+默认光波 → 巨大终极光波。]
						[c/99CCFF:巨大终极光波命中触发龙卷风（5帧冷却）并释放追踪弹幕；真近战命中亦触发龙卷风，并散出高加速正弦海灵。]
						[c/4FAEFF:散出的海灵前20帧正弦扭行后强力追踪，前10帧无伤。默认光波不释放追踪弹幕。]
						'''
					BB_Right_DefaultShuriken:
						'''
						[c/66CCFF:右键：投掷潮汐手里剑（默认）。]
						[c/7F8FA6:手里剑命中后造成伤害，投掷速度随射程调整。]
						'''
					BB_Right_LostGarment:
						'''
						[c/66CCFF:右键（失落外衣）：消耗 1 层潮汐进行风暴突进。]
						[c/7F8FA6:冲刺并在路径上留下一排追踪海沫。]
						'''
					BB_Right_CeruleanShield:
						'''
						[c/66CCFF:右键（蔚蓝护盾）：消耗 1 层潮汐进行强力水流突进。]
						[c/7F8FA6:冲刺并释放水流波纹，命中回复潮汐。]
						'''
					BB_Right_VortexPortal:
						'''
						[c/66CCFF:右键（漩涡传送门）：消耗 1 层潮汐进行传送突袭。]
						[c/7F8FA6:瞬间移动到鼠标位置并向方向施放横扫光波。]
						'''
					BB_Right_Spin_Locked: "[c/7F8FA6:按住左键再按住右键：暂未解锁（需第2阶段解锁回旋斩模式）]"
					BB_Right_Spin_Unlocked:
						'''
						[c/7F8FA6:按住左键再按住右键：将剑势转为环身旋舞。]
						[c/DDA0FF:转盘会随持续时间加速；只有达到满速后，才会向周围撒出潮刃。]
						[c/FFB347:低速旋舞用于蓄势，完成转速后才真正压制近身区域。]
						'''
					BB_Tide: "[c/4FAEFF:当前潮汐值：]"
					BB_Tide_Desc_NoAccessory: "[c/4FAEFF:（当前未佩戴冲刺/闪现配件，潮汐仅提升武器伤害）]"
					BB_Tide_Desc_HasAccessory: "[c/4FAEFF:（当前已佩戴配件，可消耗 1 点潮汐进行突进/瞬移攻击）]"
					Dash1_Unlock: "[c/66FFAA:已解锁：基础突进]"
					Dash1_Lock: "[c/7F8FA6:暂未解锁，需击败克苏鲁之眼]"
					Dash2_Unlock: "[c/66FFAA:已解锁：回旋切割]"
					Dash2_Lock: "[c/DDA0FF:暂未解锁，需击败血肉之墙]"
					Dash3_Unlock: "[c/66FFAA:已解锁：快刀斩]"
					Dash3_Lock: "[c/99CCFF:暂未解锁，需击败血肉之墙]"
					BB_Passive: "[c/9AEF9E:当玩家进行冲刺时执行突进强化，强化效果取决于当前佩戴的冲刺盾牌。当前被动状态：{0}（背包右键切换）。]"
					PassiveStateOn: "[c/7BFFB7:开启]"
					PassiveStateOff: "[c/F0D070:关闭]"
					PassiveDevice_None: "[c/7F8FA6:当前未读取到盾冲设备。]"
					PassiveDevice_OrnateShield: "[c/99CCFF:当前佩戴华丽护盾；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_DeepDiver: "[c/99CCFF:当前佩戴深渊潜游者；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_AsgardsValor: "[c/99CCFF:当前佩戴阿斯加德英勇；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_ElysianAegis: "[c/99CCFF:当前佩戴极乐之庇护；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_AsgardianAegis: "[c/99CCFF:当前佩戴阿斯加德之庇护；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					Dash4_Unlock: "[c/66FFAA:已解锁：大招「潮狱处刑」]"
					Dash4_Lock: "[c/FFB347:大招「潮狱处刑」未解锁（需佩戴黄金饰章解锁）]"
					BB_Final: "[c/9FD8A2:潮汐满溢且大招就绪时，按传奇技能键锁定猎物，再以左键宣判释放潮狱处刑。]"
					LegendaryHint: "[c/6C8EFF:按住Shift键以读取记录]"
					LegendaryText:
						'''
						[c/66CCFF:潮汐被灌满的那一刻，整把剑才真正开始狩猎。]
						[c/7F8FA6:它先沿着鼠标搜寻最值得处刑的目标，再把整片战场一并拖入判决。]
						[c/99CCFF:锁定一旦完成，逃跑与换位都只是把死亡的角度改得更难看。]
						[c/DDA0FF:左键落下的瞬间，持剑者会从目标周围反复现身，将其穿透、回斩、再度现身。]
						[c/FFB347:最后留下的印记不会立刻散去，它会贴着猎物继续书写余下的处刑。]
						[c/66CCFF:当海潮终于退下时，敌人与路径上的旁观者往往已经一起碎裂。]
						'''
				}
			}

			BBTest: {
				DisplayName: BB测试
				Tooltip: ""
			}

			OffshoreWindTurbine: {
				DisplayName: 离岸风力发电机
				Tooltip:
					'''
					海爵剑的潮汐上限增加 2 层
					潮汐层数越多，每层 3% 的伤害加成积累上限越高，长线战斗优势越明显
					[c/7F8FA6:多件叠加生效]
					'''
			}

			ImpactRestarter: {
				DisplayName: 冲击重启器
				Tooltip:
					'''
					右键突进命中敌人后立刻将冷却重置为零，可以立即再次发动
					满潮状态下的回旋冲刺命中敌人时，冷却从 3 秒压缩至 1 秒
					[c/7F8FA6:适合在密集敌群中以右键突进为核心节奏反复冲打]
					'''
			}

			HighTideOverloadBarrier: {
				DisplayName: 满潮过载防护层
				Tooltip:
					'''
					潮汐值为满时，获得 20 点防御力与 20% 伤害减免
					同时会在身周持续产生水尘粒子，作为满潮防护层激活的视觉标志
					[c/7F8FA6:潮汐一旦消耗，防护立即解除；保住满潮是持续防御的关键]
					'''
			}

			SurgeChainReactor: {
				DisplayName: 电涌连锁反应器
				Tooltip:
					'''
					快刀斩命中敌人时，在命中点额外爆发一次 75×75 的蓝色水能冲击
					将原本点对点的穿刺伤害扩散到周围敌群，显著提高密集场合的清场效率
					[c/7F8FA6:水能爆炸属于近战伤害，同样受潮汐加成与通用伤害加成影响]
					'''
			}

			VortexPortal: {
				DisplayName: 涡旋传送门
				Tooltip: 将海爵右键替换为"盾潮连斩"
			}

			LostGarment: {
				DisplayName: 旧日战甲
				Tooltip: 将海爵右键替换为"回旋切割"
			}

			CeruleanShield: {
				DisplayName: 碧蓝护盾
				Tooltip: 将海爵右键替换为"回旋切割"，命中时额外触发碧蓝爆炸
			}

			BBPassiveChanneler: {
				DisplayName: 潮汐被动触媒
				Tooltip:
					'''
					[c/9AEF9E:只要背包任意位置存有海爵剑，快刀斩被动即持续激活，无需手持武器]
					被动效果与手持时完全一致，不会增强或改变任何数值
					[c/7F8FA6:不提供其他战斗加成，仅用于让被动在换持武器期间也不中断]
					'''
			}
		}


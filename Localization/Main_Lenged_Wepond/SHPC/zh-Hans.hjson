Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendSHPC: {
					DisplayName: 能流过载-SHPC
					SHPC_LeftIntro: "[c/66CCFF:左键发射能量光球，默认发射白色光球，造成范围伤害]"
					SHPC_LoadingUIHint: "[c/66CCFF:打开背包并按下] [[c/66CCFF:{0}]] [c/66CCFF:打开装填UI，将特定材料装填进去，可以改变攻击效果]"
					SHPC_CurrentAmmoEffect: "[c/66CCFF:当前装填效果：{0}]"
					SHPC_DefaultAmmoEffect: 未装填特定材料，默认发射白色光球，造成范围伤害
					SHPC_UnloadHint: "[c/CFCFCF:背包内右键：倒出当前弹夹的材料；Shift+右键：倒出全部弹夹的材料]"
					SHPC_Passive: "[c/B8FF9E:被动I-【额外准备】：手持时即可增加魔力上限与利用效率，停火时快速恢复魔力]"
					SHPC_PassiveII: "[c/B8FF9E:被动II-【哨戒炮集群】：在地表作战时空投哨戒炮协同作战，最多同时存在三台炮]"
					SHPC_PassiveIILocked: "[c/999999:被动II-【哨戒炮集群】：暂未解锁]"
					SHPC_EquipEffect: "[c/66CCFF:装备效果：佩戴时提供额外屏障护盾保护玩家]"
					SHPC_NeverOverheats: "[c/FF4040:激光扫射永不过热]"
					SHPC_RightIntro1:
						'''
						[c/FFB347:右键进行激光扫射，扫射会积攒热量，热量满后武器会过热停机，停止攻击后热量会散失]
						[c/FFB347:随着流程推进，热量满后将可以进入更高的等级，每级热量会使右键伤害乘算提升5%，并附带特殊效果]
						[c/FFB347:当前热量等级上限：Ⅰ级 效果：无附加效果]
						[c/FFB347:扫射过程中按下左键，会消耗一级热量立即发射三颗能量光球]
						'''
					SHPC_RightIntro2:
						'''
						[c/FFB347:右键进行激光扫射，扫射会积攒热量，热量满后武器会过热停机，停止攻击后热量会散失]
						[c/FFB347:随着流程推进，热量满后将可以进入更高的等级，每级热量会使右键伤害乘算提升5%，并附带特殊效果]
						[c/FFB347:当前热量等级上限：Ⅱ级 效果：增加副光束，光束穿透3名敌人]
						[c/FFB347:扫射过程中按下左键，会消耗一级热量立即发射三颗能量光球]
						'''
					SHPC_RightIntro3:
						'''
						[c/FFB347:右键进行激光扫射，扫射会积攒热量，热量满后武器会过热停机，停止攻击后热量会散失]
						[c/FFB347:随着流程推进，热量满后将可以进入更高的等级，每级热量会使右键伤害乘算提升5%，并附带特殊效果]
						[c/FFB347:当前热量等级上限：Ⅲ级 效果：主副光束首次命中有概率触发热爆]
						[c/FFB347:扫射过程中按下左键，会消耗一级热量立即发射三颗能量光球]
						'''
					SHPC_RightIntro4:
						'''
						[c/FFB347:右键进行激光扫射，扫射会积攒热量，热量满后武器会过热停机，停止攻击后热量会散失]
						[c/FFB347:随着流程推进，热量满后将可以进入更高的等级，每级热量会使右键伤害乘算提升5%，并附带特殊效果]
						[c/FFB347:当前热量等级上限：Ⅳ级 效果：增加第二副光束，伤害提升，热爆可穿透触发]
						[c/FFB347:扫射过程中按下左键，会消耗一级热量立即发射三颗能量光球]
						'''
					SHPC_RightIntro5:
						'''
						[c/FFB347:右键进行激光扫射，扫射会积攒热量，停止攻击后热量会散失]
						[c/FFB347:随着流程推进，热量满后将可以进入更高的等级，每级热量会使右键伤害乘算提升5%，并附带特殊效果]
						[c/FFB347:当前热量等级上限：Ⅴ级 效果：无限穿透，满热后保持扫射且不会燃烧自身生命]
						[c/FFB347:扫射过程中按下左键，会消耗一级热量立即发射三颗能量光球]
						'''
					SHPC_Final: "[c/99B3FF:系统仍在演化。此前的缺陷尚未完全修正，但其潜力仍然存在。或许有一天，它能够得到真正的验证。]"
					SHPC_EXHint:
						'''
						[c/66CCFF:大招【超级激光】：按下【{0}】即可将大量能量聚集到枪口]
						[c/66CCFF:随后发射一道贯穿一切的超级激光]
						'''
					SHPC_EXDisabledHint: "[c/9A9A9A:大招【超级激光】进入困难模式后自动解锁。]"
					SHPC_AmmoWheelHint: "[c/F7D87C:关闭背包按下] [[c/F7D87C:{0}]] [c/F7D87C:打开切换轮盘，可以切换装填的弹药]"
					Tooltip: "[GFB]"
					TooltipGFB: 终于来到这里了吗？这个陌生又熟悉的世界。
				}

				SHPCBook: {
					DisplayName: SHPC图鉴光盘
					Tooltip: 左键打开 SHPC 材料索引，右键打开右键热量系统索引。
				}
			}

			FastChip: {
				DisplayName: 快充芯片
				Tooltip: "[GFB]"
				TooltipLocked: "[c/9A9A9A:需先解锁大招才可看到]"
				TooltipUnlocked:
					'''
					左键能量球为大招提供双倍充能，右键激光扫射提供充能
					减半生命回复，右键扫射时使生命回复更低
					'''
			}

			DiffuChip: {
				DisplayName: 扩散芯片
				Tooltip:
					'''
					增加7%魔法伤害和7%魔法暴击率
					右键散热强化攻击获得更强的集中度
					'''
			}

			CommandAscend: {
				DisplayName: 枪身改造部件-迫击
				Tooltip:
					'''
					手持SHPC时将右键更改为迫击模式
					发射一枚迫击炮打击敌人
					造成猛烈爆炸并降下激光雨
					“未曾考虑掩体”
					'''
			}

			MilitaryCaller: {
				DisplayName: 枪身改造部件-炮台
				Tooltip:
					'''
					手持SHPC时右键改为军用呼叫器模式
					射出一个信标，空中投送一座友军炮台
					最多同时维持8座炮台，每座持续5分钟
					距离已有炮台18格内会部署失败
					不同生物群系，对应不同的炮台
					“友方驱逐舰已入场”
					'''
			}

			CtrlChip: {
				DisplayName: 火控芯片
				Tooltip:
					'''
					出现一枚可自动吸附在敌人身上
					并提供自瞄能力的火控准星
					自瞄对所有武器均有效
					对SHPC的激光可提供额外的制导效果
					关闭配饰可见性可隐藏准星
					'''
			}

			FlyChip: {
				DisplayName: 飞升芯片
				Tooltip:
					'''
					手持SHPC时
					飞行时间增加70%
					移动速度和跳跃速度提高10%，加速度提高0.7倍
					'''
			}

			HeatModule: {
				DisplayName: 急速电流过热系统
				Tooltip:
					'''
					SHPC激光扫射的热量提升速度大幅加快
					每一级热量提供更高伤害增幅
					到达最大热量时会灼烧周围的敌人
					过热不会导致停机
					'''
			}

			AIOC: {
				DisplayName: 全合一芯片组
				Tooltip: "[GFB]"
				TooltipCompact:
					'''
					拥有4种芯片的所有功能，并强化装备SHPC提供的屏障
					按住Shift显示各芯片效果与屏障强化效果
					装备SHPC提供的屏障护盾血量提升50%
					不再拥有部分芯片的负面作用
					“你好，世界”
					'''
				TooltipFull:
					'''
					快充芯片：左键能量光球为大招提供双倍充能，激光扫射也提供充能
					扩散芯片：魔法伤害和魔法暴击率各+7%，强化热量攻击的集中度
					火控芯片：暴击率+7%，手持SHPC时获得可吸附、追踪、自瞄的准星
					飞升芯片：手持SHPC时飞行时间+70%，移动速度、跳跃速度和加速度提高
					屏障强化：装备SHPC时，其屏障护盾血量提升50%，与其他屏障相互不冲突
					不再拥有部分芯片的负面作用
					“你好，世界”
					'''
			}

			ProjectilePossessionModule: {
				DisplayName: 枪身改造部件-吸收
				Tooltip:
					'''
					手持SHPC时右键改为吸收模式
					最多吸收15发敌对弹幕
					直接销毁被捕获的敌方弹幕，并将友方复制体吸收到玩家周围
					松开右键将储存的友方弹幕向前直线连射出去
					“图，伤，速，大小，无敌帧，花来”
					'''
			}

			KarasawaModule: {
				DisplayName: 卡拉萨瓦模块
				Tooltip:
					'''
					手持SHPC时右键改为卡拉萨瓦蓄力炮模式
					按住右键持续蓄力，松开后发射一发无视防御并补偿伤害减免的超高速能量炮；蓄力不足会进入失败冷却
					卡拉萨瓦巨炮。。。多么优秀的武器。。。
					只可惜他在仓库里积了太久的灰
					无论如何，他必须重见天日
					'''
			}
		}

		TheSpecialText: {
			SHPCAmmoWheelHover: "{0} - {1} 发"
			SHPCBookNoRecords: 暂无已注册的 SHPC 材料记录。
			SHPCBookMissingEffect: 暂无效果记录
		}

		AMMO: {
			SHPCAmmoPrompt: 该物品可用为SHPC充能，效果为：
			SHPCAmmoPanel: 左键面板倍率：{0}倍；装填次数：{1} 发
			SHPCAmmo1: 能量核心会让光球弹跳，并迸出密集的电火花
			SHPCAmmo2: 风暴之颚会释放五重连锁电弧，在敌群之间快速跳跃
			SHPCAmmo3: 硫磺鳞片会在光球落地时炸开，留下腐蚀性的硫雾区域
			SHPCAmmo4: 纯净凝胶会直接裂成多发继续追击的光球
			SHPCAmmo5: 混乱精华受极强重力影响，下落时造成更强伤害
			SHPCAmmo6: 冰雪精华会在爆炸处铺开液氮寒域，持续压制区域内敌人
			SHPCAmmo7: 日光精华会从爆点上方展开核心，快速射出七道追踪的日光激光
			SHPCAmmo8: 凋星微尘会直接散射多枚星魂，命中后产生中型爆炸并施加幻星感染
			SHPCAmmo9: 光明之魂会召来高伤害光魂，环绕光球并持续伤害周围目标
			SHPCAmmo10: 暗影之魂会喷涌出追猎暗魂，让它们自动搜寻附近敌人
			SHPCAmmo11: 飞翔之魂会先升上空中，再从高处向目标俯冲轰炸
			SHPCAmmo12: 恐惧之魂会留下滞空游猎的恐魂，在原地附近持续寻找猎物
			SHPCAmmo13: 力量之魂会释放三枚延迟爆炸的能量光球
			SHPCAmmo14: 视域之魂会让飞行更久的光球释放更猛烈的爆炸
			SHPCAmmo15: 生命碎片会射出多发生命蝴蝶，追踪敌人，并为玩家治疗
			SHPCAmmo16: ！！！
			SHPCAmmo17: 深渊细胞会发射蝰蛇鱼，从上方坠下并爆开
			SHPCAmmo18: 瘟疫细胞罐会发射标记射线，并呼叫瘟疫导弹
			SHPCAmmo19: 灾厄尘会喷涌大量赤色灵魂，其中一部分会缓慢波动并无限贯穿敌人
			SHPCAmmo20: ！！！
			SHPCAmmo21: 日曜碎片会在原爆点召唤多柄穿刺长矛从天而降
			SHPCAmmo22: 星旋碎片会在飞行途中释放追踪导弹护航
			SHPCAmmo23: 星云碎片会释放三发追猎星体，蓝色星体具有更强的效果
			SHPCAmmo24: 星尘碎片会分裂出大量细胞，让它们持续递归繁殖
			SHPCAmmo25: 冥思溶剂会释放高速黑光，造成猛烈爆炸
			SHPCAmmo26: 浊火精华会在释放猛烈的定向冲击波
			SHPCAmmo27: ！！！
			SHPCAmmo28: 神圣晶体会在爆炸时折射出多道追踪几何激光
			SHPCAmmo29: 血石核心会吸收玩家生命以此来强化自身，并在爆炸后释放治疗伤害光球
			SHPCAmmo30: 毁灭之灵会释放追踪灵魂和回旋灵魂
			SHPCAmmo31: 灵质会在路径上和命中敌人时释放大量追踪灵魂
			SHPCAmmo32: 暗离子体会制造主动追踪敌人的小型暗核，将敌人吸入后裂爆，并无视防御与95%以下伤害减免
			SHPCAmmo33: 扭曲虚空会释放多发虚空刀锋，穿透大量敌人
			SHPCAmmo34: 恒温能量会制造一片液氮区域，并释放大量冰刺
			SHPCAmmo35: 梦魇魔能会分裂出梦魇弧光，持续命中敌人
			SHPCAmmo36: 化神魂精会连续发射大量星针，穿透许多敌人
			SHPCAmmo37: 龙魂碎片会释放猛烈火焰
			SHPCAmmo38: 星流棱晶会发射审判激光，并展开分形几何追击
			SHPCAmmo39: 湮灭余烬会锁定一名敌人，并释放大量湮灭打击
			SHPCAmmo40: 装甲外壳会喷射大量逐渐减速的电磁光球，随后形成持续风暴
			SHPCAmmo41: 珍珠碎片会射出三颗大珍珠，破碎后分裂成逐渐加速的追踪小珍珠
			SHPCAmmo42: 日蚀之阴碎片会制造黑蚀之日，可以不断的强化，并最终释放强力爆炸
			SHPCAmmo43: 万物的焦点会发射一枚重型穿甲弹，命中后释放电磁闪电、两层金源珠椭圆和外层充能单元环
			SHPCAmmo44: 灾劫核心会分裂成四发强追踪的光弹
		}


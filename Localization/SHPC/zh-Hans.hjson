Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendSHPC: {
					DisplayName: SHPC-传奇归来
					SHPC_LeftIntro:
						'''
						[c/66CCFF:左键：发射能量光球。]
						[c/FFD966:背包材料可用于装填，材料会按倍率强化左键基础伤害，部分材料装药量不同。]
						[c/99CCFF:能量耗尽后自动重新装填。]
						[c/AAAAAA:未装药时仍可攻击，但只会发射默认白球；默认白球的倍率和爆炸范围会随流程提升。]
						[c/99CCFF:对武器点击右键，可以将现有的装药倒出并概率返还。]
						[c/DDA0FF:当前装药效果为：]
						'''
					SHPC_RightIntro1:
						'''
						[c/66CCFF:右键：按住进行精准激光扫射。]
						[c/FFB347:当前形态：Ⅰ级热量。持续射击会积累热量，填满后可短暂维持输出，随后强制停机。]
						[c/DDA0FF:扫射期间点击左键可手动散热，发射3枚能量光球并降低一级热量。]
						'''
					SHPC_RightIntro2:
						'''
						[c/66CCFF:右键：按住进行精准激光扫射。]
						[c/FFB347:当前形态：Ⅱ级热量。主光束旁会追加一道带轻微偏射与螺旋水平偏移的副光束。]
						[c/99CCFF:在Ⅱ级热量下，光束可穿透3名敌人，每次穿透后伤害略微衰减。]
						[c/DDA0FF:扫射期间点击左键可手动散热，发射3枚能量光球并降低一级热量。]
						'''
					SHPC_RightIntro3:
						'''
						[c/66CCFF:右键：按住进行精准激光扫射。]
						[c/FFB347:当前形态：Ⅲ级热量。副光束首次命中时有概率引发小范围热爆，主光束首次命中时有概率引发中范围热爆。]
						[c/DDA0FF:扫射期间点击左键可手动散热，发射3枚能量光球并降低一级热量。]
						'''
					SHPC_RightIntro4:
						'''
						[c/66CCFF:右键：按住进行精准激光扫射。]
						[c/FFB347:当前形态：Ⅳ级热量。追加第二道副光束，热爆触发率提升，并可在穿透后继续触发。]
						[c/FF7043:进入Ⅳ级热量会压制生命恢复并持续灼烧使用者。]
						[c/DDA0FF:扫射期间点击左键可手动散热，发射3枚能量光球并降低一级热量。]
						'''
					SHPC_RightIntro5:
						'''
						[c/66CCFF:右键：按住进行精准激光扫射。]
						[c/FFB347:当前形态：Ⅴ级热量。光束获得无限穿透，并附加基于目标最大生命值的额外伤害。]
						[c/FF7043:进入Ⅴ级热量会快速消耗使用者生命。]
						[c/DDA0FF:扫射期间点击左键可手动散热，发射3枚能量光球并降低一级热量。]
						'''
					SHPC_Final: "[c/99B3FF:系统仍在演化。此前的缺陷尚未完全修正，但其潜力仍然存在。或许有一天，它能够得到真正的验证。]"
					SHPC_EXHint:
						'''
						[c/66CCFF:身边有敌人时，每次左键发射会积蓄1点终极能量，最高储存60点。]
						[c/FFD966:当能量完全充盈后，按下 {0} 即可启动终极模式。]
						[c/FF7043:经过短暂蓄力，释放一道短暂但足以贯穿一切的超巨型激光。]
						'''
					SHPC_EXDisabledHint: "[c/9A9A9A:当前未佩戴黄金饰章，大招将被禁用。]"
					SHPC_AmmoWheelHint: "[c/F7D87C:按住 [{0}] 打开装药轮盘；松开时会装填当前扇区的材料。]"
					Tooltip: "[GFB]"
					TooltipGFB: 终于来到这里了吗？这个陌生又熟悉的世界。
					LegendaryHint: "[c/BABABA:按住Shift键以读取记录]"
					LegendaryText:
						'''
						[c/66E6FF:最初的方案过于依赖单一能源，但结果证明，这种设计注定无法稳定运行。]
						[c/66E6FF:新的结构不再局限于灵魂，任何具备能量密度的材料都被纳入测试范围。]
						[c/66E6FF:不同输入带来的响应差异极大，部分组合甚至呈现出异常的放大效应。]
						[c/66E6FF:控制系统因此被重新设计，能量在完全约束前即被强制释放。]
						[c/66E6FF:理论上，这种装置不再受弹药类型限制，但它真正的极限仍无人知晓。]
						[c/66E6FF:扫射模式下，原有的灵魂依赖被彻底剔除，结构被迫重构为更原始的热能驱动形式。]
						[c/66E6FF:为维持输出稳定，散热系统被重新定义，出现了新的热失控效应。]
						[c/66E6FF:随着持续运作，系统将不可避免地进入过热区间，并以此换取更高的释放效率。]
						[c/66E6FF:若操作者无法及时干预，这种“优化”将反过来燃尽自身。]
						'''
				}

				SHPCBook: {
					DisplayName: SHPC材料手册
					Tooltip: 左键打开或关闭 SHPC 材料索引。
				}
			}
		}

		TheSpecialText: {
			SHPCAmmoWheelHover: "{0} - {1} 发"
			SHPCBookNoRecords: 暂无已注册的 SHPC 材料记录。
			SHPCBookMissingEffect: 暂无效果记录
		}

		AMMO: {
			SHPCAmmoPrompt: 该物品可用为SHPC充能，效果为：
			SHPCAmmoPanel: 左键面板倍率：{0}倍；装填次数：{1} 发
			SHPCAmmo1: 能量核心会让光球弹跳，并在路径上迸出密集的电火花。
			SHPCAmmo2: 风暴之颚会释放五重连锁电弧，在敌群之间快速跳跃。
			SHPCAmmo3: 硫磺鳞片会在光球落地时炸开，留下腐蚀性的硫雾区域。
			SHPCAmmo4: 纯净凝胶会在能量耗尽后裂成两枚继续追击的光球。
			SHPCAmmo5: 混乱精华会瞄准下方目标，砸出沉重的浩劫冲击。
			SHPCAmmo6: 冰雪精华会在爆炸处铺开液氮寒域，持续压制区域内敌人。
			SHPCAmmo7: 日光精华会从爆点展开连发核心，快速射出七道微弱追踪的日光激光。
			SHPCAmmo8: 泰坦之心会凝成巨型幻核，以厚重冲击撞开并撕裂敌人。
			SHPCAmmo9: 光明之魂会召来高伤害光魂，环绕光球并持续轰炸周围目标。
			SHPCAmmo10: 暗影之魂会喷涌出追猎暗魂，让它们自动搜寻附近敌人。
			SHPCAmmo11: 飞翔之魂会先升上空中，再从高处向目标俯冲轰炸。
			SHPCAmmo12: 恐惧之魂会留下滞空游猎的恐魂，在原地附近持续寻找猎物。
			SHPCAmmo13: 力量之魂会释放三枚延迟爆炸的能量光球。
			SHPCAmmo14: 视域之魂会让光球飞行越久爆炸越猛烈。
			SHPCAmmo15: 生命碎片会追踪敌人，并尝试将造成的力量转化为治疗。
			SHPCAmmo16: 该材料槽位暂未接入实际物品，因此不会提供装药效果。
			SHPCAmmo17: 深渊细胞会凝成深渊渊球，从上方坠下并爆开。
			SHPCAmmo18: 瘟疫细胞罐会标记目标，并引发带有瘟疫性质的核爆。
			SHPCAmmo19: 灾厄余烬会喷涌赤色灵魂，让爆点附近化为灼热灾场。
			SHPCAmmo20: 【甲虫外壳的 SHPC 效果尚未实现，目前只作为预留记录。】
			SHPCAmmo21: 日曜碎片会齐射多柄穿刺长矛，从爆点撕开前方敌人。
			SHPCAmmo22: 星旋碎片会在飞行途中释放导弹护航，并拦截附近目标。
			SHPCAmmo23: 星云碎片会召出追猎星体，蓄力后引发集中爆炸。
			SHPCAmmo24: 星尘碎片会分裂出细胞弹体，让它们继续扩散攻击。
			SHPCAmmo25: 冥思溶剂会制造黑色爆点，把视野内的敌人卷入其中。
			SHPCAmmo26: 浊火精华会在撞击物块后释放猛烈的定向冲击波。
			SHPCAmmo27: 【该材料槽位暂未接入实际物品，因此不会提供装药效果。】
			SHPCAmmo28: 神圣晶簇会在爆炸时折射出多道几何激光。
			SHPCAmmo29: 血石核心会以玩家生命为代价强化自身，并在爆炸后返还治疗。
			SHPCAmmo30: 毁灭之灵会唤醒深处幽魂，让它们向敌人持续逼近。
			SHPCAmmo31: 灵质会制造连锁魂爆，在敌人之间接续引发灵魂冲击。
			SHPCAmmo32: 暗离子体会制造小型暗核，将敌人吸入后裂爆。
			SHPCAmmo33: 扭曲虚空会展开虚空刀锋，以多次交错轨迹绞杀目标。
			SHPCAmmo34: 恒温能量会反弹飞行，并裂射出穿刺冰矢。
			SHPCAmmo35: 梦魇魔能会分裂出梦魇弧光，持续切割命中的敌人。
			SHPCAmmo36: 化神魂精会召来大量星针，对一片区域进行火力覆盖。
			SHPCAmmo37: 龙魂碎片会烙下爆燃印记，让敌人承受巨龙怒火。
			SHPCAmmo38: 星流棱晶会发射审判激光，并展开分形几何追击。
			SHPCAmmo39: 湮灭余烬会锁定视野内敌人，释放大范围湮灭打击。
			SHPCAmmo40: 装甲外壳会喷射大量电磁光球，形成持续风暴。
		}


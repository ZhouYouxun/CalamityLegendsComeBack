			GhostSniperRifle: {
				GhostSniperRound.DisplayName: Ghost Sniper Round
				GhostSniperSpectreOrb.DisplayName: Ghost Sniper Spectre Orb
			}
		}

		TheSpecialText: {
			TetrisLevel: LEVEL {0}
			TetrisMultiplayerLevel: CO-OP LEVEL {0}
			TetrisGameOver: GAME OVER
			TetrisRestart: Press R to restart
			TetrisNoInviteTarget: No nearby Tetris player found.
			TetrisInviteSent: Tetris invite sent to {0}.
			TetrisInviteIncoming: "{0} invited you to co-op Tetris. Press Y or Enter to accept. Press N or Esc to decline."
			TetrisInviteRejected: Tetris invite was rejected.
			TetrisInviteAccepted: Co-op Tetris linked.
			TetrisMultiplayerGuest: Waiting for host board sync
			Game2048Score: SCORE {0}

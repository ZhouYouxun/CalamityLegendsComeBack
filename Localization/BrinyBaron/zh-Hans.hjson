Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendBrinyBaron: {
					DisplayName: 新传奇 - 海爵剑
					Tooltip: "[GFB]"
					BB_Left_1:
						'''
						[c/66CCFF:左键：进行一系列的挥动并射出海沫与海灵。]
						[c/66CCFF:海沫可以高速穿行，并在结束时爆成水花。]
						[c/66CCFF:海灵可以追踪敌人，并施加激流。]
						'''
					BB_Left_2:
						'''
						[c/66CCFF:左键：进行三段挥动并射出海沫、海灵与光波。]
						[c/66CCFF:海沫可以散射出更大的水刃，并穿透更多敌人。]
						[c/66CCFF:海灵可以更快追踪敌人，并施加激流。]
						[c/66CCFF:光波可以向前推进，形成宽大的潮汐斩击。]
						[c/66CCFF:近战剑刃命中可以召来龙卷。]
						'''
					BB_Left_3:
						'''
						[c/66CCFF:左键：进行四段挥动并射出海沫、海灵、手里剑与光波。]
						[c/66CCFF:海沫可以并排齐射，穿透敌人并在结束时爆成水花。]
						[c/66CCFF:海灵可以成群追踪敌人，并施加激流。]
						[c/66CCFF:手里剑可以扇形飞出，切割敌人，并在命中时释放海沫。]
						[c/66CCFF:光波可以向前推进，终段释放更巨大的潮汐斩击。]
						[c/66CCFF:近战剑刃命中可以召来龙卷。]
						'''
					BB_Left_4:
						'''
						[c/66CCFF:左键：进行完整挥动并射出海沫、海灵、手里剑与光波。]
						[c/66CCFF:海沫可以并排齐射，穿透敌人并在结束时爆成水花。]
						[c/66CCFF:海灵可以成群追踪敌人，并施加激流。]
						[c/66CCFF:手里剑可以扇形飞出，切割敌人，并在命中时释放海沫。]
						[c/66CCFF:光波可以向前推进，终段释放更巨大的潮汐斩击。]
						[c/66CCFF:近战剑刃命中可以召来龙卷，并追加海灵弹幕。]
						'''
					BB_Right_DefaultShuriken:
						'''
						[c/FFB347:右键：丢出一发潮汐手里剑，切割敌人。]
						[c/FFB347:满潮时，手里剑可追踪敌人。]
						'''
					BB_Right_LostGarment:
						'''
						[c/FFB347:右键：旧日战甲将攻击改为穿刺突进。]
						[c/FFB347:突进会穿过路径上的所有敌人，不会反弹。]
						'''
					BB_Right_CeruleanShield:
						'''
						[c/FFB347:右键：碧蓝护盾将攻击改为反弹突进。]
						[c/FFB347:撞击敌人会向外爆发，并缩短突进冷却。]
						'''
					BB_Right_VortexPortal:
						'''
						[c/FFB347:右键：涡旋传送门会将你传送到鼠标位置。]
						[c/FFB347:传送后，立刻施展两次潮汐斩击。]
						'''
					BB_Right_Spin_Locked: "[c/DDA0FF:按住左键再按住右键：回旋斩需二阶段解锁。]"
					BB_Right_Spin_Unlocked:
						'''
						[c/DDA0FF:摁住双键可以将大剑持续挥舞，挥舞过程逐渐加速。]
						[c/DDA0FF:到达最高速度时，造成最高伤害，并不断释放手里剑。]
						'''
					BB_Tide: "[c/4FAEFF:当前潮汐值：]"
					BB_Tide_Desc_NoAccessory: "[c/4FAEFF:当前潮汐值的作用：【提升伤害】【提升移动速度】【满潮时额外提升伤害】]"
					BB_Tide_Desc_HasAccessory: "[c/4FAEFF:当前潮汐值的作用：【提升伤害】【提升移动速度】【满潮时额外提升伤害】【配件会追加右键或满潮效果】]"
					Dash1_Unlock: "[c/66FFAA:已解锁：基础突进]"
					Dash1_Lock: "[c/7F8FA6:暂未解锁，需击败克苏鲁之眼]"
					Dash2_Unlock: "[c/66FFAA:已解锁：回旋切割]"
					Dash2_Lock: "[c/DDA0FF:暂未解锁，需击败血肉之墙]"
					Dash3_Unlock: "[c/66FFAA:已解锁：快刀斩]"
					Dash3_Lock: "[c/99CCFF:暂未解锁，需击败血肉之墙]"
					BB_Passive: "[c/9AEF9E:被动【快刀斩】突进强化读取当前盾牌设备。状态：{0}；背包右键切换。]"
					PassiveStateOn: "[c/7BFFB7:开启]"
					PassiveStateOff: "[c/F0D070:关闭]"
					PassiveDevice_None: "[c/7F8FA6:当前未读取到盾冲设备。]"
					PassiveDevice_OrnateShield: "[c/99CCFF:当前佩戴华丽护盾；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_DeepDiver: "[c/99CCFF:当前佩戴深渊潜游者；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_AsgardsValor: "[c/99CCFF:当前佩戴阿斯加德英勇；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_ElysianAegis: "[c/99CCFF:当前佩戴极乐之庇护；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					PassiveDevice_AsgardianAegis: "[c/99CCFF:当前佩戴阿斯加德之庇护；盾冲期间每 7 帧会沿速度左右两侧各释放一枚潮刃。]"
					Dash4_Unlock: "[c/66FFAA:已解锁：大招【潮狱处刑】]"
					Dash4_Lock: "[c/FFB347:大招【潮狱处刑】当前大招未解锁。]"
					BB_Final: "[c/9FD8A2:大招【潮狱处刑】满潮且大招就绪时，按传奇技能键标记猎物；左键确认处刑。]"
					LegendaryHint: "[c/6C8EFF:按住Shift键以读取记录]"
					LegendaryText:
						'''
						[c/66CCFF:最初的海爵剑只保留了最直接的战斗方式：挥刀、卷起龙卷，再投出一枚追踪手里剑。]
						[c/66CCFF:这种设计足够干净，却很难承载一把传奇武器应有的潮汐节奏。]
						[c/99CCFF:重构后，斩击不再只等待命中，而是逐步积蓄潮汐，并在连段中展开海沫、海灵、手里剑与光波。]
						[c/FFB347:右键也不再固定为投掷，它会随着不同装置改写为突进、反弹、传送或更激进的追猎方式。]
						[c/DDA0FF:当潮汐被推至极限，所有路径、锁定与残留印记都会被收束进最后一次处刑。]
						'''
				}
			}

			BBTest: {
				DisplayName: BB测试
				Tooltip: ""
			}

			OffshoreWindTurbine: {
				DisplayName: 离岸风力发电机
				Tooltip:
					'''
					海爵剑的潮汐上限直接增加 4 层
					潮汐层数越多，每层 3% 的伤害加成积累上限越高，长线战斗优势越明显
					[c/7F8FA6:多件叠加生效]
					'''
			}

			ImpactRestarter: {
				DisplayName: 冲击重启器
				Tooltip:
					'''
					右键突进命中敌人后立刻将冷却重置为零，可以立即再次发动
					满潮状态下的回旋冲刺命中敌人时，冷却从 3 秒压缩至 1 秒
					[c/7F8FA6:适合在密集敌群中以右键突进为核心节奏反复冲打]
					'''
			}

			HighTideOverloadBarrier: {
				DisplayName: 满潮过载防护层
				Tooltip:
					'''
					潮汐值为满时，获得 20 点防御力与 20% 伤害减免
					同时会在身周持续产生水尘粒子，作为满潮防护层激活的视觉标志
					[c/7F8FA6:潮汐一旦消耗，防护立即解除；保住满潮是持续防御的关键]
					'''
			}

			SurgeChainReactor: {
				DisplayName: 电涌连锁反应器
				Tooltip:
					'''
					海爵左键挥刀伤害降低 50%，但快刀斩伤害提升至 2000%
					快刀斩期间会持续释放更猛烈的海灵弹幕
					[c/7F8FA6:用速度换爆发：快刀斩成为核心输出手段]
					'''
			}

			VortexPortal: {
				DisplayName: 涡旋传送门
				Tooltip:
					'''
					[c/99CCFF:将海爵右键替换为"传送双斩"]
					传送到鼠标位置，连续施展两刀（第一刀结束时自动接第二刀）
					[c/FFB347:冷却时间为 6 秒，远长于普通冲刺的 3 秒；技能优先级最高]
					'''
			}

			LostGarment: {
				DisplayName: 旧日战甲
				Tooltip:
					'''
					[c/99CCFF:将海爵右键替换为"穿透突进"]
					朝鼠标方向冲刺，穿过沿途所有敌人，造成多段伤害
					[c/FFB347:技能优先级最低]
					'''
			}

			CeruleanShield: {
				DisplayName: 碧蓝护盾
				Tooltip:
					'''
					[c/99CCFF:将海爵右键替换为"反弹突进"]
					朝鼠标方向冲刺，撞击第一个敌人后弹开并造成碧蓝爆炸
					若成功撞到敌人，冷却立即缩短至 1 秒（而非 3 秒）
					[c/FFB347:技能优先级20，高于旧日战甲，低于涡旋传送门]
					'''
			}

			BBPassiveChanneler: {
				DisplayName: 潮汐雷达
				Tooltip:
					'''
					[c/9AEF9E:只要背包任意位置存有海爵剑，快刀斩被动即持续激活，无需手持武器]
					被动效果与手持时完全一致，不会增强或改变任何数值
					[c/7F8FA6:不提供其他战斗加成，仅用于让被动在换持武器期间也不中断]
					'''
			}

			BottledRaft: {
				DisplayName: 瓶中筏
				Tooltip:
					'''
					战士伤害 +5%
					海爵潮汐上限提升至 6
					满潮时额外获得 +7% 海爵伤害
					'''
			}

			BottledBoat: {
				DisplayName: 瓶中船
				Tooltip:
					'''
					战士伤害 +8%
					海爵潮汐上限提升至 8
					满潮时额外获得 +10% 海爵伤害
					满潮时手里剑追踪能力与斩击次数大幅提升
					'''
			}

			BottledBlackPearl: {
				DisplayName: 瓶中黑珍珠号
				Tooltip:
					'''
					战士伤害 +12%
					海爵潮汐上限提升至 10
					满潮时额外获得 +14% 海爵伤害
					满潮时同时获得 10 点防御力与 10% 伤害减免
					光波弹幕穿透次数大幅提升（近乎无限）
					'''
			}

			BottledAircraftCarrier: {
				DisplayName: 瓶中航空母舰
				Tooltip:
					'''
					战士伤害 +15%
					海爵潮汐上限提升至 13
					满潮时额外获得 +18% 海爵伤害
					'''
			}

			DrinkingFountain: {
				DisplayName: 饮水机
				Tooltip:
					'''
					剑刃命中敌人时在命中点生成回血水球
					满血时水球不回血，转而追踪敌人造成伤害
					[c/7F8FA6:水球属于近战伤害，受潮汐加成影响]
					'''
			}

			AdrenalineInjector: {
				DisplayName: 肾上腺素注射器
				Tooltip:
					'''
					剑刃命中敌人叠加层数，提升伤害与攻速（最多18层）
					一旦受到伤害，立刻清空全部层数，且该次伤害额外增加
					[c/7F8FA6:层数越高风险越大；适合高压进攻节奏]
					'''
			}
		}


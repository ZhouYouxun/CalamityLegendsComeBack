Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				PlayerSaddleItem: {
					DisplayName: Silla de montar para jugadores
					Tooltip:
						'''
						Haz clic izquierdo en un jugador cercano para montarlo.
						Mientras cabalgas, no puedes moverte, pero puedes seguir atacando e interactuando con normalidad.
						Te desmonta automáticamente si tu montura muere.
						Haz clic izquierdo de nuevo para desmontar o clic derecho para echar de tu montura a quien te está montando.
						'''
				}
			}
		}

		TheSpecialText: {
			PlayerSaddleNoTarget: No se encontró ningún jugador cercano para montar.
			PlayerSaddleOccupied: Ese jugador ya tiene un jinete.
			PlayerSaddleMounted: ¡{0} ahora monta a {1}!
		}
	}
}

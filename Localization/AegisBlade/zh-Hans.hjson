Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				AegisBlade: {
					DisplayName: 庇护之刃
					Tooltip: "[GFB]"
					FunctionalTooltip:
						'''
						[c/FFD966:左键] [c/DCD6C8:持续挥舞大剑；旋转期间会不断向周围散射金色追踪灵魂]
						[c/8DB8FF:右键] [c/DCD6C8:举起40帧庇护盾牌——前15帧为完美格挡窗口，之后可继续蓄力]
						[c/8DB8FF:盾牌猛击] [c/DCD6C8:松开右键朝光标冲刺，以盾牌猛击沿途敌人；蓄力越久，冲刺越远、伤害越高]
						[c/8DB8FF:完全蓄力] [c/DCD6C8:击败任意机械BOSS后解锁；左键可投下庇护之刃，在落点两侧生成16格高的速凝掩体]
						[c/DCD6C8:掩体持续60秒，BOSS战中持续10秒]
						[c/8DB8FF:完美格挡] [c/DCD6C8:吸收全部伤害，获得35无敌帧与8点能量；随后的盾牌猛击额外强化]
						[c/8DB8FF:举盾] [c/DCD6C8:+20防御并免疫击退]
						[c/7FE886:被动【埃癸斯】] [c/DCD6C8:根据移动速度获得6~15点额外防御；静止时达到上限]
						[c/7FE886:被动【壁垒】] [c/DCD6C8:无持续伤害减益时，接触类伤害降低20%，静止时效果翻倍]
						[c/FFD700:大招【金手】] [c/DCD6C8:能量满后按下传奇技能键，金手降临并赋予10秒完全无敌]
						'''
					LegendaryHint: "[c/BABABA:按住Shift键以读取记录]"
					LegendaryText:
						'''
						[c/FFD966:在远古的战场上，曾有一位骑士，身披金甲，手持此刃。]
						[c/FFD966:他的盾牌从未破裂，不是因为它无坚不摧，]
						[c/FFD966:而是因为他总能在攻击落下的瞬间，以光芒将其完全吸收。]
						[c/FFD966:传说他的身影如同黎明本身——不可触及，难以逾越。]
						[c/FFD966:而这把剑，正是他意志的延伸：护卫者的锋芒。]
						'''
				}

				Summon: {
					GlacialEmbrace: {
						DisplayName: 冰霜之拥 — 传奇重塑
						Tooltip: "[GFB]"
					}
				}
			}

			NewLegendGaelsGreatsword: {
				// DisplayName: New Legend Gaels Greatsword
				// Tooltip: ""
			}
		}


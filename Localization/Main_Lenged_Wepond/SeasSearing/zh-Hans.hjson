Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				SeasSearing: {
					DisplayName: 沧海焚天-海之烧灼
					Tooltip: "[GFB]"
					Intro: "[c/58FFDA:深海辐射步枪。污染会累积、扩散，并在指令下崩坏。]"
					LeftClick_Phase1:
						'''
						[c/9AEAFF:左键：连射污染弹，侦查灵魂追踪敌人。]
						[c/9AEAFF:每轮攻势末尾追加一枚污染火箭。]
						'''
					LeftClick_Phase2:
						'''
						[c/9AEAFF:左键：连射污染弹，并喷出腐蚀胆汁。]
						[c/9AEAFF:污染火箭仍会在每轮末尾追击敌人。]
						'''
					LeftClick_Phase3:
						'''
						[c/9AEAFF:左键：连射污染弹，伴随胆汁与污染火箭。]
						[c/9AEAFF:弹雨中的污染弹命中后会散布气泡。]
						'''
					LeftClick_Phase4:
						'''
						[c/9AEAFF:左键：污染弹雨裹挟胆汁、气泡与火箭。]
						[c/9AEAFF:天鳍鱼雷也会加入攻势，追击敌人。]
						'''
					LeftClick_Phase5:
						'''
						[c/9AEAFF:左键：污染弹雨持续倾泻，深水雷加入攻势。]
						[c/9AEAFF:部分攻击命中后会引发小型核爆。]
						'''
					LeftClick_Phase6:
						'''
						[c/9AEAFF:左键：全自动倾泻污染弹，命中后散布气泡。]
						[c/9AEAFF:胆汁、火箭、鱼雷、深水雷与追踪导弹接连加入攻势。]
						[c/9AEAFF:持续命中还能引发小型核爆。]
						'''
					RightClick_Tier0: "[c/6FE6B0:右键：蓄力喷出深海霰弹，引爆敌人身上的污染。]"
					RightClick_Tier1:
						'''
						[c/6FE6B0:右键：蓄力喷出深海霰弹，引爆敌人身上的污染。]
						[c/6FE6B0:深渊光柱随后在光标处升起。]
						'''
					RightClick_Tier2:
						'''
						[c/6FE6B0:右键：蓄力连续喷出深海霰弹，引爆污染。]
						[c/6FE6B0:深渊光柱随后在光标处升起。]
						'''
					RightClick_Tier3:
						'''
						[c/6FE6B0:右键：蓄力连续喷出深海霰弹，引爆污染。]
						[c/6FE6B0:深渊光柱与污染漩涡在光标处爆发。]
						'''
					EnemyRadiation_Tier0:
						'''
						[c/B4E24C:被动【辐射污染】：命中使敌人逐渐迟缓，并压制其恢复。]
						[c/B4E24C:污染会向附近扩散；右键可使它在敌人身上崩坏。]
						'''
					EnemyRadiation_Tier1:
						'''
						[c/B4E24C:被动【辐射污染】：命中使敌人迟缓、衰弱，并压制其恢复。]
						[c/B4E24C:污染扩散后可被右键引爆，并刺出污染尖刺。]
						'''
					EnemyRadiation_Tier2:
						'''
						[c/B4E24C:被动【辐射污染】：命中使敌人迟缓、衰弱，并压制其恢复。]
						[c/B4E24C:污染扩散后可被右键引爆，生成尖刺与漩涡。]
						'''
					EnemyRadiation_Tier3:
						'''
						[c/B4E24C:被动【辐射污染】：命中使敌人迟缓、衰弱，并压制其恢复。]
						[c/B4E24C:污染扩散后可被右键引爆，生成尖刺与漩涡。]
						'''
					PlayerRadiation_Tier0: "[c/FFC94C:被动【辐射兴奋】：持续命中唤醒体内的辐射力量。]"
					PlayerRadiation_Tier1: "[c/FFC94C:被动【辐射兴奋】：持续命中使体内的辐射力量逐渐增强。]"
					PlayerRadiation_Tier2: "[c/FFC94C:被动【辐射兴奋】：持续命中使体内的辐射力量逐渐增强。]"
					PlayerRadiation_Tier3: "[c/FFC94C:被动【辐射兴奋】：持续命中使体内的辐射力量逐渐增强。]"
					Passive: "[c/66CCFF:装备效果：佩戴时产生深渊水压光环，使附近敌人迟缓并染上污染。]"
					EquipScaling: "[c/66CCFF:伤害为手持武器的20%，频率随手持武器变化，同一敌人最快每10帧命中一次；可积累辐射等级，但不能主动引爆。]"
					LegendaryText: 如今我们又该何去何从？
					Ultimate:
						'''
						[c/FF8A30:大招【空对地核导弹】：按下【{0}】准备激光标记。]
						[c/FF8A30:按下左键锁定目标，核导弹随后从天而降。]
						'''
				}
			}
		}


Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Summon: {
					GlacialEmbrace: {
						ModeName0: 斩击形态
						ModeName1: 突刺形态
						ModeName2: 打击形态
						GE_Intro:
							'''
							[c/7BC8E5:当前战斗形态：{0}，每五秒自动循环切换到下一形态]
							[c/A0D8EF:左键先召冰核，再召冰钉；满仆从后长按蓄力特攻，释放后15帧冷却]
							'''
						GE_LeftClick:
							'''
							[c/90FFB0:斩击形态：冰钉分内外双环旋斩，并周期性飞出切穿目标]
							[c/80EFFF:突刺形态：冰钉更快射出，命中敌人后嵌入体内]
							[c/FF8B60:打击形态：冰钉平时会主动冲撞；对齐后左键合拢撞击并休眠]
							'''
						GE_SpikeMode0: ""
						GE_SpikeMode1: ""
						GE_SpikeMode2: ""
						GE_SpecialIntro: "[c/A0D8EF:蓄力特攻变为冰刀、冰楔或冰柱；非完美释放仅10%起，线性提升到100%]"
						GE_SpecialMode0: ""
						GE_SpecialMode1: ""
						GE_SpecialMode2: ""
						GE_PassiveRhythm: "[c/B0E0FF:◇ 裂隙封存：右键开启节奏条，绿区松开叠连击；鞭击命中会命令冰钉协同突袭]"
						GE_PassiveCombo: "[c/B0E0FF:当前连击{0}层：每秒持续回复+{1}且防御+{2}，十层后冰钉加速]"
						GE_PassiveDivinity: ""
						GE_PassiveAurora: ""
						GE_Ultimate:
							'''
							[c/A0F0FF:★ 大招 — 维度压缩 (满{1}/240后按{0}释放)]
							[c/A0F0FF:特殊攻击和冰钉命中都会充能，释放时所有冰钉会聚成神钻向前贯穿，在此期间玩家处于无敌状态]
							'''
						LegendaryHint: "[c/BABABA:按住 Shift 键即可阅读冰霜之拥的完整传奇文本与背景]"
						LegendaryText:
							'''
							[c/B0D8FF:起初它只是深冰层里遗忘的晶核，独自在寒渊中转动。]
							[c/B0D8FF:后来持有者把它唤作冰霜之拥，让冰钉随呼吸列阵。]
							[c/80C8FF:斩击像环形寒刃，突刺像穿心冰楔，打击像合拢的刑架。]
							[c/80C8FF:它不奖励乱按，只回应节奏、蓄力与形态轮换的时机。]
							[c/A0B0FF:当连击稳定，冰钉会更快，持有者也会获得回复与护甲。]
							[c/A0B0FF:若特攻接连命中，极光会短暂护身，削弱袭来的伤害。]
							[c/E0C0FF:极冰能量充满后，所有冰钉会聚成三层神钻向前贯穿。]
							[c/E0C0FF:终末爆裂会清空这场冰阵，也把战场留给绝对零度。]
							'''
					}
				}
			}
		}

		Projectiles: {
			IceBlockMinion.DisplayName: 极寒冰核
			IceSpikeMinion.DisplayName: 樊寒冰钉
			GlacialEmbraceChargeHoldout.DisplayName: 冰霜蓄力
			IceBladeProj.DisplayName: 极寒裂空斩刃
			IceWedgeProj.DisplayName: 冰楔穿甲
			IcePillarProj.DisplayName: 冰岩重崩柱
			GlacialDrillProj.DisplayName: 维度压缩
		}

		Buffs: {

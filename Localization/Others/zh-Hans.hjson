			TheEnforcer: {
				TheNewEnforcerHoldOut.DisplayName: 新执法者
				NewEssenceFlame2.DisplayName: 新灵魂火
				TheNewEnforcerSlash.DisplayName: 执法斩痕
				OldEssenceFlame2.DisplayName: 旧式灵魂火
			}
		}


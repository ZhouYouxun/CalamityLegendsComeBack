Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				MiaoGun: {
					DisplayName: Pretty Good Gun
					Tooltip:
						'''
						Fires random projectiles
						"Seriously? This again?"
						"It’s only been a few months since we made something like this…"
						"Wait, you’re saying this is our signature style?"
						"...Fine. Have it your way."
						'''
				}

				DesertEagle: {
					DisplayName: Desert Eagle
					Tooltip:
						'''
							Left-click alternates between scattering kinetic-infused bullets and firing powerful life-stealing shots
							Hold right-click to spin the Desert Eagle at high speed, shredding enemies on contact
							When fully charged, left-click unleashes a powerful piercing round
							"Used by legendary marksmen"
						'''
				}

				SHPBow: {
					DisplayName: S.H.P.B.
					Tooltip: "[GFB]"
					ModeName0: Pierce
					ModeName1: Ricochet
					ModeName2: Scatter
					ModeName3: Homing
					SHPB_CurrentSequence: "[c/78E6FF:Current SHP string: {0}]"
					SHPB_Left: "[c/9FD8FF:Left click fires one arrow recipe built from the string, processed from left to right.]"
					SHPB_StackHint: "[c/C7F3FF:Left-click a core in the panel to append it. A full string rolls forward. Right-click a core to reset the string to that core. Repeats are allowed.]"
					SHPB_Mode0: "[c/60E2FF:Pierce layers add speed, penetration, armor penetration, and tighter local hit timing.]"
					SHPB_Mode1: "[c/FFD464:Ricochet layers add tile rebounds and post-hit retargeting range.]"
					SHPB_Mode2: "[c/FF7AAA:Scatter layers split the shot in sequence, with a hard cap on branch count for balance.]"
					SHPB_Mode3: "[c/A476FF:Homing layers increase target search range and steering strength.]"
					SHPB_Right: "[c/F7D87C:Tap right click to open the core panel. Hold right click past 0.15 seconds to charge the whole string, then release when the bar is full.]"
					SHPB_EX: "[c/BAA0FF:Forged beside SHPC, she refused to speak as a cannon; the string gathers the stars, and every full draw feels like a silent verdict.]"
					SHPB_Final: "[c/9FD8FF:Same origin, different form. Where the barrel questioned the world, this string pins four answers into the starlight.]"
				}

				Tetris: {
					DisplayName: Tetris
					Tooltip:
						'''
						Hold this item to unfold a pixel Tetris board.
						A/D or Left/Right moves the falling piece. S or Down soft drops. Space hard drops.
						W, Up, or X rotates clockwise. Z rotates counterclockwise. C stores the current piece.
						Clear full rows to score and survive. If the stack reaches the top, game over. Press R after game over to restart.
						'''
				}

				Snake: {
					DisplayName: Snake
					Tooltip:
						'''
						Hold this item to unfold a pixel Snake board.
						Tap W/A/S/D once to turn the snake. Eat apples to grow longer and faster.
						Hitting a wall or your own body ends the game. Press R after game over to restart.
						'''
				}

				Minesweeper: {
					DisplayName: Minesweeper
					Tooltip:
						'''
						Hold this item to unfold a pixel Minesweeper board.
						Left-click a covered tile to reveal it. Right-click a covered tile to place or remove a flag.
						Numbers show how many mines touch that tile. Revealing a mine ends the game.
						Correctly flag every mine, with no wrong flags, or reveal every safe tile to win. Left-click after the game ends to restart.
						'''
				}

				Strikers1945: {
					DisplayName: 1945
					Tooltip:
						'''
						Hold this item to unfold a vertical retro shooter panel.
						A/D moves left and right. W/S moves forward and back. The plane fires automatically.
						Destroy randomly incoming enemy aircraft to score. Enemy planes, enemy bullets, and collisions cost one life.
						Enemies sometimes drop P upgrades that add extra shots and spread. Lose all three lives and it is game over. Press R to restart.
						'''
				}

				TheNewEnforcer: {
					DisplayName: The New Enforcer
					Tooltip:
						'''
						[c/9C6DFF:Swings through a 240-degree arc, alternating direction with every strike]
						[c/59E8FF:Every swing releases several heavily improved homing essence flames]
						[c/D8C7FF:True melee hits carve multiple execution slashes through the target]
						[c/8A8A8A:The improved flames spawn three old essence flames on impact]
						'''
				}
			}

			Consumables: {
				LegendarySupplyBox: {
					DisplayName: Legendary Supply Box
					Tooltip: Right click to claim the currently available legendary weapons.
				}

				RetroGameConsoleSupplyBox: {
					DisplayName: Retro Game Console Supply Box
					Tooltip: Right click to claim the currently available retro game consoles.
				}
			}
		}

		Projectiles: {
			A_Dev: {
				TetrisPanel.DisplayName: Tetris Board
				SnakePanel.DisplayName: Snake Board
				MinesweeperPanel.DisplayName: Minesweeper Board
				Strikers1945Panel.DisplayName: 1945 Striker Board
				SHPBowHoldout.DisplayName: S.H.P.B. Holdout
				SHPBowSelectionPanel.DisplayName: SHP Core Panel
				SHPBowArrow.DisplayName: SHP Core Arrow
			}

			TheEnforcer: {
				TheNewEnforcerHoldOut.DisplayName: The New Enforcer
				NewEssenceFlame2.DisplayName: New Essence Flame
				TheNewEnforcerSlash.DisplayName: Enforcement Slash
				OldEssenceFlame2.DisplayName: Old Essence Flame
			}
		}

		TheSpecialText: {
			TetrisLevel: LEVEL {0}
			TetrisGameOver: GAME OVER
			TetrisRestart: Press R to restart
			SnakeSpeed: SPEED {0}
			SnakeGameOver: GAME OVER
			SnakeRestart: Press R to restart
			MinesweeperMines: "{0} MINES"
			MinesweeperGameOver: GAME OVER
			MinesweeperWin: You Win
			MinesweeperRestart: Left-click to restart
			Strikers1945GameOver: GAME OVER
			Strikers1945Restart: Press R to restart
		}

		Keybinds: {
			LegendarySkill.DisplayName: Legendary Skill
			LegendaryWeaponFormSwitch.DisplayName: Legendary Weapon Form Switch
		}
	}
}

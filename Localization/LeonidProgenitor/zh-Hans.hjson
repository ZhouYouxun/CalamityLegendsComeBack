Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				LeonidProgenitor: {
					DisplayName: 新传奇 - 狮源流星
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/74D8FF:左键：在身边生成两颗有紫蓝色描边的 狮源陨星-小 依次推向鼠标。]
						[c/99CCFF:陨星命中反射陨星时，增加伤害并偏转向反射陨星，同时将反射陨星推出一小段距离。]
						[c/99CCFF:偏转最多7次后弹射向最近敌怪。每次偏转/弹射增加速度与4%倍率。]
						[c/9AD8FF:注入的金属锭之力会在左键陨星命中、弹射以及终结技等过程中生效。]
						'''
					StealthLeftClick: "[c/B7A4FF:潜伏左键：在鼠标斜上方生成7颗狮源陨星朝斜下方落下，若附近有反射陨星则优先偏转。]"
					RightClick:
						'''
						[c/8DEBFF:右键：长按略微降低移速并于身前蓄力小行星，松开推向鼠标。]
						[c/8DEBFF:碰撞释放7颗逐渐减速并悬停的反射陨星。]
						[c/9AD8FF:长按蓄力时将吸引牵引已有反射陨星，每回收一颗初始获得4%进度。]
						[c/9AD8FF:回收路径上的陨星会环绕运动并造成伤害。]
						[c/5CD6FF:潜伏右键：标记鼠标位置并发射狮子头，到达后咬下造成高额伤害，同时向四周释放14颗反射陨星。]
						'''
					UltimateSkill:
						'''
						[c/FFE85A:终结技（按 {0}）：生成巨大的重力场，上方范围敌人获得”群星重力”减益（速度归零并持续下落），]
						[c/FFE85A:3秒内在上空凝聚大量大小狮源陨星，随后依次落下。在终结能量和潜伏值均达到100%时可用。]
						'''
					Passives:
						'''
						[c/AF80FF:【被动技能】]
						[c/BFAFFF:引力操控：手持时获得重力控制与羽落效果，且免疫扭曲与极限重力。]
						[c/BFAFFF:动能循环：左键发射的陨星每反射3次，伤害额外提升15%。]
						[c/BFAFFF:极点连珠：弹射满7次的左键陨星在飞出一段距离后回到身边做圆周运动，]
						[c/BFAFFF:（最多6个，存在6秒，造成一半伤害）。]
						'''
					CurrentMetals: "[c/CFEFFF:当前注入的锭之力：]"
					EmptyMetalLine: >>> <<<
					MetalLine: >>> {0} {1}：{2} <<<
					LegendaryHint: "[c/BABABA:按住 Shift 读取传奇记录]"
					LegendaryText:
						'''
						[c/66E6FF:最初的流星更像一把会召来陨石的武器，命中之后，让天空继续补上后续坠落。]
						[c/66E6FF:这样的设计已经足够直观，却没有真正解释它为什么会和背包里的金属产生联系。]
						[c/66E6FF:重构后，它不再吞噬材料，而是读取那些被携带的金属回响，并把它们转化为不同的落星。]
						[c/66E6FF:主流星负责打开轨迹，小流星则根据背包中的锭材不断改写坠落方式。]
						[c/66E6FF:它像是在替天空翻找材料，只不过每一次翻找，都会以一次新的撞击结束。]
						'''
					MetalName1: 铜锭
					MetalDesc1: 命中后释放小型连锁闪电
					MetalName2: 锡锭
					MetalDesc2: 本体可以在方块上反弹
					MetalName3: 铁锭
					MetalDesc3: 忽视部分敌人防御
					MetalName4: 铅锭
					MetalDesc4: 产生小型震荡波
					MetalName5: 银锭
					MetalDesc5: 在空中向两侧分裂一次
					MetalName6: 钨锭
					MetalDesc6: 提升流星体积并额外穿透一次
					MetalName7: 金锭
					MetalDesc7: 10% 概率爆出 1 到 3 枚金币弹幕
					MetalName8: 铂金锭
					MetalDesc8: 释放斩杀刀光，目标越虚弱越锋利
					MetalName9: 魔矿锭
					MetalDesc9: 释放小型 EatersBite 吞噬者弹幕
					MetalName10: 猩红矿锭
					MetalDesc10: 释放 VampireKnife 吸血飞刀弹幕
					MetalName11: 天蓝锭
					MetalDesc11: 无重力高速滑翔，沿途甩出天蓝羽刃，命中卷起牵引气旋
					MetalName12: 陨石锭
					MetalDesc12: 夜晚概率追加一颗陨星
					MetalName13: 狱石锭
					MetalDesc13: 死亡时产生更大爆炸
					MetalName14: 钴锭
					MetalDesc14: 命中后随机方向弹射一次
					MetalName15: 钯金锭
					MetalDesc15: 命中回血，带冷却
					MetalName16: 秘银锭
					MetalDesc16: 在周围生成 MythrilFlare，短暂停顿后追踪敌人
					MetalName17: 山铜锭
					MetalDesc17: 命中后从屏幕边缘射出两枚 FlowerPetal
					MetalName18: 精金锭
					MetalDesc18: 产生灼烧区域
					MetalName19: 钛金锭
					MetalDesc19: 短时间获得类似引力靴的跳跃、下落与加速度加成
					MetalName20: 寒元锭
					MetalDesc20: 轻追踪并穿甲，命中生成寒元冰场与延迟收束冰晶
					MetalName21: 神圣锭
					MetalDesc21: 随机位置射出短圣光激光
					MetalName22: 叶绿锭
					MetalDesc22: 主流星和小流星都会自动追踪敌人
					MetalName23: 永恒锭
					MetalDesc23: 沿途播种藤核，命中放出回生光并绽开追踪花瓣
					MetalName24: 蘑菇矿锭
					MetalDesc24: 路径留下旋转消散的小蘑菇
					MetalName25: 幽灵锭
					MetalDesc25: 在初始位置留下幽灵分身
					MetalName26: 熔渣锭
					MetalDesc26: 飞行时甩出熔渣团，命中喷发深渊火柱并灼烧
					MetalName27: 夜明锭
					MetalDesc27: 命中后混合召来 MoonlordArrowTrail 与 LunarFlare
					MetalName28: 炫星锭
					MetalDesc28: 撒下星座节点，命中引爆炫星感染爆点与环形星阵
					MetalName29: 龙蒿
					MetalDesc29: 沿途长出龙蒿藤刺，命中形成会内刺的花冠
					MetalName30: 宇宙锭
					MetalDesc30: 撕开寰宇裂隙并释放会二段追踪的空间碎片
					MetalName31: 圣金锭
					MetalDesc31: 召来金蓝金源天枪，穿甲并留下 Auric Rebuke 脉冲
					MetalName32: 暗影
					MetalDesc32: 留下魔影回响，命中开启吸附裂隙并施加弑神余焰
					MetalName33: 生命合金
					MetalDesc33: 追踪强化，周期三色重构脉冲，命中爆发并放出生命合金光芒
				}

				LPBook: {
					DisplayName: 狮源金属矩阵图鉴
					Tooltip: 打开狮源金属矩阵，显示每一种金属锭的注入效果。
				}
			}
		}


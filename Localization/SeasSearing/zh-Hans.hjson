				SeasSearingMissile.DisplayName: 深渊追踪导弹
				SeasSearingMissileExplosion.DisplayName: 深渊导弹引爆
				SeasSearingNukesplosion.DisplayName: 深渊核爆圈
			}
		}

		Buffs: {
			SeasSearingRadiationBuff: {
				DisplayName: 深渊辐射污染
				Description: 水压、毒素与不稳定深海辐射正在累积
			}
		}
	}

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Malachite: {
					DisplayName: 孔雀翎
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/7DFF9A:左键：]掷出孔雀苦无。
						背后若有潜伏苦无，会优先逐发射出。
						肉后不受重力；歌莉娅/月后数量提升。
						'''
					RightClick:
						'''
						[c/80FFC8:右键：]身后积攒右键羽毛。
						右键会按短间隔全部倾泻。
						普通右羽不会爆炸，也无潜伏增伤。
						'''
					StealthStrike:
						'''
						[c/B5FF74:潜伏左键：]召出23根孔雀石飞镖。
						[c/B5FF74:潜伏右键：]射出所有右键羽毛。
						潜伏右羽命中会爆炸并获得强化。
						'''
					Finale:
						'''
						[c/D6FF9A:大招：]满潜伏且冷却结束时按 [{0}]。
						聚光锁定自身和近敌，花瓣缓落。
						23片花瓣化刃，按距离分配刺向敌人。
						'''
					Passive:
						'''
						[c/9AFFC8:被动（手持）：]
						幻影之刃：左右键潜伏攻击只消耗一半潜伏值，并在使用后恢复 15 点潜伏值。
						遁入暗影：潜伏值高于 50% 时，获得 15% 移速加成。
						灵动步伐：允许擦弹，每次擦弹获得 5 点潜伏值，10 帧冷却。
						'''
					LegendaryHint: "[c/BABABA:按住 Shift 读取记录]"
					LegendaryText: "[c/B5FF74:看似停在影子里，实际上每一根都在等待猎物暴露逃跑的方向。]"
				}
			}

			Accessories: {
				PeacockScroll: {
					DisplayName: 孔雀卷轴
					Tooltip:
						'''
						+10%盗贼伤害
						孔雀翎已挂载右键羽毛时，+15%盗贼攻击速度
						若世纪之花已被击败，辅助孔雀翎更快补充右键羽毛
						'''
				}

				PrecisionEmblem: {
					DisplayName: 精准徽章
					Tooltip:
						'''
						+5%盗贼伤害，+10%盗贼暴击率
						被激发的孔雀翎苦无获得10点护甲穿透
						孔雀苦无和王牌苦无额外造成5%乘算伤害
						'''
				}

				MalachiteFeather: {
					DisplayName: 孔雀石羽毛
					Tooltip:
						'''
						手持孔雀翎时，+15%盗贼伤害，+5%盗贼暴击率，+10%孔雀翎弹幕速度
						没有潜伏孔雀苦无时，每30帧辅助生成一根右键羽毛
						'''
				}

				GaleAce: {
					DisplayName: 疾风王牌
					Tooltip:
						'''
						手持孔雀翎时，+15%盗贼伤害，+5%盗贼暴击率
						中毒减益伤害翻倍
						孔雀翎终结技的花瓣会被吹向面朝一侧
						通过终结技激发的外挂苦无会替换为王牌苦无
						'''
				}

				PeacockBox: {
					DisplayName: 孔雀盒
					Tooltip:
						'''
						孔雀翎在背包中也会积攒右键羽毛
						每60帧积攒1根，满23根后自动发射
						'''
				}

				PeacockDart: {
					DisplayName: 孔雀飞镖
					Tooltip:
						'''
						孔雀翎左键和右键弹幕受重力影响
						这些弹幕造成30%额外伤害
						'''
				}
			}
		}

		Projectiles: {
			Malachite: {
				MalachiteKunai.DisplayName: 孔雀苦无
				MalachiteHitCutVisual.DisplayName: 孔雀翎命中线
				MalachiteGreenExplosion.DisplayName: 孔雀翎爆破
				MalachiteRightFeather.DisplayName: 孔雀石右羽
				MalachiteRightFeatherExplosion.DisplayName: 孔雀石羽爆
				MalachiteRightNovaShard.DisplayName: 孔雀石新星
				MalachiteGrazeSlashVisual.DisplayName: 灵动擦弹斩
				MalachiteFinaleController.DisplayName: 孔雀翎终结式
				MalachiteFinaleSlash.DisplayName: 孔雀翎斩击
				MalachiteFinaleHitSlash.DisplayName: 孔雀翎斩杀
				MalachiteFinaleDart.DisplayName: 孔雀翎飞刃
				MalachiteFinaleImpactExplosion.DisplayName: 孔雀翎灯爆
				MalachiteFinalePetal.DisplayName: 孔雀翎花瓣
			}
		}

		Cooldowns.Malachite_EX: 孔雀翎终结技冷却
	}
}

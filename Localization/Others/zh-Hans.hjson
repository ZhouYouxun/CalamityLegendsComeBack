Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Tetris: {
					DisplayName: 俄罗斯方块
					Tooltip:
						'''
						手持该物品即可展开像素俄罗斯方块面板。
						多人模式下右键邀请最近的、同样手持俄罗斯方块的玩家联机。
						A/D 或左右方向键控制方块左右移动。S 或下方向键快速下落。空格键硬降到底。
						W、上方向键或 X 顺时针旋转。Z 逆时针旋转。C 暂存当前方块。
						游戏结束后按 R 重新开始。
						'''
				}

				Game2048: {
					DisplayName: "2048"
					Tooltip:
						'''
						手持该物品即可展开 4×4 像素 2048 面板。
						使用 W/A/S/D 或方向键滑动全部方块，相同数字每次滑动只会合并一次。
						每次有效滑动都会生成新的 2 或 4。游戏结束后按 R 重新开始。
						'''
				}

				Snake: {
					DisplayName: 贪吃蛇
					Tooltip:
						'''
						手持该物品即可展开像素贪吃蛇面板。
						单次点击 W/A/S/D 控制蛇转向。
						游戏结束后按 R 重新开始。
						'''
				}

				Minesweeper: {
					DisplayName: 扫雷
					Tooltip:
						'''
						手持该物品即可展开像素扫雷面板。
						左键踩雷，右键标记雷，可以反复取消标记
						数字表示周围的地雷数量，不小心踩到雷，会导致游戏直接结束
						标记所有地雷即可获胜，游戏结束后左键点击重新开始。
						[c/6FDFFF:“不是怎么老被炸呀”]
						'''
				}

				STG: {
					Tooltip:
						'''
						手持该物品即可展开纵屏弹幕射击面板。
						A/D 控制左右，W/S 控制前后，飞机会自动开火。
						击落随机来袭的敌机获得分数。命中敌机、敌弹或被敌机撞到都会损失生命。
						敌机偶尔掉落 P 强化，提升子弹数量与散射。三条命耗尽后游戏结束，按 R 重新开始。
						'''
					DisplayName: STG
				}

				SacredThunder: {
					DisplayName: 神圣雷霆
					Tooltip: "[GFB]"
					LegendaryText:
						'''
						丢出雷电神圣飞盘，反复攻击5次后飞回玩家
						潜伏攻击：飞盘停在空中滞留15秒，不断释放越来越多的闪电与圣光，结束后巨型爆炸并消失
						[c/FFE85A:“可是我觉得很神圣啊”]
						[c/6FDFFF:”神圣你雷霆“]
						'''
				}

				LegendaryCodex: {
					DisplayName: 传奇图鉴
					Tooltip: 左键点击以打开传奇武器图鉴面板。
				}

				CTRLBoss: {
					DisplayName: Boss进度与召唤器
					Tooltip: 左键打开或关闭 Boss 进度调试面板，右键打开或关闭 Boss 召唤面板。
				}

				SoundproofEarmuffs: {
					DisplayName: 隔音耳罩
					Tooltip:
						'''
						在背包中右键切换隔音。
						开启后音效降低90%，音乐不受影响。
						当前状态：[STATE]
						'''
					EnabledState: 开启
					DisabledState: 关闭
				}
			}

			Consumables: {
				LegendarySupplyBox: {
					DisplayName: 传奇补给箱
					Tooltip:
						'''
						右键打开，领取目前已经准备好的传奇武器。
						“你根本想象不到在另一个世界的人们想要获得这个箱子两个月的使用权需要经历多少种苦难”
						'''
				}

				RetroGameConsoleSupplyBox: {
					DisplayName: 复古游戏机补给包
					Tooltip: 右键打开，领取目前已经准备好的复古游戏机。
				}

				QuickStartBox: {
					DisplayName: 快速发展道具箱
					Tooltip:
						'''
						右键打开，获得一些快速发展的强力装备、海量药水与物资。
						【注意：这个道具很破坏平衡，想好了再开启】
						'''
				}

				Prime2041Summoner: {
					DisplayName: 奇怪的机械骷髅头
					Tooltip:
						'''
						这将召唤一个来自 2.0.4.1 版本的机械骷髅王
						必须在大师模式召唤才有效
						仅在夜间可用
						'''
				}

				Destroyer2041Summoner: {
					DisplayName: 奇怪的机械蠕虫
					Tooltip:
						'''
						这将召唤一个来自 2.0.4.1 版本的毁灭者
						必须在大师模式召唤才有效
						仅在夜间可用
						'''
				}

				Twins2041Summoner: {
					DisplayName: 奇怪的机械晶状体
					Tooltip:
						'''
						这将召唤一个来自 2.0.4.1 版本的双子魔眼
						必须在大师模式召唤才有效
						仅在夜间可用
						'''
				}
			}

			LegendaryEmblem: {
				DisplayName: 黄金饰章
				Tooltip: 使用后永久解锁此角色手持所有传奇武器的大招
				AlreadyConsumed: 这个角色已经获得了黄金饰章的永久强化。
				UnconsumedStatus: 这个角色尚未获得黄金饰章的永久强化。
				ConsumedStatus: 这个角色已经获得黄金饰章的永久强化。
			}

			LegendaryUltimateTester: {
				DisplayName: 传奇大招测试器
				Tooltip: 仅限测试用：所有传奇武器的大招会在1秒内充能完成
			}

			TestWeapon: {
				// DisplayName: Test Weapon
				// Tooltip: ""
			}
		}


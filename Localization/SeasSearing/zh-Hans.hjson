Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				SeasSearing: {
					DisplayName: 海之烧灼：传奇归来
					Tooltip: "[GFB]"
					Intro: "[c/58FFDA:深海辐射步枪。污染会累积、扩散，并在指令下崩坏。]"
					LeftClick_Stage0: "[c/9AEAFF:左键：单发精准射击。每次命中叠加深渊辐射污染。]"
					LeftClick_Stage1: "[c/9AEAFF:左键：二连点射。每次命中叠加深渊辐射污染。]"
					LeftClick_Stage2:
						'''
						[c/9AEAFF:左键：二连点射。每次命中叠加深渊辐射污染。]
						[c/4CD268:每颗子弹命中时散布 2–4 颗污染气泡。]
						'''
					LeftClick_Stage3:
						'''
						[c/9AEAFF:左键：三连点射。每次命中叠加污染并散布污染气泡。]
						[c/58FFDA:射击结束后：发射一枚天鳍鱼雷 + 污染火箭弹。]
						'''
					LeftClick_Stage4:
						'''
						[c/9AEAFF:左键：四连点射。每次命中散布污染气泡。]
						[c/58FFDA:射击结束后：发射一枚天鳍鱼雷 + 污染火箭弹。]
						[c/FF8A30:最后一颗子弹命中触发核爆，造成 2× 弹药伤害，拥有独立无敌帧。]
						'''
					LeftClick_Stage5:
						'''
						[c/9AEAFF:左键：四连点射。每发子弹同时发射一枚天鳍鱼雷。]
						[c/FF8A30:第 4 枚鱼雷升级为追踪导弹：2× 伤害，200×200 爆炸，并释放尖刺弹幕。]
						[c/FF8A30:最后一颗子弹命中触发核爆。]
						'''
					RightClick:
						'''
						[c/58FFDA:右键·三段压力协议：蓄力→松开=压力炮弹(击中生成追踪卫星气泡)；]
						[c/58FFDA:继续蓄力锁定→松开=强化炮弹+80帧增强连射窗口；]
						[c/58FFDA:蓄力至极限→深渊裂变：三道海渊喷柱引爆全场污染，左键变为快速酸液连射模式持续2秒。]
						'''
					Passive: "[c/4CD268:手持：释放深渊水压领域，迟滞附近敌人并缓慢播撒污染。]"
					Ultimate: "[c/FF8A30:大招（空对地核导弹）：按下] [[c/FF8A30:{0}]] [c/FF8A30:标定目标，引导深海热核打击。核爆会让幸存者获得巨量污染。]"
					LegendaryHint: "[c/BABABA:按住 Shift 读取灾害记录]"
					LegendaryText:
						'''
						[c/58FFDA:最初的海之烧灼只需要完成一件事：把子弹打进目标体内，让污染开始扩散。]
						[c/4CD268:这种设计已经很适合硫磺海，却容易把灾害变成单纯的持续伤害数字。]
						[c/58FFDA:重构后，每一次射击都会留下灾难坐标，污染云、裂光与酸蚀会在战场上逐步叠加。]
						[c/4CD268:右键不再只是补伤害，而是选择何时引爆那些已经感染的区域。]
						[c/FF8A30:当最终打击落下，真正爆开的不是一发子弹，而是此前所有污染共同指向的崩坏。]
						'''
				}
			}
		}

		Projectiles: {

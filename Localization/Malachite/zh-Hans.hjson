Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Malachite: {
					DisplayName: 孔雀翎
					Tooltip: "[GFB]"
					LeftClick: "[c/7DFF9A:左键：]掷出高速苦无，命中敌人会造成中毒。普通苦无会轻微下坠，飞行越久越接近无视重力；若背后已有孔雀苦无，会优先逐把投出孔雀苦无；没有孔雀苦无时再投出急疯苦无。"
					RightClick: "[c/80FFC8:右键：]在身后生成 3 把急疯苦无构成刀扇。急疯苦无倍率更高、能够穿透且不受重力影响；冷却 3 秒。它们可以和 23 把孔雀苦无共存；只有已存在完整急疯刀扇时，才会先激发急疯批再重新挂上 3 把。"
					StealthStrike: "[c/B5FF74:潜伏攻击：]潜伏左键和潜伏右键完全相同：若背后已有 1-23 根孔雀苦无，会先按左键弹幕一齐射出，再重新挂满 23 根孔雀苦无。孔雀苦无不能穿透但会追踪目标；王牌苦无命中时引发迷你爆破。"
					Finale: "[c/D6FF9A:终结技：]满潜伏且冷却结束时按 [{0}]，绿色聚光灯落下，花瓣飘坠；2 秒后挥出孔雀翎斩击，并在周边敌怪身上引发多段绿色爆炸。"
					Passive:
						'''
						[c/9AFFC8:被动（手持）：]
						灵动步伐：允许擦弹，每次擦弹获得 1 点潜伏值。
						幻影之刃：使用潜伏攻击后恢复 15 点潜伏值。
						遁入暗影：潜伏值高于 50% 时，获得 15% 伤害减免与移速加成。
						'''
					LegendaryHint: "[c/BABABA:按住 Shift 读取记录]"
					LegendaryText:
						'''
						[c/B5FF74:看似停在影子里，实际上每一根都在等待猎物暴露逃跑的方向。]
						'''
				}
			}
		}

		Projectiles: {
			Malachite: {
				MalachiteKunai.DisplayName: 孔雀苦无
				MalachiteGreenExplosion.DisplayName: 孔雀翎爆破
				MalachiteFinaleController.DisplayName: 孔雀翎终结式
				MalachiteFinaleSlash.DisplayName: 孔雀翎斩击
			}
		}

		Cooldowns.Malachite_EX: 孔雀翎终结技冷却
	}
}

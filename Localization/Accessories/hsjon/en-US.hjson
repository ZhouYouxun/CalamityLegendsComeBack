Mods: {
	CalamityLegendsComeBack: {
		Items: {
			LegendaryEmblem: {
				DisplayName: Legendary Emblem
				Tooltip: Must be equipped to activate legendary weapon ultimates
			}

			LegendaryUltimateTester: {
				DisplayName: Legendary Ultimate Tester
				Tooltip: Test accessory: legendary weapon ultimates fully recharge in 1 second
			}

			TestItem: {
				DisplayName: PF Test Item
				Tooltip: While equipped, Pristine Fury single right clicks cycle imprints for testing
			}

			FastChargeModule: {
				DisplayName: Fast Charge Module
				Tooltip: Halves the maximum charge time of the EX super laser, but also halves the player's life regeneration
			}

			ChargedDiffusionChip: {
				DisplayName: Charged Diffusion Chip
				Tooltip: Left click scatters five energy orbs at once, but each deals only 30% damage
			}

			CommandAscend: {
				DisplayName: Command: Ascend
				Tooltip: While holding SHPC, right click switches to a mortar holdout that automatically charges and fires weakly guided bombardment shells
			}

			MilitaryCaller: {
				DisplayName: Military Caller
				Tooltip:
					'''
					While holding SHPC, right click switches to Military Caller mode
					This mode does not use the right-click heat system
					Fires a tech beacon that air-drops one friendly Calamity tech turret
					Each call has a base cost of 40 mana
					Up to 8 turrets can exist at once
					Deploying a ninth turret makes the oldest turret explode in place
					Each turret lasts up to 5 minutes
					Deployment fails within 18 tiles of another turret
					Biome turret mapping:
					Jungle = Plague; Snow = Ice; Underworld or Brimstone Crags = Fire
					Ocean, Sulphurous Sea, Abyss, or Sunken Sea = Water
					Astral, Hallow, or Sky = Laser
					Desert or Evil biome = Onyx; other biomes = Lab
					'''
			}

			Barrier: {
				DisplayName: Barrier
				Tooltip: While holding SHPC, charges a shield equal to 25% of maximum life rounded down to a multiple of 5. Damage resets a 10-second recharge delay, then the shield fully charges over 5 seconds. While active, it reduces pre-defense damage by 10%
			}

			TacticalComputer: {
				DisplayName: Tactical Computer
				Tooltip: Gives SHPC right click automatic lock-on
			}

			HeatRedirectModule: {
				DisplayName: Heat Redirect Module
				Tooltip:
					'''
					SHPC right-click shots generate 20% more heat and natural heat dissipation is reduced by 33%
					Each heat level grants an additional 33% SHPC right-click damage
					Forced shutdown releases an expanded smoke field that repeatedly damages nearby enemies
					At maximum Heat V, continued fire constantly releases damaging smoke fields around the player
					'''
			}

			ProjectilePossessionModule: {
				DisplayName: Projectile Possession Module
				Tooltip:
					'''
					While holding SHPC, right click switches to projectile possession mode
					Hold right click to absorb nearby hostile projectiles in a vacuum cone
					Stores up to 15 projectiles; release right click to convert them into friendly projectiles and fire them forward
					Projectiles with more than 3600 damage or more than 3600 time left cannot be absorbed
					Some persistent beams and blacklisted projectiles are ignored
					'''
			}

			WastelandEnergyCore: {
				DisplayName: Wasteland Energy Core
				Tooltip:
					'''
					+7% SHPC damage
					SHPC left-click mana cost -8%; right-click mana cost -12%
					SHPC left click gains 1 extra soul canister and loads 25% more ammo rounded up to a multiple of 5
					While holding SHPC, stand still and cease fire to rapidly restore mana
					Automatically drinks mana potions when needed
					'''
			}

			EverfrostEnergyCore: {
				DisplayName: Everfrost Energy Core
				Tooltip:
					'''
					+15% SHPC damage
					SHPC left-click mana cost -10%; right-click mana cost -20%; left click has a 20% chance not to consume ammo
					SHPC left click gains 2 extra soul canisters and loads 50% more ammo rounded up to a multiple of 5
					While holding SHPC, stop moving horizontally and cease fire to rapidly restore mana
					Automatically drinks mana potions when needed
					Shortens right-click startup
					'''
			}

			EvolutionEnergyCore: {
				DisplayName: Evolution Energy Core
				Tooltip:
					'''
					+15% SHPC damage, +5% critical strike chance, allows right-click critical hits
					SHPC left-click mana cost -15%; right-click mana cost -30%; left click has a 20% chance not to consume ammo
					SHPC left click gains 3 extra soul canisters and loads 75% more ammo rounded up to a multiple of 5
					While holding SHPC, cease fire to rapidly restore mana
					Automatically drinks mana potions when needed
					Shortens right-click startup
					'''
			}

			StarstreamEnergyCore: {
				DisplayName: Starstream Energy Core
				Tooltip:
					'''
					+20% SHPC damage, +10% critical strike chance, allows right-click critical hits
					While holding SHPC, gain infinite mana; left click has a 50% chance not to consume ammo
					SHPC left click gains 4 extra soul canisters and loads 100% more ammo rounded up to a multiple of 5
					Shortens right-click startup
					'''
			}

			OffshoreWindTurbine: {
				DisplayName: Offshore Wind Turbine
				Tooltip: Increases Briny Baron's maximum tide by 2
			}

			ImpactRestarter: {
				DisplayName: Impact Restarter
				Tooltip: Briny Baron's short right-click dash fully refreshes its cooldown on enemy impact\nThe full-tide spin dash reduces that cooldown to 1 second instead
			}

			HighTideOverloadBarrier: {
				DisplayName: High-Tide Overload Barrier
				Tooltip: While Briny Baron's tide is full, grants 20 defense and 20% damage reduction
			}

			SurgeChainReactor: {
				DisplayName: Surge Chain Reactor
				Tooltip: Briny Baron's quick slash releases an extra 75x75 water burst on enemy impact
			}

			ATunedQuiver: {
				DisplayName: Tuned Quiver
				Tooltip:
					'''
					+15% ranged damage
					+4 defense
					Grants arrow speed bonuses. Each BlossomFlux doctrine receives a different bonus.
					Recipe: Magic Quiver + 10 Jungle Spores + 5 Vines @ Anvil
					'''
			}

			BResonatingQuiver: {
				DisplayName: Resonating Quiver
				Tooltip:
					'''
					+15% ranged damage
					+5% ranged critical strike chance
					+15 ranged projectile armor penetration
					+6 defense
					Grants arrow speed bonuses. Each BlossomFlux doctrine receives a different bonus.
					Recipe: Tuned Quiver + Ranger Emblem + 5 Life Alloys + 5 Galactica Singularities @ Ancient Manipulator
					'''
			}

			CDominationQuiver: {
				DisplayName: Domination Quiver
				Tooltip:
					'''
					+15% ranged damage
					+5% ranged critical strike chance
					+15 ranged projectile armor penetration
					+16 defense
					+15% maximum life
					Grants arrow speed bonuses. Each BlossomFlux doctrine receives a different bonus.
					All attacks pass through walls and ignore defense.
					Recipe: Resonating Quiver + 10 Reaper Teeth + 10 Ruinous Souls @ Ancient Manipulator
					'''
			}

			PastLingering: {
				DisplayName: Lingering Remnant
				Tooltip:
					'''
					Changes Breakthrough into a Phantasm-like mode: arrows are no longer converted and release strongly homing shards after hitting enemies.
					Continuous fire gradually increases attack speed. Reaching the maximum tier plays an extra sound.
					Recipe: Phantasm + 12 Luminite Bars + 5 Vortex Fragments @ Ancient Manipulator
					'''
			}

			SeedOfSilva: {
				DisplayName: Seed of Silva
				Tooltip:
					'''
					Generates five seeds that slowly orbit the player and emit a faint green glow.
					While holding BlossomFlux, the seeds bloom into different flowers based on the current doctrine.
					Breakthrough: Sunflower
					Sunflowers create a small field. Breakthrough arrows passing through it gain 30% damage and 15% critical strike chance.
					Recovery: Daisy
					Daisies have 15 maximum life, regenerate 1.2 life per second, and inherit the player's defense and damage reduction.
					If a daisy takes 20 or more damage, it heals the player for its stored regenerated life, rounded down.
					Reconnaissance: Delphinium
					Delphiniums attack nearby enemies once every 1.5 seconds with a curving arc that deals light damage and stuns for 1 second.
					Stunned enemies are heavily slowed and take double damage from reconnaissance arrows.
					Enemies immune to knockback only receive the damage bonus, reduced to 1.15x.
					Each successful delphinium stun restores 0.5 seconds of flight time.
					Bombardment: Torchflower
					Torchflowers spray flames when enemies approach.
					Arrows passing through a torchflower also trigger an explosion with an independent cooldown.
					Plague: Mandrake
					Mandrakes slow nearby enemies and reduce their contact damage by 15%.
					Mandrakes constantly create spores, like a Spore Sac, applying debuffs for 3 seconds each. Their cap follows the current weapon.
					Mandrakes also occasionally fire homing withering-flower projectiles that paralyze and slow enemies.
					Recipe: Bloom Stone + 50 Planty Mush + 10 Auric Bars @ Mythril Anvil
					'''
			}

			SilvaHarp: {
				DisplayName: Silva Harp
				Tooltip:
					'''
					+5 life per second. This regeneration cannot be reduced by any factor.
					+60 frames of invincibility after taking damage.
					Modern Silva's revival invincibility is increased to 10 seconds.
					During that invincibility, incoming life loss is reduced to 10%.
					After the revival ends, life is restored to at least 50% of maximum life, and the cooldown can tick during boss fights.
					Massively reduces the revival effect cooldown.
					Recipe: 12 Effulgent Feathers + 30 Planty Mush + 12 Gold Bars + 3 Divine Geodes @ Cosmic Anvil
					'''
			}

			GuZhou: {
				DisplayName: Long Barge
				Tooltip:
					'''
					+10% generic magic damage
					While holding SunderBlade, gain an additional +5% magic damage
					When SunderBlade consumes Breath of Transformation, each consumed stack grants +5% magic damage for 20 seconds; repeated triggers reset the duration
					Consuming Breath of Transformation during Empyrean of Truth slows the locked non-worm enemy by 15%
					'''
			}

			YiGanYiYing: {
				DisplayName: Sense and Response
				Tooltip:
					'''
					+50 maximum mana
					-15% mana cost
					When SunderBlade's right click consumes Breath of Transformation, each active SunderBlade sword grants +2% magic damage for 5 seconds
					During Empyrean of Truth, each sword instead grants +3% magic damage for 15 seconds
					This damage bonus is recalculated and its duration reset the next time Breath of Transformation is consumed
					'''
			}

			QianDingWanDing: {
				DisplayName: Absolute Composure
				Tooltip:
					'''
					+100 maximum mana
					-15% mana cost
					Increases SunderBlade sword effect radius from 50 tiles to 75 tiles
					Up to 3 SunderBlade swords orbit the player on an elliptical path and act as mobile turrets
					SunderBlade right-click lightning grants 7 ultimate energy on hit instead of 6
					Four Symbols of Harmony creates swords every 6 seconds instead of every 10 seconds
					'''
			}

			FengYunZhiBian: {
				DisplayName: Storm of Transform
				Tooltip:
					'''
					SunderBlade damage +15%
					SunderBlade attacks inflict Static Discharge for 1.5 seconds
					Empyrean of Truth duration increases from 25 seconds to 30 seconds
					During Empyrean of Truth, gain an additional +9% magic damage and 36 magic armor penetration
					'''
			}

			JiDianFa: {
				DisplayName: Jolting Arts
				Tooltip:
					'''
					Double-tap a horizontal direction to become lightning and dash; dash direction follows your current velocity vector
					Briefly grants invincibility during the dash and leaves modest momentum in the same direction
					If the Calamity dash hotkey is bound, the bound single-sword dash takes priority
					While holding SunderBlade, dash distance +30% and dash cooldown -30%
					While holding SunderBlade, dashing releases up to 3 lightning bolts based on nearby SunderBlade swords, with a 15-second cooldown
					'''
			}

			GaleAce: {
				DisplayName: Gale Ace
				Tooltip: ""
			}


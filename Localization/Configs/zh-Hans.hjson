Mods: {
	CalamityLegendsComeBack: {
		Configs: {
			CalamityLegendsComeBackConfig: {
				DisplayName: 传奇归来设置

				AllowMassMaterialRecipes: {
					Label: 允许大量材料可制作
					Tooltip: 开启后可以允许大量材料以较简单的方式进行复制或制作
				}

				AllowBossRelicWeaponRecipes: {
					Label: 允许 Boss 遗物兑换武器
					Tooltip: 开启后，可以用部分 Boss 遗物制作对应掉落武器。
				}

				AllowOtherRecipes: {
					Label: 允许额外 QOL 配方
					Tooltip: 开启后，会加入部分改善流程体验的额外配方。
				}

				AllowWheelSlowdown: {
					// Label: Allow Wheel Slowdown
					// Tooltip: ""
				}

				GiveQuickStartBoxOnSpawn: {
					// Label: Give Quick Start Box On Spawn
					// Tooltip: ""
				}
			}

			CLCBClientConfig: {
				DisplayName: 传奇归来客户端设置

				ShowMatrixBossBar: {
					Label: 显示矩阵风格Boss血条
					Tooltip: 开启后，在屏幕正上方居中显示我们自制的矩阵风格 Boss 血条。
				}

				ShowInternalEnglishNames: {
					Label: 显示内部英文名
					Tooltip: 开启后，当游戏语言不是英文时，会在所有物品的提示名称后追加其内部英文名。
				}
			}
		}
	}
}

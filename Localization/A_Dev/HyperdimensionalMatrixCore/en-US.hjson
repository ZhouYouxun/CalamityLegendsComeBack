Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				HyperdimensionalMatrixCore: {
					DisplayName: Hyperdimensional Matrix
					Tooltip:
						'''
						[c/7EB8FF:Summons the Matrix Core — a development engine made manifest; damage scales substantially with minion slots]
						[c/FF9040:Autonomously cycles five modules: Data Grid · Geometry Burst · Geo Satellites · Metaball Fusion · Space Warp]
						[c/FFEC40:Periodically erupts into Compile Storm — all modules fire simultaneously; the wielder briefly becomes invincible]
						[c/5880C0:Fortifies your body · reduces incoming damage · regenerates life · accelerates movement · reduces aggro]
						[c/FF3030:Overclocks all module cycles when critically wounded; passively damages all nearby enemies]
						[c/787888:"You did not summon a minion. You instantiated a runtime."]
						'''
				}
			}
		}


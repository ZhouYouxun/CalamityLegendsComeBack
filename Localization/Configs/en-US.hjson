Mods: {
	CalamityLegendsComeBack: {
		Configs: {
			CalamityLegendsComeBackConfig: {
				DisplayName: Calamity Legends Come Back Settings

				Headers: {
					RecipeSettings: Recipe Settings
					DraedonTechnology: Draedon Technology
				}

				AllowMassMaterialRecipes: {
					Label: "[i:CrystalBall] Allow Bulk Material Crafting"
					Tooltip: Allows many in-game raw materials to be crafted quickly
				}

				AllowBossRelicWeaponRecipes: {
					Label: "[i:CalamityMod/ProvidenceRelic] Allow Boss Relic Weapon Exchanges"
					Tooltip: Allows Master or Revenge Mode relics to be exchanged directly for weapons
				}

				AllowOtherRecipes: {
					Label: "[i:Toolbox] Allow Extra QOL Recipes"
					Tooltip: Enables many recipes that improve gameplay flow
				}

				AllowBossSummonShop: {
					Label: "[i:BestiaryGirl] Allow Zoologist Boss Summons"
					Tooltip: The Zoologist sells Boss summons at the appropriate progression; a few recipes that would return pre-kill materials are temporarily disabled.
				}

				LightningDecryption: {
					Label: "[i:CalamityMod/CodebreakerBase] Rapid Decryption and Charging"
					Tooltip: Codebreaker schematics and charging-station lab-seeking mechanisms complete within one second while retaining their normal power-cell costs
				}
			}

			CLCBClientConfig: {
				DisplayName: Calamity Legends Come Back Client Settings

				Headers: {
					Interface: Interface
					Readability: Readability
				}

				ShowMatrixBossBar: {
					Label: "[i:CalamityMod/DraedonsHeart] Custom Health Bar Display"
					Tooltip: Displays a new custom health bar at the top of the screen
				}

				ShowInternalEnglishNames: {
					Label: "[i:Book] Show Internal English Names"
					Tooltip: Enabled by default and shows an item's internal name while viewing it but has no effect when the game language is English
				}

				ShowHostileProjectileOutlines: {
					Label: "[i:RainbowGun] Show Hostile Projectile Outlines"
					Tooltip: Makes enemy projectile borders easier to see
				}
			}
		}
	}
}

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Summon: {
					GlacialEmbrace: {
						DisplayName: 冰霜之拥 · 传奇归来
						Tooltip: "[GFB]"

						// ═══════════════════════════════════════════════════════════
						//  GE_Intro — 顶部模式显示 + 基础提示
						// ═══════════════════════════════════════════════════════════
						GE_Intro:
							'''
							[c/7BC8E5:当前战斗形态：{0}]
							[c/A0D8EF:召唤系传奇武器 — 基础伤害 48，法力消耗 10]
							[c/A0D8EF:左键：召唤樊寒冰刺环绕守护；仆从栏满时转为蓄力特殊攻击。]
							[c/A0D8EF:首次使用自动召唤极寒冰核（不占仆从栏），作为辅助核心运作。]
							[c/A0D8EF:所有攻击命中均施加霜冻灼烧（持续 5 秒）。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_ModeName0/1/2 — 模式名称（供 C# GetLocalizedValue 调用）
						// ═══════════════════════════════════════════════════════════
						GE_ModeName0: 斩击模式
						GE_ModeName1: 突刺模式
						GE_ModeName2: 打击模式

						// ═══════════════════════════════════════════════════════════
						//  GE_LeftClickFlow — 左键召唤流程总览
						// ═══════════════════════════════════════════════════════════
						GE_LeftClickFlow:
							'''
							[c/A0D8EF:◆ 左键 — 召唤流程]
							[c/A0D8EF:第一步：若场上无极寒冰核，优先召唤冰核（0 仆从栏），锚定为冰刺系统核心。]
							[c/A0D8EF:第二步：若仆从栏未满，召唤樊寒冰刺环绕玩家，行为随当前形态而变。]
							[c/A0D8EF:第三步：若仆从栏已满，生成蓄力器进入蓄力特殊攻击。]
							[c/A0D8EF:打击模式特别条件：冰刺已列阵时，左键直接触发碰撞轰击。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_ModeLeft0 — 斩击模式：冰刺行为
						// ═══════════════════════════════════════════════════════════
						GE_ModeLeft0:
							'''
							[c/90FFB0:◈ 斩击模式 — 冰刺行为]
							[c/90FFB0:仆从栏消耗降至 0.5，可召唤双倍数量的冰刺。]
							[c/90FFB0:每根冰刺分裂为内环晶体与外环晶体，双层旋转守护：]
							[c/90FFB0:  · 内环晶体：轨道半径 90px，角速度 4°/帧，伤害倍率 ×0.85]
							[c/90FFB0:  · 外环晶体：轨道半径 140px，角速度 2.8°/帧，伤害倍率 ×1.35]
							[c/90FFB0:每颗晶体对同一敌人每完整旋转周期仅命中一次，避免重复计伤。]
							[c/90FFB0:适合需要大范围覆盖与持续压制的场景。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_ModeLeft1 — 突刺模式：冰刺行为
						// ═══════════════════════════════════════════════════════════
						GE_ModeLeft1:
							'''
							[c/80EFFF:◈ 突刺模式 — 冰刺行为]
							[c/80EFFF:仆从栏消耗 1.0，以 90px 半径环绕玩家旋转。]
							[c/80EFFF:环绕 3 秒后自动锁定 800px 范围内的目标，以速度 16 飞出。]
							[c/80EFFF:冰刺嵌入敌人体内，每个敌人最多嵌入 6 根；超出上限的冰刺碎裂消散。]
							[c/80EFFF:引爆方式：]
							[c/80EFFF:  · 鞭击命中目标：随机引爆该目标上 1 根嵌入冰刺]
							[c/80EFFF:  · 冰棘穿甲楔命中目标：引爆该目标上全部嵌入冰刺]
							[c/80EFFF:引爆后冰刺脱嵌，以速度 18 贯穿飞射，造成二次伤害。]
							[c/80EFFF:适合单体高爆发输出，搭配鞭类武器效果尤佳。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_ModeLeft2 — 打击模式：冰刺行为
						// ═══════════════════════════════════════════════════════════
						GE_ModeLeft2:
							'''
							[c/FF8B60:◈ 打击模式 — 冰刺行为]
							[c/FF8B60:仆从栏消耗 1.0，冰刺以尖端朝内的姿态环绕玩家。]
							[c/FF8B60:6 秒冷却结束后，所有活跃冰刺自动向光标方向列阵为两翼夹击阵型。]
							[c/FF8B60:列阵完成时左键点击：触发碰撞轰击 —— ]
							[c/FF8B60:  · 冰刺从两翼急速冲撞汇合至中心点]
							[c/FF8B60:  · 碰撞产生太阳鞭爆破，伤害倍率 ×2.2]
							[c/FF8B60:  · 碰撞后冰刺进入 4 秒休眠期，无法行动]
							[c/FF8B60:两次列阵间有 6 秒冷却时间。]
							[c/FF8B60:适合精确控制战场节奏，对大型目标效果显著。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_Charge — 蓄力攻击总览（仆从栏满时）
						// ═══════════════════════════════════════════════════════════
						GE_Charge:
							'''
							[c/A0D8EF:◆ 蓄力攻击（仆从栏满时按住左键）]
							[c/A0D8EF:蓄力时长 45 帧（约 0.75 秒），卡点甜区在第 35-45 帧之间。]
							[c/A0D8EF:完美卡点释放：伤害倍率 ×1.5。]
							[c/A0D8EF:所有蓄力弹幕命中均触发 OnSpecialHitNPC()，每次 +4 终结技能量。]
							[c/A0D8EF:蓄力释放同时触发霜冻节奏 QTE 判定。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_ChargeSlash — 斩击模式蓄力弹幕
						// ═══════════════════════════════════════════════════════════
						GE_ChargeSlash:
							'''
							[c/90FFB0:斩击蓄力 → 极寒裂空斩刃（IceBladeProj）]
							[c/90FFB0:生成 160×160 的巨型旋转冰刃。]
							[c/90FFB0:在 30 帧内完成 2 圈完整旋转，覆盖范围极广。]
							[c/90FFB0:NPC 无敌帧仅 8 帧，可在短时间内造成多段伤害。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_ChargePierce — 突刺模式蓄力弹幕
						// ═══════════════════════════════════════════════════════════
						GE_ChargePierce:
							'''
							[c/80EFFF:突刺蓄力 → 冰棘穿甲楔（IceWedgeProj）]
							[c/80EFFF:具有轻微追踪能力的穿刺弹幕。]
							[c/80EFFF:命中目标时引爆该目标上所有嵌入的樊寒冰刺。]
							[c/80EFFF:与突刺模式的嵌入机制完美联动，实现连锁爆破。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_ChargeStrike — 打击模式蓄力弹幕
						// ═══════════════════════════════════════════════════════════
						GE_ChargeStrike:
							'''
							[c/FF8B60:打击蓄力 → 冰岩重崩柱（IcePillarProj）]
							[c/FF8B60:受重力影响的巨型冰柱，自上而下砸落。]
							[c/FF8B60:命中时强制施加 Boss 击退：击退速度 = 方向向量 × 3.5。]
							[c/FF8B60:引爆场上所有非休眠状态的樊寒冰刺。]
							[c/FF8B60:落地处产生 1.5 倍伤害的范围爆炸。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_PassiveFrostRhythm — 被动1：霜冻节奏（QTE 系统）
						// ═══════════════════════════════════════════════════════════
						GE_PassiveFrostRhythm:
							'''
							[c/B0E0FF:◇ 被动 — 霜冻节奏（QTE 卡点系统）]
							[c/B0E0FF:切换战斗形态时触发节奏卡点 QTE：]
							[c/B0E0FF:  · 时间窗口 40 帧，甜区为进度的 70%-90%]
							[c/B0E0FF:  · 在甜区内再次按下切换键即为成功]
							[c/B0E0FF:蓄力释放时亦触发 QTE：甜区在第 35-45 帧之间。]
							[c/B0E0FF:卡点成功：连击数 +1（上限 20）。]
							[c/B0E0FF:卡点失败或超时：连击数归零，冰川神性立即消失。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_ComboBonus — 连击加成明细
						// ═══════════════════════════════════════════════════════════
						GE_ComboBonus:
							'''
							[c/B0E0FF:连击加成明细：]
							[c/B0E0FF:  · 生命恢复 + 连击数÷2（最高 +10 回复/秒）]
							[c/B0E0FF:  · 防御力 + (连击数÷4)×8（最高 +40 防御）]
							[c/B0E0FF:  · 每达成 5 次连击：恢复 60 帧翅膀飞行时间]
							[c/B0E0FF:  · 连击数 ≥10：触发"冰川神性"增益，持续 5 秒]
							[c/B0E0FF:冰川神性效果：所有冰刺旋转速度 ×1.1，视觉光效增强。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_PassiveAurora — 被动2：极光旋律
						// ═══════════════════════════════════════════════════════════
						GE_PassiveAurora:
							'''
							[c/C8A0FF:◇ 被动 — 极光旋律]
							[c/C8A0FF:当特殊弹幕（蓄力弹幕或终结技弹幕）在 0.75 秒（45 帧）内连续命中敌人时触发。]
							[c/C8A0FF:触发后获得极光旋律增益，持续 5 秒：]
							[c/C8A0FF:  · 防御力 +10]
							[c/C8A0FF:  · 受到的所有伤害减少 15%（防御计算前生效）]
							[c/C8A0FF:反复触发可刷新持续时间。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_Ultimate — 终结技：至臻极冰之樊寒神钻
						// ═══════════════════════════════════════════════════════════
						GE_Ultimate:
							'''
							[c/A0F0FF:★ 终结技 — 至臻极冰之樊寒神钻]
							[c/A0F0FF:能量达到 240 后按] [[c/A0F0FF:{1}]] [c/A0F0FF:释放。]
							[c/A0F0FF:充能来源：每次特殊弹幕命中 +4 能量（需 60 次命中充满）。]
							[c/A0F0FF:基础伤害：武器面板伤害 × 2.5 = 120。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_UltimateDetail — 终结技详细阶段
						// ═══════════════════════════════════════════════════════════
						GE_UltimateDetail:
							'''
							[c/A0F0FF:终结技阶段详解：]
							[c/A0F0FF:  ① 集结（1.5 秒）]
							[c/A0F0FF:    所有场上冰刺被消灭并重生为钻头组件。]
							[c/A0F0FF:    最多 30 根冰刺分三层集结于玩家周围。]
							[c/A0F0FF:  ② 闪耀（0.33 秒）]
							[c/A0F0FF:    释放十字星芒视觉爆发，宣告神钻降临。]
							[c/A0F0FF:  ③ 冲锋（3 秒）]
							[c/A0F0FF:    以速度 12 朝光标方向冲锋。]
							[c/A0F0FF:    NPC 无敌帧仅 3 帧，实现极速连击。]
							[c/A0F0FF:    冲锋期间玩家位置固定并完全免疫伤害。]
							[c/A0F0FF:  ④ 碎裂]
							[c/A0F0FF:    造成 6.0 倍钻头伤害的 AoE 范围爆炸。]
							[c/A0F0FF:    屏幕震动强度 10.0；重置所有增益状态与连击数。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_UltimateBonus — 超额仆从栏加成
						// ═══════════════════════════════════════════════════════════
						GE_UltimateBonus: "[c/A0F0FF:超额加成：仆从栏超过 10 时，终结技每超出 1 栏伤害 +3%。]"

						// ═══════════════════════════════════════════════════════════
						//  GE_FormSwitchHint — 形态切换按键提示
						// ═══════════════════════════════════════════════════════════
						GE_FormSwitchHint: "[c/F7D87C:按下] [[c/F7D87C:{0}]] [c/F7D87C:切换攻击形态，同时触发霜冻节奏卡点判定。]"

						// ═══════════════════════════════════════════════════════════
						//  GE_SkillHint — 终结技按键提示
						// ═══════════════════════════════════════════════════════════
						GE_SkillHint: "[c/F7D87C:能量充满后按下] [[c/F7D87C:{1}]] [c/F7D87C:释放至臻极冰之樊寒神钻。]"

						// ═══════════════════════════════════════════════════════════
						//  GE_StateReset — 状态重置说明
						// ═══════════════════════════════════════════════════════════
						GE_StateReset:
							'''
							[c/A0D8EF:状态重置规则：]
							[c/A0D8EF:  · 切换武器时：连击数归零、QTE 进度中断、被动增益消失]
							[c/A0D8EF:  · 冰川神性随连击归零而消失]
							[c/A0D8EF:  · 极光旋律计时器清空]
							[c/A0D8EF:  · 打击模式列阵状态与冷却清空]
							[c/A0D8EF:  · 终结技能量在切换武器后完整保留]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_Debuff — 减益信息
						// ═══════════════════════════════════════════════════════════
						GE_Debuff: "[c/A0D8EF:减益：所有攻击命中施加霜冻灼烧（Frostburn II），持续 5 秒。]"

						// ═══════════════════════════════════════════════════════════
						//  GE_CoreMinion — 冰核说明
						// ═══════════════════════════════════════════════════════════
						GE_CoreMinion:
							'''
							[c/A0D8EF:◆ 极寒冰核（IceBlockMinion）]
							[c/A0D8EF:不占用仆从栏的辅助核心，首次使用武器时自动召唤。]
							[c/A0D8EF:作为冰刺系统的锚点，只要持有武器便会存在。]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_ModeOverview — 三形态速览
						// ═══════════════════════════════════════════════════════════
						GE_ModeOverview:
							'''
							[c/F7D87C:三形态速览：]
							[c/90FFB0:  · 斩击模式：半栏双刺，内外旋转，广域持续压制]
							[c/80EFFF:  · 突刺模式：飞射嵌入，鞭击引爆，单体爆发输出]
							[c/FF8B60:  · 打击模式：列阵碰撞，太阳鞭爆破，精准节奏控场]
							'''

						// ═══════════════════════════════════════════════════════════
						//  GE_UltimateActiveText — 终结技释放文本
						// ═══════════════════════════════════════════════════════════
						GE_UltimateActiveText: 极冰聚寒 · 神钻降世!

						// ═══════════════════════════════════════════════════════════
						//  GE_DivinityName — 冰川神性增益名
						// ═══════════════════════════════════════════════════════════
						GE_DivinityName: 冰川神性

						// ═══════════════════════════════════════════════════════════
						//  GE_AuroraMelodyName — 极光旋律增益名
						// ═══════════════════════════════════════════════════════════
						GE_AuroraMelodyName: 极光旋律

						// ═══════════════════════════════════════════════════════════
						//  GE_ComboDisplay — 连击显示文本
						// ═══════════════════════════════════════════════════════════
						GE_ComboDisplay: "[c/B0E0FF:霜冻连击：×{0}（+{1} 回血，+{2} 防御）]"

						// ═══════════════════════════════════════════════════════════
						//  GE_UltimateChargeDisplay — 能量显示
						// ═══════════════════════════════════════════════════════════
						GE_UltimateChargeDisplay: "[c/A0F0FF:极冰能量：{0}/240]"

						// ═══════════════════════════════════════════════════════════
						//  GE_QteSuccess / GE_QteFail — QTE 结果文本
						// ═══════════════════════════════════════════════════════════
						GE_QteSuccess: "完美！连击：{0}"
						GE_QteFail: "失误！"

						// ═══════════════════════════════════════════════════════════
						//  GE_StrikeAlignReady — 打击列阵就绪提示
						// ═══════════════════════════════════════════════════════════
						GE_StrikeAlignReady: "[c/FF8B60:冰刺已列阵 — 左键触发碰撞轰击!]"

						// ═══════════════════════════════════════════════════════════
						//  LegendaryHint / LegendaryText
						// ═══════════════════════════════════════════════════════════
						LegendaryHint: "[c/BABABA:按住 Shift 阅读完整传奇记录]"
						LegendaryText:
							'''
							[c/B0D8FF:起初只是一枚被遗忘在永冻层深处的冰晶碎片，]
							[c/B0D8FF:在无人触及的千年寒渊中独自旋转。]
							[c/B0D8FF:它不知道什么是温暖，也不知道什么是寂静以外的声音。]
							[c/80C8FF:后来有人试图驾驭它，将极寒编织成环绕身侧的守护，]
							[c/80C8FF:却发现冰霜有自己的节奏与意志。]
							[c/80C8FF:每一次旋转都是一段未谱完的旋律，每一次碎裂都是一声未发出的叹息。]
							[c/A0B0FF:于是斩击劈开凝滞的空气，突刺穿透冻结的时光，]
							[c/A0B0FF:打击震碎一切本不该碎裂的事物。]
							[c/A0B0FF:三种姿态并非选择，而是寒冰自身的呼吸方式。]
							[c/C0A0FF:学会倾听它的节拍，在每一次转换中踏准冰霜的韵脚——]
							[c/C0A0FF:那便是驾驭极寒的唯一秘钥。]
							[c/E0C0FF:当最后一次节拍完美落下，神钻便会从万年冰封中苏醒，]
							[c/E0C0FF:将所有的冰刺凝为一柄贯穿星空的极光之矛，]
							[c/E0C0FF:以绝对零度的意志，终结这冰与火交织的战场。]
							'''
					}
				}
			}
		}

		Projectiles: {

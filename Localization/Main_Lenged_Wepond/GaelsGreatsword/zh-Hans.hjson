Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewLegendGaelsGreatsword: {
					DisplayName: 末世余烬-盖尔大剑
					Tooltip: "[GFB]"
					FunctionalTooltip:
						'''
						[c/FFD966:左键] [c/DCD6C8:略快于雄伟之护的自定义大剑挥舞，斩击高潮时剑身胀大。]
						[c/DCD6C8:每次挥舞循环释放血骷髅、硫火飞镖、复仇灵魂、灾厄斩击与裁决箭雨。]
						[c/8DB8FF:右键] [c/DCD6C8:按住举剑格挡，持续举剑会缓慢积攒余烬。]
						[c/DCD6C8:格挡中受到伤害会使该次伤害降低50%。]
						[c/DCD6C8:解除格挡后，将自己大幅击退，并进入5秒冷却。]
						[c/EED6FA:完美格挡] [c/DCD6C8:举剑瞬间的0.23秒内受击视为完美格挡。]
						[c/DCD6C8:完全格开该次伤害，姿态不断且不进冷却。]
						[c/DCD6C8:返还大量余烬、立即解锁追击斩。]
						[c/DCD6C8:以血火反击新星与复仇灵魂回敬来袭方向。]
						[c/8DB8FF:冷却右键] [c/DCD6C8:格挡冷却期间，右键改为从记录鼠标点正上方10格进行竖直下戳。]
						[c/DCD6C8:落地爆炸并迸发灵魂。]
						[c/7B5CFF:黑暗灵魂] [c/DCD6C8:肉前固定恢复灾厄怒气并获得缓落；随Boss进度强化为短程飞行]
						[c/A01A2A:融于血与火] [c/DCD6C8:生命不高于50%或怒气达到75%以上时获得黑暗之血。]
						[c/DCD6C8:左键进入伤害窗口会消耗生命，提高伤害并点燃余烬。]
						[c/A01A2A:黑暗之血] [c/DCD6C8:离开触发阈值后仍持续3秒]
						[c/C86AFF:黑暗余烬] [c/DCD6C8:命中与黑暗之血会充能；余烬越高，近战伤害、攻速和减伤略微提高。]
						[c/DCD6C8:满格时终结技就绪。]
						[c/7B5CFF:黑暗人性] [c/DCD6C8:生命不高于50%时获得怒气并大幅提高近战攻速；这是肉后唯一的怒气来源]
						[c/FFD700:终结技] [c/DCD6C8:击败肉山后，无需传奇饰章。]
						[c/DCD6C8:满余烬时按灾厄怒气键 {0} 消耗余烬，旋转斗篷并释放大量追踪血骷髅。]
						[c/DCD6C8:斗篷收势时掀起终结新星与环形灵魂齐射。]
						'''
					LegendaryHint: "[c/BABABA:按住Shift键以读取记录]"
					LegendaryText:
						'''
						[c/8B6CFF:最初的盖尔大剑只需要保留一件事：一把破旧大剑在终局仍然向前挥下。]
						[c/8B6CFF:但如果只是复刻挥砍，它就只剩致敬，而不是能在这个世界里继续战斗的武器。]
						[c/8B6CFF:重构后，左键被整理为循环展开的至尊灾厄武器回响，每一段都把近身斩击与远处余波绑在一起。]
						[c/A01A2A:右键不再只是笨重下劈，而是先成为格挡姿态；只有姿态被击碎后，才用竖直坠落回应战场。]
						[c/A01A2A:而在举剑的一瞬，老猎人仍能把致命一击完全格开，再以血与火原样奉还。]
						[c/8B6CFF:它依旧不是高贵的剑，只是把血、火与迟来的怒意，一次又一次拖回战场中央。]
						'''
					FinisherLocked: 肉山之后，盖尔才抵达世界的尽头
					FinisherNeedsEmbers: 黑暗余烬尚未填满
					ParryText: 完美格挡！
				}
			}
		}

		Projectiles: {
			GaelGreatswordSwingHoldout.DisplayName: 盖尔大剑挥舞
			GaelGreatswordPlungeHoldout.DisplayName: 舍身斩
			GaelGreatswordGuardHoldout.DisplayName: 盖尔格挡
			GaelGreatswordCapeFinisher.DisplayName: 黑暗灵魂斗篷
			GaelGreatswordEmberUI.DisplayName: 黑暗余烬
			GaelGreatswordBloodEcho.DisplayName: 血火余波
			GaelGreatswordBrimstoneDart.DisplayName: 硫火回忆
			GaelGreatswordVengefulSoul.DisplayName: 复仇黑暗灵魂
			GaelGreatswordCatastropheSlash.DisplayName: 灾厄斩击回忆
			GaelGreatswordCondemnationArrow.DisplayName: 裁决箭
			GaelGreatswordDarkSoul.DisplayName: 血骷髅
		}

		Buffs: {
			GaelGreatswordBlackBlood: {
				DisplayName: 黑暗之血
				Description: 左键攻击会消耗生命并换取更高伤害
			}
		}
	}
}

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Tetris: {
					DisplayName: 俄罗斯方块
					Tooltip:
						'''
						手持该物品即可展开像素俄罗斯方块面板。
						多人模式下右键邀请最近的、同样手持俄罗斯方块的玩家联机。
						A/D 或左右方向键控制方块左右移动。S 或下方向键快速下落。空格键硬降到底。
						W、上方向键或 X 顺时针旋转。Z 逆时针旋转。C 暂存当前方块。
						游戏结束后按 R 重新开始。
						'''
				}

				Game2048: {
					DisplayName: "2048"
					Tooltip:
						'''
						手持该物品即可展开 4×4 像素 2048 面板。
						使用 W/A/S/D 或方向键滑动全部方块，相同数字每次滑动只会合并一次。
						每次有效滑动都会生成新的 2 或 4。游戏结束后按 R 重新开始。
						'''
				}

				Snake: {
					DisplayName: 贪吃蛇
					Tooltip:
						'''
						手持该物品即可展开像素贪吃蛇面板。
						单次点击 W/A/S/D 控制蛇转向。
						游戏结束后按 R 重新开始。
						'''
				}

				Minesweeper: {
					DisplayName: 扫雷
					Tooltip:
						'''
						手持该物品即可展开像素扫雷面板。
						左键踩雷，右键标记雷，可以反复取消标记
						数字表示周围的地雷数量，不小心踩到雷，会导致游戏直接结束
						标记所有地雷即可获胜，游戏结束后左键点击重新开始。
						[c/6FDFFF:“不是怎么老被炸呀”]
						'''
				}

				STG: {
					Tooltip:
						'''
						手持该物品即可展开纵屏弹幕射击面板。
						A/D 控制左右，W/S 控制前后，飞机会自动开火。
						击落随机来袭的敌机获得分数。命中敌机、敌弹或被敌机撞到都会损失生命。
						敌机偶尔掉落 P 强化，提升子弹数量与散射。三条命耗尽后游戏结束，按 R 重新开始。
						'''
					DisplayName: STG
				}

				LegendaryCodex: {
					DisplayName: 传奇图鉴
					Tooltip:
						'''
						[c/55DFFF:欢迎游玩《灾厄-传奇》 欢迎加入群聊进行讨论：876728711]
						[c/FF5555:如果遇到显示传奇武器时屏幕变黑的情况]
						[c/FF5555:请前往 模组配置 > 灾厄 > 客户端配置 > 第2个：额外文本特效，将其关闭。]
						[c/70E0A0:本模组还包含许多QOL相关内容 详情请看配置选项：]
						[c/70E0A0:大量材料的制作以及许多额外的改善体验的配方]
						[c/70E0A0:动物学家会在合适的时候出售Boss召唤物]
						[c/70E0A0:自定义Boss血条 以及显示物品内部名]
						[c/70E0A0:可以快速加速破译和充能的时间]
						[c/70E0A0:敌方弹幕包边等等更多功能]
						[c/FFFFFF:点击左键查看传奇图鉴]

						      ╱|、
						    (˚ˎ 。7
						     |、˜〵
						     じしˍ,)ノ
						'''
				}

				CTRLBoss: {
					DisplayName: Boss进度修改器
					Tooltip: 左键打开或关闭 Boss 进度调试面板。
				}

				SoundproofEarmuffs: {
					DisplayName: 隔音耳罩
					Tooltip:
						'''
						在背包中右键切换隔音。
						开启后音效降低90%，音乐不受影响。
						当前状态：[STATE]
						'''
					EnabledState: 开启
					DisabledState: 关闭
				}
			}

			Consumables: {
				LegendarySupplyBox: {
					DisplayName: 传奇补给包
					Tooltip: 右键打开，领取当前版本的传奇武器和配套图鉴。
				}

				RetroGameConsoleSupplyBox: {
					DisplayName: 复古游戏机补给包
					Tooltip: 右键打开，领取目前已经准备好的复古游戏机。
				}
			}

			LegendaryEmblem: {
				DisplayName: 黄金饰章
				Tooltip: 使用后永久解锁此角色手持所有传奇武器的大招
				AlreadyConsumed: 这个角色已经获得了黄金饰章的永久强化。
			}

			LegendaryUltimateTester: {
				DisplayName: 传奇大招测试器
				Tooltip: 仅供测试：让所有传奇武器的大招在1秒之内完成充能
			}
		}

		Projectiles: {
			A_Dev: {
				TetrisPanel.DisplayName: 俄罗斯方块面板

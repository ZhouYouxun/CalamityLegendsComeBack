Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Malachite: {
					DisplayName: Peacock Plume
					Tooltip: "[GFB]"
					LeftClick: "[c/7DFF9A:Left click:] Throw a fast poisonous kunai that briefly pins to enemies on hit. Stored special kunai are thrown one by one first. After Wall of Flesh, normal kunai ignore gravity instead of gaining a use-speed cut; after Plaguebringer Goliath they spawn 2 at a time, and after Moon Lord they spawn 3 at a time, pausing 10 frames before a high-speed launch."
					RightClick: "[c/80FFC8:Right click:] Generate 3 frenzied kunai behind you. If a full frenzied fan already exists, the old fan is awakened in one burst before 3 new kunai are stored. 3 second cooldown."
					StealthStrike: "[c/B5FF74:Stealth strike:] Left and right stealth strikes are identical: any stored peacock kunai are fired as left-click shots, then 23 new peacock kunai open behind you. Peacock kunai cannot pierce and rapidly home with a 3 degree per-frame turn limit; the ace causes a miniature blast on hit."
					Finale: "[c/D6FF9A:Finale:] At full stealth and when off cooldown, press [{0}] to call a softened green cone spotlight and falling petals. After 2 seconds, slash with Peacock Plume and erupt multi-hit green black-hole blasts around nearby enemies."
					Passive:
						'''
						[c/9AFFC8:Passives while held:]
						Nimble Step: enables grazing; each graze grants 1 stealth point.
						Phantom Blade: stealth strikes restore 15 stealth points.
						Into Shadow: above 50% stealth, gain 15% damage reduction and movement speed.
						'''
					LegendaryHint: "[c/BABABA:Hold Shift to read the record]"
					LegendaryText:
						'''
						[c/7DFF9A:When the plume opens, it is not the blade that moves, but the time left to its target.]
						[c/80FFC8:The frenzied kunai obey the fan only until they are awakened.]
						[c/B5FF74:The peacock spread waits in shadow, each blade watching for the first wrong step.]
						[c/D6FF9A:Once the spotlight falls, one cut is enough; the blasts finish the curtain call.]
						'''
				}
			}

			Accessories: {
				PeacockScroll: {
					DisplayName: Peacock Scroll
					Tooltip:
						'''
						+10% rogue damage
						While Peacock Plume's right-click is on cooldown, +15% rogue attack speed
						After Plantera is defeated, triggering Peacock Plume's left-click acceleration regenerates 3 frenzied kunai
						'''
				}

				PrecisionEmblem: {
					DisplayName: Precision Emblem
					Tooltip:
						'''
						+5% rogue damage and +10% rogue critical strike chance
						Awakened Peacock Plume kunai gain 10 armor penetration
						Peacock kunai and ace kunai deal 5% extra multiplicative damage
						'''
				}

				MalachiteFeather: {
					DisplayName: Malachite Feather
					Tooltip:
						'''
						While holding Peacock Plume, +15% rogue damage, +5% rogue critical strike chance, and +10% Peacock Plume projectile speed
						If no hanging kunai are present, generates one frenzied kunai every 30 frames
						'''
				}

				GaleAce: {
					DisplayName: Gale Ace
					Tooltip:
						'''
						While holding Peacock Plume, +15% rogue damage and +5% rogue critical strike chance
						Poison damage is doubled
						Peacock Plume's finale petals are blown toward your facing direction and deal damage
						Hanging kunai awakened by the finale become ace kunai
						'''
				}
			}
		}

		Projectiles: {
			Malachite: {
				MalachiteKunai.DisplayName: Peacock Kunai
				MalachiteHitCutVisual.DisplayName: Peacock Hit Lines
				MalachiteGreenExplosion.DisplayName: Peacock Blast
				MalachiteFinaleController.DisplayName: Peacock Finale
				MalachiteFinaleSlash.DisplayName: Peacock Slash
				MalachiteFinalePetal.DisplayName: Peacock Petal
			}
		}

		Cooldowns.Malachite_EX: Peacock Finale Cooldown
	}
}

			}

			AzureThunderGuZhouSlowDebuff: {
				DisplayName: Long Barge Lock
				Description: Movement speed reduced by 15%
			}

			AzureThunderQingTingDebuff: {
				DisplayName: Azure Thunder
				Description: Entangled by SunderBlade lightning
			}
		}


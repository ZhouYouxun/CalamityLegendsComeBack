Mods: {
	CalamityLegendsComeBack: {
		Common.NoMana: Not enough mana

		Items: {
			Weapons: {
				AzureThunder: {
					DisplayName: SunderBlade
					Tooltip: "[GFB]"
					AzureThunderLeft:
						'''
						[c/6FDFFF:Left click:] [c/DCD6C8:slowly swing the greatsword, releasing SunderBlade light orbs and multiple flying heavy swords.]
						[c/8DEBFF:On hit,] [c/DCD6C8:release extra lightning attacks.]
						'''
					AzureThunderRight:
						'''
						[c/6FDFFF:Right click:] [c/DCD6C8:create multiple floating swords on nearby ground or in the air.]
						[c/8DEBFF:Floating swords] [c/DCD6C8:periodically call down lightning on nearby enemies.]
						'''
					AzureThunderUltimate:
						'''
						[c/FFE85A:Ultimate:] [c/DCD6C8:at 120 ultimate energy, press [{0}] to gain Empyrean of Truth for 25 seconds.]
						[c/FFE85A:Empyrean of Truth] [c/DCD6C8:empowers SunderBlade's left click, right click, and final strikes.]
						'''
					AzureThunderPassiveHeavenEarth0: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:unlocked by default. Desert Scourge will improve it.]"
					AzureThunderPassiveHeavenEarth1: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:+1 mana regeneration for each active SunderBlade sword.]"
					AzureThunderPassiveHeavenEarth2: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:+1 mana regeneration for each active SunderBlade sword; +2 armor penetration.]"
					AzureThunderPassiveHeavenEarth3: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:+1 mana regeneration for each active SunderBlade sword; +2 armor penetration; +1 life regeneration.]"
					AzureThunderPassiveHeavenEarth4: "[c/B8F4FF:Force of Nature:] [c/DCD6C8:+1 mana regeneration for each active SunderBlade sword; +2 armor penetration; +1 life regeneration; +2% magic damage.]"
					AzureThunderPassiveHeavensWard0: "[c/B8F4FF:Ordained by Heaven:] [c/8A8A8A:unlocks after Hive Mind or Perforators.]"
					AzureThunderPassiveHeavensWard1: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 40 life.]"
					AzureThunderPassiveHeavensWard2: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 80 life.]"
					AzureThunderPassiveHeavensWard3: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 125 life.]"
					AzureThunderPassiveHeavensWard4: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 150 life.]"
					AzureThunderPassiveHeavensWard5: "[c/B8F4FF:Ordained by Heaven:] [c/DCD6C8:while held, periodically dodge one hit and restore 200 life.]"
					AzureThunderPassiveFourSymbols0: "[c/B8F4FF:Four Symbols of Harmony:] [c/8A8A8A:unlocks after Wall of Flesh.]"
					AzureThunderPassiveFourSymbols1: "[c/B8F4FF:Four Symbols of Harmony:] [c/DCD6C8:if fewer than 3 SunderBlade swords exist, automatically create one every 10 seconds.]"
					AzureThunderPassiveFourSymbols2: "[c/B8F4FF:Four Symbols of Harmony:] [c/DCD6C8:if fewer than 3 SunderBlade swords exist, automatically create one every 10 seconds; triggering this also restores life.]"
					AzureThunderPassiveFourSymbols3: "[c/B8F4FF:Four Symbols of Harmony:] [c/DCD6C8:triggering this restores life; if fewer than 6 SunderBlade swords exist, automatically create one every 10 seconds.]"
					AzureThunderThunderCharge: "[c/FFE85A:Breath of Transformation:] [c/DCD6C8:gained by final left-click lightning based on the target's electric debuffs and Elemental Mix, up to 3 stacks; disabled during Empyrean of Truth.]"
					AzureThunderDot: "[c/FFE85A:Empyrean of Truth damage over time:] [c/DCD6C8:upgrades from Static Discharge through progression and adds stronger debuffs at higher tiers.]"
					AzureThunderFinal: '''[c/FFE85A:"Let solemn thunder cleanse evil, call sweet rain, and spare the living."]'''
				}
			}
		}

		Buffs: {
			AzureThunderHarmonyBuff: {
				DisplayName: Empyrean of Truth
				Description: Final damage, defense, damage reduction, and life regeneration are increased; SunderBlade attacks are empowered.
			}
		}

		Projectiles: {
			AzureThunder: {
				AzureThunderSwingHoldout.DisplayName: SunderBlade
				AzureThunderLightOrb.DisplayName: SunderBlade Light Orb
				AzureThunderFlatLightning.DisplayName: SunderBlade Flat Bolt
				AzureThunderFlyingSword.DisplayName: SunderBlade Flying Sword
				AzureThunderGroundSword.DisplayName: SunderBlade Ground Sword
				AzureThunderGrandSword.DisplayName: SunderBlade Grand Sword
				AzureThunderStrikeSequencer.DisplayName: SunderBlade Strike Sequencer
			}
		}

		Cooldowns: {
			AzureThunder_ThunderCharge: Breath of Transformation
			AzureThunder_Ultimate: Empyrean of Truth
		}
	}
}

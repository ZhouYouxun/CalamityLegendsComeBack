			BFDominationQuiver: {
				// DisplayName: Domination Quiver
				/* Tooltip:
					'''
					+18% ranged damage, +8% ranged critical strike chance
					All BlossomFlux right-click charge times reduced by 50%
					Recovery: right-click healing flashes +4.
					Reconnaissance: right-click mark duration reaches its maximum.
					Bombardment: right-click barrage damage and radius increased.
					Plague: unlocks all advanced debuffs.
					''' */
			}

			PastLingering: {
				// DisplayName: Lingering Remnant
				/* Tooltip:
					'''
					Changes Breakthrough into a Phantasm-like mode: arrows are no longer converted and release strongly homing shards after hitting enemies.
					Continuous fire gradually increases attack speed. Reaching the maximum tier plays an extra sound.
					Recipe: Phantasm + 12 Luminite Bars + 5 Vortex Fragments @ Ancient Manipulator
					''' */
			}

			SwordsplosionQuiver: {
				// DisplayName: Swordsplosion Quiver
				/* Tooltip:
					'''
					Changes Bombardment's falling projectiles into Swordsplosion blade rain.
					Each blade can only deal damage once.
					''' */
			}

			BlightSpewerQuiver: {
				// DisplayName: Blight Spewer Quiver
				/* Tooltip:
					'''
					Changes Plague left-click into Blight Spewer plague flames.
					Keeps BlossomFlux's base plague effects.
					''' */
			}

			SeedOfSilva: {
				// DisplayName: Seed of Silva
				/* Tooltip:
					'''
					Generates five seeds that slowly orbit the player and emit a faint green glow.
					While holding BlossomFlux, the seeds bloom into different flowers based on the current doctrine.
					Breakthrough: Sunflower
					Sunflowers create a small field. Breakthrough arrows passing through it gain 30% damage and 15% critical strike chance.
					Recovery: Daisy
					Daisies have 15 maximum life, regenerate 1.2 life per second, and inherit the player's defense and damage reduction.
					If a daisy takes 20 or more damage, it heals the player for its stored regenerated life, rounded down.
					Reconnaissance: Delphinium
					Delphiniums attack nearby enemies once every 1.5 seconds with a curving arc that deals light damage and stuns for 1 second.
					Stunned enemies are heavily slowed and take double damage from reconnaissance arrows.
					Enemies immune to knockback only receive the damage bonus, reduced to 1.15x.
					Each successful delphinium stun restores 0.5 seconds of flight time.
					Bombardment: Torchflower
					Torchflowers spray flames when enemies approach.
					Arrows passing through a torchflower also trigger an explosion with an independent cooldown.
					Plague: Mandrake
					Mandrakes slow nearby enemies and reduce their contact damage by 15%.
					Mandrakes constantly create spores, like a Spore Sac, applying debuffs for 3 seconds each. Their cap follows the current weapon.
					Mandrakes also occasionally fire homing withering-flower projectiles that paralyze and slow enemies.
					Recipe: Bloom Stone + 50 Planty Mush + 10 Auric Bars @ Mythril Anvil
					''' */
			}

			SilvaHarp: {
				// DisplayName: Silva Harp
				/* Tooltip:
					'''
					Grants 150% of Bad Seed's positive attributes: +30% ranged damage, +15% ranged critical strike chance, and +22.5% arrow velocity.
					BlossomFlux gains a further +7.5% damage and +12% critical strike chance.
					+15 life per second. This regeneration cannot be reduced by any factor.
					+90 frames of invincibility after taking damage.
					Final Stand recharges twice as fast and can recharge during boss fights; it restores 300 life and immediately triggers an ultimate.
					That ultimate skips charging without shortening its barrage. It neither halves defense nor inflicts Withered.
					Recipe: Bad Seed + 12 Effulgent Feathers + 30 Planty Mush + 12 Gold Bars + 3 Divine Geodes @ Cosmic Anvil
					''' */
			}

			FairyDance: {
				// DisplayName: Fairy Dance
				/* Tooltip:
					'''
					+4 life regeneration and +6 defense.
					Summons pink, green, and blue fairies.
					Holding either attack with BlossomFlux sends them toward the cursor.
					Fairies launch every 5 frames, with 2 frames between each color.
					Contact deals 20 ranged damage, increased to 30 while holding right click.
					Releasing a charged right-click attack launches all three at once.
					Each simultaneous charge deals 120 damage and has 10 armor penetration.
					Fairy damage receives ranged bonuses but cannot critically strike.
					''' */
			}

			RainbowSpiritDance: {
				// DisplayName: Rainbow Spirit Dance
				/* Tooltip:
					'''
					+6 life regeneration, +10 defense, and +10% ranged damage.
					Includes every effect of Fairy Dance.
					Every 60 BlossomFlux hits summons a Prismatic Lacewing.
					Lacewings live for 18 seconds, with at most 7 active.
					While holding left click, each fires a fast rainbow bolt every 45 frames.
					Bolts deal 60 ranged damage, can critically strike, and inflict Holy Flames.
					Rainbow bolts have a maximum range of 35 tiles.
					Holding right click makes the lacewings rapidly orbit the player.
					Releasing right click sends every lacewing toward the cursor.
					Each deals 1200 ranged damage and is guaranteed to critically strike.
					Healing at least 200 life at once consumes one fairy and restores 100 life.
					If Final Stand is cooling down, its cooldown is reduced by 60 seconds.
					''' */
			}

			BadSeed: {
				// DisplayName: Bad Seed
				/* Tooltip:
					'''
					Halves defense and grants +20% ranged damage.
					Grants +10% ranged critical strike chance and +15% arrow velocity.
					BlossomFlux gains a further +5% damage and +8% critical strike chance.
					Final Stand immediately triggers an ultimate and skips its charge phase.
					All BlossomFlux ultimates have half their normal barrage duration.
					Final Stand recharges twice as fast and can recharge during boss fights.
					It no longer grants temporary invulnerability and instead restores 200 life.
					The revival also inflicts Withered for 30 seconds.
					''' */
			}

			BFArrowRest: {
				// DisplayName: BFArrowRest
				/* Tooltip:
					'''
					While equipped, BlossomFlux Breakthrough and Bombardment convert wooden arrows into their own projectiles; all other arrows fire normally.
					Without this accessory, both modes always fire their own projectiles regardless of arrow type.
					Recovery, Reconnaissance, and Plague are unaffected and always fire their custom projectiles.
					''' */
			}
		}


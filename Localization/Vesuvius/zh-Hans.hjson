Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				NewVesuvius: {
					DisplayName: 维苏维阿斯
					Tooltip: "[GFB]"
					LeftClick:
						'''
						[c/FF8A3D:左键：按住蓄力“超级火山蓄力”，松手后释放。]
						[c/FF8A3D:短点会被强制压到第0层，只发射三颗弱流星。]
						'''
					ChargeStage1: "[c/FF8A3D:当前解锁：第1层，玄武岩喷流。]"
					ChargeStage2: "[c/FF9F45:当前解锁：第2层，斯特龙博利喷发。]"
					ChargeStage3: "[c/FFC45B:当前解锁：第3层，武尔卡诺式喷发。]"
					ChargeStage4: "[c/FF754F:当前解锁：第4层，维苏威式喷发。]"
					ChargeStage5: "[c/D84BFF:当前解锁：第5层，Toba级超级喷发。]"
					RightClick:
						'''
						[c/FFB15C:右键：按住右键像标枪一样架住法杖蓄力，松开后投掷。]
						[c/FFB15C:插入地形后形成活动断层核心；流程推进后会追加炮台火球、火山碎屑流和俯冲带。]
						'''
					Passive:
						'''
						[c/CC9A6A:被动【火山灰】手持时周围持续飘落火山灰。]
						[c/CC9A6A:被动【地震波】从空中落地会引发地震；坠落速度越高，范围和伤害越高。]
						'''
					EXHint:
						'''
						[c/FFD86B:手持维苏维阿斯时会积蓄终极能量，最高60点。]
						[c/FFD86B:大招【火山喷发】能量满后按] [[c/FFD86B:{0}]] [c/FFD86B:将法杖举过头顶并开始蓄力。]
						[c/FFD86B:准备音效响起后，点击左键释放5秒的火山灰、岩浆、陨石、火焰弹和黑曜石碎片。]
						'''
					EXDisabledHint: "[c/9A9A9A:大招【火山喷发】当前大招未解锁。]"
					Final: "[c/FFB15C:地壳崩裂、灰烬遮天、火山碎屑流横扫整个战场。]"
					LegendaryHint: "[c/BABABA:按住 Shift 读取记录]"
					LegendaryText:
						'''
						[c/FFB15C:最初的维苏维阿斯只是把火山理解成陨石：从天而降，砸碎目标，然后爆开。]
						[c/FF8A3D:这种设计足够直接，却只表现了火山最表层的坠落，没有表现地层本身的灾变。]
						[c/FFB15C:重构后，喷流、火山弹、岩浆柱、火焰风暴与破火山口崩塌被压进同一根法杖。]
						[c/D84BFF:右键不再只是另一种投射，而是把地震、断层与地壳压力一并拖进战场。]
						[c/FF4422:当最终爆发到来，落下的已经不是熔岩，而是整片地层替火山完成的一次宣告。]
						'''
				}
			}
		}


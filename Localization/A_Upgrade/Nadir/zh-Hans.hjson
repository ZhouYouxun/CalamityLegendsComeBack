Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Melee: {
					UmbralNadir: {
						DisplayName: 冥蚀天底
						Tooltip:
							'''
							[c/8CFF96:左键：上挑、劈落、冲刺贯穿的三段矛法，命中撕开黑洞冲击并叠加"蚀痕"。]
							[c/8CFF96:冲刺贯穿会留下持续吞噬的黑洞奇点，把敌群吸拢成一团。]
							[c/6FE0C0:右键：投出高速三连冥蚀矛。前两矛沿飞行轨迹唤出暗影魂针，专扑蚀痕最深的敌人；]
							[c/6FE0C0:第三矛命中即引爆终爆，消耗范围内全部蚀痕，消耗越多、爆发越猛。]
							[c/DDA0FF:按住左键时再按右键：进入回旋斩迹，将敌人卷拢、疯狂叠层并蓄满奇点；松开任一键即结束。]
							[c/DDA0FF:奇点蓄满时，回旋会以你为中心释放一记吞噬全场蚀痕的黑洞新星。]
							'''
						Charge: "[c/8A6FE0:奇点充能：{0}%]"
						NovaReady: "[c/DDA0FF:奇点已满——回旋斩迹将释放黑洞新星]"
					}
				}
			}
		}

		Projectiles: {
			Nadir: {
				UmbralNadirHoldout.DisplayName: 冥蚀连斩
				UmbralNadirImpactExplosion.DisplayName: 冥蚀黑洞冲击

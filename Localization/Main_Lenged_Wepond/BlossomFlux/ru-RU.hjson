			}

			BFResonatingQuiver: {
				// DisplayName: Resonating Quiver
				/* Tooltip:
					'''
					+14% ranged damage, +12 ranged armor penetration
					All BlossomFlux right-click charge times reduced by 35%
					Recovery: right-click healing flashes +3.
					Reconnaissance: right-click mark duration greatly increased.
					Bombardment: right-click barrage damage increased.
					Plague: unlocks the first set of advanced debuffs.

Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				StructureExtractor: {
					DisplayName: Extracteur de structures
					Tooltip: Tenez cet objet, faites glisser avec le clic gauche pour sélectionner une zone, puis confirmez l'exportation d'un fichier de structure .csch de Calamity.
				}
			}
		}

		Projectiles.A_Dev.StructureExtractorOverlay.DisplayName: Matrice d'extraction de structures

		TheSpecialText: {
			StructureExtractorSelectionLabel: "{0}x{1} | origine {2}, {3} | {4} tuiles"
			StructureExtractorConfirmTitle: Confirmer l'exportation de la structure
			StructureExtractorConfirmBody:
				'''
				Coin supérieur gauche : {0}, {1}
				Taille : {2} x {3}
				Total de tuiles : {4}
				Dossier d'enregistrement : {5}
				'''
			StructureExtractorCancel: Annuler
			StructureExtractorConfirm: Exporter
			StructureExtractorCanceled: Extraction de structure annulée.
			StructureExtractorExportSaved: Fichier de structure enregistré dans : {0}
			StructureExtractorExportDetails: Sélection : coin supérieur gauche {0}, {1} ; taille {2}x{3} ; {4} tuiles.
			StructureExtractorExportFailed: Échec de l'exportation de la structure : {0}
			StructureExtractorExportError: Erreur d'exportation de structure : {0}
		}
	}
}

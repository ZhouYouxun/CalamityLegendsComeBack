Mods: {
	CalamityLegendsComeBack: {
		Items: {
			Weapons: {
				Summon: {
					GlacialEmbrace: {
						ModeName0: 斩击模式
						ModeName1: 突刺模式
						ModeName2: 打击模式
						GE_Intro:
							'''
							[c/7BC8E5:当前战斗形态：{0}（每5秒自动轮换至下一形态）]
							[c/A0D8EF:召唤系传奇武器，基础伤害48，每次消耗10点法力]
							[c/A0D8EF:首次使用自动召唤极寒冰核（不占仆从栏）]
							[c/A0D8EF:所有攻击命中时均附加极寒灼烧（持续5秒）]
							'''
						GE_LeftClick:
							'''
							[c/A0D8EF:◆ 左键：无冰核时先召唤冰核作为锚定]
							[c/A0D8EF:  冰核存在后，点击召唤围绕玩家的冰钉]
							[c/A0D8EF:  仆从满时长按蓄力，松开触发特殊攻击]
							'''
						GE_SpikeMode0:
							'''
							[c/90FFB0:◈ 斩击 — 每枚冰钉分裂为大小两枚对置环绕]
							[c/90FFB0:  小钉：内轨90px，4°/帧，0.85x伤害]
							[c/90FFB0:  大钉：外轨140px，2.8°/帧，1.35x伤害]
							[c/90FFB0:  大小角速度不同，无敌帧各自独立结算]
							'''
						GE_SpikeMode1:
							'''
							[c/80EFFF:◈ 突刺 — 冰钉绕圈约3秒后自动飞出锁敌]
							[c/80EFFF:  命中时嵌入敌人，单敌最多容纳6枚冰钉]
							[c/80EFFF:  鞭子命中随机引爆1枚嵌入冰钉并贯穿]
							[c/80EFFF:  冰钉贯穿会造成二次伤害并击中小范围内的敌人]
							'''
						GE_SpikeMode2:
							'''
							[c/FF8B60:◈ 打击 — 冰钉尖端朝内，6秒冷却后自动列阵]
							[c/FF8B60:  列阵完成时按左键，冰钉对向碰撞产生冲击波]
							[c/FF8B60:  碰撞伤害2.2x，随后所有冰钉休眠4秒]
							'''
						GE_SpecialIntro: "[c/A0D8EF:◆ 特殊攻击（仆从满时长按左键蓄力，松开释放）]"
						GE_SpecialMode0:
							'''
							[c/90FFB0:斩击特殊：在鼠标位置凝聚冰刀（蓄满后发光）]
							[c/90FFB0:  松开后短暂延迟，冰刀快速绕玩家旋转2圈]
							[c/90FFB0:  多段命中，8帧无敌帧间隔]
							'''
						GE_SpecialMode1:
							'''
							[c/80EFFF:突刺特殊：射出具有追踪性的冰楔朝鼠标方向]
							[c/80EFFF:  命中时破碎，引爆目标身上全部嵌入冰钉]
							'''
						GE_SpecialMode2:
							'''
							[c/FF8B60:打击特殊：射出受重力影响的巨型冰柱]
							[c/FF8B60:  命中时大范围爆炸，可强制击退Boss]
							[c/FF8B60:  同时引爆所有冰钉产生冲击波，冰钉进入休眠]
							'''
						GE_PassiveRhythm:
							'''
							[c/B0E0FF:◇ 被动 — 霜冻节律：按住右键启动节奏QTE条]
							[c/B0E0FF:  在绿色甜点区间松开右键：连击+1（上限20）]
							[c/B0E0FF:  超出范围或超时未松开则连击清零并重置]
							'''
						GE_PassiveCombo: "[c/B0E0FF:  当前连击：{0}次（+{1}生命/秒，+{2}防御）]"
						GE_PassiveDivinity: "[c/B0E0FF:  连击达10次：冰钉速度提升10%（冰川神性5秒）]"
						GE_PassiveAurora:
							'''
							[c/C8A0FF:◇ 被动 — 极光旋律：特殊攻击命中间隔≤0.75秒]
							[c/C8A0FF:  触发5秒极光加护（+10防御，减伤15%）]
							'''
						GE_Ultimate:
							'''
							[c/A0F0FF:★ 终结技 — 至臻极冰之樊寒神钻（{0}键释放）]
							[c/A0F0FF:  特殊攻击命中+4能量，当前：{1}/240]
							[c/A0F0FF:  释放后冰钉三倍扩充为三层钻头（最多30枚）]
							[c/A0F0FF:  按左键推出，高频贯穿敌人，期间玩家无敌]
							[c/A0F0FF:  3秒后爆碎，造成6倍范围巨额伤害，清空冰钉]
							'''
						LegendaryHint: "[c/BABABA:按住 Shift 阅读完整传奇记录]"
						LegendaryText:
							'''
							[c/B0D8FF:起初只是一枚被遗忘在永冻层深处的冰晶碎片，]
							[c/B0D8FF:在无人触及的千年寒渊中独自旋转。]
							[c/B0D8FF:它不知道什么是温暖，也不知道什么是寂静以外的声音。]
							[c/80C8FF:后来有人试图驾驭它，将极寒编织成环绕身侧的守护，]
							[c/80C8FF:却发现冰霜有自己的节奏与意志。]
							[c/80C8FF:每一次旋转都是一段未谱完的旋律，]
							[c/80C8FF:每一次碎裂都是一声未发出的叹息。]
							[c/A0B0FF:于是斩击劈开凝滞的空气，突刺穿透冻结的时光，]
							[c/A0B0FF:打击震碎一切本不该碎裂的事物。]
							[c/A0B0FF:三种姿态并非选择，而是寒冰自身的呼吸方式。]
							[c/C0A0FF:学会倾听它的节拍，在每一次转换中踏准冰霜的韵脚——]
							[c/C0A0FF:那便是驾驭极寒的唯一秘钥。]
							[c/E0C0FF:当最后一次节拍完美落下，神钻便会从万年冰封中苏醒，]
							[c/E0C0FF:将所有的冰钉凝为一柄贯穿星空的极光之矛。]
							[c/E0C0FF:以绝对零度的意志，终结这冰与火交织的战场。]
							'''
					}
				}
			}
		}

		Projectiles: {
			IceBlockMinion.DisplayName: 极寒冰核
			IceSpikeMinion.DisplayName: 樊寒冰钉
			GlacialEmbraceChargeHoldout.DisplayName: 冰霜蓄力
